  "payments|status:ASCENDING,updatedAt:ASCENDING": {
    "purpose": "Sweep payments stuck in a non-terminal state",
    "feature": "Payments",
    "query": "paymentTimeoutSweep: where(status).where(updatedAt<=cutoff)",
    "owner": "Platform/Infra",
    "dateAdded": "2026-07-12",
    "expectedLifespan": "permanent"
  },
  "_sokoniTaskQueue|status:ASCENDING,scheduleFor:ASCENDING": {
    "purpose": "Pick up due retry tasks",
    "feature": "Task Queue",
    "query": "relScheduledRetryProcessor: where(status).where(scheduleFor<=now)",
    "owner": "Platform/Infra",
    "dateAdded": "2026-07-12",
    "expectedLifespan": "permanent"
  },
  "etimsQueue|status:ASCENDING,priority:ASCENDING,nextRetryAt:ASCENDING": {
    "purpose": "Drain the eTIMS submission queue by priority",
    "feature": "eTIMS",
    "query": "etimsProcessQueue: where(status).where(nextRetryAt<=now).orderBy(priority,nextRetryAt)",
    "owner": "Platform/Infra",
    "dateAdded": "2026-07-12",
    "expectedLifespan": "permanent"
  },
  "packageRequests|status:ASCENDING,scheduledTime:ASCENDING": {
    "purpose": "Dispatch deliveries whose scheduled time has arrived",
    "feature": "Logistics",
    "query": "processScheduledDeliveries: where(status).where(scheduledTime<=now)",
    "owner": "Platform/Infra",
    "dateAdded": "2026-07-12",
    "expectedLifespan": "permanent"
  },
  "dispatchQueue|status:ASCENDING,timeoutAt:ASCENDING": {
    "purpose": "Cascade an offer to the next rider on timeout",
    "feature": "Dispatch",
    "query": "processCascadeTimeouts: where(status==offered).where(timeoutAt<=now)",
    "owner": "Platform/Infra",
    "dateAdded": "2026-07-12",
    "expectedLifespan": "permanent"
  },
  "asyncJobs|status:ASCENDING,lockedUntil:ASCENDING": {
    "purpose": "Recover jobs whose worker died holding the lock",
    "feature": "Async Jobs",
    "query": "asyncSweeper: where(status==RUNNING).where(lockedUntil<=now)",
    "owner": "Platform/Infra",
    "dateAdded": "2026-07-12",
