{
  "name": "SOKONI — Kenya's Global Marketplace",
  "short_name": "SOKONI",
  "description": "Buy, sell, rent, book and hire — Kenya's all-in-one marketplace.",
  "version": "1.1.0",
  "start_url": "/?source=pwa",
  "scope": "/",
  "id": "sokoni-kenya-marketplace",

  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#71ff00",

  "orientation": "portrait-primary",
  "lang": "en-KE",
  "dir": "ltr",

  "categories": ["shopping", "business", "lifestyle"],
  "prefer_related_applications": false,

  "icons": [
    {
      "src": "assets/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Shop Now",
      "short_name": "Shop",
      "url": "/category?cat=all&source=shortcut",
      "description": "Browse all products",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Flash Sale",
      "short_name": "Deals",
      "url": "/flashsale?source=shortcut",
      "description": "Limited time deals",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Sell on Sokoni",
      "short_name": "Sell",
      "url": "/seller?source=shortcut",
      "description": "Seller dashboard",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Track Order",
      "short_name": "Track",
      "url": "/track?source=shortcut",
      "description": "Track your delivery",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],

  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=ke.co.mysokoni.app",
      "id": "ke.co.mysokoni.app"
    }
  ],

  "screenshots": [
    {
      "src": "assets/screenshots/screen-1.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Home — browse products"
    },
    {
      "src": "assets/screenshots/screen-2.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Seller dashboard"
    },
    {
      "src": "assets/screenshots/screen-3.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Checkout with M-Pesa"
    },
    {
      "src": "assets/screenshots/screen-4.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Live order tracking"
    }
  ],

  "share_target": {
    "action": "/product",
    "method": "GET",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link"
    }
  }
