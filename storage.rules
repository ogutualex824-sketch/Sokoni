rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    /* ── Helper: reject executable and dangerous MIME types ──────────────────
       Security 6.0: expanded blocklist covers archives (zip/rar/7z),
       scripts (sh/bat/ps1), PE/ELF binaries, SVG (XSS vector), and
       any application/octet-stream (unknown binary).
       ────────────────────────────────────────────────────────────────────── */
    function notExecutable() {
      return !(request.resource.contentType.matches('application/x-.*')
            || request.resource.contentType.matches('text/x-.*')
            || request.resource.contentType.matches('application/octet-stream')
            || request.resource.contentType.matches('application/java-.*')
            || request.resource.contentType.matches('application/vnd.microsoft.*')
            || request.resource.contentType.matches('application/x-ms.*')
            || request.resource.contentType.matches('application/zip')
            || request.resource.contentType.matches('application/x-zip.*')
            || request.resource.contentType.matches('application/x-rar.*')
            || request.resource.contentType.matches('application/x-7z.*')
            || request.resource.contentType.matches('application/x-tar')
            || request.resource.contentType.matches('application/gzip')
            || request.resource.contentType == 'application/x-msdownload'
            || request.resource.contentType == 'application/x-dosexec'
            || request.resource.contentType == 'application/x-shellscript'
            || request.resource.contentType == 'text/html'
            || request.resource.contentType == 'text/javascript'
            || request.resource.contentType == 'application/javascript'
            || request.resource.contentType == 'application/json'
            || request.resource.contentType == 'image/svg+xml');
    }

    /* ── Helper: only allow explicitly safe image types ── */
    function safeImageOnly() {
      return request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/jpg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
          || request.resource.contentType == 'image/gif'
          || request.resource.contentType == 'image/avif';
    }

    /* ── Provider & entertainment stories — 150 MB video or 15 MB image ──
       STG-1: read requires auth (previously public) to prevent anonymous hotlinking.
       STG-4: separate delete rule avoids request.resource null on DELETE.      ── */
    match /provider-stories/{uid}/{filename} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && (
                                (request.resource.contentType.matches('video/.*')
                                  && request.resource.size < 150 * 1024 * 1024)
                             || (safeImageOnly()
                                  && request.resource.size < 15 * 1024 * 1024)
                           );
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    match /entertainment-stories/{uid}/{filename} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && (
                                (request.resource.contentType.matches('video/.*')
                                  && request.resource.size < 150 * 1024 * 1024)
                             || (safeImageOnly()
                                  && request.resource.size < 15 * 1024 * 1024)
                           );
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Property and BnB videos — 150 MB max ── */
    match /bnb-videos/{uid}/{filename} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && request.resource.contentType.matches('video/.*')
                           && request.resource.size < 150 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    match /property-videos/{uid}/{filename} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && request.resource.contentType.matches('video/.*')
                           && request.resource.size < 150 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Product images — 15 MB max, safe image types only ── */
    match /product-images/{uid}/{allPaths=**} {
      allow read:          if true;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && safeImageOnly()
                           && request.resource.size < 15 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Profile avatars — 5 MB max, safe image types only ── */
    match /profile-avatars/{uid}/{filename} {
      allow read:          if true;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && safeImageOnly()
                           && request.resource.size < 5 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Seller store banners / logos — 10 MB max, safe image types only ── */
    match /seller-assets/{uid}/{allPaths=**} {
      allow read:          if true;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && safeImageOnly()
                           && request.resource.size < 10 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Driver / provider identity documents — 20 MB max (safe image or PDF only) ── */
    match /documents/{uid}/{filename} {
      allow read:  if request.auth != null
                   && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024
                   && (safeImageOnly()
                    || request.resource.contentType == 'application/pdf');
    }

    /* ── Community / post media — 15 MB image or 80 MB video ── */
    match /community-media/{uid}/{filename} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && (
                                (request.resource.contentType.matches('video/.*')
                                  && request.resource.size < 80 * 1024 * 1024)
                             || (safeImageOnly()
                                  && request.resource.size < 15 * 1024 * 1024)
                           );
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── AI Creative Studio — generated assets, banners, posters,
          logos, brand kits, stories, receipts, menus, events,
          property, vehicle, delivery proof, and AI-generated output.
          STG-5: safeImageOnly() replaces image/.* to block SVG/XSS vectors. ── */
    match /creative-assets/{uid}/{allPaths=**} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && (
                                (safeImageOnly()
                                  && request.resource.size < 15 * 1024 * 1024)
                             || (request.resource.contentType.matches('video/.*')
                                  && request.resource.size < 150 * 1024 * 1024)
                             || (request.resource.contentType == 'application/pdf'
                                  && request.resource.size < 20 * 1024 * 1024)
                           );
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Security audit exports — admin-only, PDF/CSV/XLSX only ──
       STG-2: write now requires admin token claim, not just UID match.        ── */
    match /security-exports/{adminUid}/{filename} {
      allow read:          if request.auth != null
                           && (request.auth.uid == adminUid
                               || request.auth.token.role == 'admin'
                               || request.auth.token.role == 'super_admin');
      allow create, update: if request.auth != null
                           && request.auth.uid == adminUid
                           && (request.auth.token.admin == true
                               || request.auth.token.superAdmin == true)
                           && notExecutable()
                           && (request.resource.contentType == 'application/pdf'
                            || request.resource.contentType == 'text/csv'
                            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')
                           && request.resource.size < 50 * 1024 * 1024;
      allow delete:        if request.auth != null
                           && (request.auth.token.admin == true
                               || request.auth.token.superAdmin == true);
    }

    /* ── Chat attachments — 100 MB max, no executables ── */
    match /chatAttachments/{uid}/{allPaths=**} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && request.resource.size < 100 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── KYC / verification documents — strict: image or PDF, admin+owner read ── */
    match /kyc-documents/{uid}/{filename} {
      allow read:  if request.auth != null
                   && (request.auth.uid == uid
                       || request.auth.token.admin == true
                       || request.auth.token.role == 'admin'
                       || request.auth.token.role == 'super_admin');
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && notExecutable()
                   && request.resource.size < 20 * 1024 * 1024
                   && (safeImageOnly()
                    || request.resource.contentType == 'application/pdf');
    }

    /* ── Default: deny everything else ── */
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
