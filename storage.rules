rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    /* ── Helper: reject executable and dangerous MIME types ──────────────────
       Security 6.0: expanded blocklist covers archives (zip/rar/7z),
       scripts (sh/bat/ps1), PE/ELF binaries, SVG (XSS vector), and
       any application/octet-stream (unknown binary).
       ────────────────────────────────────────────────────────────────────── */
    function notExecutable() {
      return !(request.resource.contentType.matches('application/x-.*')
            || request.resource.contentType.matches('text/x-.*')
            || request.resource.contentType.matches('application/octet-stream')
            || request.resource.contentType.matches('application/java-.*')
            || request.resource.contentType.matches('application/vnd.microsoft.*')
            || request.resource.contentType.matches('application/x-ms.*')
            || request.resource.contentType.matches('application/zip')
            || request.resource.contentType.matches('application/x-zip.*')
            || request.resource.contentType.matches('application/x-rar.*')
            || request.resource.contentType.matches('application/x-7z.*')
            || request.resource.contentType.matches('application/x-tar')
            || request.resource.contentType.matches('application/gzip')
            || request.resource.contentType == 'application/x-msdownload'
            || request.resource.contentType == 'application/x-dosexec'
            || request.resource.contentType == 'application/x-shellscript'
            || request.resource.contentType == 'text/html'
            || request.resource.contentType == 'text/javascript'
            || request.resource.contentType == 'application/javascript'
            || request.resource.contentType == 'application/json'
            || request.resource.contentType == 'image/svg+xml');
    }

    /* ── Helper: only allow explicitly safe image types ── */
    function safeImageOnly() {
      return request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/jpg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
          || request.resource.contentType == 'image/gif'
          || request.resource.contentType == 'image/avif';
    }

    /* ── Provider & entertainment stories — 150 MB video or 15 MB image ──
       STG-1: read requires auth (previously public) to prevent anonymous hotlinking.
       STG-4: separate delete rule avoids request.resource null on DELETE.      ── */
    match /provider-stories/{uid}/{filename} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && (
                                (request.resource.contentType.matches('video/.*')
                                  && request.resource.size < 150 * 1024 * 1024)
                             || (safeImageOnly()
                                  && request.resource.size < 15 * 1024 * 1024)
                           );
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    match /entertainment-stories/{uid}/{filename} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && (
                                (request.resource.contentType.matches('video/.*')
                                  && request.resource.size < 150 * 1024 * 1024)
                             || (safeImageOnly()
                                  && request.resource.size < 15 * 1024 * 1024)
                           );
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Property and BnB videos — 150 MB max ── */
    match /bnb-videos/{uid}/{filename} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && request.resource.contentType.matches('video/.*')
                           && request.resource.size < 150 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    match /property-videos/{uid}/{filename} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && request.resource.contentType.matches('video/.*')
                           && request.resource.size < 150 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Product images — 15 MB max, safe image types only ── */
    match /product-images/{uid}/{allPaths=**} {
      allow read:          if true;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && safeImageOnly()
                           && request.resource.size < 15 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Provider service (rate-card) images — D3. Owner-only writes, safe images,
       15 MB cap; public read (directory/service pages display them). ── */
    match /provider-service-images/{uid}/{allPaths=**} {
      allow read:          if true;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && safeImageOnly()
                           && request.resource.size < 15 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Profile avatars — 5 MB max, safe image types only ── */
    match /profile-avatars/{uid}/{filename} {
      allow read:          if true;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && safeImageOnly()
                           && request.resource.size < 5 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Seller store banners / logos — 10 MB max, safe image types only ── */
    match /seller-assets/{uid}/{allPaths=**} {
      allow read:          if true;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && safeImageOnly()
                           && request.resource.size < 10 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Driver / provider identity documents — 20 MB max (safe image or PDF only) ── */
    match /documents/{uid}/{filename} {
      allow read:  if request.auth != null
                   && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024
                   && (safeImageOnly()
                    || request.resource.contentType == 'application/pdf');
    }

    /* ── Community / post media — 15 MB image or 80 MB video ── */
    match /community-media/{uid}/{filename} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && (
                                (request.resource.contentType.matches('video/.*')
                                  && request.resource.size < 80 * 1024 * 1024)
                             || (safeImageOnly()
                                  && request.resource.size < 15 * 1024 * 1024)
                           );
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── AI Creative Studio — generated assets, banners, posters,
          logos, brand kits, stories, receipts, menus, events,
          property, vehicle, delivery proof, and AI-generated output.
          STG-5: safeImageOnly() replaces image/.* to block SVG/XSS vectors. ── */
    match /creative-assets/{uid}/{allPaths=**} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && (
                                (safeImageOnly()
                                  && request.resource.size < 15 * 1024 * 1024)
                             || (request.resource.contentType.matches('video/.*')
                                  && request.resource.size < 150 * 1024 * 1024)
                             || (request.resource.contentType == 'application/pdf'
                                  && request.resource.size < 20 * 1024 * 1024)
                           );
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── Security audit exports — admin-only, PDF/CSV/XLSX only ──
       STG-2: write now requires admin token claim, not just UID match.        ── */
    match /security-exports/{adminUid}/{filename} {
      allow read:          if request.auth != null
                           && (request.auth.uid == adminUid
                               || request.auth.token.role == 'admin'
                               || request.auth.token.role == 'super_admin');
      allow create, update: if request.auth != null
                           && request.auth.uid == adminUid
                           && (request.auth.token.admin == true
                               || request.auth.token.superAdmin == true)
                           && notExecutable()
                           && (request.resource.contentType == 'application/pdf'
                            || request.resource.contentType == 'text/csv'
                            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')
                           && request.resource.size < 50 * 1024 * 1024;
      allow delete:        if request.auth != null
                           && (request.auth.token.admin == true
                               || request.auth.token.superAdmin == true);
    }

    /* ── Chat attachments — 100 MB max, no executables ── */
    match /chatAttachments/{uid}/{allPaths=**} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                           && request.auth.uid == uid
                           && notExecutable()
                           && request.resource.size < 100 * 1024 * 1024;
      allow delete:        if request.auth != null && request.auth.uid == uid;
    }

    /* ── KYC / verification documents — strict: image or PDF, admin+owner read ── */
    match /kyc-documents/{uid}/{filename} {
      allow read:  if request.auth != null
                   && (request.auth.uid == uid
                       || request.auth.token.admin == true
                       || request.auth.token.role == 'admin'
                       || request.auth.token.role == 'super_admin');
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && notExecutable()
                   && request.resource.size < 20 * 1024 * 1024
                   && (safeImageOnly()
                    || request.resource.contentType == 'application/pdf');
    }

    /* ── Unboxing photos — QUARANTINE, then publish (owner 2026-10-03) ──────────
       A buyer's photo is private until AdminOS approves the unboxing post:
         1. browser uploads to unboxing-pending/{uid}/{file}: only that signed-in uid,
            safe image types only (no SVG), under 8 MB; readable by the owner and
            admins only; never public.
         2. submitUnboxing (Admin SDK) accepts media ONLY under the caller's own
            unboxing-pending/{uid}/ path.
         3. adminModerateReview (kind 'unboxing', approve) copies the file to
            unboxing/{uid}/{file} with the Admin SDK. That public path is never
            browser-writable, so nothing reaches the public before approval.
       Reject leaves the pending file private. A browser can never "publish" media. */
    match /unboxing-pending/{uid}/{filename} {
      allow read:   if request.auth != null
                    && (request.auth.uid == uid
                        || request.auth.token.get('admin', false) == true
                        || request.auth.token.get('superAdmin', false) == true);
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && safeImageOnly()
                    && request.resource.size < 8 * 1024 * 1024;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /unboxing/{uid}/{filename} {
      allow read:  if true;
      allow write: if false;
    }

    /* ── Default: deny everything else ── */
    // ── Education (sokoni-5b, 2026-10-03). The callables store STORAGE PATHS, never download URLs (a download token
    //    opens a file for anyone holding the link, whatever these rules say).
    // Learner photos — learners may be MINORS: owner + admin read ONLY (never public, never "any authed").
    // Teachers / companies get no access (the callables never return a photo to them).
    match /learner-photos/{uid}/{file} {
      allow read:           if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true || request.auth.token.superAdmin == true);
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && safeImageOnly()
                            && request.resource.size < 2 * 1024 * 1024
                            && file.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.(jpg|jpeg|png|webp)$');
      allow delete:         if request.auth != null && request.auth.uid == uid;
    }

    // Course materials — paid content, NOT world-readable. Learners read them ONLY through the courseLessons 'content'
    // op's 15-minute signed URL (enrolment / free-preview / owner checked server-side). Write = the course's instructor
    // while the course is a DRAFT. The firestore.get() cross-service check needs the Storage service agent's Firestore
    // access ("Cloud Storage for Firebase can access Firestore"); without it these writes are DENIED (fail closed).
    // Office (OOXML) types pass notExecutable(); contentType is client-declared, so the server should verify file type.
    match /course-materials/{ownerUid}/{courseId}/{file} {
      allow read:           if request.auth != null && (request.auth.uid == ownerUid || request.auth.token.admin == true || request.auth.token.superAdmin == true);
      allow create, update: if request.auth != null && request.auth.uid == ownerUid
                            && notExecutable()
                            && (request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'text/plain',
                                 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                                 'application/vnd.openxmlformats-officedocument.presentationml.presentation',
                                 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'])
                            && request.resource.size < 25 * 1024 * 1024
                            && firestore.get(/databases/(default)/documents/courses/$(courseId)).data.instructorUid == request.auth.uid
                            && firestore.get(/databases/(default)/documents/courses/$(courseId)).data.status == 'draft';
      allow delete:         if request.auth != null && request.auth.uid == ownerUid
                            && firestore.get(/databases/(default)/documents/courses/$(courseId)).data.status == 'draft';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
