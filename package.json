{
  "name": "sokoni",
  "version": "1.0.0",
  "description": "SOKONI — Kenya's Premier Marketplace",
  "private": true,
  "scripts": {
    "predeploy": "node scripts/verify-commission-single-source.js && node scripts/verify-consent-gate.js && node scripts/verify-claim-based-auth.js && node scripts/audit-duplicate-ids.js && node scripts/verify-admin-markup.js && node scripts/pre-deploy-check.js && node scripts/verify-appcheck.js && node scripts/verify-index-governance.js && node scripts/reconcile-indexes.js --verify",
    "verify:consent": "node scripts/verify-consent-gate.js",
    "verify:auth": "node scripts/verify-claim-based-auth.js",
    "audit:ids": "node scripts/audit-duplicate-ids.js",
    "verify:markup": "node scripts/verify-admin-markup.js",
    "test:panels": "node scripts/test-apps-render.js && node scripts/test-users-render.js",
    "audit:panels": "node scripts/audit-orphan-panels.js",
    "verify:appcheck": "node scripts/verify-appcheck.js",
    "test:offline": "node scripts/test-offline-detection.js",
    "verify:indexes": "node scripts/verify-index-governance.js",
    "verify:index-drift": "node scripts/reconcile-indexes.js --verify",
    "reconcile:indexes": "node scripts/reconcile-indexes.js --sync",
    "report:index-capacity": "node scripts/index-capacity-report.js",
    "dev": "http-server . -p 3000 -o --cors -c-1",
    "dev:bs": "browser-sync start --config bs-config.js",
    "deploy": "npx -y firebase-tools@latest deploy --only hosting",
    "deploy:all": "node scripts/verify-commission-single-source.js && npx -y firebase-tools@latest deploy --project sokoni-aeb26",
    "deploy:functions": "node scripts/verify-commission-single-source.js && npx -y firebase-tools@latest deploy --only functions --project sokoni-aeb26",
    "deploy:hosting": "node scripts/verify-commission-single-source.js && npx -y firebase-tools@latest deploy --only hosting --project sokoni-aeb26",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore,storage --project sokoni-aeb26",
    "check": "node scripts/pre-deploy-check.js",
    "monitor": "node scripts/setup-monitoring.js",
    "test:kass": "node scripts/test-kass-retrieval.js",
    "test:kass-modes": "node scripts/test-kass-modes-memory.js",
    "test:promotions": "node scripts/test-promotions.js",
    "test:sms": "node scripts/test-sms.js",
    "test:notify": "node scripts/test-notify.js",
    "verify:commission": "node scripts/verify-commission-single-source.js",
    "test:search": "node scripts/test-firestore-search.js",
    "scan:guards": "node scripts/scan-firestore-guards.js",
    "audit:invokers": "node scripts/audit-callable-invokers.js --all --probe",
    "release:preflight": "node scripts/audit-callable-invokers.js --all --snapshot .release-preflight.json",
    "release:postflight": "node scripts/audit-callable-invokers.js --all --compare .release-preflight.json",
    "scan:hidden-blur": "node scripts/scan-hidden-backdrop-blur.js",
    "scan:xss": "node scripts/scan-xss-sinks.js",
    "check:variants": "node scripts/check-variant-parity.js",
    "check:profile-rules": "node scripts/check-profile-rules.js",
    "test:algolia-isolation": "node scripts/test-algolia-batch-isolation.js"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "http-server": "^14.1.1",
    "playwright": "^1.60.0"
  }
}
