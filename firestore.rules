rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }

    function isAdmin() {
      return request.auth != null &&
             (request.auth.token.admin == true || request.auth.token.superAdmin == true);
    }

    function isModerator() {
      return request.auth != null &&
             (request.auth.token.moderator == true ||
              request.auth.token.admin == true ||
              request.auth.token.superAdmin == true);
    }

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthed() && resource.data.uid == request.auth.uid;
    }

    function claimsOwner() {
      return isAuthed() && request.resource.data.uid == request.auth.uid;
    }

    function uidUnchanged() {
      return !request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasAny(['uid']);
    }

    function _validGPS(lat, lng) {
      return lat is number && lng is number
          && lat >= -5.0  && lat <= 5.0
          && lng >= 33.9  && lng <= 42.0;
    }

    function noAdminFields() {
      return !request.resource.data.keys()
               .hasAny(['isAdmin','suspended','banned','adminApproved',
                        'featured','verified','flagged','adminNote',
                        'role','approved','approvedAt','approvedBy',
                        'commissionRate']);
    }

    function noPrivilegeEscalation() {
      return !request.resource.data.keys().hasAny(['registeredAs'])
             || !request.resource.data.registeredAs.keys()
                  .hasAny(['admin','superAdmin','moderator','isAdmin']);
    }

    function noProviderForgery() {
      let data = request.resource.data;
      let tokenProvider = request.auth.token.firebase.sign_in_provider;

      return !data.keys().hasAny(['provider'])
             || data.provider == tokenProvider
             || (data.provider == 'google'    && tokenProvider == 'google.com')
             || (data.provider == 'apple'     && tokenProvider == 'apple.com')
             || (data.provider == 'microsoft' && tokenProvider == 'microsoft.com')
             || (data.provider == 'facebook'  && tokenProvider == 'facebook.com')
             || (data.provider == 'github'    && tokenProvider == 'github.com')
             || (data.provider == 'phone'     && tokenProvider == 'phone')
             || (data.provider == 'password'  && tokenProvider == 'password')
             || (data.provider == 'oauth'     && tokenProvider != 'password');
    }

    function validPrice(field) {
      return request.resource.data[field] is number
             && request.resource.data[field] > 0;
    }

    function validOrderStatus() {
      return !request.resource.data.keys().hasAny(['status'])
             || request.resource.data.status in [
                  'pending','processing','confirmed',
                  'shipped','out_for_delivery','delivered','cancelled','refunded',
                  'completed',
                  'pending_payment','paid','awaiting_confirmation',
                  'rider_assigned','rider_en_route','picked_up','in_transit'
                ];
    }

    match /users/{userId} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == userId);
      allow create: if isAuthed()
                    && request.auth.uid == userId
                    && noAdminFields()
                    && noPrivilegeEscalation()
                    && noProviderForgery();
      allow update: if isAdmin()
                    || (isAuthed() && request.auth.uid == userId
                        && uidUnchanged()
                        && noAdminFields()
                        && noPrivilegeEscalation()
                        && noProviderForgery());
      allow delete: if isAdmin();
    }

    match /applications/{appId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin() || isOwner();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /providers/{providerId} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.uid == request.auth.uid
                        && uidUnchanged()
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['status', 'verified', 'suspended', 'approved']));
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {

      allow create: if isAuthed()
                    && (request.resource.data.customerId == request.auth.uid
                        || request.resource.data.buyerId  == request.auth.uid
                        || request.resource.data.userId   == request.auth.uid)
                    && noAdminFields();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid          == request.auth.uid)
                    || (isAuthed() && resource.data.buyerId      == request.auth.uid)
                    || (isAuthed() && resource.data.userId       == request.auth.uid)
                    || (isAuthed() && resource.data.providerId   == request.auth.uid)
                    || (isAuthed() && resource.data.customerId   == request.auth.uid)
                    || (isAuthed() && resource.data.ownerId      == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.customerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','cancelReason','cancellationReason','cancelledAt','cancelledBy','updatedAt','date','time','notes']))
                    || (isAuthed() && resource.data.ownerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','providerNote','updatedAt','confirmedAt','completedAt','approvedAt','rejectedAt','rejectionReason','checkIn','checkOut','reminders','autoCompletedAt']))
                    || (isAuthed() && resource.data.providerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','providerNote','updatedAt','confirmedAt','completedAt']));
      allow delete: if isAdmin();
    }
    match /venues/{venueId} {

      allow read:   if resource.data.status == 'active' || isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /venueBlockouts/{blockId} {
      allow read:   if isAuthed();
      /* Creator must own the venue they are blocking out */
      allow create: if isAuthed()
                    && request.resource.data.createdBy == request.auth.uid
                    && get(/databases/$(database)/documents/venues/$(request.resource.data.venueId)).data.ownerId == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.createdBy == request.auth.uid);
    }
    match /bookingHolds/{holdId} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid || isAdmin();
    }

    match /rides/{rideId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid         == request.auth.uid)
                    || (isAuthed() && resource.data.passengerId == request.auth.uid)
                    || (isAuthed() && resource.data.driverId    == request.auth.uid);

      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','cancelReason','updatedAt']))
                    || (isAuthed() && resource.data.driverId == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','driverNote','updatedAt','acceptedAt',
                                       'arrivedAt','startedAt','completedAt','driverLocation']));
      allow delete: if isAdmin();
    }

    match /driverLocations/{driverId} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthed()
                    && resource.data.uid          == request.auth.uid
                    && request.resource.data.uid  == request.auth.uid;
      allow delete: if isAdmin() || isOwner();
    }

    match /packages/{pkgId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.senderId == request.auth.uid)
                    || (isAuthed() && resource.data.driverId == request.auth.uid);
      allow update: if isAdmin()
                    || ((isAuthed() && resource.data.driverId == request.auth.uid
                         || isOwner())
                        && uidUnchanged());
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if claimsOwner()
                    && validOrderStatus();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid              == request.auth.uid)
                    || (isAuthed() && resource.data.userId           == request.auth.uid)
                    || (isAuthed() && resource.data.buyerId          == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid         == request.auth.uid)
                    || (isAuthed() && resource.data.sellerUid        == request.auth.uid)
                    || (isAuthed() && resource.data.assignedDriverUid == request.auth.uid);
      allow update: if isAdmin()

                    || ((isAuthed() && (resource.data.uid == request.auth.uid
                                       || resource.data.buyerUid == request.auth.uid))
                        && uidUnchanged()
                        && request.resource.data.status in ['cancelled']
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','cancelReason','updatedAt','review']))

                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && uidUnchanged() && validOrderStatus()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','sellerNote','readyAt','trackingNo','updatedAt']))

                    || (isAuthed() && resource.data.assignedDriverUid == request.auth.uid
                        && uidUnchanged() && validOrderStatus()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','driverNote','updatedAt','pickedUpAt','deliveredAt','etaMin']));
      allow delete: if isAdmin();
      match /events/{eventId} {

        allow create: if isAdmin()
                      || (isAuthed()
                          && (
                               get(/databases/$(database)/documents/orders/$(orderId)).data.uid              == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.buyerUid         == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.sellerUid        == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDriverUid == request.auth.uid
                          ));
        allow read:   if isAdmin()
                      || (isAuthed()
                          && get(/databases/$(database)/documents/orders/$(orderId))
                               .data.keys().hasAny(['uid','buyerUid','sellerUid','assignedDriverUid'])
                          && (
                               get(/databases/$(database)/documents/orders/$(orderId)).data.uid              == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.buyerUid         == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.sellerUid        == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDriverUid == request.auth.uid
                          ));
        allow update, delete: if false;
      }
    }

    match /fcm_tokens/{tokenId} {
      allow write: if isAuthed()
                   && request.auth.token.email != null
                   && request.resource.data.email == request.auth.token.email;
      allow read:  if isAdmin();
    }

    match /auditLogs/{logId} {
      allow create:         if isAuthed()
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.keys().hasAll(['uid','action','ts']);
      allow read:           if isModerator();
      allow update, delete: if false;
    }

    match /notifications/{notifId} {

      allow create: if isAdmin()
                    || (isAuthed()
                        && request.resource.data.targetUid == request.auth.uid
                        && request.resource.data.targetUid != 'broadcast'
                        && request.resource.data.keys().hasAll(['targetUid','heading','sub'])
                        && request.resource.data.type in [
                             'order','delivery','ride','general',
                             'booking','message','review','inventory_low',
                             'payment_reminder','support_reply'
                           ]);
      allow read:   if isAdmin()
                    || (isAuthed() && (
                         resource.data.targetUid == request.auth.uid
                      || resource.data.targetUid == 'broadcast'
                    ));

      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.targetUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['read', 'archived', 'pinned']));

      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.targetUid == request.auth.uid);
    }

    match /userNotifPrefs/{userId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }

    match /escrow/{orderId} {
      allow read:   if isAdmin();
      allow create, update, delete: if false;
    }
    match /referrals/{refId} {
      allow create: if isAuthed() && claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.referrerUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // CONSOLIDATED: Duplicate match /reviews/{reviewId} merged here (was duplicated near line 3119).
    // Moderation gate enforced: only 'approved' reviews are publicly readable.
    // Authors and admins may read their own unapproved reviews.
    match /reviews/{reviewId} {
      allow read:   if resource.data.status == "approved"
                    || (request.auth != null && (request.auth.uid == resource.data.authorUid || isAdmin()));
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    match /etims_submissions/{docId} {
      allow create:               if claimsOwner();
      allow read, update, delete: if isAdmin();
    }

    match /lawyers/{docId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    match /legalAppointments/{apptId} {
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','area','type','date','time','status'])
                    && request.resource.data.uid    == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status'])
                        && request.resource.data.status == 'cancelled')
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status'])
                        && request.resource.data.status in ['confirmed','declined','completed']);
      allow delete: if isAdmin();
    }

    match /legalServiceRequests/{reqId} {
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','category','type','status'])
                    && request.resource.data.uid    == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status'])
                        && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    match /legalReviews/{reviewId} {
      allow read:   if true;

      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','lawyerId','rating','date'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && !request.resource.data.keys().hasAny(['verified']);
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /foodOrders/{orderId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.buyerUid     == request.auth.uid)
                    || (isAuthed() && resource.data.restaurantId == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['id','restaurantId','restaurantName','phone','items','total','status','buyerUid'])
                    && request.resource.data.status   == 'placed'
                    && request.resource.data.total     > 0;
      allow update: if isAdmin()
                    || (isAuthed() && (resource.data.restaurantId == request.auth.uid
                        || resource.data.buyerUid == request.auth.uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','riderName','riderPhone','riderRating','updatedAt','statusHistory']));
      allow delete: if isAdmin();
    }

    match /foodMenus/{restaurantId} {
      allow read:   if true;
      allow write:  if isAdmin() || (isAuthed() && request.auth.uid == restaurantId);
    }

    match /legalBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.clientUid == request.auth.uid)
                    || (isAuthed() && resource.data.lawyerId  == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['ref','lawyerId','lawyerName','clientName','phone','matter','status','hub'])
                    && request.resource.data.clientUid == request.auth.uid
                    && request.resource.data.status in ['sent','confirmed']
                    && request.resource.data.hub == 'legal';
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
      allow delete: if isAdmin();
    }

    match /mechanics/{docId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    match /etims_config/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /userSync/{uid}/{subcol}/{docId} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write:  if isAuthed() && request.auth.uid == uid;
      allow delete: if isAuthed() && request.auth.uid == uid;
    }

    match /products/{productId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.sellerUid == request.auth.uid
                    && validPrice('price')
                    && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.sellerUid == request.auth.uid
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['sellerUid'])
                        && noAdminFields());
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
    }

    match /listings/{listingId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.ownerId == request.auth.uid
                    && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.ownerId == request.auth.uid
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['ownerId'])
                        && noAdminFields());
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid);
    }

    match /conversations/{convId} {
      function isParticipant() {
        return isAuthed() && request.auth.uid in resource.data.participants;
      }
      allow read: if isParticipant();

      allow update: if isParticipant()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['lastMessage','lastMessageAt','lastSenderId','unread']);
      allow create: if isAuthed()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() <= 2;
      allow delete: if isAdmin();
      match /messages/{msgId} {
        function inConvo() {
          return isAuthed()
            && get(/databases/$(database)/documents/conversations/$(convId))
                 .data.participants.hasAny([request.auth.uid]);
        }
        allow read: if inConvo();
        // MSG-1: all writes go through the sendMessage CF (admin SDK, bypasses rules).
        // Direct client writes are blocked to prevent senderId/senderName spoofing.
        allow create: if false;
        allow update, delete: if isAdmin();
      }
    }

    match /teams/{teamId} {
      allow read:   if true;

      allow create: if isAuthed() && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid);
    }

    match /tournaments/{tourneyId} {
      allow read:   if true;
      allow create: if claimsOwner();
      allow update: if isAdmin() || (isOwner() && uidUnchanged());
      allow delete: if isAdmin();
    }

    match /sportsPlayers/{playerId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    match /sportsCoaches/{coachId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    match /sportsVenues/{venueId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    match /sportsVenueBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['venueId','date','slots','name','phone','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sportsCoachBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['coachId','name','phone','date','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sportsTournamentRegs/{regId} {
      allow read:   if request.auth != null; // PII guard (B-17): phone/captain data requires authentication
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['tournamentId','teamName','captain','phone','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /sportsReviews/{reviewId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['targetId','targetType','author','rating','body','uid','ts'])
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.body.size() <= 2000;
      allow delete: if isAdmin();
    }

    match /sportsPosts/{postId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['type','author','sport','content','uid','ts'])
                    && request.resource.data.content.size() <= 3000;
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['content','likes','comments','updatedAt']));
      allow delete: if isAdmin() || isOwner();
    }

    match /sportsOrders/{orderId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['itemId','qty','total','phone','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /fitness_bookings/{bookingId} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(['type','provider','ref','uid','status','ts'])
                    && request.resource.data.status == 'confirmed';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /fitness_progress/{userId} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == userId);
      allow create: if isAuthed() && request.auth.uid == userId;
      allow update: if isAuthed() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /fitness_gyms/{gymId} {
      allow read:   if true;
      allow create: if isAuthed() && request.auth.uid == gymId && noAdminFields();
      allow update: if isAuthed() && request.auth.uid == gymId && uidUnchanged() && noAdminFields();
      allow delete: if isAdmin();
    }

    match /fitness_classes/{classId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['name','type','instructor','phone','uid','ts']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['name','loc','time','fee','slots','desc','type','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_clubs/{clubId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['name','type','uid','ts']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['name','desc','meet','members','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_community_posts/{postId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['uid','ts'])
                    && (request.resource.data.text == null || request.resource.data.text.size() <= 2000);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['text','likes','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_equipment/{itemId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['uid','ts']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['price','desc','sold','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_requests/{requestId} {
      allow read:   if request.auth != null; // PII guard (B-17): contact/phone data requires authentication
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['text','uid','ts'])
                    && request.resource.data.text.size() <= 1000;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['text','phone','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_challenges/{entryId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAuthed() && resource.data.uid == request.auth.uid && uidUnchanged();
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_checkins/{checkinId} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.gymUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.gymUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['memberName','gymUid','ts']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // REMOVED (B-17 fix): duplicate match /digitalProducts/{productId} — this block permitted
    // client-side create/update/delete, bypassing the CF-only intent enforced below.
    // Firestore OR-merges duplicate match blocks, so the client create here silently defeated
    // the `allow write: if false` guard in the Digital Products Hub section.
    // Canonical authoritative block is in the Digital Products Hub section below.

    // REMOVED (B-17 fix): duplicate match /digitalPurchases/{purchaseId} — this block permitted
    // client-side creates (pending/processing status), allowing clients to fabricate purchase
    // records and potentially claim entitlements without completing payment.
    // All purchase record creation/updates must go through Admin SDK (Cloud Functions).
    // Canonical authoritative block is in the Digital Products Hub section below.

    match /bnbListings/{listingId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(['id','name','type','location','price','phone','hostUid'])
                    && request.resource.data.hostUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.hostUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name','type','location','price','pricePerNight','desc','description','amenities','phone','image','images','video','available','maxGuests','bedrooms','bathrooms','updatedAt']));
      allow delete: if isAdmin() || (isAuthed() && resource.data.hostUid == request.auth.uid);
    }

    match /bnbBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid    == request.auth.uid)
                    || (isAuthed() && resource.data.hostUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['bnbId','uid','name','phone','checkIn','checkOut','nights','total','status'])
                    && request.resource.data.status == 'confirmed';
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.hostUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
      allow delete: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(['orderId','reason','status'])
                    && request.resource.data.status == 'open';
      allow read:   if isModerator()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid == request.auth.uid)
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);

      allow update: if isModerator()
                    || (isAuthed()
                        && (resource.data.uid      == request.auth.uid
                         || resource.data.buyerUid == request.auth.uid)
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['evidence','refundRequested',
                             'refundAmount','refundReason','refundRequestedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow create: if isAuthed()
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.keys().hasAll(['message','senderUid','sentAt'])
                      && request.resource.data.message.size() <= 2000
                      && (
                           get(/databases/$(database)/documents/disputes/$(disputeId)).data.uid       == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.buyerUid  == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.sellerUid == request.auth.uid
                        || isModerator()
                      );
        allow read:   if isModerator()
                      || (isAuthed() && (
                           get(/databases/$(database)/documents/disputes/$(disputeId)).data.uid       == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.buyerUid  == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.sellerUid == request.auth.uid
                      ));
        allow update, delete: if false;
      }
    }

    match /fraudAlerts/{alertId} {
      allow create: if isAuthed()
                    && request.resource.data.flaggedBy == request.auth.uid
                    && request.resource.data.keys().hasAll(['targetId','reason','flaggedBy']);
      allow read:   if isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    match /onboardingCompleted/{docId} {
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['role','uid','completedAt']);
      allow read:   if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read:   if true;
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['productId','offerPrice','originalPrice','active','createdBy'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.offerPrice < request.resource.data.originalPrice;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /withdrawals/{withdrawalId} {
      allow create: if isAuthed()
                    && request.resource.data.uid    == request.auth.uid
                    && request.resource.data.amount is  number
                    && request.resource.data.amount >   0
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['authorUid','content'])
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.content.size() <= 5000;

      allow update: if isAuthed()
                    && (
                         (resource.data.authorUid == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['content','title','edited','editedAt','tags','images']))
                      || (request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['likes','helpful','replies','reactions','reactionCount','views'])
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes'])
                              || (request.resource.data.likes is number
                                  && request.resource.data.likes >= resource.data.likes - 1
                                  && request.resource.data.likes <= resource.data.likes + 1))
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['helpful'])
                              || (request.resource.data.helpful is number
                                  && request.resource.data.helpful >= resource.data.helpful - 1
                                  && request.resource.data.helpful <= resource.data.helpful + 1))
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['views'])
                              || (request.resource.data.views is number
                                  && request.resource.data.views == resource.data.views + 1))
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionCount'])
                              || (request.resource.data.reactionCount is number
                                  && request.resource.data.reactionCount >= resource.data.reactionCount - 1
                                  && request.resource.data.reactionCount <= resource.data.reactionCount + 1))
                         )
                    );
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.authorUid == request.auth.uid);
    }
    match /communityGroups/{groupId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (isAuthed() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() || (isAuthed() && resource.data.createdBy == request.auth.uid);
    }
    match /userProgress/{uid}/{subcol}/{docId} {
      allow read, write: if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }
    match /userSessions/{sessionId} {
      allow create: if isAuthed()
                    && request.auth.token.email != null
                    && request.resource.data.userEmail == request.auth.token.email;
      allow read:   if isAdmin()
                    || (isAuthed()
                        && request.auth.token.email != null
                        && resource.data.userEmail == request.auth.token.email);
      allow update: if isAdmin()
                    || (isAuthed()
                        && request.auth.token.email != null
                        && resource.data.userEmail == request.auth.token.email);
      allow delete: if isAdmin()
                    || (isAuthed()
                        && request.auth.token.email != null
                        && resource.data.userEmail == request.auth.token.email);
    }

    match /bookingFees/{feeId} {

      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','amount','type'])
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /broadcast_notifications/{notifId} {
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin()
                  || (isAuthed() && (
                       resource.data.targetUid == request.auth.uid
                    || resource.data.targetUid == 'broadcast'
                  ));
    }

    match /deleted_products/{productId} {
      allow create, update: if isAdmin();
      allow read, delete:   if isAdmin();
    }

    match /unboxingReviews/{reviewId} {
      allow read:   if true;
      allow create: if claimsOwner();
      allow update: if (isAdmin() || isOwner()) && uidUnchanged();
      allow delete: if isAdmin() || isOwner();
    }

    match /shopEmployees/{empUid} {
      allow read:   if isAdmin()
                    || request.auth.uid == empUid
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
      allow create: if isAdmin()
                    || (isAuthed() && request.resource.data.shopOwnerId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
    }

    match /sellers/{uid} {
      allow read:   if true;
      allow create: if isAuthed() && request.auth.uid == uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && request.auth.uid == uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();

      // Click-and-collect orders placed by buyers, managed by the seller at POS
      match /clickAndCollect/{orderId} {
        // Seller sees all their C&C orders; buyer sees only their own
        allow read: if isAuthed()
                    && (request.auth.uid == uid
                        || resource.data.customerId == request.auth.uid
                        || isAdmin());
        allow create: if isAuthed()
                      && request.resource.data.customerId == request.auth.uid
                      && request.resource.data.keys().hasAll(['customerId','items','total','status'])
                      && request.resource.data.total is number
                      && request.resource.data.total > 0
                      && request.resource.data.status == 'pending';
        // Only seller / admin updates status (ready, collected, cancelled)
        allow update: if isAuthed() && (request.auth.uid == uid || isAdmin());
        allow delete: if false;
      }
    }

    match /sellerBroadcasts/{sellerName}/broadcasts/{broadcastId} {
      allow read:   if isAuthed();

      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['sellerUid'])
                    && request.resource.data.sellerUid == request.auth.uid;
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
    }

    match /landlordData/{uid} {
      allow read, write: if isAuthed() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    match /follows/{followId} {
      allow read:   if isAdmin() || (isAuthed() && followId.matches(request.auth.uid + '--.*'));
      allow create: if isAuthed() && followId.matches(request.auth.uid + '--.*');
      allow delete: if isAdmin() || (isAuthed() && followId.matches(request.auth.uid + '--.*'));
    }

    match /driverRatings/{ratingId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.driverId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /rideDrivers/{driverId} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && noAdminFields()
                    && _validGPS(request.resource.data.lat, request.resource.data.lng);
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.uid         == request.auth.uid
                        && request.resource.data.uid == request.auth.uid
                        && noAdminFields()
                        && (!request.resource.data.keys().hasAny(['lat','lng'])
                            || _validGPS(request.resource.data.lat, request.resource.data.lng)));
      allow delete: if isAdmin();
    }

    match /rideRequests/{reqId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid              == request.auth.uid)
                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid);

      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','cancelReason','updatedAt']))
                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','assignedDriverId','driverNote',
                                                      'updatedAt','acceptedAt','arrivedAt',
                                                      'startedAt','completedAt','driverLocation']));
      allow delete: if isAdmin();
    }

    match /packageRequests/{pkgId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid              == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid         == request.auth.uid)
                    || (isAuthed() && resource.data.sellerUid        == request.auth.uid)
                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid);
      allow update: if isAdmin()

                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','cancelReason','confirmedAt',
                                                      'buyerConfirmedAt','sellerPayoutReady',
                                                      'timeline','_lastTimelineEntry','updatedAt']))

                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','sellerNote','readyAt',
                                                      'timeline','_lastTimelineEntry','updatedAt']))

                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','driverNote','updatedAt',
                                                      'pickedUpAt','deliveredAt','arrivedAtSellerAt',
                                                      'acceptedAt','etaMin','payoutDue','proofNote',
                                                      'driverLat','driverLng','driverSpeed',
                                                      'timeline','_lastTimelineEntry'])
                        && (!request.resource.data.keys().hasAny(['driverLat','driverLng'])
                            || _validGPS(request.resource.data.driverLat, request.resource.data.driverLng)));
      allow delete: if isAdmin();
    }

    match /entArtists/{artistId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    match /entEvents/{eventId} {
      allow read:   if true;
      allow create: if claimsOwner();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    match /entTickets/{ticketId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid)
                    || (isAuthed() && resource.data.organizerUid == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.organizerUid == request.auth.uid
                        && uidUnchanged());
      allow delete: if isAdmin();
    }

    match /entVenues/{venueId} {
      allow read:   if true;
      allow create: if claimsOwner();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    match /entVenueBookings/{bookId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid)
                    || (isAuthed() && resource.data.venueOwnerUid == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.venueOwnerUid == request.auth.uid
                        && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    match /entArtistBookings/{bookId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid)
                    || (isAuthed() && resource.data.artistUid == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.artistUid == request.auth.uid
                        && uidUnchanged());
      allow delete: if isAdmin() || isOwner();
    }

    match /entReviews/{reviewId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    match /entContent/{contentId} {
      allow read:   if resource.data.status == 'active' || isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    match /deliveries/{deliveryId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.senderUid   == request.auth.uid)
                   || (isAuthed() && resource.data.assignedRiderId == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.senderUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.senderUid   == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['senderUid','deliveryFee','proofPIN']))
                    || (isAuthed() && resource.data.assignedRiderId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status','timeline','updatedAt','assignedRiderId',
                                      'riderName','riderPhone','riderAt','pickedUpAt',
                                      'deliveredAt','etaMin']));
      allow delete: if isAdmin();
    }

    match /deliveryRiders/{riderId} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.auth.uid == riderId
                    && !request.resource.data.keys().hasAny(['approved','verified','suspended','banned']);
      allow update: if isAdmin()
                    || (isAuthed() && request.auth.uid == riderId
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['approved','verified','suspended','banned']));
      allow delete: if isAdmin();
    }

    match /deliveryLocations/{riderId} {
      /* P0-7 (Phase 4 audit): was `read: if true` — anonymous access to every rider's
         real-time GPS (privacy/safety leak). Minimum baseline: require auth so live
         location can't be scraped anonymously. TODO(P0-7 full): scope to the delivery's
         participants (assigned rider + order buyer/seller + admin) by denormalizing a
         `viewers` array onto this doc from the assignment path, then:
           allow read: if isAdmin() || request.auth.uid == riderId
                        || (isAuthed() && request.auth.uid in resource.data.viewers); */
      allow read:   if isAuthed();
      allow write:  if isAdmin()
                    || (isAuthed() && request.auth.uid == riderId);
    }

    match /deliveryProofs/{proofId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.riderId    == request.auth.uid)
                   || (isAuthed() && resource.data.senderUid  == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.riderId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /shopSettings/{sellerUid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
      allow write: if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
    }

    /* SmartPOS 2.0 — Multi-device sessions */
    match /posSessions/{sessionId} {
      /* Seller always has full read access; other session members via memberUids array */
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerId == request.auth.uid)
                    || (isAuthed() && request.auth.uid in resource.data.memberUids);
      /* Only Cloud Functions (Admin SDK) write session state */
      allow write:  if false;
    }

    match /posPayments/{checkoutId} {
      allow read:  if isAdmin()
                   || (isAuthed() && (resource.data.sellerUid == request.auth.uid || resource.data.sellerId == request.auth.uid))
                   || (isAuthed() && (resource.data.callerUid == request.auth.uid || resource.data.buyerId == request.auth.uid));
      allow write: if false;
    }

    match /posQrLog/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /sellerPayments/{paymentId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid  == request.auth.uid)
                   || (isAuthed() && resource.data.callerUid  == request.auth.uid);
      /* SEC-F1: financial record — Cloud Functions only (Admin SDK bypasses rules).
         Previously `if isAdmin()`, which let a compromised/mis-scoped admin token
         mutate payment records straight from a client. 0 client files write this. */
      allow write: if false;
    }

    match /revenueConfig/{configId} {
      allow read:  if isAdmin()
                   || (isAuthed() && configId == ("seller_" + request.auth.uid))
                   || (isAuthed() && configId == "global")
                   || (isAuthed() && configId.matches("hub_.*"));
      allow write: if isAdmin();
    }

    match /subscriptionPlans/{planId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /sellerSubscriptions/{sellerUid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
      allow write: if isAdmin();
    }

    match /commissionLedger/{entryId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      /* SEC-F1: IMMUTABLE financial ledger — Cloud Functions only (Admin SDK bypasses
         rules). Previously `if isAdmin()`, which allowed ledger tampering from a client
         with an admin token, defeating the audit trail. 0 client files write this. */
      allow write: if false;
    }

    match /featuredListings/{featureId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid)
                   || resource.data.status == "active";
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sokoAds/{adId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /adImpressions/{impId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /sellerBilling/{sellerUid}/monthly/{period} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
      allow write: if isAdmin();
    }

    match /deliveryFees/{feeId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
    match /communityEvents/{eventId} {
      allow read: if true;
      allow create: if isAuthed()
                    && request.resource.data.organizerUid == request.auth.uid
                    && noAdminFields();
      allow update: if isAdmin() || (isAuthed() && resource.data.organizerUid == request.auth.uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    match /communityRecommendations/{recId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.askerUid == request.auth.uid;

      allow update: if isAdmin()
                    || (isAuthed() && resource.data.askerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['content','title','tags','edited','editedAt']));
      allow delete: if isAdmin();
    }
    match /communityRecResponses/{respId} {
      allow read: if true;
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['responderUid','content'])
                    && request.resource.data.responderUid == request.auth.uid;
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.responderUid == request.auth.uid);
    }
    match /communityReports/{reportId} {

      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','targetId','reason'])
                    && request.resource.data.uid == request.auth.uid;
      allow read, update: if isModerator();
      allow delete: if isAdmin();
    }

    match /leadFees/{leadId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /b2bFees/{feeId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /users/{uid}/loyalty/{docId} {
      allow read: if isAdmin() || (isAuthed() && request.auth.uid == uid);

      allow write: if isAdmin()
                   || (isAuthed()
                       && request.auth.uid == uid
                       && resource != null
                       && request.resource.data.total <= resource.data.total);
    }

    match /verifications/{sellerUid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);

      allow create: if isAuthed()
                    && request.auth.uid == sellerUid
                    && request.resource.data.status == 'pending'
                    && !request.resource.data.keys().hasAny(['verifiedAt','approvedBy']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /homeServiceBookings/{bookingId} {

      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','name','phone','service'])
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /homeServiceProviders/{provId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    match /homeServiceReviews/{revId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','providerId','rating'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    match /homeServiceLeads/{leadId} {
      allow read:   if isAdmin();
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['phone','service','uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /techITRequests/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /techStartups/{docId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    match /techJobs/{docId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    match /techLeads/{docId} {
      allow read:   if isAdmin();
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['name','phone']);
      allow update, delete: if isAdmin();
    }

    match /wallets/{walletUid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == walletUid);

      allow create: if isAuthed() && request.auth.uid == walletUid
                    && request.resource.data.balance == 0;

      allow update: if isAdmin(); // Wallet mutations via Admin SDK (Cloud Functions) only
      allow delete: if isAdmin();
    }

    match /notificationPrefs/{prefUid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == prefUid);
      allow create: if isAuthed() && request.auth.uid == prefUid
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthed() && request.auth.uid == prefUid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']);
      allow delete: if isAdmin();
    }

    match /walletTxns/{txId} {
      allow read:             if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin(); // All writes via Admin SDK (Cloud Functions) only
    }

    match /escrows/{escrowId} {
      allow create: if isAuthed() && request.resource.data.buyerUid == request.auth.uid;
      allow read:   if isAdmin()
                    || (isAuthed() && (resource.data.buyerUid  == request.auth.uid
                                    || resource.data.sellerUid == request.auth.uid));
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.buyerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['status','updatedAt'])
                        && request.resource.data.status in ['disputed','cancelled'])
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['status','updatedAt'])
                        && request.resource.data.status in ['shipped','delivered']);
      allow delete: if isAdmin();
    }

    match /businesses/{bizId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();

      match /pos_transactions/{txId} {
        allow read:   if isAdmin()
                      || (isAuthed() && request.auth.uid == bizId)
                      || (isAuthed() && resource.data.sellerUid == request.auth.uid);
        allow create: if isAuthed()
                      && request.auth.uid == bizId
                      && request.resource.data.sellerUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /terminals/{terminalId} {
        allow read:            if isAdmin() || (isAuthed() && request.auth.uid == bizId);
        allow create, update:  if isAuthed() && request.auth.uid == bizId;
        allow delete:          if isAdmin() || (isAuthed() && request.auth.uid == bizId);
      }

      match /terminal_queue/{queueId} {
        allow read:   if isAdmin() || (isAuthed() && request.auth.uid == bizId);
        allow create: if isAuthed() && request.auth.uid == bizId;
        allow update, delete: if isAdmin();
      }
    }

    match /bizViews/{bizId} {
      allow read:   if true;

      allow create: if isAuthed()
                    && request.resource.data.keys().hasOnly(['viewCount','lastViewAt'])
                    && request.resource.data.viewCount == 1;
      allow update: if isAuthed()
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['viewCount','lastViewAt'])
                    && request.resource.data.viewCount == resource.data.viewCount + 1;
      allow delete: if isAdmin();
    }

    match /businessTeam/{memberId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.ownerUid == request.auth.uid && uidUnchanged()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.ownerUid == request.auth.uid);
    }

    match /verificationRequests/{reqId} {
      allow create: if isAuthed()
                    && request.resource.data.applicantUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.applicantUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /adminLog/{logId} {
      allow create: if isAdmin();
      allow read:   if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /platformMetrics/{metricId} {
      allow read:  if isModerator();
      allow write: if isAdmin();
    }

    match /roleGrants/{grantId} {
      allow read:           if isAdmin();
      allow create:         if isAdmin();
      allow update, delete: if false;
    }

    match /flags/{flagId} {
      allow create: if isAuthed()
                    && request.resource.data.reporterUid == request.auth.uid;
      allow read:   if isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }
    match /propertyInquiries/{docId} {

      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['phone','propertyId','uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /propertyViewings/{docId} {

      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['propertyId','date','time','uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /platformInvites/{token} {
      allow get:    if true;
      allow list:   if isAdmin();
    }

    match /platformEmployees/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /shopInvites/{token} {
      allow get:    if true;
      allow list:   if isAdmin()
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
    }

    /* payments rules are defined exclusively in the Unified Payment Orchestrator block below (CF-only writes) */

    match /subscriptions/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);

    }

    match /vouchers/{code} {

      allow read:   if isAuthed();

      allow create, update, delete: if isAdmin();
    }

    match /voucherRedemptions/{redemptionId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /clientMetrics/{docId} {
      allow read:  if isAdmin();
    }

    match /trending/{hub} {
      allow read:  if true;
    }

    match /mailQueue/{docId} {
      allow read:  if isAdmin();
    }

    match /emailBounces/{email} {
      allow read:   if isAdmin();
      allow delete: if isAdmin();
    }

    match /emailAnalytics/{docId} {
      allow read:  if isAdmin();
    }

    match /emailEvents/{eventId} {
      allow read:  if isAdmin();
    }

    match /notificationHistory/{docId} {
      allow read:  if isAdmin()
                   || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    match /dmarcReports/{reportId} {
      allow read:  if isAdmin();
    }

    match /dmarcReports/{reportId}/records/{ipId} {
      allow read:  if isAdmin();
    }

    match /dmarcAlerts/{alertId} {
      allow read:  if isAdmin();
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(["resolved", "resolvedAt", "resolvedBy"]);
    }

    match /jobs/{jobId} {
      allow read:  if resource.data.active == true || isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.company is string
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 5000
                    && request.resource.data.contactEmail is string
                    && !('applicants' in request.resource.data)
                       || request.resource.data.applicants == 0;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == resource.data.uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['applicants','featured','plan','uid']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /jobApplications/{appId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['jobId','uid','name','email','phone','coverLetter','appliedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.coverLetter.size() <= 3000
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /education/{docId} {
      allow read:   if resource.data.active == true || isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.category is string
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 3000
                    && !('featured' in request.resource.data)
                    && !('active'   in request.resource.data)
                    && !('verified' in request.resource.data);
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.uid == request.auth.uid
                        && resource.data.uid == request.resource.data.uid
                        && !('featured' in request.resource.data)
                        && !('verified' in request.resource.data)
                        && !('active'   in request.resource.data));
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    function isPosOwner() {
      return isAuthed() && resource.data.sellerId == request.auth.uid;
    }
    function claimsPosOwner() {
      return isAuthed() && request.resource.data.sellerId == request.auth.uid;
    }

    match /posTransactions/{txnId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.status in ['completed', 'failed', 'pending']
                    && !('adminNote' in request.resource.data);
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isAdmin(); 
    }

    match /posProducts/{productId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0;
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isPosOwner() || isAdmin();
      allow delete: if isPosOwner() || isAdmin();
    }

    match /posStockMovements/{moveId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.productId is string
                    && request.resource.data.qty is number;
      allow read:   if isPosOwner() || isAdmin();
    }

    match /posShifts/{shiftId} {
      allow create: if claimsPosOwner();
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isPosOwner() || isAdmin(); 
      allow delete: if isAdmin();
    }

    match /posCustomers/{customerId} {
      allow create: if claimsPosOwner();
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isPosOwner() || isAdmin();
      allow delete: if isAdmin();
    }

    /* SmartPOS 2.1 — Sale records */
    match /posSales/{saleId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerId == request.auth.uid)
                   || (isAuthed() && resource.data.cashierUid == request.auth.uid);
      allow write: if false; /* CF only */
    }

    /* Digital receipts — public verify, CF write */
    match /receipts/{receiptId} {
      allow read:  if true; /* public verification endpoint */
      allow write: if false;
    }

    /* POS audit trail — manager+ read, CF write */
    match /posAuditLog/{logId} {
      allow read:  if isAdmin()
                   || (isAuthed() && (request.auth.token.posRole == 'manager'
                       || request.auth.token.posRole == 'owner'));
      allow write: if false;
    }

    /* Inventory transfers */
    match /inventoryTransfers/{transferId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerId == request.auth.uid);
      allow write: if false;
    }

    /* Branches */
    match /branches/{branchId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /posRefunds/{refundId} {
      /* CF-only writes — client cannot verify txn ownership server-side */
      allow read:   if isPosOwner() || isAdmin();
      allow write:  if false;
    }

    match /posVoids/{voidId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.originalTxnId is string;
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isAdmin();
    }

    match /posCashFloats/{floatId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.amount is number;
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /posDevices/{deviceId} {
      allow create: if claimsPosOwner();
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isPosOwner() || isAdmin();
      allow delete: if isAdmin();
    }

    /* ── Plug-and-Play POS v1.0 ─────────────────────────────────── */
    match /bootstrapCache/{cacheId} {
      allow read:  if isAuthed();
      allow write: if false; // CF-only
    }

    match /deviceAuditLog/{logId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only — immutable audit trail
    }

    match /syncQueue/{itemId} {
      allow read:  if isAuthed() && resource.data.uid == request.auth.uid;
      allow write: if false; // CF-only
    }

    match /posConfig/{configId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerId == request.auth.uid);
      allow write:  if isAdmin();
    }

    match /pos_branches/{branchId} {
      allow create: if isAuthed()
                    && request.resource.data.businessId == request.auth.uid
                    && request.resource.data.keys().hasAll(['businessId','name']);
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.businessId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.businessId == request.auth.uid
                        && request.resource.data.businessId == resource.data.businessId);
      allow delete: if isAdmin();
    }

    /* ─── SmartPOS 3.0 — Smart Inventory Pro ───────────────────── */
    match /posBatches/{batchId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posSerials/{serialId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posWarehouses/{warehouseId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posWarehouseStock/{stockId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posPurchaseOrders/{poId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posSuppliers/{supplierId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posReorderQueue/{itemId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posStockValuation/{valuationId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — Accounting ────────────────────────────── */
    match /posAccounts/{accountId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posJournalEntries/{entryId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posExpenses/{expenseId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posAccountingPeriods/{periodId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posAccountBalances/{balanceId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — CRM Pro ───────────────────────────────── */
    match /posWallets/{walletId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posWalletTransactions/{txnId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posGiftCards/{cardId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posStoreCreditLog/{creditId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posReferrals/{referralId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posOffers/{offerId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — Staff Ops ─────────────────────────────── */
    match /posAttendance/{attendanceId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posCommissions/{commissionId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posCommissionRates/{rateId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posApprovals/{approvalId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posCashReconciliation/{reconcileId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — HQ / Branch Mgmt ──────────────────────── */
    match /posCentralPrices/{priceId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posSharedCatalog/{catalogId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posCrossBranchFulfillments/{fulfillmentId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — BI Snapshots ──────────────────────────── */
    match /posBISnapshots/{snapshotId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — AI Assistant ──────────────────────────── */
    match /posAIQueries/{queryId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — Integrations ──────────────────────────── */
    match /posWebhooks/{webhookId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posAPIKeys/{keyId} {
      /* never expose key hash to client — owner can read metadata only */
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — Hardware Registry ─────────────────────── */
    match /posTerminals/{terminalId} {
      allow read:  if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      /* hardware wizard writes directly — allow owner write */
      allow create, update: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /tenants/{tenantId}/{document=**} {
      function isTenantMember() {
        return request.auth != null &&
               (request.auth.token.tenantId == tenantId || isAdmin());
      }
      function isTenantAdmin() {
        return isAdmin() || request.auth.token.get('tenantAdmin', false) == true;
      }
      match /inventory_products/{productId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 200
                      && request.resource.data.tenantId == tenantId
                      && !('deletedAt' in request.resource.data);
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && request.resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }
      match /inventory_levels/{levelId} {
        allow read:   if isTenantMember();
      }
      match /inventory_movements/{mvId} {
        allow read:   if isTenantMember();
      }
      match /inventory_purchaseOrders/{poId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.supplierId is string
                      && request.resource.data.status == 'draft';
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['createdBy', 'tenantId']);
        allow delete: if isTenantAdmin();
      }
      match /inventory_suppliers/{supplierId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.name is string
                      && request.resource.data.tenantId == tenantId;
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }
      match /inventory_warehouses/{warehouseId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantAdmin();
      }
      match /inventory_audits/{auditId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.status == 'in_progress';
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && resource.data.status == 'in_progress'
                      && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['completedAt', 'results']);
        allow delete: if isTenantAdmin();
      }
      match /inventory_alerts/{alertId} {
        allow read:   if isTenantMember();
      }
      match /inventory_reservations/{resId} {
        allow read:   if isTenantMember();
      }
      match /inventory_batches/{batchId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantMember() && request.resource.data.tenantId == tenantId;
      }
      match /inventory_serials/{serialId} {
        allow read:   if isTenantMember();
      }
      match /inventory_serialIndex/{serialNo} {
        allow read:   if isTenantMember();
      }
      match /inventory_analytics/{docId} {
        allow read:   if isTenantMember();
      }
      match /inventory_forecasts/{forecastId} {
        allow read:   if isTenantMember();
      }
      match /inventory_ai_logs/{logId} {
        allow read:   if isTenantAdmin();
      }
      match /inventory_audit/{logId} {
        allow read:   if isTenantAdmin();
      }
      match /inventory_avco/{avcoId} {
        allow read:  if isTenantMember();
        allow write: if false; // CF-only — inventoryUpdateAVCO, inventoryDeductAVCO
        match /history/{histId} {
          allow read:  if isTenantMember();
          allow write: if false; // CF-only
        }
      }
      match /inventory_health/{docId} {
        allow read:   if isTenantMember();
      }
      match /inventory_health_history/{docId} {
        allow read:   if isTenantMember();
      }
      match /inventory_fraud_events/{eventId} {
        allow read:   if isTenantAdmin();
      }
      match /inventory_simulations/{simId} {
        allow read:   if isTenantMember();
      }
      match /inventory_recalls/{recallId} {
        allow read:   if isTenantMember();
        allow create: if isTenantAdmin();
        allow update: if isTenantAdmin();
      }
      match /inventory_import_jobs/{jobId} {
        allow read:   if isTenantMember();
      }
      match /inventory_webhooks/{webhookId} {
        allow read:   if isTenantAdmin();
        allow create: if isTenantMember();
        allow update: if isTenantAdmin();
        allow delete: if isTenantAdmin();
        match /deliveries/{deliveryId} {
          allow read:  if isTenantAdmin();
        }
      }
      match /inventory_workflows/{workflowId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember() && request.resource.data.tenantId == tenantId;
        allow update: if isTenantAdmin();
        allow delete: if isTenantAdmin();
      }
      match /inventory_workflow_runs/{runId} {
        allow read:   if isTenantMember();
      }
      match /inventory_pricing_rules/{productId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantAdmin();
      }
      match /inventory_price_recommendations/{productId} {
        allow read:   if isTenantMember();
      }
      match /inventory_digital_twin/{warehouseId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantAdmin();
      }
      match /inventory_sustainability/{docId} {
        allow read:   if isTenantMember();
      }
      match /inventory_commerce_graph/{docId} {
        allow read:   if isTenantMember();
      }
      match /inventory_ai_tasks/{taskId} {
        allow read:   if isTenantAdmin();
        allow create: if isTenantMember();
      }
      match /inventory_supplier_catalog/{supplierId} {
        allow read:   if isTenantMember();
      }

      match /inventory_variants/{variantId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.productId is string
                      && request.resource.data.productId.size() > 0
                      && request.resource.data.sku is string;
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['tenantId', 'productId']);
        allow delete: if isTenantAdmin();
      }
      match /inventory_bom/{bomId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.parentProductId is string
                      && request.resource.data.active == true;
        allow update: if isTenantAdmin()
                      && resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }
      match /inventory_work_orders/{woId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.status == 'draft'
                      && request.resource.data.bomId is string
                      && request.resource.data.quantity is number
                      && request.resource.data.quantity > 0;

        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status in ['draft', 'in_progress']
                          && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['tenantId', 'bomId', 'completedAt', 'cancelledAt']));
        allow delete: if isTenantAdmin();
      }
      match /inventory_transfers/{transferId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.fromWarehouseId is string
                      && request.resource.data.toWarehouseId is string
                      && request.resource.data.status == 'pending'

                      && request.resource.data.fromWarehouseId != request.resource.data.toWarehouseId;

        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'receivedAt', 'receivedBy',
                                                      'receivedQty', 'note', 'updatedAt']));
        allow delete: if isTenantAdmin();
      }
      match /inventory_grn/{grnId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.purchaseOrderId is string
                      && request.resource.data.supplierId is string
                      && request.resource.data.status == 'draft';

        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status == 'draft'
                          && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['tenantId', 'purchaseOrderId', 'postedAt', 'postedBy']));

        allow delete: if isTenantAdmin()
                      && resource.data.status == 'draft';
      }
      match /inventory_stockcounts/{countId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.warehouseId is string
                      && request.resource.data.status == 'open'
                      && request.resource.data.keys().hasAll(['startedBy', 'startedAt']);

        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status == 'open'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['note', 'updatedAt']));
        allow delete: if isTenantAdmin()
                      && resource.data.status == 'open';

        match /lines/{lineId} {
          allow read:   if isTenantMember();
          allow create: if isTenantMember()
                        && get(/databases/$(database)/documents/tenants/$(tenantId)/inventory_stockcounts/$(countId))
                             .data.status == 'open'
                        && request.resource.data.keys().hasAll(['productId', 'counted', 'countedBy', 'countedAt'])
                        && request.resource.data.counted is number
                        && request.resource.data.counted >= 0;
          allow update: if isTenantMember()
                        && get(/databases/$(database)/documents/tenants/$(tenantId)/inventory_stockcounts/$(countId))
                             .data.status == 'open'
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['counted', 'note', 'updatedAt', 'updatedBy']);
          allow delete: if isTenantAdmin();
        }
      }
      match /inventory_requisitions/{reqId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.status == 'pending'
                      && request.resource.data.requestedBy == request.auth.uid
                      && request.resource.data.keys().hasAll(['items', 'requestedBy', 'requestedAt'])
                      && request.resource.data.items is list
                      && request.resource.data.items.size() > 0;

        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.requestedBy == request.auth.uid
                          && resource.data.status == 'pending'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'cancelNote', 'updatedAt'])
                          && request.resource.data.status == 'cancelled');
        allow delete: if isTenantAdmin();
      }
      match /inventory_supplier_contracts/{contractId} {
        allow read:   if isTenantMember();
        allow create: if isTenantAdmin()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.supplierId is string;
        allow update: if isTenantAdmin()
                      && resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }
      match /inventory_shelf_scans/{scanId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.warehouseId is string
                      && request.resource.data.status == 'pending';
        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status == 'pending'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'imageRef', 'updatedAt']));
        allow delete: if isTenantAdmin();
      }
    }

    match /gipLocations/{assetId} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && request.resource.data.assetId == assetId
                    && request.resource.data.lat  is number
                    && request.resource.data.lat  >= -90   && request.resource.data.lat  <= 90
                    && request.resource.data.lng  is number
                    && request.resource.data.lng  >= -180  && request.resource.data.lng  <= 180;
      allow update: if isAuthed()
                    && (request.auth.uid == resource.data.uid || isAdmin())
                    && request.resource.data.lat  is number
                    && request.resource.data.lat  >= -90   && request.resource.data.lat  <= 90
                    && request.resource.data.lng  is number
                    && request.resource.data.lng  >= -180  && request.resource.data.lng  <= 180;
      allow delete: if isAdmin();
    }

    match /gipDispatch/{jobId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid','type','status']);
      allow update: if isAuthed()
                    && (isAdmin() || resource.data.assignedAssetId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /gipAlerts/{alertId} {
      allow read:   if isAuthed()
                    && (isAdmin() || resource.data.assetId == request.auth.uid);
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved','resolvedAt']);
      allow delete: if isAdmin();
    }

    match /gipGeofences/{zoneId} {
      allow read:   if isAuthed();
      allow write:  if isAdmin();
    }

    match /gipGeofenceEvents/{eventId} {
      allow read:   if isAdmin();
    }

    match /gipHeatData/{region}/{date}/{hour} {
      allow read:   if isAuthed();
    }

    match /gipAnalytics/{date}/{subcollection}/{docId} {
      allow read:   if isAuthed()
                    && (isAdmin() || docId == request.auth.uid);
    }

    match /gipAssets/{assetId} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthed()
                    && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      match /serviceHistory/{serviceId} {
        allow read:   if isAuthed()
                      && (isAdmin() || get(/databases/$(database)/documents/gipAssets/$(assetId)).data.uid == request.auth.uid);
        allow create: if isAuthed()
                      && (isAdmin() || get(/databases/$(database)/documents/gipAssets/$(assetId)).data.uid == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    match /gipRoutes/{routeId} {
      allow read:   if isAuthed()
                    && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isAuthed();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sasosSubscriptions/{uid} {
      allow read:   if isAuthed() && request.auth.uid == uid;
    }

    match /sasosBillingLedger/{entryId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /sasosInvoices/{invoiceId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /sasosUsage/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && docId.matches(request.auth.uid + '_.*'));
    }

    match /sasosDunning/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /sasosRiskProfiles/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /sasosRiskEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /sasosManualReview/{uid} {
      allow read, write: if isAdmin();
    }

    match /sasosInsights/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /sasosAuditLog/{logId} {
      allow read:   if isAdmin();
    }

    match /sasosPlans/{planId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    match /sasosRenewalQueue/{docId} {
      allow read, write: if isAdmin();
    }

    match /sasosRevenueAggregates/{dateId} {
      allow read:   if isAdmin();
    }

    match /sasosPaymentRefs/{refId} {
      allow read, write: if false;
    }

    match /aiCredits/{uid} {
      allow read:   if isAuthed() && request.auth.uid == uid;
    }

    match /sasosCreditLedger/{entryId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /sasosStorageUsage/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && docId.matches(request.auth.uid + '_.*'));
    }

    match /entitlements/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /sasosOrgs/{orgId} {
      allow read:  if isAdmin()
                   || (isAuthed()
                       && exists(/databases/$(database)/documents/sasosSeats/$(orgId + '_' + request.auth.uid)));
    }

    match /sasosSeats/{seatId} {
      allow read:  if isAdmin()
                   || (isAuthed() && seatId.matches('.*_' + request.auth.uid));
    }

    match /sasosSeatInvites/{inviteId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.invitee == request.auth.uid);
    }

    match /sasosLicenses/{licenseId} {
      allow read:   if isAdmin()
                    || (isAuthed()
                        && exists(/databases/$(database)/documents/sasosSeats/$(resource.data.orgId + '_' + request.auth.uid)));
    }

    match /platformServices/{serviceId} {
      allow read:  if isAdmin();
    }

    match /platformHealth/{serviceId} {
      allow read:  if isAdmin();
    }

    match /platformDependencies/{edgeId} {
      allow read:  if isAdmin();
    }

    match /platformEvents/{eventId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.metadata.publishedBy == request.auth.uid);
      allow write: if false; /* CF only */
    }

    /* Event Bus subscriber registry */
    match /eventSubscribers/{subId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* Operations Center metrics */
    match /opsMetrics/{metricId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /selfHealLog/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /platformErrors/{errId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* Unified Payment Orchestrator */
    match /payments/{paymentId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.buyerId == request.auth.uid);
      allow write: if false; /* CF only */
    }

    match /platformSubscriptions/{subId} {
      allow read:  if isAuthed();
    }

    match /platformFanOut/{taskId} {
      allow read:  if isAdmin();
    }

    match /managerAuditLog/{entryId} {
      allow read:   if isAdmin();
    }

    match /managerAuthRequests/{reqId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.requestedByUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.requestedByUid == request.auth.uid;
      allow update: if isAuthed()
                    && (resource.data.requestedByUid == request.auth.uid || isAdmin())
                    && request.resource.data.keys().hasOnly(['status','respondedById','respondedByName','respondedAt'])
                    && request.resource.data.status in ['approved','denied'];
    }

    match /managerFCMTokens/{managerId} {
      allow read:   if isAdmin();
      /* Each manager may only write their own FCM token; admins may write any */
      allow write:  if isAdmin()
                    || (isAuthed()
                        && request.auth.uid == managerId
                        && request.resource.data.uid == request.auth.uid);
    }

    match /contactRequests/{reqId} {
      allow create: if isAuthed()
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['buyerUid','sellerUid','productId','message','createdAt']);
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid  == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','respondedAt','sellerNote']));
      allow delete: if isAdmin();
    }

    match /productQA/{qaId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['buyerUid','productId','question','createdAt']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.buyerUid  == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['question']))
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['answer','answeredAt']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.buyerUid == request.auth.uid);
    }

    match /posPrintJobs/{jobId} {
      allow read:             if isAdmin()
                              || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;  
    }

    match /sellerStats/{sellerUid} {
      allow read:             if isAdmin()
                              || (isAuthed() && request.auth.uid == sellerUid);
      allow create, update, delete: if false;  
    }

    match /productStats/{productId} {
      allow read:   if true;           
    }

    match /productPriceHistory/{historyId} {
      allow read:   if true;           
    }

    match /productViewDedup/{dedupKey} {
      allow read, write: if false;     
    }

    match /sellerPerformance/{sellerId} {
      allow read:   if true;           
    }

    match /ops_backups/{docId} {
      allow read:   if isAdmin();
    }

    match /cspViolations/{docId} {
      allow read:   if isAdmin();
    }

    match /_healthcheck/{docId} {
      allow read:   if isAdmin();
    }

    match /emailLogs/{logId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /emailQueue/{jobId} {
      allow read:   if isAdmin();
    }

    match /emailPreferences/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write:  if isAuthed() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                        ["orders","payments","marketing","account","security"]);
    }

    match /feedback/{feedbackId} {
      allow read:   if isAdmin();
    }

    match /ops_reports/{reportId} {
      allow read:   if isAdmin();
    }

    match /healthSnapshots/{snapId} {
      allow read:   if isAdmin();
    }

    match /funnelStats/{dateId} {
      allow read:   if isAdmin();
    }

    match /recentlyViewed/{uid}/items/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /savedSearches/{uid}/searches/{searchId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /userBehavior/{uid}/kassInteractions/{docId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
    }

    match /availabilityStatus/{uid} {
      allow read:  if true;
    }

    match /priceAlerts/{alertId} {
      allow read:   if request.auth != null &&
                       (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null &&
                       (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /searchQueryLog/{logId} {
      allow read:  if isAdmin();
    }

    match /checkoutSessions/{sessionId} {
      allow read:   if isAuthed() && resource.data.uid == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /rateLimits/{key} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /paymentVerifications/{ref} {
      allow read:  if isAuthed() &&
                      (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /_systemConfig/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /commissions/{commissionId} {
      allow read:   if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /securityEvents/{eventId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /sysConfig/{doc} {
      allow read:  if isAuthed();
    }

    match /trackedVehicles/{vehicleId} {
      allow read:  if isAuthed() && (
                     resource.data.ownerUid             == request.auth.uid ||
                     request.auth.uid in resource.data.authorizedDrivers ||
                     request.auth.uid in resource.data.familyMembers     ||
                     request.auth.uid in resource.data.fleetManagers      ||
                     isAdmin()
                   );
      allow create: if (isAuthed() && request.resource.data.ownerUid == request.auth.uid)
                    || isAdmin();
      allow update: if isAuthed()
                    && (resource.data.ownerUid == request.auth.uid || isAdmin())
                    && !request.resource.data.diff(resource.data)
                        .affectedKeys().hasAny(['ownerUid']);
      allow delete: if (isAuthed() && resource.data.ownerUid == request.auth.uid)
                    || isAdmin();
    }

    match /vehicleLocations/{vehicleId} {
      function _veh() {
        return get(/databases/$(database)/documents/trackedVehicles/$(vehicleId)).data;
      }
      allow read:  if isAuthed() && (
                     _veh().ownerUid == request.auth.uid ||
                     request.auth.uid in _veh().authorizedDrivers ||
                     request.auth.uid in _veh().familyMembers     ||
                     isAdmin()
                   );

      allow write: if isAuthed() && (
                     _veh().ownerUid == request.auth.uid ||
                     request.auth.uid in _veh().authorizedDrivers ||
                     isAdmin()
                   );
    }

    match /vehicleRoutes/{routeId} {
      allow read:   if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /vehicleAlerts/{alertId} {
      allow read:   if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /vehicleGeofences/{geofenceId} {
      allow read:   if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthed() && resource.data.ownerUid == request.auth.uid || isAdmin();
    }

    match /gpsDevices/{deviceId} {
      allow read:   if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    match /trackingShares/{shareId} {
      allow read:   if isAdmin()
                    || (isAuthed() && (resource.data.createdBy == request.auth.uid
                                      || resource.data.sharedWith == request.auth.uid));
      allow create: if isAuthed() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAuthed() && resource.data.createdBy == request.auth.uid || isAdmin();
      allow update: if isAdmin();
    }

    match /trackingSubscriptions/{uid} {
      allow read:   if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow write:  if isAuthed() && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(['adminOverride','freeTrial']);
      allow write:  if isAdmin();
    }

    match /vehicleServiceHistory/{recordId} {
      allow read:   if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /driverSessions/{sessionId} {
      allow read:   if isAuthed() && (
                      resource.data.driverUid == request.auth.uid ||
                      isAdmin()
                    );
      allow create: if isAuthed() && request.resource.data.driverUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.driverUid == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    match /etimsProfiles/{uid} {
      allow read:   if isAuthed() && (request.auth.uid == uid || isAdmin());
    }

    match /etimsCredentials/{uid}     { allow read, write: if false; }
    match /etimsSequences/{uid}       { allow read, write: if false; }
    match /etimsReconciliations/{docId}{ allow read, write: if false; }

    match /etimsInvoices/{invoiceId} {
      allow read:   if isAuthed() && (
                      resource.data.sellerUid == request.auth.uid ||
                      resource.data.buyerUid  == request.auth.uid ||
                      isAdmin()
                    );
    }

    match /etimsQueue/{queueId} {
      allow read:  if isAdmin();
    }
    match /etimsBulkJobs/{jobId} {
      allow read:  if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin());
    }
    match /etimsAlerts/{alertId} {
      allow read:  if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin());
    }

    match /hubs/{hubId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthed() && (
                      resource.data.managerId == request.auth.uid ||
                      resource.data.managerIds.hasAny([request.auth.uid])
                    ));
      allow delete: if isAdmin();
    }

    match /hubCredentials/{hubId} { allow read, write: if false; }
    match /hubSequences/{hubId}   { allow read, write: if false; }

    match /hubDocuments/{docId} {
      allow read: if isAuthed() && (
                    isAdmin() ||
                    resource.data.sellerId == request.auth.uid ||
                    resource.data.buyerId  == request.auth.uid ||
                    (exists(/databases/$(database)/documents/hubs/$(resource.data.hubId)) &&
                     get(/databases/$(database)/documents/hubs/$(resource.data.hubId)).data.managerIds.hasAny([request.auth.uid]))
                  );
    }

    match /hubInvoices/{invoiceId} {
      allow read: if isAuthed() && (
                    isAdmin() ||
                    resource.data.sellerUid == request.auth.uid ||
                    resource.data.buyerUid  == request.auth.uid ||
                    (exists(/databases/$(database)/documents/hubs/$(resource.data.hubId)) &&
                     get(/databases/$(database)/documents/hubs/$(resource.data.hubId)).data.managerIds.hasAny([request.auth.uid]))
                  );
    }

    match /hubInvoiceQueue/{queueId} {
      allow read:  if isAdmin();
    }

    match /dispatchQueue/{deliveryRef} {

      allow read: if isAuthed() && (
        isAdmin() ||
        resource.data.rankedRiders[resource.data.currentIndex].riderId == request.auth.uid ||
        get(/databases/$(database)/documents/packageRequests/$(deliveryRef)).data.sellerUid == request.auth.uid
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    match /deliveryProofs/{deliveryRef} {

      allow read: if isAuthed() && (
        isAdmin() ||
        resource.data.riderId == request.auth.uid ||
        get(/databases/$(database)/documents/packageRequests/$(deliveryRef)).data.sellerUid == request.auth.uid
      );
      allow create: if isAdmin();
    }

    match /deliveryAttempts/{attemptId} {
      allow read:  if isAdmin();
    }

    match /deliveryBatches/{batchId} {
      allow read: if isAuthed() && (
        isAdmin() ||
        resource.data.riderId == request.auth.uid
      );
    }

    match /riderMetrics/{docId} {

      allow read: if isAuthed() && (
        isAdmin() ||
        docId.matches(request.auth.uid + '_.*')
      );
    }

    match /deliveryHubs/{hubId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    match /fraudAlerts/{alertId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
    }

    match /analyticsRollup/{docId} {
      allow read:  if isAdmin();
    }

    match /smsQueue/{docId} {
      allow read:  if isAdmin();
    }

    match /csatRatings/{ratingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.riderId == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.rating   is number
                    && request.resource.data.rating   >= 1
                    && request.resource.data.rating   <= 5;
      allow update, delete: if false;
    }

    match /whatsappQueue/{docId} {
      allow read:  if isAdmin();
    }

    match /deliverySignatures/{docId} {
      allow read:  if isAdmin()
                   || (isAuthed() && (
                       resource.data.riderId == request.auth.uid
                       || resource.data.buyerUid == request.auth.uid));
    }

    match /ledger/{txId} {
      allow read:   if isAdmin();
    }

    match /wallets/{entityId} {
      allow read:   if isAdmin()
                    || (isAuthed() && request.auth.uid == entityId);

      match /transactions/{txId} {
        allow read:   if isAdmin()
                      || (isAuthed() && request.auth.uid == entityId);
      }
    }

    match /commissionRules/{ruleId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    match /payouts/{payoutId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.entityId == request.auth.uid);
    }

    match /promotions/{promoId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    match /promotionUsage/{usageId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.buyerUid == request.auth.uid);
    }

    match /taxRecords/{taxId} {
      allow read:   if isAdmin();
    }

    match /finosSnapshots/{snapId} {
      allow read:   if isAdmin();
    }

    match /finosAuditLog/{logId} {
      allow read:   if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status == 'active'
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.keys().hasAll(['senderId','timestamp','type','status','deleted','edited'])
                      && request.resource.data.type in ['text','image','pdf','voice']
                      && (request.resource.data.type != 'text'
                          || (request.resource.data.text is string && request.resource.data.text.size() <= 4000));

        allow update: if request.auth != null
                      && resource.data.senderId == request.auth.uid
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['deleted','deletedAt','text','edited','editedAt','storageRef']);
      }
    }

    match /userConversations/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      match /items/{conversationId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
      }
    }

    match /typingIndicators/{conversationId} {
      allow read: if request.auth != null;
      match /users/{uid} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /chatPolicies/{docId} {
      allow read:  if isAdmin();
    }

    match /moderationQueue/{reportId} {
      allow read:   if isAdmin();
      allow create: if isAuthed()
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.keys().hasAll(['conversationId','reportedBy','reason','status','createdAt'])
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin();
    }

    // REMOVED (B-17 fix): duplicate match /reviews/{reviewId} — moderation-gated read rule
    // has been merged into the canonical block earlier in this file (search for CONSOLIDATED reviews).
    match /reviews/{reviewId}/flags/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /reviews/{reviewId}/helpfulVotes/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
    }
    match /ratingsSummary/{targetId} {
      allow read:  if true;
    }
    match /dataDeletionRequests/{reqId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
    }
    match /dataRightsRequests/{reqId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
    }
    match /accountDeletions/{reqId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
    }
    match /shopHandles/{handle} {
      allow read:  if true;
    }
    match /minishopConfig/{shopId} {
      allow read:  if true;
    }
    match /minishopAnalytics/{shopId} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == resource.data.ownerUid);
    }
    match /shopFollowers/{docId} {
      allow read:  if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthed() && resource.data.uid == request.auth.uid;
    }
    match /minishopCampaigns/{campaignId} {

      allow read:  if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
    }
    match /merchantHealthScores/{shopId} {

      allow read:  if isAuthed() && (request.auth.uid == resource.data.sellerUid || isAdmin());
    }
    match /merchantAutomations/{docId} {

      allow read:  if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
    }
    match /merchantAcademyProgress/{shopId} {

      allow read:  if isAuthed() && (request.auth.uid == resource.data.uid || isAdmin());
    }

    match /trips/{tripId} {
      allow read:  if isAdmin() || (isAuthed() && resource.data.riderId == request.auth.uid);
    }
    match /riderLocations/{riderId} {
      allow read:  if isAdmin() || (isAuthed() && riderId == request.auth.uid);
      allow write: if isAuthed() && riderId == request.auth.uid;
    }
    match /fleetEvents/{eventId} {
      allow read:  if isAdmin();
    }
    match /driverEarningQueue/{docId} {
      allow read:  if isAdmin();
    }

    match /loyaltyAccounts/{uid} {

      allow read:  if isAuthed() && request.auth.uid == uid || isAdmin();
    }
    match /loyaltyTransactions/{txId} {

      allow read:  if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
    }
    match /loyaltyRules/{docId} {

      allow read:  if true;
      allow write: if isAdmin();
    }

    match /wallets/{uid} {

      allow read:  if isAuthed() && request.auth.uid == uid || isAdmin();
    }
    match /walletTransactions/{txId} {

      allow read:  if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
    }
    match /payoutRequests/{reqId} {

      allow read:  if isAuthed() && resource.data.sellerUid == request.auth.uid || isAdmin();
    }

    match /jobs/{jobId} {

      allow read:  if resource.data.status == 'active'
                   || (isAuthed() && resource.data.employerUid == request.auth.uid)
                   || isAdmin();
    }
    match /jobApplications/{appId} {

      allow read:  if isAuthed() && (
                     resource.data.seekerUid == request.auth.uid ||
                     resource.data.employerUid == request.auth.uid
                   ) || isAdmin();
    }
    match /jobSeekerProfiles/{uid} {

      allow read:  if isAuthed();
    }
    match /savedJobs/{docId} {

      allow read:  if isAuthed() && resource.data.uid == request.auth.uid;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthed() && resource.data.uid == request.auth.uid;
    }


    /* ── QR Code System v1.0 ─────────────────────────────────────── */
    match /qrTokens/{tokenId} {
      allow read, write: if false;
    }

    /* ── Education Hub v1.0 ────────────────────────────────────────── */
    match /courses/{courseId} {
      allow read: if resource.data.status == 'published' || isAdmin() || (isAuthed() && resource.data.instructorUid == request.auth.uid);
      allow write: if false;
    }
    match /courseEnrollments/{docId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /courseProgress/{docId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /courseReviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    /* ── Super Admin / Platform Config ─────────────────────────────── */
    match /platformConfig/{docId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
    match /platformBroadcasts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* ── Foundation Charitable Giving Platform ──────────────────────── */
    match /foundationStats/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /foundationDonations/{donId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /foundationApplications/{appId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /foundationCampaigns/{campId} {
      allow read: if true;
      allow write: if false;
    }
    match /foundationRecurring/{recId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }

    /* ── SOKONI Impact Enterprise Platform ──────────────────────────── */
    match /impactLedger/{entryId} {
      allow read: if isAdmin();
