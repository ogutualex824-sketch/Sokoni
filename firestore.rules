rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ══════════════════════════════════════════════════════════════
       HELPER FUNCTIONS
    ══════════════════════════════════════════════════════════════ */

    /*
     * isSuperAdmin()
     * Firebase ID token carries superAdmin == true custom claim.
     * Super admins can do everything admins can, plus manage admin claims.
     */
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }

    /*
     * isAdmin()
     * Returns true when the Firebase ID token carries the custom
     * claim  admin == true OR superAdmin == true, set server-side
     * by the Cloud Functions grantAdminClaim / grantPlatformRole.
     * Hardcoded email checks are intentionally absent.
     */
    function isAdmin() {
      return request.auth != null &&
             (request.auth.token.admin == true || request.auth.token.superAdmin == true);
    }

    /*
     * isModerator()
     * Moderators can read and act on flagged content, disputes, and
     * community reports.  They cannot manage user accounts or view
     * sensitive financial data.
     */
    function isModerator() {
      return request.auth != null &&
             (request.auth.token.moderator == true ||
              request.auth.token.admin == true ||
              request.auth.token.superAdmin == true);
    }

    /*
     * isAuthed()
     * Any request that carries a valid Firebase Auth token.
     * Does NOT imply ownership of the target document.
     */
    function isAuthed() {
      return request.auth != null;
    }

    /*
     * isOwner()
     * The authenticated user's UID matches the 'uid' field already
     * stored in the target document (read before write).
     * Used in update / delete rules to verify the existing owner.
     */
    function isOwner() {
      return isAuthed() && resource.data.uid == request.auth.uid;
    }

    /*
     * claimsOwner()
     * The authenticated user's UID matches the 'uid' field in the
     * document being written (the incoming payload).
     * Used in create rules so users cannot write documents on behalf
     * of another user.
     */
    function claimsOwner() {
      return isAuthed() && request.resource.data.uid == request.auth.uid;
    }

    /*
     * uidUnchanged()
     * Returns true when an update does NOT touch the 'uid' field.
     * Applied to every update rule that allows non-admin writes so
     * that ownership cannot be silently transferred by overwriting
     * the uid field.
     */
    function uidUnchanged() {
      return !request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasAny(['uid']);
    }

    /*
     * _validGPS(lat, lng)
     * Validates GPS coordinates fall within Kenya's bounding box.
     * Applied to rideDrivers and packageRequests GPS fields to prevent
     * location spoofing or impossible coordinate values.
     * Kenya approx bounds: lat −5.0 to 5.0, lng 33.9 to 42.0
     */
    function _validGPS(lat, lng) {
      return lat is number && lng is number
          && lat >= -5.0  && lat <= 5.0
          && lng >= 33.9  && lng <= 42.0;
    }

    /*
     * noAdminFields()
     * Rejects writes that try to set admin-only privilege fields.
     * Applied to create/update rules for users, products, and orders
     * so clients cannot self-elevate or self-approve.
     */
    function noAdminFields() {
      return !request.resource.data.keys()
               .hasAny(['isAdmin','suspended','banned','adminApproved',
                        'featured','verified','flagged','adminNote',
                        'role','approved','approvedAt','approvedBy']);
    }

    /*
     * noPrivilegeEscalation()
     * When a write includes 'registeredAs', ensure the user is not
     * attempting to grant themselves admin, superAdmin, or moderator roles,
     * which must only be set via Cloud Functions / server-side claims.
     */
    function noPrivilegeEscalation() {
      return !request.resource.data.keys().hasAny(['registeredAs'])
             || !request.resource.data.registeredAs.keys()
                  .hasAny(['admin','superAdmin','moderator','isAdmin']);
    }

    /*
     * noProviderForgery()
     * When a client writes 'provider' or 'providers', the value must
     * match what Firebase Auth actually authenticated with.
     * This prevents a client from claiming to be a Google user when
     * they authenticated via password (or vice versa).
     */
    function noProviderForgery() {
      let data = request.resource.data;
      let tokenProvider = request.auth.token.firebase.sign_in_provider;
      // Allow the write if no 'provider' field is written, or if it matches
      // the canonical mapping between our short names and Firebase's provider IDs.
      return !data.keys().hasAny(['provider'])
             || data.provider == tokenProvider
             || (data.provider == 'google'    && tokenProvider == 'google.com')
             || (data.provider == 'apple'     && tokenProvider == 'apple.com')
             || (data.provider == 'microsoft' && tokenProvider == 'microsoft.com')
             || (data.provider == 'facebook'  && tokenProvider == 'facebook.com')
             || (data.provider == 'github'    && tokenProvider == 'github.com')
             || (data.provider == 'phone'     && tokenProvider == 'phone')
             || (data.provider == 'password'  && tokenProvider == 'password')
             || (data.provider == 'oauth'     && tokenProvider != 'password');
    }

    /*
     * validPrice(field)
     * Ensures a numeric price/amount field is a positive number.
     */
    function validPrice(field) {
      return request.resource.data[field] is number
             && request.resource.data[field] > 0;
    }

    /*
     * validOrderStatus()
     * Status transitions must use one of the defined lifecycle values.
     * Covers both the legacy order statuses and the new SokoniOrders
     * 11-state engine (pending_payment → completed / cancelled / refunded).
     */
    function validOrderStatus() {
      return !request.resource.data.keys().hasAny(['status'])
             || request.resource.data.status in [
                  'pending','processing','confirmed',
                  'shipped','out_for_delivery','delivered','cancelled','refunded',
                  'completed',
                  'pending_payment','paid','awaiting_confirmation',
                  'rider_assigned','rider_en_route','picked_up','in_transit'
                ];
    }

    /* ══════════════════════════════════════════════════════════════
       USERS
       Each document is keyed by the Firebase Auth UID.
       Written by auth.js on createUserWithEmailAndPassword.
       • Only the document owner or an admin may read / update.
       • Nobody may delete their own account doc — admin only.
    ══════════════════════════════════════════════════════════════ */
    match /users/{userId} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == userId);
      allow create: if isAuthed()
                    && request.auth.uid == userId
                    && noAdminFields()
                    && noPrivilegeEscalation()
                    && noProviderForgery();
      allow update: if isAdmin()
                    || (isAuthed() && request.auth.uid == userId
                        && uidUnchanged()
                        && noAdminFields()
                        && noPrivilegeEscalation()
                        && noProviderForgery());
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       APPLICATIONS  (provider / driver onboarding)
       • create:  claimsOwner() — the uid in the payload must match
                  the authenticated user; anonymous submissions are
                  rejected at the rule layer, not just the UI.
       • read:    applicant or admin — nobody else sees your application.
       • update:  admin-only — the applicant cannot alter a submitted
                  application (prevents gaming approval status).
       • delete:  admin-only.
    ══════════════════════════════════════════════════════════════ */
    match /applications/{appId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin() || isOwner();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       PROVIDERS
       Public listing is intentional — hub pages (healthcare.html,
       services.html etc.) discover providers without requiring login.

       • create:  the uid field in the new document must match the
                  authenticated user's uid.  Previously this was only
                  isAuthed(), meaning any logged-in user could register
                  a provider profile on behalf of anyone else.
       • update:  provider may update their own profile, but cannot
                  touch approval/verification fields (status, verified,
                  suspended, approved) and cannot change the uid field.
       • delete:  admin-only.
    ══════════════════════════════════════════════════════════════ */
    match /providers/{providerId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.uid == request.auth.uid
                        && uidUnchanged()
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['status', 'verified', 'suspended', 'approved']));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       BOOKINGS
       • create:  claimsOwner() — uid in payload must match auth uid.
       • read:    admin, the booking creator (uid / buyerId / userId),
                  or the assigned provider.
       • update:  admin, the assigned provider (updating booking status),
                  or the original creator — uid field is frozen on all
                  non-admin updates to prevent ownership transfer.
       • delete:  admin-only.
    ══════════════════════════════════════════════════════════════ */
    match /bookings/{bookingId} {
      /* Service bookings (old) + Venue bookings (new) — unified rule */
      allow create: if isAuthed();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid          == request.auth.uid)
                    || (isAuthed() && resource.data.buyerId      == request.auth.uid)
                    || (isAuthed() && resource.data.userId       == request.auth.uid)
                    || (isAuthed() && resource.data.providerId   == request.auth.uid)
                    || (isAuthed() && resource.data.customerId   == request.auth.uid)
                    || (isAuthed() && resource.data.ownerId      == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.customerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','cancelReason','cancellationReason','cancelledAt','cancelledBy','updatedAt','date','time','notes']))
                    || (isAuthed() && resource.data.ownerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','providerNote','updatedAt','confirmedAt','completedAt','approvedAt','rejectedAt','rejectionReason','checkIn','checkOut','reminders','autoCompletedAt']))
                    || (isAuthed() && resource.data.providerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','providerNote','updatedAt','confirmedAt','completedAt']));
      allow delete: if isAdmin();
    }

    /* ── Venue & Resource Booking Engine ─────────────────────────── */
    match /venues/{venueId} {
      /* Anyone can browse active venues; only the owner (via CF) may write */
      allow read:   if resource.data.status == 'active' || isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /venueBlockouts/{blockId} {
      allow read:   if isAuthed();
      allow create: if isAuthed();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.createdBy == request.auth.uid);
    }

    match /bookingHolds/{holdId} {
      /* Slot holds: auth users can create; CF cleanup deletes expired; owner can delete their own */
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid || isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       RIDES
       • create:  claimsOwner().
       • read:    admin, the passenger (uid / passengerId), or the
                  assigned driver.
       • update:  admin, the assigned driver (status updates), or the
                  passenger/owner (cancel) — uid frozen on all writes.
       • delete:  admin-only.
    ══════════════════════════════════════════════════════════════ */
    match /rides/{rideId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid         == request.auth.uid)
                    || (isAuthed() && resource.data.passengerId == request.auth.uid)
                    || (isAuthed() && resource.data.driverId    == request.auth.uid);
      /* Passenger may cancel only; driver may update status/location fields only */
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','cancelReason','updatedAt']))
                    || (isAuthed() && resource.data.driverId == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','driverNote','updatedAt','acceptedAt',
                                       'arrivedAt','startedAt','completedAt','driverLocation']));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       DRIVER LOCATIONS  (real-time GPS)
       Public read is intentional — passengers track drivers live.

       Previously the single `allow write` rule checked the INCOMING
       uid but not the EXISTING document's uid.  A user could therefore
       overwrite another driver's location document by simply setting
       their own uid in the new payload.

       The rules are now split into three verbs:
       • create:  incoming uid must match auth uid.
       • update:  BOTH the existing doc's uid AND the incoming uid must
                  match auth uid, preventing a user from overwriting
                  another driver's document.
       • delete:  owner of the existing doc or admin.
    ══════════════════════════════════════════════════════════════ */
    match /driverLocations/{driverId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthed()
                    && resource.data.uid          == request.auth.uid
                    && request.resource.data.uid  == request.auth.uid;
      allow delete: if isAdmin() || isOwner();
    }

    /* ══════════════════════════════════════════════════════════════
       PACKAGES / DELIVERIES
       Same ownership pattern as rides.
       Senders and assigned delivery drivers can read and update.
       uid is frozen on all non-admin updates.
    ══════════════════════════════════════════════════════════════ */
    match /packages/{pkgId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.senderId == request.auth.uid)
                    || (isAuthed() && resource.data.driverId == request.auth.uid);
      allow update: if isAdmin()
                    || ((isAuthed() && resource.data.driverId == request.auth.uid
                         || isOwner())
                        && uidUnchanged());
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       ORDERS  (marketplace checkout + SokoniOrders state machine)
       • Readable by buyer (uid / userId / buyerId / buyerUid),
         seller (sellerUid), assigned driver (assignedDriverUid), admin.
       • create:  buyer; uid frozen; valid status; positive total.
       • update:  buyer (cancel / confirm receipt), seller (confirm ready),
                  assigned driver (status transitions), admin (any).
                  uid field is always frozen on non-admin updates.
       • delete:  admin only.

       orderEvents subcollection — immutable event log:
       • create:  any authenticated party to the order.
       • read:    buyer, seller, assigned driver, or admin.
       • update/delete: nobody — append-only audit trail.
    ══════════════════════════════════════════════════════════════ */
    match /orders/{orderId} {
      allow create: if claimsOwner()
                    && validOrderStatus();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid              == request.auth.uid)
                    || (isAuthed() && resource.data.userId           == request.auth.uid)
                    || (isAuthed() && resource.data.buyerId          == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid         == request.auth.uid)
                    || (isAuthed() && resource.data.sellerUid        == request.auth.uid)
                    || (isAuthed() && resource.data.assignedDriverUid == request.auth.uid);
      allow update: if isAdmin()
                    /* Buyer may cancel or confirm receipt */
                    || ((isAuthed() && (resource.data.uid == request.auth.uid
                                       || resource.data.buyerUid == request.auth.uid))
                        && uidUnchanged() && validOrderStatus()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','cancelReason','confirmedAt','updatedAt','review']))
                    /* Seller may confirm ready / update tracking */
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && uidUnchanged() && validOrderStatus()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','sellerNote','readyAt','trackingNo','updatedAt']))
                    /* Driver may update delivery status */
                    || (isAuthed() && resource.data.assignedDriverUid == request.auth.uid
                        && uidUnchanged() && validOrderStatus()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','driverNote','updatedAt','pickedUpAt','deliveredAt','etaMin']));
      allow delete: if isAdmin();

      match /events/{eventId} {
        /* Append-only audit trail — only parties to the parent order may write */
        allow create: if isAdmin()
                      || (isAuthed()
                          && (
                               get(/databases/$(database)/documents/orders/$(orderId)).data.uid              == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.buyerUid         == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.sellerUid        == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDriverUid == request.auth.uid
                          ));
        allow read:   if isAdmin()
                      || (isAuthed()
                          && get(/databases/$(database)/documents/orders/$(orderId))
                               .data.keys().hasAny(['uid','buyerUid','sellerUid','assignedDriverUid'])
                          && (
                               get(/databases/$(database)/documents/orders/$(orderId)).data.uid              == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.buyerUid         == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.sellerUid        == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDriverUid == request.auth.uid
                          ));
        allow update, delete: if false;
      }
    }

    /* ══════════════════════════════════════════════════════════════
       FCM TOKENS  (push notification registration)
       Previously `allow write: if isAuthed()` let any authenticated
       user overwrite any other user's push token, silently disabling
       their notifications.

       Now the write is gated on the token document's email field
       matching the authenticated user's email claim from the Firebase
       JWT.  The document ID is derived from the email in firebase.js,
       so a user can only write the token document for their own email.
    ══════════════════════════════════════════════════════════════ */
    match /fcm_tokens/{tokenId} {
      allow write: if isAuthed()
                   && request.auth.token.email != null
                   && request.resource.data.email == request.auth.token.email;
      allow read:  if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       AUDIT LOGS
       Append-only — authenticated clients (security.js) can add
       entries.  Nobody can update or delete, preserving a tamper-
       evident trail.  Moderators and admins can read.
    ══════════════════════════════════════════════════════════════ */
    match /auditLogs/{logId} {
      allow create:         if isAuthed()
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.keys().hasAll(['uid','action','ts']);
      allow read:           if isModerator();
      allow update, delete: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       NOTIFICATIONS
       Created server-side by admin (or Cloud Functions which bypass
       client rules).  Users can read and mark-read only their own
       notifications, identified by the userId field admin set on
       creation.  uid field is frozen on user updates.
    ══════════════════════════════════════════════════════════════ */
    match /notifications/{notifId} {
      /* SokoniNotifEngine.push() creates notifications client-side for order/delivery dispatch.
         SECURITY: wallet_credit, security_alert, listing_approved/rejected, platform_update must
         originate server-side (CF) only — restricting client to safe workflow types prevents
         social-engineering via fake payment or security alerts. */
      allow create: if isAdmin()
                    || (isAuthed()
                        && request.resource.data.targetUid == request.auth.uid
                        && request.resource.data.targetUid != 'broadcast'
                        && request.resource.data.keys().hasAll(['targetUid','heading','sub'])
                        && request.resource.data.type in [
                             'order','delivery','ride','general',
                             'booking','message','review','inventory_low',
                             'payment_reminder','support_reply'
                           ]);
      allow read:   if isAdmin()
                    || (isAuthed() && (
                         resource.data.targetUid == request.auth.uid
                      || resource.data.targetUid == 'broadcast'
                    ));
      /* Users may update only presentation-state fields on their own notifications.
         Server-side fields (targetUid, type, heading, sub, priority, groupKey) are frozen. */
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.targetUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['read', 'archived', 'pinned']));
      /* Users may delete their own notifications (engine exposes delete action) */
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.targetUid == request.auth.uid);
    }

    /* Notification preferences — per-user DND, quiet hours, category toggles.
       Only the owning user may read or write their own preference document. */
    match /userNotifPrefs/{userId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }

    /* /escrow/{orderId} — DEPRECATED. Canonical escrow collection is /escrows/{escrowId} below.
       Keeping read-only access so old records remain visible to admin. No new writes. */
    match /escrow/{orderId} {
      allow read:   if isAdmin();
      allow create, update, delete: if false;
    }

    match /referrals/{refId} {
      allow create: if isAuthed() && claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.referrerUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       REVIEWS  (platform / seller / product / provider)
       Publicly readable — seller-public.html and product.html show
       reviews without requiring login.
       • create:  claimsOwner().
       • update:  author or admin; uid field is frozen to prevent the
                  author from transferring review ownership.
       • delete:  author or admin.
    ══════════════════════════════════════════════════════════════ */
    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    /* ══════════════════════════════════════════════════════════════
       eTIMS SUBMISSIONS  (KRA invoice records)
       Sellers can create their own submissions (etims.js).
       Only admin can read, update, or delete — tax records are
       admin-audited, not user-browsable.
    ══════════════════════════════════════════════════════════════ */
    match /etims_submissions/{docId} {
      allow create:               if claimsOwner();
      allow read, update, delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       LAWYERS  (legal-hub.html directory)
       Public listing — anyone can browse.  Only the registering
       attorney (claimsOwner) may create; only admin may delete.
    ══════════════════════════════════════════════════════════════ */
    match /lawyers/{docId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       LEGAL APPOINTMENTS  (legal-hub.html booking system)
       • create:  any authenticated user; uid in payload must match.
       • read:    the requester (uid), the assigned lawyer (lawyerId),
                  or admin.
       • update:  lawyer updates status (confirm/decline); requester
                  may cancel only; uid field frozen on all writes.
       • delete:  admin only.
    ══════════════════════════════════════════════════════════════ */
    match /legalAppointments/{apptId} {
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','area','type','date','time','status'])
                    && request.resource.data.uid    == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status'])
                        && request.resource.data.status == 'cancelled')
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status'])
                        && request.resource.data.status in ['confirmed','declined','completed']);
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       LEGAL SERVICE REQUESTS  (property / vehicle / business)
       • create:  any authenticated user.
       • read:    requester (uid) or admin; lawyers assigned to the
                  request may also read (lawyerId field).
       • update:  admin updates status; requester may cancel only.
       • delete:  admin only.
    ══════════════════════════════════════════════════════════════ */
    match /legalServiceRequests/{reqId} {
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','category','type','status'])
                    && request.resource.data.uid    == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status'])
                        && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       LEGAL REVIEWS  (lawyer / appointment ratings)
       Publicly readable — trust signals for the directory.
       • create:  any authenticated user; reviewer cannot set
                  verified=true (admin-only field).
       • update:  admin only — prevents review manipulation.
       • delete:  admin or the original reviewer.
    ══════════════════════════════════════════════════════════════ */
    match /legalReviews/{reviewId} {
      allow read:   if true;
      /* SECURITY: uid + lawyerId required; uid must match caller — prevents anonymous
         review spam and multi-submission under different document IDs. */
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','lawyerId','rating','date'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && !request.resource.data.keys().hasAny(['verified']);
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       FOOD ORDERS  (food-menu.html checkout → food-dashboard.html restaurant)
       • read:   buyer (buyerUid), restaurant (restaurantId via isAuthed), admin
       • create: any authenticated user; required fields + status=='placed'
       • update: admin or restaurant owner (status + riderName only)
       • delete: admin only
    ══════════════════════════════════════════════════════════════ */
    match /foodOrders/{orderId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.buyerUid     == request.auth.uid)
                    || (isAuthed() && resource.data.restaurantId == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['id','restaurantId','restaurantName','phone','items','total','status','buyerUid'])
                    && request.resource.data.status   == 'placed'
                    && request.resource.data.total     > 0;
      allow update: if isAdmin()
                    || (isAuthed() && (resource.data.restaurantId == request.auth.uid
                        || resource.data.buyerUid == request.auth.uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','riderName','riderPhone','riderRating','updatedAt','statusHistory']));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       FOOD MENUS  (food-dashboard.html → food-menu.html)
       • read:   public (anyone can browse a restaurant's menu)
       • write:  admin or restaurant owner
    ══════════════════════════════════════════════════════════════ */
    match /foodMenus/{restaurantId} {
      allow read:   if true;
      allow write:  if isAdmin() || (isAuthed() && request.auth.uid == restaurantId);
    }

    /* ══════════════════════════════════════════════════════════════
       LEGAL BOOKINGS  (legal-hub.html → lawyer consultation bookings)
       • read:   client (clientUid match), lawyer (lawyerId match via sellerUid), admin
       • create: authenticated; clientUid must match caller; status restricted
       • update: admin or the lawyer (status + updatedAt only)
       • delete: admin only
    ══════════════════════════════════════════════════════════════ */
    match /legalBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.clientUid == request.auth.uid)
                    || (isAuthed() && resource.data.lawyerId  == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['ref','lawyerId','lawyerName','clientName','phone','matter','status','hub'])
                    && request.resource.data.clientUid == request.auth.uid
                    && request.resource.data.status in ['sent','confirmed']
                    && request.resource.data.hub == 'legal';
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       MECHANICS  (mechanics.html directory)
       Same public-listing, owner-write pattern as lawyers.
    ══════════════════════════════════════════════════════════════ */
    match /mechanics/{docId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       eTIMS CONFIG  (KRA merchant credentials)
       Previously `allow read, write: if isAuthed()` let any
       authenticated user overwrite KRA tax settings.

       Config reads still require authentication (etims.js reads the
       counter on every invoice).  Writes are restricted to admin so
       that merchant credentials (TIN, device serial) cannot be
       tampered with by a regular user.
    ══════════════════════════════════════════════════════════════ */
    match /etims_config/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       USER SESSIONS  (multi-device session tracking)
       • create:  the userEmail field in the new session document must
                  match the authenticated user's email claim from the
                  Firebase JWT.  Previously isAuthed() allowed any user
                  to create a session document with someone else's email,
                  enabling session list spoofing.
       • read / update / delete:  the stored userEmail must match the
                  JWT email claim, or admin.
                  (The session ID is a random 128-bit string generated
                   client-side — guessing another user's session ID is
                   computationally infeasible.)
    ══════════════════════════════════════════════════════════════ */
    /* ══════════════════════════════════════════════════════════════
       USER SYNC  (cross-device localStorage ↔ Firestore bridge)
       ─────────────────────────────────────────────────────────────
       Structure:
         userSync/{uid}/kv/{key}        — simple key-value pairs
         userSync/{uid}/products/{pid}  — seller products (one doc each)

       • Only the document owner can read or write their own sync
         documents.  No cross-user reads.  Admin can read all.
       • uid field in written documents must match auth uid to prevent
         a user from writing to another user's sync bucket.
    ══════════════════════════════════════════════════════════════ */
    match /userSync/{uid}/{subcol}/{docId} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write:  if isAuthed() && request.auth.uid == uid;
      allow delete: if isAuthed() && request.auth.uid == uid;
    }

    /* ══════════════════════════════════════════════════════════════
       PRODUCTS  (public marketplace catalogue)
       Written by seller-wiring.js when a seller uploads a product.
       • Public read — all visitors browse the catalogue.
       • create:  sellerUid in payload must match auth uid.
       • update:  only the owning seller (sellerUid) or admin;
                  sellerUid field is frozen to prevent ownership transfer.
       • delete:  seller or admin.
    ══════════════════════════════════════════════════════════════ */
    match /products/{productId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.sellerUid == request.auth.uid
                    && validPrice('price')
                    && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.sellerUid == request.auth.uid
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['sellerUid'])
                        && noAdminFields());
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       LISTINGS  (universal hub provider listings)
       Written by hub-wiring.js when a provider saves a listing.
       • Public read — hub pages show listings to all visitors.
       • create:  ownerId in payload must match auth uid.
       • update:  owner (ownerId) or admin; ownerId frozen so ownership
                  cannot be transferred.
       • delete:  owner or admin.
    ══════════════════════════════════════════════════════════════ */
    match /listings/{listingId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.ownerId == request.auth.uid
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['ownerId'])
                        && noAdminFields());
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       CONVERSATIONS  (cross-device real-time messaging)
       convId = [uid1,uid2].sort().join('_')  — deterministic per pair.
       • create:  both participants must be authenticated; the creator's
                  uid must be in the participants array.
       • read / update: only participants can access — enforced by
                  array-contains check on the stored participants field.
       • delete:  admin-only (soft-delete: remove self from participants).

       Messages subcollection:
       • create:  sender must be a participant AND senderId must match uid.
       • read:    participants only.
       • update / delete: admin only (messages are immutable for users).
    ══════════════════════════════════════════════════════════════ */
    match /conversations/{convId} {
      function isParticipant() {
        return isAuthed() && request.auth.uid in resource.data.participants;
      }
      allow read: if isParticipant();
      /* SECURITY: field-lock update so participants cannot add new members to a
         1:1 conversation and turn it into a mass-broadcast channel. */
      allow update: if isParticipant()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['lastMessage','lastMessageAt','lastSenderId','unread']);
      allow create: if isAuthed()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() <= 2;
      allow delete: if isAdmin();

      match /messages/{msgId} {
        function inConvo() {
          return isAuthed()
            && get(/databases/$(database)/documents/conversations/$(convId))
                 .data.participants.hasAny([request.auth.uid]);
        }
        allow read: if inConvo();
        allow create: if inConvo()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.keys().hasAll(['senderId','text','sentAt'])
                      && request.resource.data.text.size() <= 4000;
        allow update, delete: if isAdmin();
      }
    }

    /* ══════════════════════════════════════════════════════════════
       TEAMS  (sports-hub.html team registrations)
       • Public read — anyone can browse registered teams.
       • create: ownerId in payload must match auth uid.
       • update: team owner or admin; ownerId frozen.
       • delete: team owner or admin.
    ══════════════════════════════════════════════════════════════ */
    match /teams/{teamId} {
      allow read:   if true;
      /* ownerId in the new document must match the authenticated user */
      allow create: if isAuthed() && request.resource.data.ownerId == request.auth.uid;
      /* SECURITY: freeze ownerId — prevents silent ownership transfer to another uid. */
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       TOURNAMENTS  (sports-hub.html tournament creation)
       • Public read — anyone can view and join tournaments.
       • create: any authenticated user may create a tournament.
       • update: creator or admin; createdBy field frozen.
       • delete: admin only (affects all registered teams).
    ══════════════════════════════════════════════════════════════ */
    match /tournaments/{tourneyId} {
      allow read:   if true;
      allow create: if claimsOwner();
      allow update: if isAdmin() || (isOwner() && uidUnchanged());
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SPORTS HUB — PLAYER PROFILES  (sportsPlayers collection)
       • Public read — anyone can browse the player directory.
       • create: owner uid must match auth uid; no privilege fields.
       • update: owner may edit own profile (uid frozen); admin may moderate.
       • delete: player owner or admin.
    ══════════════════════════════════════════════════════════════ */
    match /sportsPlayers/{playerId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    /* ══════════════════════════════════════════════════════════════
       SPORTS HUB — COACH PROFILES  (sportsCoaches collection)
       • Public read — coach directory visible to all.
       • create: authenticated; uid must match; no privilege fields.
       • update: coach owner (uid frozen) or admin.
       • delete: admin only (unlink from teams first).
    ══════════════════════════════════════════════════════════════ */
    match /sportsCoaches/{coachId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SPORTS HUB — VENUE PROFILES  (sportsVenues collection)
       • Public read — venue directory searchable by all.
       • create: venue owner uid must match; no privilege fields.
       • update: venue owner (uid frozen) or admin.
       • delete: admin only.
    ══════════════════════════════════════════════════════════════ */
    match /sportsVenues/{venueId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SPORTS VENUE BOOKINGS  (sportsVenueBookings collection)
       • create: authenticated user; uid in payload must match auth uid;
                 required booking fields must be present.
       • read: booking owner or admin.
       • update / delete: admin only (status changes, cancellations).
    ══════════════════════════════════════════════════════════════ */
    match /sportsVenueBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['venueId','date','slots','name','phone','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SPORTS COACH BOOKINGS  (sportsCoachBookings collection)
       • create: authenticated user; uid in payload must match auth uid;
                 required booking fields must be present.
       • read: booking owner or admin.
       • update / delete: admin only.
    ══════════════════════════════════════════════════════════════ */
    match /sportsCoachBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['coachId','name','phone','date','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SPORTS TOURNAMENT REGISTRATIONS  (sportsTournamentRegs collection)
       • Public read — organizers see all team registrations.
       • create: authenticated; uid in payload must match auth uid;
                 required fields must be present.
       • update: admin only (approve / reject registrations).
       • delete: admin or the registering user (withdrawal).
    ══════════════════════════════════════════════════════════════ */
    match /sportsTournamentRegs/{regId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['tournamentId','teamName','captain','phone','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       SPORTS REVIEWS  (sportsReviews collection)
       • Public read — all reviews visible to everyone.
       • create: authenticated; required fields present; rating 1–5;
                 body ≤ 2,000 chars; immutable after posting.
       • update: intentionally disabled (use delete + re-create).
       • delete: admin moderation only.
    ══════════════════════════════════════════════════════════════ */
    match /sportsReviews/{reviewId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['targetId','targetType','author','rating','body','uid','ts'])
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.body.size() <= 2000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SPORTS COMMUNITY POSTS  (sportsPosts collection)
       • Public read — community feed visible to all.
       • create: authenticated; required fields present; content ≤ 3,000 chars.
       • update: post owner (edit content / likes) or admin; uid frozen.
       • delete: post owner or admin.
    ══════════════════════════════════════════════════════════════ */
    match /sportsPosts/{postId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['type','author','sport','content','uid','ts'])
                    && request.resource.data.content.size() <= 3000;
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['content','likes','comments','updatedAt']));
      allow delete: if isAdmin() || isOwner();
    }

    /* ══════════════════════════════════════════════════════════════
       SPORTS MARKETPLACE ORDERS  (sportsOrders collection)
       • create: authenticated; uid in payload must match auth uid;
                 required order fields must be present.
       • read: order owner or admin.
       • update: admin only (status management, fulfilment).
       • delete: admin only.
    ══════════════════════════════════════════════════════════════ */
    match /sportsOrders/{orderId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['itemId','qty','total','phone','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       FITNESS HUB — BOOKINGS  (fitness-hub.html)
       • read: owner or admin only (financial/personal data)
       • create: authenticated, uid must match, required fields enforced
       • update/delete: admin only (booking state managed server-side)
    ══════════════════════════════════════════════════════════════ */
    match /fitness_bookings/{bookingId} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(['type','provider','ref','uid','status','ts'])
                    && request.resource.data.status == 'confirmed';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       FITNESS HUB — PROGRESS  (workout log, weight log, goals, badges)
       • read/write: owner only (personal health data); admin read
       • create: authenticated with uid match
    ══════════════════════════════════════════════════════════════ */
    match /fitness_progress/{userId} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == userId);
      allow create: if isAuthed() && request.auth.uid == userId;
      allow update: if isAuthed() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       FITNESS HUB — GYM PROFILES  (gym owner dashboard)
       • read: public (gyms are public listings)
       • create/update: owner only (uid == doc id)
       • delete: admin only
    ══════════════════════════════════════════════════════════════ */
    match /fitness_gyms/{gymId} {
      allow read:   if true;
      allow create: if isAuthed() && request.auth.uid == gymId && noAdminFields();
      allow update: if isAuthed() && request.auth.uid == gymId && uidUnchanged() && noAdminFields();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       FITNESS HUB — CLASSES  (instructor-posted fitness classes)
       • read: public
       • create: authenticated with uid match, required fields enforced
       • update: owner (limited fields) or admin
       • delete: owner or admin
    ══════════════════════════════════════════════════════════════ */
    match /fitness_classes/{classId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['name','type','instructor','phone','uid','ts']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['name','loc','time','fee','slots','desc','type','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       FITNESS HUB — CLUBS  (community fitness clubs)
       • read: public
       • create: authenticated with uid match
       • update: owner (limited fields) or admin
       • delete: owner or admin
    ══════════════════════════════════════════════════════════════ */
    match /fitness_clubs/{clubId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['name','type','uid','ts']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['name','desc','meet','members','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       FITNESS HUB — COMMUNITY POSTS  (workout achievement posts)
       • read: public
       • create: authenticated with uid match, content size limited
       • update: owner (content/likes only) or admin
       • delete: owner or admin
    ══════════════════════════════════════════════════════════════ */
    match /fitness_community_posts/{postId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['uid','ts'])
                    && (request.resource.data.text == null || request.resource.data.text.size() <= 2000);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['text','likes','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       FITNESS HUB — EQUIPMENT LISTINGS
       • read: public (marketplace-style listings)
       • create: authenticated with uid match
       • update: owner (price/desc only) or admin
       • delete: owner or admin
    ══════════════════════════════════════════════════════════════ */
    match /fitness_equipment/{itemId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['uid','ts']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['price','desc','sold','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       FITNESS HUB — REQUESTS  (Ask Hub — help requests to providers)
       • read: public (providers browse requests)
       • create: any authenticated user
       • update: owner (edit text/phone) or admin
       • delete: owner or admin
    ══════════════════════════════════════════════════════════════ */
    match /fitness_requests/{requestId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['text','uid','ts'])
                    && request.resource.data.text.size() <= 1000;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['text','phone','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       FITNESS HUB — CHALLENGES  (challenge participation records)
       • read: public (for leaderboards)
       • create/update: owner only (doc id = uid_challengeId)
       • delete: owner or admin
    ══════════════════════════════════════════════════════════════ */
    match /fitness_challenges/{entryId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAuthed() && resource.data.uid == request.auth.uid && uidUnchanged();
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       FITNESS HUB — CHECK-INS  (gym member check-in log)
       • read: gym owner (gymUid == auth.uid) or admin
       • create: gym owner only (gymUid must match auth.uid)
       • update/delete: admin only
    ══════════════════════════════════════════════════════════════ */
    match /fitness_checkins/{checkinId} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.gymUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.gymUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['memberName','gymUid','ts']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       DIGITAL ESOKO — PRODUCTS  (digital-esoko-seller.html → digital-esoko.html)
       • read:   public (anyone can browse)
       • create: authenticated seller; claimsOwner() + required fields + price ≥ 0
       • update: seller (limited fields) or admin
       • delete: seller or admin
    ══════════════════════════════════════════════════════════════ */
    match /digitalProducts/{productId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(['id','title','category','price','sellerUid','sellerName','fileURL'])
                    && request.resource.data.price >= 0
                    && request.resource.data.sellerUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['title','description','price','category','tags','coverURL','fileURL','fileName','fileSize','active','featured','downloads','rating','updatedAt']));
      allow delete: if isAdmin() || (isAuthed() && resource.data.sellerUid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       DIGITAL ESOKO — PURCHASES  (buyer → confirmed payment only)
       • read:   buyer (buyerUid match), seller (sellerUid match), or admin
       • create: authenticated buyer; status must be 'completed'; amount > 0
       • update: admin only (no field changes by users after purchase)
       • delete: admin only
    ══════════════════════════════════════════════════════════════ */
    match /digitalPurchases/{purchaseId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.buyerUid  == request.auth.uid)
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['productId','buyerUid','sellerUid','amount','ref','status'])
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.status   == 'completed'
                    && request.resource.data.amount    > 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       BNB LISTINGS  (bnb-manage.html host → bnb.html / bnb-hub.html guest)
       • read:   public (anyone can browse listings)
       • create: authenticated host; claimsOwner() + required fields
       • update: the host who owns it (limited fields) or admin
       • delete: listing owner or admin
    ══════════════════════════════════════════════════════════════ */
    match /bnbListings/{listingId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(['id','name','type','location','price','phone','hostUid'])
                    && request.resource.data.hostUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.hostUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name','type','location','price','pricePerNight','desc','description','amenities','phone','image','images','video','available','maxGuests','bedrooms','bathrooms','updatedAt']));
      allow delete: if isAdmin() || (isAuthed() && resource.data.hostUid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       BNB BOOKINGS  (bnb.html / bnb-hub.html guest confirm)
       • read:   the guest (uid match), the host (hostUid match), or admin
       • create: authenticated guest; claimsOwner() + required fields; status must be 'confirmed'
       • update: the host (status changes only) or admin
       • delete: admin only
    ══════════════════════════════════════════════════════════════ */
    match /bnbBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid    == request.auth.uid)
                    || (isAuthed() && resource.data.hostUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['bnbId','uid','name','phone','checkIn','checkOut','nights','total','status'])
                    && request.resource.data.status == 'confirmed';
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.hostUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       DISPUTES  (dispute.html — buyer/seller dispute resolution)
       • create: any authenticated user may submit a dispute.
       • read: submitter (uid match), moderator, or admin.
       • update: moderator or admin (sets status / response).
       • delete: admin only.
    ══════════════════════════════════════════════════════════════ */
    match /disputes/{disputeId} {
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(['orderId','reason','status'])
                    && request.resource.data.status == 'open';
      allow read:   if isModerator()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid == request.auth.uid)
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      /* Parties may add evidence/refund requests; moderators manage status/resolution */
      allow update: if isModerator()
                    || (isAuthed()
                        && (resource.data.uid      == request.auth.uid
                         || resource.data.buyerUid == request.auth.uid)
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['evidence','refundRequested',
                             'refundAmount','refundReason','refundRequestedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin();

      /* Dispute messages subcollection — parties + moderators */
      match /messages/{msgId} {
        allow create: if isAuthed()
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.keys().hasAll(['message','senderUid','sentAt'])
                      && request.resource.data.message.size() <= 2000
                      && (
                           get(/databases/$(database)/documents/disputes/$(disputeId)).data.uid       == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.buyerUid  == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.sellerUid == request.auth.uid
                        || isModerator()
                      );
        allow read:   if isModerator()
                      || (isAuthed() && (
                           get(/databases/$(database)/documents/disputes/$(disputeId)).data.uid       == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.buyerUid  == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.sellerUid == request.auth.uid
                      ));
        allow update, delete: if false;
      }
    }

    /* ══════════════════════════════════════════════════════════════
       FRAUD ALERTS  (submitted by SokoniFraud.flag())
       Authenticated users flag suspicious activity; only moderators/admin read.
    ══════════════════════════════════════════════════════════════ */
    match /fraudAlerts/{alertId} {
      allow create: if isAuthed()
                    && request.resource.data.flaggedBy == request.auth.uid
                    && request.resource.data.keys().hasAll(['targetId','reason','flaggedBy']);
      allow read:   if isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       ONBOARDING COMPLETED  (written by SokoniOnboarding.complete())
       One doc per role completion per user.
    ══════════════════════════════════════════════════════════════ */
    match /onboardingCompleted/{docId} {
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['role','uid','completedAt']);
      allow read:   if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       OFFERS  (admin-managed product promotions)
       Public read; only admins can write.
    ══════════════════════════════════════════════════════════════ */
    match /offers/{offerId} {
      allow read:   if true;
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['productId','offerPrice','originalPrice','active','createdBy'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.offerPrice < request.resource.data.originalPrice;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow create: if isAuthed()
                    && request.resource.data.uid    == request.auth.uid
                    && request.resource.data.amount is  number
                    && request.resource.data.amount >   0;
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       COMMUNITY POSTS  (community.html real-time feed)
       • Public read — anyone can browse the community feed.
       • create:  any authenticated user may post.
       • update:  any authenticated user may react (likes/helpful)
                  or add replies (arrayUnion).  Author and admin may
                  update their own full post content.
       • delete:  the post author (authorUid) or admin.
    ══════════════════════════════════════════════════════════════ */
    match /communityPosts/{postId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['authorUid','content'])
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.content.size() <= 5000;
      /* Authors can edit their own post content only; anyone can increment social counters.
         Numeric counters (likes, helpful, reactionCount, views) are capped to ±1 per update
         to prevent bulk self-inflation. replies and reactions are arrays/maps — no numeric cap. */
      allow update: if isAuthed()
                    && (
                         (resource.data.authorUid == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['content','title','edited','editedAt','tags','images']))
                      || (request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['likes','helpful','replies','reactions','reactionCount','views'])
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes'])
                              || (request.resource.data.likes is number
                                  && request.resource.data.likes >= resource.data.likes - 1
                                  && request.resource.data.likes <= resource.data.likes + 1))
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['helpful'])
                              || (request.resource.data.helpful is number
                                  && request.resource.data.helpful >= resource.data.helpful - 1
                                  && request.resource.data.helpful <= resource.data.helpful + 1))
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['views'])
                              || (request.resource.data.views is number
                                  && request.resource.data.views == resource.data.views + 1))
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionCount'])
                              || (request.resource.data.reactionCount is number
                                  && request.resource.data.reactionCount >= resource.data.reactionCount - 1
                                  && request.resource.data.reactionCount <= resource.data.reactionCount + 1))
                         )
                    );
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.authorUid == request.auth.uid);
    }

    match /communityGroups/{groupId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (isAuthed() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() || (isAuthed() && resource.data.createdBy == request.auth.uid);
    }

    match /userProgress/{uid}/{subcol}/{docId} {
      allow read, write: if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /userSessions/{sessionId} {
      allow create: if isAuthed()
                    && request.auth.token.email != null
                    && request.resource.data.userEmail == request.auth.token.email;
      allow read:   if isAdmin()
                    || (isAuthed()
                        && request.auth.token.email != null
                        && resource.data.userEmail == request.auth.token.email);
      allow update: if isAdmin()
                    || (isAuthed()
                        && request.auth.token.email != null
                        && resource.data.userEmail == request.auth.token.email);
      allow delete: if isAdmin()
                    || (isAuthed()
                        && request.auth.token.email != null
                        && resource.data.userEmail == request.auth.token.email);
    }

    /* ══════════════════════════════════════════════════════════════
       BOOKING FEES  (SokoniPay — all channel revenue records)
       Written by sokoni-pay.js on every payment event.
       • create:  any authenticated user (client or provider paying deposit)
       • read:    admin only — revenue data is sensitive
       • update/delete: admin only
    ══════════════════════════════════════════════════════════════ */
    match /bookingFees/{feeId} {
      /* uid in the payload must match the caller — prevents writing fee records on behalf of others */
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','amount','type'])
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* commissionLedger — authoritative rule is in the Revenue Engine block below (~line 1375).
       Written exclusively by Cloud Functions (intasendWebhook, generateInvoice).
       Seller reads own entries; admin reads all. No client writes. */

    /* ══════════════════════════════════════════════════════════════
       BROADCAST NOTIFICATIONS  (admin → all users push targets)
       Written server-side by Cloud Functions (KASS/admin tools).
       Users cannot write — admin and functions only.
    ══════════════════════════════════════════════════════════════ */
    match /broadcast_notifications/{notifId} {
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin()
                  || (isAuthed() && (
                       resource.data.targetUid == request.auth.uid
                    || resource.data.targetUid == 'broadcast'
                  ));
    }

    /* ══════════════════════════════════════════════════════════════
       DELETED PRODUCTS  (soft-delete audit trail)
       Written server-side by Cloud Functions when admin deletes a
       product. Read and delete are admin-only.
    ══════════════════════════════════════════════════════════════ */
    match /deleted_products/{productId} {
      allow create, update: if isAdmin();
      allow read, delete:   if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       UNBOXING REVIEWS  (unboxing.html video reviews)
       Public read — anyone can browse unboxing content.
       • create: authenticated users only; uid field must match auth uid.
       • update: author or admin; uid field frozen.
       • delete: author or admin.
    ══════════════════════════════════════════════════════════════ */
    match /unboxingReviews/{reviewId} {
      allow read:   if true;
      allow create: if claimsOwner();
      allow update: if (isAdmin() || isOwner()) && uidUnchanged();
      allow delete: if isAdmin() || isOwner();
    }

    /* ══════════════════════════════════════════════════════════════
       SHOP EMPLOYEES  (created by seller.js addEmployee())
       • Employee reads their own record (by UID).
       • Shop owner reads/writes/deletes employees in their shop.
       • Admin has full access.
    ══════════════════════════════════════════════════════════════ */
    match /shopEmployees/{empUid} {
      allow read:   if isAdmin()
                    || request.auth.uid == empUid
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
      allow create: if isAdmin()
                    || (isAuthed() && request.resource.data.shopOwnerId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       SELLERS
       Store profiles created by the seller wizard.
       • create / update: only the owner (uid must match auth uid).
       • read: public — ministore and category pages read seller profiles.
       • delete: admin-only.
    ══════════════════════════════════════════════════════════════ */
    match /sellers/{uid} {
      allow read:   if true;
      allow create: if isAuthed() && request.auth.uid == uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && request.auth.uid == uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SELLER BROADCASTS
       Push notifications sent by sellers to their followers.
       • create: only the seller who owns the broadcast path.
       • read:   any authenticated user (buyers following the seller).
       • delete: the seller who created it, or admin.
    ══════════════════════════════════════════════════════════════ */
    match /sellerBroadcasts/{sellerName}/broadcasts/{broadcastId} {
      allow read:   if isAuthed();
      /* Path segment is seller display-name, not UID.
         Ownership is verified via sellerUid field in the payload. */
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['sellerUid'])
                    && request.resource.data.sellerUid == request.auth.uid;
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       LANDLORD DATA
       Stores the landlord's property/unit list.
       Only the owner can read or write their own data.
    ══════════════════════════════════════════════════════════════ */
    match /landlordData/{uid} {
      allow read, write: if isAuthed() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       FOLLOWS
       Records buyer → seller follows.
       • create / delete: authenticated user, own document only.
       • read: authenticated user, own document or admin.
    ══════════════════════════════════════════════════════════════ */
    match /follows/{followId} {
      allow read:   if isAdmin() || (isAuthed() && followId.matches(request.auth.uid + '--.*'));
      allow create: if isAuthed() && followId.matches(request.auth.uid + '--.*');
      allow delete: if isAdmin() || (isAuthed() && followId.matches(request.auth.uid + '--.*'));
    }

    /* ══════════════════════════════════════════════════════════════
       DRIVER RATINGS  (left by passengers after trips/deliveries)
       • create: authenticated passenger (claimsOwner); one per ref.
       • read:   admin, or the rated driver (driverId match).
       • update/delete: admin only — ratings are immutable for users.
    ══════════════════════════════════════════════════════════════ */
    match /driverRatings/{ratingId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.driverId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       RIDE DRIVERS  (online/offline driver registry + live GPS)
       Public read — passengers and the matching algorithm need
       to see which drivers are online and their GPS coordinates.
       • create/update: driver can only write their own document.
       • GPS fields (lat/lng) are validated to Kenya bounding box
         to prevent location spoofing.
       • delete: admin only.
    ══════════════════════════════════════════════════════════════ */
    match /rideDrivers/{driverId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && noAdminFields()
                    && _validGPS(request.resource.data.lat, request.resource.data.lng);
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.uid         == request.auth.uid
                        && request.resource.data.uid == request.auth.uid
                        && noAdminFields()
                        && (!request.resource.data.keys().hasAny(['lat','lng'])
                            || _validGPS(request.resource.data.lat, request.resource.data.lng)));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       RIDE REQUESTS  (passenger → driver ride bookings)
       • create:  claimsOwner() — uid in payload must match auth uid.
       • read:    requester (uid), assigned driver, or admin.
       • update:  requester (cancel) or assigned driver (accept /
                  arrived / start / complete), uid frozen.
       • delete:  admin only.
    ══════════════════════════════════════════════════════════════ */
    match /rideRequests/{reqId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid              == request.auth.uid)
                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid);
      /* SECURITY: field-locked per role — rider cannot alter fare/pickup; driver cannot
         alter uid/origin/destination or financials. */
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','cancelReason','updatedAt']))
                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','assignedDriverId','driverNote',
                                                      'updatedAt','acceptedAt','arrivedAt',
                                                      'startedAt','completedAt','driverLocation']));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       PACKAGE REQUESTS  (delivery orders — regular + marketplace)
       • create:  claimsOwner() — uid in payload must match auth uid.
       • read:    buyer (uid / buyerUid), seller (sellerUid),
                  assigned driver, or admin.
       • update:  field-locked per role:
                  - Buyer:  cancel only (status, cancelReason)
                            or confirm receipt (status, buyerConfirmedAt, sellerPayoutReady)
                  - Seller: confirm ready (status, sellerNote, readyAt)
                  - Driver: status transitions + GPS fields only
                            (cannot alter addresses, fees, or buyer/seller data)
                  - Admin:  full write
       • GPS fields written by driver are validated to Kenya bounding
         box to prevent location spoofing.
       • delete:  admin only.
    ══════════════════════════════════════════════════════════════ */
    match /packageRequests/{pkgId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid              == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid         == request.auth.uid)
                    || (isAuthed() && resource.data.sellerUid        == request.auth.uid)
                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid);
      allow update: if isAdmin()
                    /* Buyer: cancel or confirm receipt */
                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','cancelReason','confirmedAt',
                                                      'buyerConfirmedAt','sellerPayoutReady',
                                                      'timeline','_lastTimelineEntry','updatedAt']))
                    /* Seller: confirm ready */
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','sellerNote','readyAt',
                                                      'timeline','_lastTimelineEntry','updatedAt']))
                    /* Driver: status transitions + GPS — cannot touch fees or addresses */
                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','driverNote','updatedAt',
                                                      'pickedUpAt','deliveredAt','arrivedAtSellerAt',
                                                      'acceptedAt','etaMin','payoutDue','proofNote',
                                                      'driverLat','driverLng','driverSpeed',
                                                      'timeline','_lastTimelineEntry'])
                        && (!request.resource.data.keys().hasAny(['driverLat','driverLng'])
                            || _validGPS(request.resource.data.driverLat, request.resource.data.driverLng)));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       ENTERTAINMENT HUB — ARTISTS / CREATORS
       Public read (buyers browse). Write/update: owner or admin.
    ══════════════════════════════════════════════════════════════ */
    match /entArtists/{artistId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    /* ══════════════════════════════════════════════════════════════
       ENTERTAINMENT HUB — EVENTS
       Public read for published events. Organizer creates/updates.
       Admin can approve / cancel.
    ══════════════════════════════════════════════════════════════ */
    match /entEvents/{eventId} {
      allow read:   if true;
      allow create: if claimsOwner();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    /* ══════════════════════════════════════════════════════════════
       ENTERTAINMENT HUB — TICKETS
       Buyer reads their own tickets; event organizer reads attendees;
       admin reads all. Ticket is created on purchase. Validation
       (marking used) may be done by admin or organizer.
    ══════════════════════════════════════════════════════════════ */
    match /entTickets/{ticketId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid)
                    || (isAuthed() && resource.data.organizerUid == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.organizerUid == request.auth.uid
                        && uidUnchanged());
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       ENTERTAINMENT HUB — VENUES
       Public read. Venue owner creates/updates. Admin full access.
    ══════════════════════════════════════════════════════════════ */
    match /entVenues/{venueId} {
      allow read:   if true;
      allow create: if claimsOwner();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    /* ══════════════════════════════════════════════════════════════
       ENTERTAINMENT HUB — VENUE BOOKINGS
       Booker and venue owner read their own. Admin reads all.
    ══════════════════════════════════════════════════════════════ */
    match /entVenueBookings/{bookId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid)
                    || (isAuthed() && resource.data.venueOwnerUid == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.venueOwnerUid == request.auth.uid
                        && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       ENTERTAINMENT HUB — ARTIST BOOKINGS
       Booker and artist read their own booking. Admin reads all.
    ══════════════════════════════════════════════════════════════ */
    match /entArtistBookings/{bookId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid)
                    || (isAuthed() && resource.data.artistUid == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.artistUid == request.auth.uid
                        && uidUnchanged());
      allow delete: if isAdmin() || isOwner();
    }

    /* ══════════════════════════════════════════════════════════════
       ENTERTAINMENT HUB — REVIEWS
       Public read for approved reviews. Author creates; admin approves.
    ══════════════════════════════════════════════════════════════ */
    match /entReviews/{reviewId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    /* ══════════════════════════════════════════════════════════════
       ENTERTAINMENT HUB — DIGITAL CONTENT
       Published content is publicly readable. Creator manages own.
    ══════════════════════════════════════════════════════════════ */
    match /entContent/{contentId} {
      allow read:   if resource.data.status == 'active' || isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    /* ══════════════════════════════════════════════════════════════
       DELIVERY HUB — DELIVERIES
       Sender owns their delivery; assigned rider can update status
       fields only; admin has full access.
    ══════════════════════════════════════════════════════════════ */
    match /deliveries/{deliveryId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.senderUid   == request.auth.uid)
                   || (isAuthed() && resource.data.assignedRiderId == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.senderUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.senderUid   == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['senderUid','deliveryFee','proofPIN']))
                    || (isAuthed() && resource.data.assignedRiderId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status','timeline','updatedAt','assignedRiderId',
                                      'riderName','riderPhone','riderAt','pickedUpAt',
                                      'deliveredAt','etaMin']));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       DELIVERY HUB — DELIVERY RIDERS
       Rider owns their profile (uid == riderId); public read for
       dispatch matching; admin full access.
    ══════════════════════════════════════════════════════════════ */
    match /deliveryRiders/{riderId} {
      allow read:   if true;
      allow create: if isAuthed() && request.auth.uid == riderId
                    && !request.resource.data.keys().hasAny(['approved','verified','suspended','banned']);
      allow update: if isAdmin()
                    || (isAuthed() && request.auth.uid == riderId
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['approved','verified','suspended','banned']));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       DELIVERY HUB — RIDER LOCATIONS
       Rider writes their own location; public read for tracking.
    ══════════════════════════════════════════════════════════════ */
    match /deliveryLocations/{riderId} {
      allow read:   if true;
      allow write:  if isAdmin()
                    || (isAuthed() && request.auth.uid == riderId);
    }

    /* ══════════════════════════════════════════════════════════════
       DELIVERY HUB — DELIVERY PROOFS
       Rider (assignedRiderId) creates the proof; sender + rider +
       admin can read it. No edits or deletes after creation.
    ══════════════════════════════════════════════════════════════ */
    match /deliveryProofs/{proofId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.riderId    == request.auth.uid)
                   || (isAuthed() && resource.data.senderUid  == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.riderId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SHOP SETTINGS — Daraja / Paybill credentials per seller
       Only the seller (owner) can read/write their own settings.
       Cloud Functions (admin SDK) bypass these rules.
    ══════════════════════════════════════════════════════════════ */
    match /shopSettings/{sellerUid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
      allow write: if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
    }

    /* ══════════════════════════════════════════════════════════════
       POS PAYMENTS — Daraja STK push results
       Seller OR the buyer who initiated (callerUid) can read.
       Only Cloud Functions (admin SDK) write to this collection.
    ══════════════════════════════════════════════════════════════ */
    match /posPayments/{checkoutId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid)
                   || (isAuthed() && resource.data.callerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SELLER PAYMENTS — Confirmed M-Pesa receipts per seller
       Written by Cloud Functions on successful Daraja callback.
       Seller reads their own history; admin reads all.
    ══════════════════════════════════════════════════════════════ */
    match /sellerPayments/{paymentId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid  == request.auth.uid)
                   || (isAuthed() && resource.data.callerUid  == request.auth.uid);
      allow write: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       REVENUE ENGINE COLLECTIONS
    ══════════════════════════════════════════════════════════════ */

    /* revenueConfig — admin writes, authed users read (needed to show rates in UI) */
    match /revenueConfig/{configId} {
      allow read:  if isAdmin()
                   || (isAuthed() && configId == ("seller_" + request.auth.uid))
                   || (isAuthed() && configId == "global")
                   || (isAuthed() && configId.matches("hub_.*"));
      allow write: if isAdmin();
    }

    /* subscriptionPlans — public read (pricing page), admin write */
    match /subscriptionPlans/{planId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* sellerSubscriptions — seller reads own, admin reads all, Cloud Functions write */
    match /sellerSubscriptions/{sellerUid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
      allow write: if isAdmin();
    }

    /* commissionLedger — seller reads own entries, admin reads all, Cloud Functions write */
    match /commissionLedger/{entryId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    /* featuredListings — seller reads own, admin reads all */
    match /featuredListings/{featureId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid)
                   || resource.data.status == "active";
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* sokoAds — seller reads own campaigns, admin reads all */
    match /sokoAds/{adId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* adImpressions — admin reads, Cloud Functions write */
    match /adImpressions/{impId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    /* invoices — seller reads own, admin reads all, Cloud Functions write */
    match /invoices/{invoiceId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    /* sellerBilling — seller reads own monthly summaries, admin reads all */
    match /sellerBilling/{sellerUid}/monthly/{period} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
      allow write: if isAdmin();
    }

    /* deliveryFees — admin reads, Cloud Functions write */
    match /deliveryFees/{feeId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    /* ── Community Hub collections — second block removed (duplicate; authoritative rule is above) ── */
    match /communityEvents/{eventId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.organizerUid == request.auth.uid;
      allow update: if isAdmin() || (isAuthed() && resource.data.organizerUid == request.auth.uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    match /communityRecommendations/{recId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.askerUid == request.auth.uid;
      /* responseCount/responses are written by CF Admin SDK only — not client-writable. */
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.askerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['content','title','tags','edited','editedAt']));
      allow delete: if isAdmin();
    }
    match /communityRecResponses/{respId} {
      allow read: if true;
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['responderUid','content'])
                    && request.resource.data.responderUid == request.auth.uid;
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.responderUid == request.auth.uid);
    }
    match /communityReports/{reportId} {
      /* SECURITY: uid required and bound to caller — prevents anonymous/forged reports. */
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','targetId','reason'])
                    && request.resource.data.uid == request.auth.uid;
      allow read, update: if isModerator();
      allow delete: if isAdmin();
    }

    /* leadFees — seller reads own, admin reads all; seller can only create records for themselves */
    match /leadFees/{leadId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    /* b2bFees — seller reads own, admin reads all; seller can only create records for themselves */
    match /b2bFees/{feeId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       LOYALTY POINTS  (users/{uid}/loyalty/points subcollection)
       Points are synced from loyalty.html after each award/redemption.
       • read:   owner or admin.
       • write:  owner may write ONLY if total does not exceed the
                 existing stored total by more than 500 in one write
                 (hard-caps per-write injection attacks).  Decreases
                 (redemptions) are always allowed.  Admin bypasses cap.
       First write (no existing doc): capped at 500 per write.
    ══════════════════════════════════════════════════════════════ */
    match /users/{uid}/loyalty/{docId} {
      allow read: if isAdmin() || (isAuthed() && request.auth.uid == uid);
      /* Loyalty writes are admin-only from client; Cloud Functions award points server-side.
         Users may only redeem (decrease total) — never self-award. */
      allow write: if isAdmin()
                   || (isAuthed()
                       && request.auth.uid == uid
                       && resource != null
                       && request.resource.data.total <= resource.data.total);
    }

    /* ══════════════════════════════════════════════════════════════
       VERIFICATIONS  (seller identity verification decisions)
       Written by admin only (verification team approves/rejects).
       • read:  any authenticated user — product.js checks this to
                show the ✅ Verified badge.
       • write: admin only — prevents self-approval.
    ══════════════════════════════════════════════════════════════ */
    match /verifications/{sellerUid} {
      allow read:   if isAuthed();
      /* Users may submit their own request (pending only, no verifiedAt self-set).
         Only admins can approve (status → 'approved') or reject. */
      allow create: if isAuthed()
                    && request.auth.uid == sellerUid
                    && request.resource.data.status == 'pending'
                    && !request.resource.data.keys().hasAny(['verifiedAt','approvedBy']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ── Home Services Hub collections ── */
    /* Bookings — authenticated users only; phone must match JWT claim or be provided as guest data */
    match /homeServiceBookings/{bookingId} {
      /* SECURITY: uid required on create and bound to caller; read uses uid not phone
         (phone can be spoofed in payload; uid comes from JWT). */
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','name','phone','service'])
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    /* Provider registrations — must be authenticated to register as a provider */
    match /homeServiceProviders/{provId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    /* Reviews — must be authenticated; uid + providerId required; rating validated. */
    match /homeServiceReviews/{revId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','providerId','rating'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }
    /* Lead fees (WhatsApp contact tracking) — authenticated create; uid bound to caller */
    match /homeServiceLeads/{leadId} {
      allow read:   if isAdmin();
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['phone','service','uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    /* ── TECH HUB ── */
    match /techITRequests/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /techStartups/{docId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    match /techJobs/{docId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    match /techLeads/{docId} {
      allow read:   if isAdmin();
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['name','phone']);
      allow update, delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SOKONI WALLET  (wallets/{uid} — one doc per user)
       • read/write: owner only (uid == auth.uid).
       • balance field: Firestore-side write validation enforces
         balance >= 0 to prevent overdrafts.
       • admin: full read for support/reconciliation.
    ══════════════════════════════════════════════════════════════ */
    match /wallets/{walletUid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == walletUid);
      /* Wallet creation: owner only, balance must start at 0. */
      allow create: if isAuthed() && request.auth.uid == walletUid
                    && request.resource.data.balance == 0;
      /* Wallet update:
         - Admin (Cloud Functions use admin SDK, bypass rules entirely).
         - Owner may ONLY decrease balance (payments, withdrawals, escrow debits).
           Balance cannot increase from client — top-ups must go through
           Cloud Functions so M-Pesa confirmation is server-verified. */
      allow update: if isAdmin()
                    || (isAuthed() && request.auth.uid == walletUid
                        && request.resource.data.balance >= 0
                        && request.resource.data.balance <= resource.data.balance);
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       NOTIFICATION PREFERENCES  (notificationPrefs/{uid})
       • One doc per user, keyed by uid.
       • Owner: full read/write on their own doc.
       • Admin: read only (for support).
    ══════════════════════════════════════════════════════════════ */
    match /notificationPrefs/{prefUid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == prefUid);
      allow create: if isAuthed() && request.auth.uid == prefUid
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthed() && request.auth.uid == prefUid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']);
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       WALLET TRANSACTIONS  (walletTxns/{txId})
       • create: authenticated users, uid in payload must match.
       • read: owner or admin.
       • update/delete: admin only — transactions are immutable for users.
    ══════════════════════════════════════════════════════════════ */
    match /walletTxns/{txId} {
      allow create: if isAuthed()
                    && request.resource.data.uid  == request.auth.uid
                    && request.resource.data.type in ['debit','payment','withdrawal'];
      allow read:   if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       ESCROWS  (escrows/{escrowId})
       • create: authenticated buyer (buyerUid must match).
       • read: buyer or seller involved, or admin.
       • update: buyer/seller for limited status changes; admin for all.
       • delete: admin only.
    ══════════════════════════════════════════════════════════════ */
    match /escrows/{escrowId} {
      allow create: if isAuthed() && request.resource.data.buyerUid == request.auth.uid;
      allow read:   if isAdmin()
                    || (isAuthed() && (resource.data.buyerUid  == request.auth.uid
                                    || resource.data.sellerUid == request.auth.uid));
      allow update: if isAdmin()
                    || (isAuthed() && (resource.data.buyerUid  == request.auth.uid
                                    || resource.data.sellerUid == request.auth.uid)
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['status','updatedAt']));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       BUSINESSES  (businesses/{bizId})
       • read: public.
       • create: authenticated user; uid in payload must match.
       • update: owner (uid match) + uid field frozen, or admin.
       • delete: admin only.
    ══════════════════════════════════════════════════════════════ */
    match /businesses/{bizId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();

      /* POS transaction sync — SmartPOS writes per-sale records here */
      match /pos_transactions/{txId} {
        allow read:   if isAdmin()
                      || (isAuthed() && request.auth.uid == bizId)
                      || (isAuthed() && resource.data.sellerUid == request.auth.uid);
        allow create: if isAuthed()
                      && request.auth.uid == bizId
                      && request.resource.data.sellerUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      /* Terminal device registry — SmartPOS device pairing & management */
      match /terminals/{terminalId} {
        allow read:            if isAdmin() || (isAuthed() && request.auth.uid == bizId);
        allow create, update:  if isAuthed() && request.auth.uid == bizId;
        allow delete:          if isAdmin() || (isAuthed() && request.auth.uid == bizId);
      }

      /* Terminal payment recovery queue — offline transaction sync */
      match /terminal_queue/{queueId} {
        allow read:   if isAdmin() || (isAuthed() && request.auth.uid == bizId);
        allow create: if isAuthed() && request.auth.uid == bizId;
        allow update, delete: if isAdmin();
      }
    }

    /* ══════════════════════════════════════════════════════════════
       BUSINESS VIEW COUNTS  (bizViews/{bizId})
       Increment-only view counter; no sensitive data.
       • read: public (for analytics display).
       • write: any authenticated user (increments only; no raw set).
       • admin: full control.
    ══════════════════════════════════════════════════════════════ */
    match /bizViews/{bizId} {
      allow read:   if true;
      /* Constrain create: only allowed fields and viewCount must start at 1 */
      allow create: if isAuthed()
                    && request.resource.data.keys().hasOnly(['viewCount','lastViewAt'])
                    && request.resource.data.viewCount == 1;
      allow update: if isAuthed()
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['viewCount','lastViewAt']);
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       BUSINESS TEAM  (businessTeam/{memberId})
       • read: public.
       • create/update: business owner (ownerUid == auth.uid) or admin.
       • delete: business owner or admin.
    ══════════════════════════════════════════════════════════════ */
    match /businessTeam/{memberId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.ownerUid == request.auth.uid && uidUnchanged()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.ownerUid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       VERIFICATION REQUESTS  (verificationRequests/{reqId})
       Users submit their own applications; admin reviews them.
       • create: authenticated; applicantUid must match auth.uid.
       • read: applicant (own) or admin.
       • update: admin only (status, notes, rejectionReason).
       • delete: admin only.
    ══════════════════════════════════════════════════════════════ */
    match /verificationRequests/{reqId} {
      allow create: if isAuthed()
                    && request.resource.data.applicantUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.applicantUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       ADMIN LOG  (adminLog/{logId})
       Append-only audit trail — only admins may read or create.
       Super admins can purge old entries.
    ══════════════════════════════════════════════════════════════ */
    match /adminLog/{logId} {
      allow create: if isAdmin();
      allow read:   if isAdmin();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       PLATFORM METRICS  (platformMetrics/{metricId})
       Cloud Functions and admin writes aggregate counters here.
       The monitoring dashboard reads these for lightweight stats.
       • write: admin / Cloud Functions (server SDK bypasses rules).
       • read:  moderator and above.
    ══════════════════════════════════════════════════════════════ */
    match /platformMetrics/{metricId} {
      allow read:  if isModerator();
      allow write: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       ROLE GRANTS LOG  (roleGrants/{grantId})
       Immutable log of every role grant / revoke action.
       Written by the grantPlatformRole / revokePlatformRole functions.
    ══════════════════════════════════════════════════════════════ */
    match /roleGrants/{grantId} {
      allow read:           if isAdmin();
      allow create:         if isAdmin();
      allow update, delete: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       MODERATION FLAGS  (flags/{flagId})
       Authenticated users can report content; moderators manage queue.
    ══════════════════════════════════════════════════════════════ */
    match /flags/{flagId} {
      allow create: if isAuthed()
                    && request.resource.data.reporterUid == request.auth.uid;
      allow read:   if isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    /* ── Property Inquiries (WhatsApp contact tracking) ── */
    match /propertyInquiries/{docId} {
      /* uid field required and bound to caller — prevents forged inquiries with arbitrary phone numbers */
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['phone','propertyId','uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
      allow update, delete: if isAdmin();
    }

    /* ── Property Viewings (schedule viewing requests) ── */
    match /propertyViewings/{docId} {
      /* uid field required and bound to caller — prevents forged viewing requests */
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['propertyId','date','time','uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       EMPLOYEE INVITE SYSTEM
    ══════════════════════════════════════════════════════════════ */

    /* Platform invites — token IS the secret; all writes via Admin SDK.
       get  = read one doc by known token (fine — token is the secret)
       list = enumerate the collection (admin only — prevents email harvesting) */
    match /platformInvites/{token} {
      allow get:    if true;
      allow list:   if isAdmin();
      allow write:  if false;
    }

    /* Platform employees — admin sees all; employee sees own record */
    match /platformEmployees/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write:  if false;
    }

    /* Shop invites — token IS the secret; all writes via Admin SDK.
       get  = read one doc by known token (join.html flow)
       list = seller may list their own pending invites; admin sees all */
    match /shopInvites/{token} {
      allow get:    if true;
      allow list:   if isAdmin()
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
      allow write:  if false;
    }

    /* ══════════════════════════════════════════════════════════════
       PAYMENTS  (IntaSend STK Push payment records)
       Written by initiateSTKPush Cloud Function.
       Updated by intasendWebhook Cloud Function on confirmation.
       Client may NOT approve its own payment — only the webhook can
       set status to COMPLETE.
    ══════════════════════════════════════════════════════════════ */
    match /payments/{paymentId} {
      /* Owner can read their own payment status for polling */
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      /* Client creates the initial pending record (via Cloud Function call) */
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == "PENDING"
                    && request.resource.data.keys().hasAll(['uid','amount','ref','status']);
      /* CRITICAL: clients may NOT update payment status.
         Only Cloud Functions (admin SDK) may set status to COMPLETE/FAILED. */
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SUBSCRIPTIONS  (provider plan entitlements)
       Written exclusively by activateSubscription Cloud Function
       after verifying payment completion.
       Client may read own subscription to display UI.
    ══════════════════════════════════════════════════════════════ */
    match /subscriptions/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      /* Client may NOT write subscriptions — must go through Cloud Function */
      allow write:  if false;
    }

    /* ══════════════════════════════════════════════════════════════
       VOUCHERS  (admin-created discount codes)
       Voucher redemption is handled atomically by redeemVoucher CF.
       usageCount and redemptions array are updated by the CF only.
    ══════════════════════════════════════════════════════════════ */
    match /vouchers/{code} {
      /* Any authenticated user may preview a voucher before redeeming */
      allow read:   if isAuthed();
      /* Only admins / Cloud Functions may create or modify vouchers */
      allow create, update, delete: if isAdmin();
    }

    /* Voucher redemption history — Cloud Function writes, owner reads */
    match /voucherRedemptions/{redemptionId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write:  if false;
    }

    /* ══════════════════════════════════════════════════════════════
       HYPER-SCALE PHASE 11: Client metrics — write from SokoniMonitor CF,
       read only by admins. Clients never write directly to this collection.
    ══════════════════════════════════════════════════════════════ */
    match /clientMetrics/{docId} {
      allow read:  if isAdmin();
      allow write: if false; // recordMetric CF only
    }

    /* Trending products — Cloud Function writes, anyone can read */
    match /trending/{hub} {
      allow read:  if true;
      allow write: if false; // generateTrending CF only
    }

    /* platformMetrics rule is defined above — no duplicate needed here. */

    /* Mail queue — sendInvoiceEmail CF writes audit entries here.
       Authenticated users cannot read others' mail logs. */
    match /mailQueue/{docId} {
      allow read:  if isAdmin();
      allow write: if false; // sendInvoiceEmail CF only
    }

    /* ══════════════════════════════════════════════════════════════
       ENTERPRISE EMAIL SYSTEM
       All email collections are written exclusively by Cloud Functions.
       Clients use onCall functions (sendBroadcastEmail, resendEmail,
       updateEmailPreferences) — never direct Firestore writes.
    ══════════════════════════════════════════════════════════════ */

    /* Bounce suppression list — admin read/delete only */
    match /emailBounces/{email} {
      allow read:   if isAdmin();
      allow delete: if isAdmin();
      allow write:  if false; // emailWebhook CF only
    }

    /* Email analytics aggregates — admin read only */
    match /emailAnalytics/{docId} {
      allow read:  if isAdmin();
      allow write: if false; // processEmailQueue CF only
    }

    /* Email event log (opens, clicks) — admin read only */
    match /emailEvents/{eventId} {
      allow read:  if isAdmin();
      allow write: if false; // emailWebhook CF only
    }

    /* Notification history — user reads own records; admin reads all */
    match /notificationHistory/{docId} {
      allow read:  if isAdmin()
                   || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if false; // server-side only
    }

    /* ── DMARC Reports — admin-only ───────────────────────────────── */

    /* Aggregate DMARC reports parsed from XML */
    match /dmarcReports/{reportId} {
      allow read:  if isAdmin();
      allow write: if false; // processDmarcReport CF only
    }

    /* Sub-collection: individual IP records within each report */
    match /dmarcReports/{reportId}/records/{ipId} {
      allow read:  if isAdmin();
      allow write: if false; // processDmarcReport CF only
    }

    /* DMARC policy failure alerts */
    match /dmarcAlerts/{alertId} {
      allow read:  if isAdmin();
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(["resolved", "resolvedAt", "resolvedBy"]);
      allow write: if false; // processDmarcReport CF only (create)
    }

    /* ══════════════════════════════════════════════════════════════
       JOBS MARKETPLACE
    ══════════════════════════════════════════════════════════════ */

    /* Job listings — anyone can read active jobs; authenticated users post */
    match /jobs/{jobId} {
      allow read:  if resource.data.active == true || isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.company is string
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 5000
                    && request.resource.data.contactEmail is string
                    && !('applicants' in request.resource.data)
                       || request.resource.data.applicants == 0;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == resource.data.uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['applicants','featured','plan','uid']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    /* Job applications — applicant writes own; employer and admin read */
    match /jobApplications/{appId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['jobId','uid','name','email','phone','coverLetter','appliedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.coverLetter.size() <= 3000
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin(); // status changes (shortlist/reject) by employer via CF
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       EDUCATION HUB
       • read:   public if active==true; owner or admin otherwise.
       • create: authenticated owner; blocks admin-privilege fields.
       • update: admin or owner (cannot touch featured/active/verified).
       • delete: admin or owner.
    ══════════════════════════════════════════════════════════════ */
    match /education/{docId} {
      allow read:   if resource.data.active == true || isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.category is string
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 3000
                    && !('featured' in request.resource.data)
                    && !('active'   in request.resource.data)
                    && !('verified' in request.resource.data);
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.uid == request.auth.uid
                        && resource.data.uid == request.resource.data.uid
                        && !('featured' in request.resource.data)
                        && !('verified' in request.resource.data)
                        && !('active'   in request.resource.data));
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       SMARTPOS — ENTERPRISE RETAIL COLLECTIONS
       All POS data is seller-scoped via the `sellerId` field.
       The `sellerId` must match the authenticated user's UID.
       Cashiers authenticate locally via PIN — they do NOT have
       their own Firebase Auth UID. All Firestore writes happen
       under the seller's Firebase Auth session (via pos-sync.js).

       Security model:
         • create: authenticated seller who owns the sellerId field
         • read:   seller who owns the data, or admin
         • update: admin only (prevents client-side tampering)
         • delete: admin only (audit trail must never be destroyed)

       POS transactions are immutable after creation.
       Refunds and voids are NEW documents, not transaction updates.
    ══════════════════════════════════════════════════════════════ */

    function isPosOwner() {
      return isAuthed() && resource.data.sellerId == request.auth.uid;
    }

    function claimsPosOwner() {
      return isAuthed() && request.resource.data.sellerId == request.auth.uid;
    }

    /* Transactions — immutable after creation (refunds = new posRefunds doc) */
    match /posTransactions/{txnId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.status in ['completed', 'failed', 'pending']
                    && !('adminNote' in request.resource.data);
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isAdmin(); /* admin-only: corrections, reconciliation */
      allow delete: if false;    /* never — audit trail is permanent */
    }

    /* Products — seller can manage their own product catalogue */
    match /posProducts/{productId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0;
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isPosOwner() || isAdmin();
      allow delete: if isPosOwner() || isAdmin();
    }

    /* Stock Movements — append-only audit log of every inventory change */
    match /posStockMovements/{moveId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.productId is string
                    && request.resource.data.qty is number;
      allow read:   if isPosOwner() || isAdmin();
      allow update: if false;  /* immutable — stock history cannot be edited */
      allow delete: if false;
    }

    /* Shifts — seller-scoped session records */
    match /posShifts/{shiftId} {
      allow create: if claimsPosOwner();
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isPosOwner() || isAdmin(); /* closing shift updates status */
      allow delete: if isAdmin();
    }

    /* Customers — seller's customer CRM (scoped to their POS) */
    match /posCustomers/{customerId} {
      allow create: if claimsPosOwner();
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isPosOwner() || isAdmin();
      allow delete: if isAdmin();
    }

    /* Refunds — new document per refund, immutable after creation */
    match /posRefunds/{refundId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.originalTxnId is string
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0;
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* Voids — immutable void records */
    match /posVoids/{voidId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.originalTxnId is string;
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* Cash floats — shift opening/closing cash counts */
    match /posCashFloats/{floatId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.amount is number;
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* Device registry — POS terminals registered per seller */
    match /posDevices/{deviceId} {
      allow create: if claimsPosOwner();
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isPosOwner() || isAdmin();
      allow delete: if isAdmin();
    }

    /* Platform-level SmartPOS config — admin-only */
    match /posConfig/{configId} {
      allow read:   if isAuthed();
      allow write:  if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       POS BRANCHES  (PosBoss.branch.init() — multi-branch management)
       Each branch document carries a `businessId` == seller's Firebase UID.
       • create / update: only the business owner.
       • read: owner or admin (branch config is commercially sensitive).
       • delete: admin only (branch history must be preserved).
    ══════════════════════════════════════════════════════════════ */
    match /pos_branches/{branchId} {
      allow create: if isAuthed()
                    && request.resource.data.businessId == request.auth.uid
                    && request.resource.data.keys().hasAll(['businessId','name']);
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.businessId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.businessId == request.auth.uid
                        && request.resource.data.businessId == resource.data.businessId);
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       INVENTORY MODULE
       Tenant-scoped under tenants/{tenantId}/inventory_*
       Stock mutations are locked to Cloud Functions only (admin SDK).
       UI reads use tenant membership via claims.
    ══════════════════════════════════════════════════════════════ */
    match /tenants/{tenantId}/{document=**} {
      function isTenantMember() {
        return request.auth != null &&
               (request.auth.token.tenantId == tenantId || isAdmin());
      }
      function isTenantAdmin() {
        return isAdmin() || request.auth.token.get('tenantAdmin', false) == true;
      }

      /* ── Products: sellers write, everyone reads ── */
      match /inventory_products/{productId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 200
                      && request.resource.data.tenantId == tenantId
                      && !('deletedAt' in request.resource.data);
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && request.resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }

      /* ── Stock Levels: Cloud Functions write, members read ── */
      match /inventory_levels/{levelId} {
        allow read:   if isTenantMember();
        allow write:  if false; // Mutations only via Cloud Functions
      }

      /* ── Movements: Cloud Functions write, members read ── */
      match /inventory_movements/{mvId} {
        allow read:   if isTenantMember();
        allow write:  if false; // Audit-safe: only Cloud Functions write
      }

      /* ── Purchase Orders: tenant members manage ── */
      match /inventory_purchaseOrders/{poId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.supplierId is string
                      && request.resource.data.status == 'draft';
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['createdBy', 'tenantId']);
        allow delete: if isTenantAdmin();
      }

      /* ── Suppliers: members create, admins delete ── */
      match /inventory_suppliers/{supplierId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.name is string
                      && request.resource.data.tenantId == tenantId;
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }

      /* ── Warehouses: admins only ── */
      match /inventory_warehouses/{warehouseId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantAdmin();
      }

      /* ── Stock Audits: members create/read, CFs complete ── */
      match /inventory_audits/{auditId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.status == 'in_progress';
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && resource.data.status == 'in_progress'
                      && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['completedAt', 'results']);
        allow delete: if isTenantAdmin();
      }

      /* ── Alerts: Cloud Functions write, members read ── */
      match /inventory_alerts/{alertId} {
        allow read:   if isTenantMember();
        allow write:  if false; // Only Cloud Functions manage alerts
      }

      /* ── Reservations: Cloud Functions only ── */
      match /inventory_reservations/{resId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }

      /* ── Batches: members create, all read ── */
      match /inventory_batches/{batchId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantMember() && request.resource.data.tenantId == tenantId;
      }

      /* ── Serial index: members read, CFs write ── */
      match /inventory_serials/{serialId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }
      match /inventory_serialIndex/{serialNo} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }

      /* ── Analytics + Forecasts: members read only ── */
      match /inventory_analytics/{docId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }
      match /inventory_forecasts/{forecastId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }

      /* ── AI Logs: members read own, admins read all ── */
      match /inventory_ai_logs/{logId} {
        allow read:   if isTenantAdmin();
        allow write:  if false;
      }

      /* ── Audit Trail: immutable, admins read ── */
      match /inventory_audit/{logId} {
        allow read:   if isTenantAdmin();
        allow write:  if false;
      }

      /* ═══════════════ INVENTORY V2 COLLECTIONS ═══════════════ */

      /* ── Health scores: CFs write, members read ── */
      match /inventory_health/{docId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }
      match /inventory_health_history/{docId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }

      /* ── Fraud events: CFs write, admins read ── */
      match /inventory_fraud_events/{eventId} {
        allow read:   if isTenantAdmin();
        allow write:  if false;
      }

      /* ── Simulations: members read, CFs write ── */
      match /inventory_simulations/{simId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }

      /* ── Recalls: admins create, members read ── */
      match /inventory_recalls/{recallId} {
        allow read:   if isTenantMember();
        allow create: if isTenantAdmin();
        allow update: if isTenantAdmin();
        allow delete: if false;
      }

      /* ── Import jobs: members read own, CFs write ── */
      match /inventory_import_jobs/{jobId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }

      /* ── Webhooks: members create, owner delete ── */
      match /inventory_webhooks/{webhookId} {
        allow read:   if isTenantAdmin();
        allow create: if isTenantMember();
        allow update: if isTenantAdmin();
        allow delete: if isTenantAdmin();
        match /deliveries/{deliveryId} {
          allow read:  if isTenantAdmin();
          allow write: if false;
        }
      }

      /* ── Workflows: members create, members manage own ── */
      match /inventory_workflows/{workflowId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember() && request.resource.data.tenantId == tenantId;
        allow update: if isTenantAdmin();
        allow delete: if isTenantAdmin();
      }
      match /inventory_workflow_runs/{runId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }

      /* ── Pricing rules: admins manage, members read recommendations ── */
      match /inventory_pricing_rules/{productId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantAdmin();
      }
      match /inventory_price_recommendations/{productId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }

      /* ── Digital twin: admins write, members read ── */
      match /inventory_digital_twin/{warehouseId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantAdmin();
      }

      /* ── Sustainability: CFs write, members read ── */
      match /inventory_sustainability/{docId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }

      /* ── Commerce graph: CFs only ── */
      match /inventory_commerce_graph/{docId} {
        allow read:   if isTenantMember();
        allow write:  if false;
      }

      /* ── AI task queue: members create, CFs read ── */
      match /inventory_ai_tasks/{taskId} {
        allow read:   if isTenantAdmin();
        allow create: if isTenantMember();
        allow write:  if false;
      }

      /* ── Supplier catalog: members read (platform-wide) ── */
      match /inventory_supplier_catalog/{supplierId} {
        allow read:   if isAuthed();
        allow write:  if false;
      }

      /* ══════════════════════════════════════════════════════════════
         INVENTORY V2 — ADVANCED PROCUREMENT & OPERATIONS COLLECTIONS
      ══════════════════════════════════════════════════════════════ */

      /* ── Product Variants (V2): size / colour / batch variants ── */
      match /inventory_variants/{variantId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.productId is string
                      && request.resource.data.productId.size() > 0
                      && request.resource.data.sku is string;
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['tenantId', 'productId']);
        allow delete: if isTenantAdmin();
      }

      /* ── Bill of Materials (V2): recipe / assembly definitions ── */
      match /inventory_bom/{bomId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.parentProductId is string
                      && request.resource.data.active == true;
        allow update: if isTenantAdmin()
                      && resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }

      /* ── Work Orders (V2): manufacturing / assembly jobs ── */
      match /inventory_work_orders/{woId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.status == 'draft'
                      && request.resource.data.bomId is string
                      && request.resource.data.quantity is number
                      && request.resource.data.quantity > 0;
        /* Members update in-progress orders (add output serial, qty); admins update any status */
        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status in ['draft', 'in_progress']
                          && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['tenantId', 'bomId', 'completedAt', 'cancelledAt']));
        allow delete: if isTenantAdmin();
      }

      /* ── Inter-Warehouse Transfers (V2): stock movement between locations ── */
      match /inventory_transfers/{transferId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.fromWarehouseId is string
                      && request.resource.data.toWarehouseId is string
                      && request.resource.data.status == 'pending'
                      /* Prevent self-transfers */
                      && request.resource.data.fromWarehouseId != request.resource.data.toWarehouseId;
        /* Members confirm receipt; admins manage all transitions */
        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'receivedAt', 'receivedBy',
                                                      'receivedQty', 'note', 'updatedAt']));
        allow delete: if isTenantAdmin();
      }

      /* ── Goods Received Notes (V2): GRN / partial delivery receipts ── */
      match /inventory_grn/{grnId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.purchaseOrderId is string
                      && request.resource.data.supplierId is string
                      && request.resource.data.status == 'draft';
        /* Draft GRNs can be edited; confirmed GRNs are immutable except admin */
        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status == 'draft'
                          && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['tenantId', 'purchaseOrderId', 'postedAt', 'postedBy']));
        /* GRNs cannot be deleted once confirmed — protects receiving audit trail */
        allow delete: if isTenantAdmin()
                      && resource.data.status == 'draft';
      }

      /* ── Stock Count Sessions (V2): physical inventory cycle counts ── */
      match /inventory_stockcounts/{countId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.warehouseId is string
                      && request.resource.data.status == 'open'
                      && request.resource.data.keys().hasAll(['startedBy', 'startedAt']);
        /* Open sessions: counters add scan lines; only admins approve/finalise */
        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status == 'open'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['note', 'updatedAt']));
        allow delete: if isTenantAdmin()
                      && resource.data.status == 'open';

        /* Count lines sub-collection — scan entries during the count */
        match /lines/{lineId} {
          allow read:   if isTenantMember();
          allow create: if isTenantMember()
                        && get(/databases/$(database)/documents/tenants/$(tenantId)/inventory_stockcounts/$(countId))
                             .data.status == 'open'
                        && request.resource.data.keys().hasAll(['productId', 'counted', 'countedBy', 'countedAt'])
                        && request.resource.data.counted is number
                        && request.resource.data.counted >= 0;
          allow update: if isTenantMember()
                        && get(/databases/$(database)/documents/tenants/$(tenantId)/inventory_stockcounts/$(countId))
                             .data.status == 'open'
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['counted', 'note', 'updatedAt', 'updatedBy']);
          allow delete: if isTenantAdmin();
        }
      }

      /* ── Purchase Requisitions (V2): internal request → PO approval chain ── */
      match /inventory_requisitions/{reqId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.status == 'pending'
                      && request.resource.data.requestedBy == request.auth.uid
                      && request.resource.data.keys().hasAll(['items', 'requestedBy', 'requestedAt'])
                      && request.resource.data.items is list
                      && request.resource.data.items.size() > 0;
        /* Requester may cancel own pending requisition; managers approve/reject */
        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.requestedBy == request.auth.uid
                          && resource.data.status == 'pending'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'cancelNote', 'updatedAt'])
                          && request.resource.data.status == 'cancelled');
        allow delete: if isTenantAdmin();
      }

      /* ── Supplier Contracts (V2): contract terms, price lists, SLAs ── */
      match /inventory_supplier_contracts/{contractId} {
        allow read:   if isTenantMember();
        allow create: if isTenantAdmin()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.supplierId is string;
        allow update: if isTenantAdmin()
                      && resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }

      /* ── Shelf Count AI Jobs (V2): AI-assisted shelf scanning sessions ── */
      match /inventory_shelf_scans/{scanId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.warehouseId is string
                      && request.resource.data.status == 'pending';
        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status == 'pending'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'imageRef', 'updatedAt']));
        allow delete: if isTenantAdmin();
      }
    }

    /* ══════════════════════════════════════════════════════════
       GEO INTELLIGENCE PLATFORM (GIP)  — Security Rules

       Security model:
         gipLocations  — asset devices write own doc; any authed user reads
         gipAssets     — asset owner writes own; any authed reads
         gipDispatch   — any authed creates; admin/assigned asset updates
         gipAlerts     — Cloud Functions write; admin/asset owner reads
         gipGeofences  — admins write; any authed reads active zones
         gipGeofenceEvents — Cloud Functions write; admins read
         gipHeatData   — Cloud Functions write; any authed reads
         gipAnalytics  — Cloud Functions write; admin or own driver reads
    ══════════════════════════════════════════════════════════ */

    /* Asset live location — each asset writes its own single document */
    match /gipLocations/{assetId} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && request.resource.data.assetId == assetId
                    && request.resource.data.lat  is number
                    && request.resource.data.lat  >= -90   && request.resource.data.lat  <= 90
                    && request.resource.data.lng  is number
                    && request.resource.data.lng  >= -180  && request.resource.data.lng  <= 180;
      allow update: if isAuthed()
                    && (request.auth.uid == resource.data.uid || isAdmin())
                    && request.resource.data.lat  is number
                    && request.resource.data.lat  >= -90   && request.resource.data.lat  <= 90
                    && request.resource.data.lng  is number
                    && request.resource.data.lng  >= -180  && request.resource.data.lng  <= 180;
      allow delete: if isAdmin();
    }

    /* Dispatch jobs */
    match /gipDispatch/{jobId} {
      allow read:   if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed()
                    && (isAdmin() || resource.data.assignedAssetId == request.auth.uid);
      allow delete: if isAdmin();
    }

    /* Fleet alerts — Cloud Functions write; admin or asset owner reads */
    match /gipAlerts/{alertId} {
      allow read:   if isAuthed()
                    && (isAdmin() || resource.data.assetId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved','resolvedAt']);
      allow delete: if isAdmin();
    }

    /* Geofence zones */
    match /gipGeofences/{zoneId} {
      allow read:   if isAuthed();
      allow write:  if isAdmin();
    }

    /* Geofence trigger audit log — Cloud Functions write only */
    match /gipGeofenceEvents/{eventId} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    /* Demand heat data — Cloud Functions write; authenticated reads */
    match /gipHeatData/{region}/{date}/{hour} {
      allow read:   if isAuthed();
      allow write:  if false;
    }

    /* Driver/fleet analytics — Cloud Functions write; admin or own driver reads */
    match /gipAnalytics/{date}/{subcollection}/{docId} {
      allow read:   if isAuthed()
                    && (isAdmin() || docId == request.auth.uid);
      allow write:  if false;
    }

    /* gipAssets — vehicle/device registry
       Owner writes their own asset; admins write all; any authed reads */
    match /gipAssets/{assetId} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthed()
                    && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      /* Service history sub-collection — owner or admin writes */
      match /serviceHistory/{serviceId} {
        allow read:   if isAuthed()
                      && (isAdmin() || get(/databases/$(database)/documents/gipAssets/$(assetId)).data.uid == request.auth.uid);
        allow create: if isAuthed()
                      && (isAdmin() || get(/databases/$(database)/documents/gipAssets/$(assetId)).data.uid == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    /* gipRoutes — optimized route records
       Any authed user writes their own routes; admins read all */
    match /gipRoutes/{routeId} {
      allow read:   if isAuthed()
                    && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isAuthed();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SASOS — Universal AI Subscription Operating System
       Collections: sasosSubscriptions, sasosBillingLedger,
         sasosInvoices, sasosUsage, sasosDunning, sasosRiskProfiles,
         sasosRiskEvents, sasosManualReview, sasosInsights,
         sasosAuditLog, sasosPlans, sasosRenewalQueue,
         sasosRevenueAggregates, sasosPaymentRefs, aiCredits,
         sasosCreditLedger, sasosStorageUsage, entitlements,
         sasosOrgs, sasosSeats, sasosSeatInvites, sasosLicenses
    ══════════════════════════════════════════════════════════════ */

    /* sasosSubscriptions — master subscription state, one doc per uid
       User reads their own doc (server refreshed on every feature gate).
       All writes are server-only via Cloud Functions. */
    match /sasosSubscriptions/{uid} {
      allow read:   if isAuthed() && request.auth.uid == uid;
      allow write:  if false;  /* CF only */
    }

    /* sasosBillingLedger — immutable billing records
       User reads their own; admin reads all. No client writes. */
    match /sasosBillingLedger/{entryId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write:  if false;  /* CF only */
    }

    /* sasosInvoices — user can read their own invoices; admin reads all */
    match /sasosInvoices/{invoiceId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write:  if false;
    }

    /* sasosUsage — user reads their own usage counters */
    match /sasosUsage/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && docId.matches(request.auth.uid + '_.*'));
      allow write:  if false;
    }

    /* sasosDunning — admin only; user reads their own grace-period record */
    match /sasosDunning/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write:  if false;
    }

    /* sasosRiskProfiles — admin reads all; users read their own (limited) */
    match /sasosRiskProfiles/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write:  if false;
    }

    /* sasosRiskEvents — admin only */
    match /sasosRiskEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    /* sasosManualReview — admin only */
    match /sasosManualReview/{uid} {
      allow read, write: if isAdmin();
    }

    /* sasosInsights — user reads their own; admin reads all */
    match /sasosInsights/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write:  if false;
    }

    /* sasosAuditLog — admin reads; no client writes */
    match /sasosAuditLog/{logId} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    /* sasosPlans — public read (pricing page); admin writes */
    match /sasosPlans/{planId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    /* sasosRenewalQueue — admin only */
    match /sasosRenewalQueue/{docId} {
      allow read, write: if isAdmin();
    }

    /* sasosRevenueAggregates — admin only */
    match /sasosRevenueAggregates/{dateId} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    /* sasosPaymentRefs — idempotency keys; no client reads or writes */
    match /sasosPaymentRefs/{refId} {
      allow read, write: if false;
    }

    /* aiCredits — user reads their own balance; CF writes */
    match /aiCredits/{uid} {
      allow read:   if isAuthed() && request.auth.uid == uid;
      allow write:  if false;
    }

    /* sasosCreditLedger — user reads their own; admin reads all */
    match /sasosCreditLedger/{entryId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write:  if false;
    }

    /* sasosStorageUsage — user reads their own; CF writes */
    match /sasosStorageUsage/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && docId.matches(request.auth.uid + '_.*'));
      allow write:  if false;
    }

    /* entitlements — user reads their own; CF writes; admin reads all */
    match /entitlements/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write:  if false;
    }

    /* ── SASOS Enterprise ── */

    /* sasosOrgs — org member reads; owner writes limited fields; CF manages */
    match /sasosOrgs/{orgId} {
      allow read:  if isAdmin()
                   || (isAuthed()
                       && exists(/databases/$(database)/documents/sasosSeats/$(orgId + '_' + request.auth.uid)));
      allow write: if false;
    }

    /* sasosSeats — member reads their own seat; owner reads all seats in org */
    match /sasosSeats/{seatId} {
      allow read:  if isAdmin()
                   || (isAuthed() && seatId.matches('.*_' + request.auth.uid));
      allow write: if false;
    }

    /* sasosSeatInvites — invitee reads their invite (by inviteId); admin reads all */
    match /sasosSeatInvites/{inviteId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.invitee == request.auth.uid);
      allow write:  if false;
    }

    /* sasosLicenses — org member reads; admin writes */
    match /sasosLicenses/{licenseId} {
      allow read:   if isAdmin()
                    || (isAuthed()
                        && exists(/databases/$(database)/documents/sasosSeats/$(resource.data.orgId + '_' + request.auth.uid)));
      allow write:  if false;
    }

    /* ══════════════════════════════════════════════════════════════
       PLATFORM REGISTRY + EVENT BUS  (platform-registry.js / platform-events.js)
       All writes are CF-only (allow write: if false on every doc collection).
       Reads are role-gated: services are semi-public; events are owner/admin.
    ══════════════════════════════════════════════════════════════ */

    /* platformServices — any authed user can browse the service catalog */
    match /platformServices/{serviceId} {
      allow read:  if isAuthed();
      allow write: if false;
    }

    /* platformHealth — any authed user can see health status */
    match /platformHealth/{serviceId} {
      allow read:  if isAuthed();
      allow write: if false;
    }

    /* platformDependencies — any authed user can see the dependency graph */
    match /platformDependencies/{edgeId} {
      allow read:  if isAuthed();
      allow write: if false;
    }

    /* platformEvents — publishers read their own events; admins see all */
    match /platformEvents/{eventId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.publisherUid == request.auth.uid);
      allow write: if false;
    }

    /* platformSubscriptions — any authed service can read subscriptions */
    match /platformSubscriptions/{subId} {
      allow read:  if isAuthed();
      allow write: if false;
    }

    /* platformFanOut — admin only; CF-written delivery tasks */
    match /platformFanOut/{taskId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* managerAuditLog — immutable: create-only from backend, read by admin */
    match /managerAuditLog/{entryId} {
      allow read:   if isAdmin();
      allow create: if false;   /* written exclusively by Cloud Functions / server SDK */
      allow update: if false;
      allow delete: if false;
    }

    /* managerAuthRequests — POS creates, manager responds (approve/deny), CF reads */
    match /managerAuthRequests/{reqId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.requestedByUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.requestedByUid == request.auth.uid;
      allow update: if isAuthed()
                    && (resource.data.requestedByUid == request.auth.uid || isAdmin())
                    && request.resource.data.keys().hasOnly(['status','respondedById','respondedByName','respondedAt'])
                    && request.resource.data.status in ['approved','denied'];
      allow delete: if false;
    }

    /* managerFCMTokens — manager registers their own push token */
    match /managerFCMTokens/{managerId} {
      allow read:   if isAdmin();
      allow write:  if isAuthed();
    }

    /* ══════════════════════════════════════════════════════════════
       CONTACT REQUESTS  (buyer→seller contact leads)
       Written by product.js _submitContactRequest() when a buyer
       requests contact with a non-premium seller.
       • create:  authenticated buyer only; uid must match auth uid.
       • read:    the seller (sellerUid field) or admin.
       • update:  seller marks as read/responded; admin can update any field.
       • delete:  admin only.
    ══════════════════════════════════════════════════════════════ */
    match /contactRequests/{reqId} {
      allow create: if isAuthed()
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['buyerUid','sellerUid','productId','message','createdAt']);
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid  == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','respondedAt','sellerNote']));
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       PRODUCT Q&A  (buyer questions on product pages)
       Written by product.js openAskQuestion() to productQA collection.
       • create:  authenticated user; uid must match auth uid.
       • read:    public (questions + answers are visible to all).
       • update:  seller can post answer (sellerUid match); admin can edit anything.
       • delete:  admin or question author (buyerUid match).
    ══════════════════════════════════════════════════════════════ */
    match /productQA/{qaId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['buyerUid','productId','question','createdAt']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.buyerUid  == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['question']))
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['answer','answeredAt']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.buyerUid == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════
       POS PRINT JOBS  (audit log for network printer proxy)
       Written by the posPrint Cloud Function (admin SDK) after
       forwarding ESC/POS bytes to a LAN printer.
       • read:   owner seller or admin.
       • create/update/delete: Cloud Functions only (admin SDK).
    ══════════════════════════════════════════════════════════════ */
    match /posPrintJobs/{jobId} {
      allow read:             if isAdmin()
                              || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;  /* CF admin SDK only */
    }

    /* ══════════════════════════════════════════════════════════════
       SELLER STATS  (real-time counters: pendingOrders, etc.)
       Incremented by onNewOrderCreated Cloud Function via admin SDK.
       Sellers read their own stats for dashboard badge counts.
       Clients may never write — only CFs write via admin SDK.
    ══════════════════════════════════════════════════════════════ */
    match /sellerStats/{sellerUid} {
      allow read:             if isAdmin()
                              || (isAuthed() && request.auth.uid == sellerUid);
      allow create, update, delete: if false;  /* CF admin SDK only */
    }

    /* ══════════════════════════════════════════════════════════════
       PRODUCT STATS  — aggregated view/sales/price/trending counters
       Written exclusively by Cloud Functions (admin SDK).
       Any authenticated or unauthenticated user may read (public data).
    ══════════════════════════════════════════════════════════════ */
    match /productStats/{productId} {
      allow read:   if true;           /* public — product metrics are public */
      allow write:  if false;          /* CF admin SDK only */
    }

    /* ══════════════════════════════════════════════════════════════
       PRODUCT PRICE HISTORY  — one document per price change event
       Written by onProductPriceChanged trigger (admin SDK).
       Publicly readable — price history transparency for buyers.
    ══════════════════════════════════════════════════════════════ */
    match /productPriceHistory/{historyId} {
      allow read:   if true;           /* public — transparency for buyers */
      allow write:  if false;          /* CF admin SDK only */
    }

    /* ══════════════════════════════════════════════════════════════
       PRODUCT VIEW DEDUP  — session deduplication keys (short-lived)
       Written by recordProductView CF (admin SDK).
       No client access — privacy protection.
    ══════════════════════════════════════════════════════════════ */
    match /productViewDedup/{dedupKey} {
      allow read, write: if false;     /* CF admin SDK only — no client access */
    }

    /* ══════════════════════════════════════════════════════════════
       SELLER PERFORMANCE  — aggregated seller metrics
       Written by aggregateSellerPerformance CF (admin SDK).
       Public read — buyers need this to evaluate sellers.
    ══════════════════════════════════════════════════════════════ */
    match /sellerPerformance/{sellerId} {
      allow read:   if true;           /* public — seller metrics are public */
      allow write:  if false;          /* CF admin SDK only */
    }

    /* ══════════════════════════════════════════════════════════════
       OPS BACKUPS  — Firestore export audit log
       Written by scheduledFirestoreBackup CF (admin SDK).
       Admin read only.
    ══════════════════════════════════════════════════════════════ */
    match /ops_backups/{docId} {
      allow read:   if isAdmin();
      allow write:  if false;          /* CF admin SDK only */
    }

    /* ══════════════════════════════════════════════════════════════
       CSP VIOLATIONS  — collected by cspReportCollect CF
       Written publicly by browsers (no auth). Admin read only.
    ══════════════════════════════════════════════════════════════ */
    match /cspViolations/{docId} {
      allow read:   if isAdmin();
      allow write:  if false;          /* CF only — browsers hit CF endpoint */
    }

    /* ══════════════════════════════════════════════════════════════
       HEALTH CHECK PROBE  — written by systemHealthCheck CF
    ══════════════════════════════════════════════════════════════ */
    match /_healthcheck/{docId} {
      allow read:   if isAdmin();
      allow write:  if false;          /* CF admin SDK only */
    }

    /* ══════════════════════════════════════════════════════════════
       EMAIL LOGS  — delivery log for every sent email
       Read: owner (matching uid) or admin.
       Write: CF only.
    ══════════════════════════════════════════════════════════════ */
    match /emailLogs/{logId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write:  if false;
    }

    /* ══════════════════════════════════════════════════════════════
       EMAIL QUEUE  — pending/processing/failed email jobs
       Admin read. CF write.
    ══════════════════════════════════════════════════════════════ */
    match /emailQueue/{jobId} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    /* ══════════════════════════════════════════════════════════════
       EMAIL PREFERENCES  — per-user opt-out preferences
       User reads and writes their own prefs.
    ══════════════════════════════════════════════════════════════ */
    match /emailPreferences/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write:  if isAuthed() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                        ["orders","payments","marketing","account","security"]);
    }

    /* ══════════════════════════════════════════════════════════════
       USER FEEDBACK  — bug reports, feature requests, page ratings
       Submit: any authenticated user or anonymous (via CF).
       Read / triage: admin only.
       Write directly: CF only.
    ══════════════════════════════════════════════════════════════ */
    match /feedback/{feedbackId} {
      allow read:   if isAdmin();
      allow write:  if false;            /* submitFeedback CF writes */
    }

    /* ══════════════════════════════════════════════════════════════
       OPS REPORTS  — daily + weekly reports written by scheduled CFs
       Admin read. CF write.
    ══════════════════════════════════════════════════════════════ */
    match /ops_reports/{reportId} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    /* ══════════════════════════════════════════════════════════════
       HEALTH SNAPSHOTS  — hourly snapshots from recordHealthSnapshot
       Admin read. CF write.
    ══════════════════════════════════════════════════════════════ */
    match /healthSnapshots/{snapId} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    /* ══════════════════════════════════════════════════════════════
       FUNNEL STATS  — daily aggregate counters for conversion tracking
       Admin read. CF write.
    ══════════════════════════════════════════════════════════════ */
    match /funnelStats/{dateId} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    /* ══════════════════════════════════════════════════════════════
       RETENTION: recently viewed (per-user subcollection)
    ══════════════════════════════════════════════════════════════ */
    match /recentlyViewed/{uid}/items/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    /* ══════════════════════════════════════════════════════════════
       RETENTION: saved searches (per-user subcollection)
    ══════════════════════════════════════════════════════════════ */
    match /savedSearches/{uid}/searches/{searchId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    /* ══════════════════════════════════════════════════════════════
       KASS: per-user behavioural signals for AI personalisation
       Owner reads their own data. CF writes via Admin SDK (bypasses rules).
    ══════════════════════════════════════════════════════════════ */
    match /userBehavior/{uid}/kassInteractions/{docId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false; // CF admin SDK only
    }

    /* ══════════════════════════════════════════════════════════════
       AVAILABILITY ENGINE: provider config (read/write by owner & admin)
       Bookings subcollection written by CF Admin SDK (not via client rules).
       Public reads go through availabilityStatus, not this collection.
    ══════════════════════════════════════════════════════════════ */
    match /providerAvailability/{uid} {
      allow read:  if request.auth != null &&
                      (request.auth.uid == uid || isAdmin());
      allow write: if false; // CF Admin SDK only
    }
    match /providerAvailability/{uid}/overrides/{date} {
      allow read:  if request.auth != null &&
                      (request.auth.uid == uid || isAdmin());
      // Client writes allowed for own holiday overrides (date format enforced by SDK)
      allow write: if request.auth != null && request.auth.uid == uid &&
                      date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      allow delete: if request.auth != null &&
                       (request.auth.uid == uid || isAdmin());
    }
    match /providerAvailability/{uid}/bookings/{slotId} {
      // Owner (provider) can read all bookings; customer can read their own
      allow read: if request.auth != null &&
                     (request.auth.uid == uid ||
                      resource.data.customerUid == request.auth.uid ||
                      isAdmin());
      allow write: if false; // CF Admin SDK only (reserveSlot / releaseSlot)
    }

    /* ══════════════════════════════════════════════════════════════
       AVAILABILITY ENGINE: lightweight live status — public read
       Only CF Admin SDK writes (setProviderAvailability, setLiveStatus).
    ══════════════════════════════════════════════════════════════ */
    match /availabilityStatus/{uid} {
      allow read:  if true;   // public: needed for search results & widgets
      allow write: if false;  // CF Admin SDK only
    }

    /* ══════════════════════════════════════════════════════════════
       RETENTION: price alerts
       Users own their alerts. CF handles scheduler writes.
    ══════════════════════════════════════════════════════════════ */
    match /priceAlerts/{alertId} {
      allow read:   if request.auth != null &&
                       (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null &&
                       (resource.data.uid == request.auth.uid || isAdmin());
    }

    /* ══════════════════════════════════════════════════════════════
       SEARCH: query log (CF write, admin read)
    ══════════════════════════════════════════════════════════════ */
    match /searchQueryLog/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       CHECKOUT SESSIONS  — server-side cart lock before payment
       Created by createCheckoutSession CF (onCall).
       Users may read only their own pending session.
       Only CFs may update (consumed) or delete.
    ══════════════════════════════════════════════════════════════ */
    match /checkoutSessions/{sessionId} {
      allow read:   if isAuthed() && resource.data.uid == request.auth.uid;
      allow create: if false;   /* createCheckoutSession CF only */
      allow update: if false;   /* verifyIntasendPayment CF only */
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       RATE LIMITS  — Firestore-backed cross-instance rate counters
       Managed exclusively by checkRateLimitDurable() inside CFs.
       Admins may read for debugging; no client access.
    ══════════════════════════════════════════════════════════════ */
    match /rateLimits/{key} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       PAYMENT VERIFICATIONS  — idempotency guard
       Set once by verifyIntasendPayment on first success.
       Prevents duplicate order creation on network retries.
    ══════════════════════════════════════════════════════════════ */
    match /paymentVerifications/{ref} {
      allow read:  if isAuthed() &&
                      (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;    /* verifyIntasendPayment CF only */
    }

    /* ══════════════════════════════════════════════════════════════
       SYSTEM CONFIG  — platform-level persistent flags (bootstrap lock)
       Written by bootstrapAdminClaim CF once. Immutable to clients.
    ══════════════════════════════════════════════════════════════ */
    match /_systemConfig/{docId} {
      allow read:  if isAdmin();
      allow write: if false;    /* bootstrapAdminClaim CF only */
    }

    /* ══════════════════════════════════════════════════════════════
       COMMISSIONS  — WAP commission records written by Cloud Functions.
       Sellers read their own entries; admins read all.
       No client may write — Cloud Functions use Admin SDK.
    ══════════════════════════════════════════════════════════════ */
    match /commissions/{commissionId} {
      allow read:   if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin());
      allow create: if false;   /* wap.js CF only */
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       SECURITY EVENTS  — injection attempts, fraud signals, rate limit
       abuse logged by Cloud Functions. Admins read; no client writes.
    ══════════════════════════════════════════════════════════════ */
    match /securityEvents/{eventId} {
      allow read:  if isAdmin();
      allow write: if false;    /* CF only — Admin SDK bypasses rules */
    }

    /* ══════════════════════════════════════════════════════════════
       SYSTEM CONFIG — fuel prices, platform settings (read-only for
       authenticated users; writes only via Admin SDK / Cloud Functions)
    ══════════════════════════════════════════════════════════════ */
    match /sysConfig/{doc} {
      allow read:  if isAuthed();
      allow write: if false;    /* CF only — fetchEPRAFuelPrices / triggerEPRAFuelFetch */
    }

    /* ══════════════════════════════════════════════════════════════
       CAR HUB — VEHICLE TRACKING (sokoni-tracking.js)
       Owner: read/write own vehicle.
       Authorized drivers / family members: read only.
       Fleet managers (array on vehicle doc): read own.
    ══════════════════════════════════════════════════════════════ */
    match /trackedVehicles/{vehicleId} {
      allow read:  if isAuthed() && (
                     resource.data.ownerUid             == request.auth.uid ||
                     request.auth.uid in resource.data.authorizedDrivers ||
                     request.auth.uid in resource.data.familyMembers     ||
                     request.auth.uid in resource.data.fleetManagers      ||
                     isAdmin()
                   );
      allow create: if (isAuthed() && request.resource.data.ownerUid == request.auth.uid)
                    || isAdmin();
      allow update: if isAuthed()
                    && (resource.data.ownerUid == request.auth.uid || isAdmin())
                    && !request.resource.data.diff(resource.data)
                        .affectedKeys().hasAny(['ownerUid']);
      allow delete: if (isAuthed() && resource.data.ownerUid == request.auth.uid)
                    || isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       CAR HUB — LIVE VEHICLE LOCATIONS
       Keyed by vehicleId. Owner and authorised parties read live GPS.
       Only the vehicle owner (or admin) may write location updates.
    ══════════════════════════════════════════════════════════════ */
    match /vehicleLocations/{vehicleId} {
      function _veh() {
        return get(/databases/$(database)/documents/trackedVehicles/$(vehicleId)).data;
      }
      allow read:  if isAuthed() && (
                     _veh().ownerUid == request.auth.uid ||
                     request.auth.uid in _veh().authorizedDrivers ||
                     request.auth.uid in _veh().familyMembers     ||
                     isAdmin()
                   );
      /* Owner + authorised drivers write — drivers are physically in the vehicle */
      allow write: if isAuthed() && (
                     _veh().ownerUid == request.auth.uid ||
                     request.auth.uid in _veh().authorizedDrivers ||
                     isAdmin()
                   );
    }

    /* ══════════════════════════════════════════════════════════════
       CAR HUB — ROUTE HISTORY
       Owner reads/creates their own routes; no direct client deletes.
    ══════════════════════════════════════════════════════════════ */
    match /vehicleRoutes/{routeId} {
      allow read:   if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       CAR HUB — VEHICLE ALERTS
       Owner reads their own alerts; admins see all.
       Alerts are created by the client on events (speed, geofence, theft).
    ══════════════════════════════════════════════════════════════ */
    match /vehicleAlerts/{alertId} {
      allow read:   if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       CAR HUB — GEOFENCE ZONES
       Owner manages their own geofences.
    ══════════════════════════════════════════════════════════════ */
    match /vehicleGeofences/{geofenceId} {
      allow read:   if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthed() && resource.data.ownerUid == request.auth.uid || isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       CAR HUB — GPS HARDWARE DEVICES
       Owner manages their own registered trackers.
    ══════════════════════════════════════════════════════════════ */
    match /gpsDevices/{deviceId} {
      allow read:   if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       CAR HUB — TEMPORARY SHARE TOKENS
       Anyone authenticated can validate a token (for share-link tracking
       page). Only the creator (owner) may create/delete their shares.
    ══════════════════════════════════════════════════════════════ */
    match /trackingShares/{shareId} {
      allow read:   if isAuthed();           /* token validated client-side with where('token','==',t) */
      allow create: if isAuthed() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAuthed() && resource.data.createdBy == request.auth.uid || isAdmin();
      allow update: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       CAR HUB — TRACKING SUBSCRIPTIONS
       Document ID == uid. User owns their own subscription record.
    ══════════════════════════════════════════════════════════════ */
    match /trackingSubscriptions/{uid} {
      allow read:   if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow write:  if isAuthed() && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(['adminOverride','freeTrial']);
      allow write:  if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       CAR HUB — VEHICLE SERVICE HISTORY
       Owner reads/creates service records for their vehicles.
    ══════════════════════════════════════════════════════════════ */
    match /vehicleServiceHistory/{recordId} {
      allow read:   if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       CAR HUB — DRIVER SESSIONS (monitoring/fleet analytics)
       Driver writes their own session; owner of the vehicle reads.
    ══════════════════════════════════════════════════════════════ */
    match /driverSessions/{sessionId} {
      allow read:   if isAuthed() && (
                      resource.data.driverUid == request.auth.uid ||
                      isAdmin()
                    );
      allow create: if isAuthed() && request.resource.data.driverUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.driverUid == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       KRA eTIMS — SELLER PROFILES
       Seller reads their own profile. All writes via CF (admin SDK).
    ══════════════════════════════════════════════════════════════ */
    match /etimsProfiles/{uid} {
      allow read:   if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow write:  if false;
    }

    /* ══════════════════════════════════════════════════════════════
       KRA eTIMS — CREDENTIALS (AES-256-GCM encrypted, CF-only)
       Never accessible to any client — admin SDK only.
    ══════════════════════════════════════════════════════════════ */
    match /etimsCredentials/{uid}     { allow read, write: if false; }
    match /etimsSequences/{uid}       { allow read, write: if false; }
    match /etimsReconciliations/{docId}{ allow read, write: if false; }

    /* ══════════════════════════════════════════════════════════════
       KRA eTIMS — INVOICES
       Seller or buyer read their own invoices. Immutable to clients.
    ══════════════════════════════════════════════════════════════ */
    match /etimsInvoices/{invoiceId} {
      allow read:   if isAuthed() && (
                      resource.data.sellerUid == request.auth.uid ||
                      resource.data.buyerUid  == request.auth.uid ||
                      isAdmin()
                    );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       KRA eTIMS — QUEUE, BULK JOBS, ALERTS (CF-managed)
    ══════════════════════════════════════════════════════════════ */
    match /etimsQueue/{queueId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /etimsBulkJobs/{jobId} {
      allow read:  if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /etimsAlerts/{alertId} {
      allow read:  if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       SOKONI HUBS — REGISTRY
       Any authenticated user can read hub metadata.
       Hub managers can update their own hub's non-tax fields.
       Tax config and credentials only via admin SDK.
    ══════════════════════════════════════════════════════════════ */
    match /hubs/{hubId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthed() && (
                      resource.data.managerId == request.auth.uid ||
                      resource.data.managerIds.hasAny([request.auth.uid])
                    ));
      allow delete: if isAdmin();
    }

    /* Hub eTIMS credentials + counters — admin SDK only, never client */
    match /hubCredentials/{hubId} { allow read, write: if false; }
    match /hubSequences/{hubId}   { allow read, write: if false; }

    /* ══════════════════════════════════════════════════════════════
       HUB OPERATIONAL DOCUMENTS
       Hub managers, linked sellers, and linked buyers can read.
       All writes via hubGenerateDocument CF only.
    ══════════════════════════════════════════════════════════════ */
    match /hubDocuments/{docId} {
      allow read: if isAuthed() && (
                    isAdmin() ||
                    resource.data.sellerId == request.auth.uid ||
                    resource.data.buyerId  == request.auth.uid ||
                    (exists(/databases/$(database)/documents/hubs/$(resource.data.hubId)) &&
                     get(/databases/$(database)/documents/hubs/$(resource.data.hubId)).data.managerIds.hasAny([request.auth.uid]))
                  );
      allow write: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       HUB TAX INVOICES (selling / hybrid hubs only)
       Hub managers, linked sellers, and linked buyers can read.
       Immutable to all clients — CF-only writes.
    ══════════════════════════════════════════════════════════════ */
    match /hubInvoices/{invoiceId} {
      allow read: if isAuthed() && (
                    isAdmin() ||
                    resource.data.sellerUid == request.auth.uid ||
                    resource.data.buyerUid  == request.auth.uid ||
                    (exists(/databases/$(database)/documents/hubs/$(resource.data.hubId)) &&
                     get(/databases/$(database)/documents/hubs/$(resource.data.hubId)).data.managerIds.hasAny([request.auth.uid]))
                  );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /* Hub invoice retry queue — admin reads, CF writes */
    match /hubInvoiceQueue/{queueId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* ══════════════════════════════════════════════════════
       DISPATCH SYSTEM  v1.0
    ══════════════════════════════════════════════════════ */

    /* dispatchQueue — cascade state per delivery */
    match /dispatchQueue/{deliveryRef} {
      /* Rider can read their own offer; seller + admin can read all */
      allow read: if isAuthed() && (
        isAdmin() ||
        resource.data.rankedRiders[resource.data.currentIndex].riderId == request.auth.uid ||
        get(/databases/$(database)/documents/packageRequests/$(deliveryRef)).data.sellerUid == request.auth.uid
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* deliveryProofs — proof of delivery records */
    match /deliveryProofs/{deliveryRef} {
      /* Rider, seller, and admin can read proof */
      allow read: if isAuthed() && (
        isAdmin() ||
        resource.data.riderId == request.auth.uid ||
        get(/databases/$(database)/documents/packageRequests/$(deliveryRef)).data.sellerUid == request.auth.uid
      );
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    /* deliveryAttempts — failed delivery attempt log */
    match /deliveryAttempts/{attemptId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* deliveryBatches — multi-order batch state (rider-owned) */
    match /deliveryBatches/{batchId} {
      allow read: if isAuthed() && (
        isAdmin() ||
        resource.data.riderId == request.auth.uid
      );
      allow write: if false;
    }

    /* riderMetrics — aggregated daily rider performance */
    match /riderMetrics/{docId} {
      /* Riders can read their own metrics; admin reads all */
      allow read: if isAuthed() && (
        isAdmin() ||
        docId.matches(request.auth.uid + '_.*')
      );
      allow write: if false;
    }

    /* deliveryHubs — hub registry */
    match /deliveryHubs/{hubId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* fraudAlerts — GPS fraud and collusion flags */
    match /fraudAlerts/{alertId} {
      allow read:   if isAdmin();
      allow create: if false;   /* CF-only */
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* analyticsRollup — pre-aggregated delivery stats */
    match /analyticsRollup/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* smsQueue — internal SMS dispatch queue */
    match /smsQueue/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       CSAT RATINGS  — buyer delivery satisfaction ratings
       Buyer writes their own. Rider reads their own. Admin reads all.
    ══════════════════════════════════════════════════════════════ */
    match /csatRatings/{ratingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.riderId == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.rating   is number
                    && request.resource.data.rating   >= 1
                    && request.resource.data.rating   <= 5;
      allow update, delete: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       WHATSAPP QUEUE  — deep-link delivery notification queue
       Admin read. CF write only.
    ══════════════════════════════════════════════════════════════ */
    match /whatsappQueue/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       DELIVERY SIGNATURES  — signed URLs of canvas signature pads
       Rider and buyer read. CF write only.
    ══════════════════════════════════════════════════════════════ */
    match /deliverySignatures/{docId} {
      allow read:  if isAdmin()
                   || (isAuthed() && (
                       resource.data.riderId == request.auth.uid
                       || resource.data.buyerUid == request.auth.uid));
      allow write: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       FINOS — Financial Operating System  v1.0
       All financial data is CF-only for writes. Reads follow RBAC:
       entity reads own; admin reads all.
    ══════════════════════════════════════════════════════════════ */

    /* Global double-entry ledger — immutable. CF writes only. */
    match /ledger/{txId} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /* Per-entity wallet balances */
    match /wallets/{entityId} {
      allow read:   if isAdmin()
                    || (isAuthed() && request.auth.uid == entityId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      /* Wallet transaction subcollection */
      match /transactions/{txId} {
        allow read:   if isAdmin()
                      || (isAuthed() && request.auth.uid == entityId);
        allow write:  if false;
      }
    }

    /* Commission rules — admin CRUD; signed-in users read for preview */
    match /commissionRules/{ruleId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* Payouts — entity reads own, admin reads all, CF writes */
    match /payouts/{payoutId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.entityId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /* Promotions — admin creates; signed-in users read active promos */
    match /promotions/{promoId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* Promotion usage records — buyer reads own, admin reads all, CF writes */
    match /promotionUsage/{usageId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.buyerUid == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /* Tax records — admin read only */
    match /taxRecords/{taxId} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    /* Daily financial snapshots — admin read only */
    match /finosSnapshots/{snapId} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    /* Idempotency keys — CF-only; 7-day TTL enforced in CF */
    match /finosIdempotency/{key} {
      allow read:   if false;
      allow write:  if false;
    }

    /* Immutable audit log — admin read only; write via CF only */
    match /finosAuditLog/{logId} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       BUSINESS COMMUNICATION SYSTEM
    ══════════════════════════════════════════════════════════════ */

    /* Conversations — participant-scoped read; CF-only write */
    match /conversations/{conversationId} {
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.participants;
      allow write:  if false;  /* createConversation / archiveCompletedConversations CFs only */

      /* Messages — participants read; participants create (with validation); own-message update only */
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status == 'active'
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.keys().hasAll(['senderId','timestamp','type','status','deleted','edited'])
                      && request.resource.data.type in ['text','image','pdf','voice']
                      && (request.resource.data.type != 'text'
                          || (request.resource.data.text is string && request.resource.data.text.size() <= 4000));

        /* Sender may soft-delete own message or mark edited */
        allow update: if request.auth != null
                      && resource.data.senderId == request.auth.uid
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['deleted','deletedAt','text','edited','editedAt','storageRef']);

        allow delete: if false;
      }
    }

    /* User conversation index — own entries only */
    match /userConversations/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;  /* CF only */

      match /items/{conversationId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    /* Typing indicators — own uid only; public read within authenticated users */
    match /typingIndicators/{conversationId} {
      allow read: if request.auth != null;

      match /users/{uid} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    /* Chat policies — admin read/write via CF; reject direct client writes */
    match /chatPolicies/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* Moderation queue — admin read via CF; no direct client access */
    match /moderationQueue/{reportId} {
      allow read:  if false;
      allow write: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       REVIEWS & RATINGS ENGINE v1.0
       reviews/{id}                 — CF admin SDK writes; authenticated reads
       reviews/{id}/flags/{uid}     — CF admin SDK writes
       reviews/{id}/helpfulVotes/{uid} — CF admin SDK writes
       ratingsSummary/{targetId}    — public reads, CF writes
    ══════════════════════════════════════════════════════════════ */
    match /reviews/{reviewId} {
      allow read:  if resource.data.status == "approved" || (request.auth != null && (request.auth.uid == resource.data.authorUid || isAdmin()));
      allow write: if false; // CF Admin SDK only
    }
    match /reviews/{reviewId}/flags/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    match /reviews/{reviewId}/helpfulVotes/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /ratingsSummary/{targetId} {
      allow read:  if true;   // public: needed for product cards and search results
      allow write: if false;  // CF Admin SDK only
    }

    /* ── Data Deletion & Rights Requests ──────────────────────────────── */
    match /dataDeletionRequests/{reqId} {
      allow read:   if isAdmin();
      allow create: if false; // CF Admin SDK only (facebookDataDeletion CF)
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /dataRightsRequests/{reqId} {
      allow read:   if isAdmin();
      allow create: if false; // CF (submitDataRightsRequest callable)
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /accountDeletions/{reqId} {
      allow read:   if isAdmin();
      allow create: if false; // CF (deleteMyAccount callable)
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* ── MiniShop & Social Commerce v1.0 ──────────────────────────────── */
    match /shopHandles/{handle} {
      allow read:  if true;   // public — URL resolution for any visitor
      allow write: if false;  // CF Admin SDK only (claimMinishopHandle)
    }
    match /minishopConfig/{shopId} {
      allow read:  if true;   // public — storefront data loaded by visitors
      allow write: if false;  // CF Admin SDK only (saveMinishopConfig)
    }
    match /minishopAnalytics/{shopId} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == resource.data.ownerUid);
      allow write: if false;  // CF Admin SDK only (trackMinishopView, followShop)
    }
    match /shopFollowers/{docId} {
      allow read:  if true;   // public — follower count visible on storefront
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthed() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    match /msViewRL/{docId} {
      allow read:  if false;
      allow write: if false;  // CF Admin SDK only (rate limit counters)
    }
    match /aiGenRL/{docId} {
      allow read:  if false;
      allow write: if false;  // CF Admin SDK only (AI generation rate limits)
    }

    /* ── MiniShop Campaigns v1.0 ───────────────────────────────────────── */
    match /minishopCampaigns/{campaignId} {
      // Sellers can read their own campaigns; public can read active campaign metadata
      allow read:  if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;  // CF Admin SDK only (createMinishopCampaign, pauseMinishopCampaign, deleteMinishopCampaign)
    }
    match /campaignClickRL/{docId} {
      allow read:  if false;
      allow write: if false;  // CF Admin SDK only (rate limit counters for trackCampaignClick)
    }

  }
}

