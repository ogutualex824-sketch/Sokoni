/* THIS FILE DIVERGES FROM PRODUCTION. Read docs/RULES_RECONCILIATION.md before
   deploying rules. It carries ~89 lines from several teams that have never been
   released; promoting them all at once is what produced 400 INVALID_ARGUMENT on the
   release (surfaced by the CLI as a misleading 409). Release one reviewed category at
   a time from the live baseline in firestore.rules.live.
   Preflight: TOKEN_FILE=<tok> node scripts/verify-rules-release-parity.js */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }

    function isAdmin() {
      return request.auth != null &&
             (request.auth.token.admin == true || request.auth.token.superAdmin == true);
    }

    function isModerator() {
      return request.auth != null &&
             (request.auth.token.moderator == true ||
              request.auth.token.admin == true ||
              request.auth.token.superAdmin == true);
    }

    function isAuthed() {
      return request.auth != null;
    }

    /* Server-enforced account deactivation. accountDeactivate sets a custom claim
       `deactivated:true`; this gates authenticated WRITE actions so a frozen
       account cannot create orders, bookings, listings or messages. FAIL-OPEN:
       only an explicit claim == true blocks — an absent claim (every normal user)
       passes, so this can never lock out active users. Admins are exempt. */
    function isActive() {
      return request.auth != null &&
             (request.auth.token.deactivated != true ||
              request.auth.token.admin == true ||
              request.auth.token.superAdmin == true);
    }

    function isOwner() {
      return isAuthed() && resource.data.uid == request.auth.uid;
    }

    function claimsOwner() {
      return isAuthed() && request.resource.data.uid == request.auth.uid;
    }

    /* True when the caller is a party to the given order — buyer (under any of
       the four id fields orders have accumulated), seller, assigned driver, or
       an admin. Used by the orderEvents trail so the timeline is visible to
       exactly the people the /orders rule already admits, and nobody else. */
    function isOrderParticipant(orderId) {
      return isAdmin() || (
        isAuthed() &&
        exists(/databases/$(database)/documents/orders/$(orderId)) &&
        (
          get(/databases/$(database)/documents/orders/$(orderId)).data.uid               == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId            == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId           == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.buyerUid          == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.sellerUid         == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDriverUid == request.auth.uid
        )
      );
    }

    function uidUnchanged() {
      return !request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasAny(['uid']);
    }

    function _validGPS(lat, lng) {
      return lat is number && lng is number
          && lat >= -5.0  && lat <= 5.0
          && lng >= 33.9  && lng <= 42.0;
    }

    /* Marketplace product ceiling.
       Reads the server-maintained counter — rules have no aggregation, so the
       count and the ceiling are both materialised into productCounters/{uid} by
       functions/product-limit.js, which is the only writer.

       Fails OPEN, deliberately. A missing counter, a missing field, or -1 all
       allow the write. The counter is created by a trigger on the seller's first
       product, so every seller has a window where it does not exist yet, and
       every seller who published before this shipped has none at all. Denying on
       absence would lock those merchants out of their own catalogue to enforce a
       commercial cap — the wrong trade every time. The cap is a billing
       boundary, not a security boundary. */
    function withinProductLimit() {
      let ctr = get(/databases/$(database)/documents/productCounters/$(request.auth.uid));
      return !exists(/databases/$(database)/documents/productCounters/$(request.auth.uid))
             || !('maxProducts' in ctr.data)
             || ctr.data.maxProducts == -1
             || !('count' in ctr.data)
             || ctr.data.count < ctr.data.maxProducts;
    }

    /* PRESENCE vs CHANGE. These guards previously tested the PRESENCE of a
       protected field on request.resource.data — which on a setDoc(merge:true)
       UPDATE is the ENTIRE merged document, not just the changed keys. So any
       user whose document already carried one of these fields (role, verified,
       featured, ageVerified, … all written server-side via the Admin SDK) had
       EVERY self-update denied: the pre-existing field tripped the guard. That is
       what stopped profile edits (and any owner edit of a doc carrying such a
       field) from saving.
       Now create/update-aware: on CREATE (resource == null) presence is correct
       — you may not create a doc bearing these fields. On UPDATE only a CHANGE to
       one is rejected, via diff().affectedKeys() — the same idiom uidUnchanged()
       uses. This cannot open an escalation hole: adding, modifying OR removing any
       protected field still appears in affectedKeys and is still denied; only
       leaving a pre-existing field untouched is now permitted. */
    /* Rating / review AGGREGATES on a review target are server-derived (CHANGELOG 213): the owner of a lawyer,
       driver, rider or provider listing must not be able to write their own rating. */
    function _ratingAggKeys() {
      return ['rating','ratingCount','ratingSum','reviewCount','reviews','avgRating','averageRating',
              'totalReviews','_ratingSum','_ratingCount','ratingDist','riderRating'];
    }
    function noRatingAggOnCreate() { return !request.resource.data.keys().hasAny(_ratingAggKeys()); }
    function noRatingAggOnUpdate() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(_ratingAggKeys()); }

    function noAdminFields() {
      return resource == null
        ? !request.resource.data.keys()
            .hasAny(['isAdmin','suspended','banned','adminApproved',
                     'featured','verified','flagged','adminNote',
                     'role','approved','approvedAt','approvedBy',
                     'commissionRate'])
        : !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isAdmin','suspended','banned','adminApproved',
                     'featured','verified','flagged','adminNote',
                     'role','approved','approvedAt','approvedBy',
                     'commissionRate']);
    }

    /* Beta gate + entitlement fields are SERVER-OWNED on users/{uid}.
       Added 2026-07-19 BEFORE the fields exist. `allow update` lets a user write
       their own document, and these guards are the only value constraints -- so the
       moment betaStatus were introduced without this, any user could set
       betaStatus:"approved" and self-approve into the beta. Same for featureFlags,
       permissions, role and trustScore.

       Zero blast radius today precisely because none of these fields exist yet;
       this closes the hole before it can be opened. Legitimate writers use the
       Admin SDK, which bypasses rules entirely. */
    /* Same PRESENCE-vs-CHANGE fix as noAdminFields (see the note there).
       Age-verification fields are a REGULATORY control written only by
       ageVerifySubmit (age-verification.js) via the Admin SDK after computing the
       age server-side; a client that could set ageVerified:true on its own
       document would defeat the gate. The diff form still blocks any CHANGE to
       these — it only stops a pre-existing ageVerified/role/… from blocking an
       unrelated edit like a name or bio change. */
    function noSelfGrant() {
      return resource == null
        ? !request.resource.data.keys()
            .hasAny(['betaStatus','accessLevel','featureFlags','permissions','role',
                     'trustScore','kycStatus','riskLevel','merchantStatus','providerStatus',
                     'ageVerified','ageVerifiedAt','ageVerifiedMethod'])
        : !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['betaStatus','accessLevel','featureFlags','permissions','role',
                     'trustScore','kycStatus','riskLevel','merchantStatus','providerStatus',
                     'ageVerified','ageVerifiedAt','ageVerifiedMethod']);
    }

    /* users/{uid}.roles is client-writable (sign-up writes ['buyer'], driver onboarding arrayUnions
       'driver'), so it must never be able to ADD a role the server grants on approval. 2026-09-27:
       event-hub trusted roles:['event_organizer'] and any user could self-mint an organizer. The
       server now reads the Auth claim instead; this is the second layer. A value already present
       (written by the Admin SDK on approval) is preserved on unrelated edits. */
    function noServerRoleSelfGrant() {
      return !request.resource.data.keys().hasAny(['roles'])
             || !(request.resource.data.roles is list)
             || !request.resource.data.roles.hasAny(['event_organizer','admin','superAdmin','moderator'])
             || (resource != null && resource.data.get('roles', []) is list
                 && request.resource.data.roles.toSet().intersection(['event_organizer','admin','superAdmin','moderator'].toSet())
                      .difference(resource.data.get('roles', []).toSet()).size() == 0);
    }

    function noPrivilegeEscalation() {
      return noSelfGrant() && noServerRoleSelfGrant()
             && (resource == null
                 ? (!request.resource.data.keys().hasAny(['registeredAs'])
                    || !request.resource.data.registeredAs.keys()
                         .hasAny(['admin','superAdmin','moderator','isAdmin']))
                 /* On update, only re-validate registeredAs when it is actually
                    being changed — a pre-existing registeredAs must not block an
                    unrelated edit. A change to it is still fully validated. */
                 : (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['registeredAs'])
                    || !request.resource.data.registeredAs.keys()
                         .hasAny(['admin','superAdmin','moderator','isAdmin'])));
    }

    /* Same PRESENCE-vs-CHANGE fix as noAdminFields/noSelfGrant (see the note there).
       On a setDoc(merge:true) UPDATE, request.resource.data is the ENTIRE merged
       document, so testing the presence of `provider` tripped on the value ALREADY
       stored. Any user whose stored provider does not match their current token's
       sign_in_provider — after account-linking, a legacy provider value, or signing
       in with a different linked method — had EVERY profile edit silently denied
       (the "edit profile is not saving" report). Now: on UPDATE, only re-validate
       provider when it is actually being CHANGED; a change is still fully checked,
       so this opens no forgery hole — it only stops a pre-existing provider from
       blocking an unrelated edit like a name or bio. */
    function noProviderForgery() {
      let data = request.resource.data;
      let tokenProvider = request.auth.token.firebase.sign_in_provider;

      return (resource != null
              && !data.diff(resource.data).affectedKeys().hasAny(['provider']))
             || !data.keys().hasAny(['provider'])
             || data.provider == tokenProvider
             || (data.provider == 'google'    && tokenProvider == 'google.com')
             || (data.provider == 'apple'     && tokenProvider == 'apple.com')
             || (data.provider == 'microsoft' && tokenProvider == 'microsoft.com')
             || (data.provider == 'facebook'  && tokenProvider == 'facebook.com')
             || (data.provider == 'github'    && tokenProvider == 'github.com')
             || (data.provider == 'phone'     && tokenProvider == 'phone')
             || (data.provider == 'password'  && tokenProvider == 'password')
             || (data.provider == 'oauth'     && tokenProvider != 'password');
    }

    /* Server-side enforcement of the profile-edit rate limit: 3 edits per rolling
       14-day window. Runs ONLY when profileEditCount actually changes, so every
       other write to a user document (lastSeen, fcmToken, roles, a normal profile
       field edit that does not advance the counter) is unaffected — nc == pc is
       the escape hatch. Uses epoch-millis (profileEditWindowStartMs) because rules
       cannot do date math on ISO strings; .get(...,default) keeps it safe on docs
       that predate these fields. The client writes matching values; a client that
       tampers (count > 3 in-window, or resetting the window while it is still
       active) is denied here. */
    function profileEditWithinLimit() {
      let prev = resource.data;
      let next = request.resource.data;
      let pc = prev.get('profileEditCount', 0);
      let nc = next.get('profileEditCount', pc);
      let pw = prev.get('profileEditWindowStartMs', 0);
      let windowActive = request.time.toMillis() < pw + 1209600000; // 14 days
      return nc == pc                                   // counter unchanged → not a rate-limited edit
             || (windowActive && nc == pc + 1 && nc <= 3
                 && next.get('profileEditWindowStartMs', 0) == pw)  // continuing an active window
             || (!windowActive && nc == 1);             // window expired/absent → fresh single edit
    }

    function validPrice(field) {
      return request.resource.data[field] is number
             && request.resource.data[field] > 0;
    }

    /* Payment state is server-owned.

       A client could previously create orders/{anyId} with status "paid" and
       paymentVerified true — claimsOwner() checks only that uid matches, and
       validOrderStatus() whitelists "paid". onNewOrderCreated gates seller
       fulfilment on exactly those two fields, so a buyer could mint a paid
       order and have a merchant ship against it without any payment.

       Clients may now only OPEN an order. Every field that asserts money
       moved, stock moved, or fulfilment may proceed is written exclusively by
       the payment callback via the Admin SDK, which bypasses these rules.

       This is create-only on purpose: the seller and driver update clauses
       below still use validOrderStatus() for their legitimate transitions,
       and are unchanged. */
    function clientOrderInit() {
      return (!request.resource.data.keys().hasAny(['status'])
              || request.resource.data.status in ['pending', 'pending_payment', 'draft'])
             && !request.resource.data.keys().hasAny([
                  'paymentVerified', 'paidAt', 'paidAmount', 'paidPhone', 'mpesaCode',
                  'settlementStatus', 'escrow', 'escrowStatus', 'payoutStatus',
                  'receiptGenerated', 'inventoryApplied', 'fulfilmentStatus'
                ]);
    }

    function validOrderStatus() {
      return !request.resource.data.keys().hasAny(['status'])
             || request.resource.data.status in [
                  'pending','processing','confirmed',
                  'shipped','out_for_delivery','delivered','cancelled','refunded',
                  'completed',
                  'pending_payment','paid','awaiting_confirmation',
                  'rider_assigned','rider_en_route','picked_up','in_transit'
                ];
    }

    match /users/{userId} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == userId);
      allow create: if isAuthed()
                    && request.auth.uid == userId
                    && noAdminFields()
                    && noPrivilegeEscalation()
                    && noProviderForgery();
      allow update: if isAdmin()
                    || (isAuthed() && request.auth.uid == userId
                        && uidUnchanged()
                        && noAdminFields()
                        && noPrivilegeEscalation()
                        && noProviderForgery()
                        && profileEditWithinLimit());
      allow delete: if isAdmin();
    }

    /* Per-user analytics (RBAC) — a user reads only their OWN summary (rider earnings/CLV, buyer
       spend); admins read any. Maintained ONLY by Cloud Functions. */
    match /users/{uid}/analytics/{doc} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write: if false;
    }

    /* ── Applications: the onboarding request for every role ───────────────────
       Providers, riders, businesses, professionals and healthcare facilities all
       submit here, and `applicationLifecycle` projects an approved applicant onto
       the registry that makes them discoverable and dispatchable.

       THIS IS THE ONLY `applications` BLOCK. A second, more permissive one used
       to exist further down this file. Firestore takes the UNION of all matching
       allow rules, so the effective read rule was the looser one — which included
       `resource.data.status == 'open' || 'active'`, granting UNAUTHENTICATED read
       of any application in either state. Every application carries the
       applicant's phone number and a rider's carries their National ID and
       driving-licence number, so a single document set to 'active' would have
       published those to the open internet. Nothing in the codebase writes either
       status to this collection (checked: no writer, and production held only
       'pending' and 'approved'), so the clause bought nothing and risked
       everything. Consolidated here, with no public read.

       Personal data is owner-or-admin only. Approval is an admin act:
       noAdminFields() keeps `approved`/`verified`/`role` out of an applicant's
       own update, so nobody can approve themselves by editing their request. */
    /* The DECISION fields are server-owned. 2026-09-27: status + decidedBy were applicant-writable,
       and the trigger honoured decidedBy whenever it named a real admin (admin uids are public) — a
       forged self-approval. A decision now needs applicationDecisions/{appId} (below, write:false);
       this keeps the applicant from even writing a decisive status. canonStatus() in
       application-lifecycle.js lower-cases, so the check does too. */
    function noApplicationDecision() {
      let decisive = ['approved','active','accepted','verified','rejected','declined','denied',
                      'suspended','revoked','banned','disabled'];
      let decisionKeys = ['decidedBy','decidedAt','decisionAppliedFor','projectionStatus','blockedFor',
                          'statusCanonical','reviewReason','agreementVerifiedAt','agreementVerifiedVersion'];
      let d = request.resource.data;
      return (resource == null
                ? !d.keys().hasAny(decisionKeys)
                : !d.diff(resource.data).affectedKeys().hasAny(decisionKeys))
             && (!d.keys().hasAny(['status'])
                 || (resource != null && !d.diff(resource.data).affectedKeys().hasAny(['status']))
                 || (d.status is string && !(d.status.lower() in decisive)));
    }

    match /applications/{appId} {
      allow create: if claimsOwner() && noAdminFields() && noApplicationDecision();
      allow read:   if isAdmin() || isOwner();
      /* The applicant may amend or withdraw a request that is still theirs
         (e.g. correcting a phone number), but cannot decide it. */
      allow update: if isAdmin() || (isOwner() && claimsOwner() && noAdminFields() && noApplicationDecision()
                                     && classificationFrozenOnceDecided());
      allow delete: if isAdmin() || isOwner();
    }
    /* CHANGELOG 236 — what an application SAYS the business is, is what AdminOS decided on. Once an application is
       decided (approved / active / verified), its applicant can no longer change the fields the category and the
       commercial lane were derived from: editing `hub:'entertainment'` onto an approved application re-priced every
       later booking at 5 % instead of the plan rate (provider-hub). A pending application stays editable. */
    function classificationFrozenOnceDecided() {
      return resource == null
        || !(resource.data.get('status', '') is string && resource.data.get('status', '').lower() in ['approved','active','verified'])
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(
             ['role','type','category','subcategory','categories','performerType','hub','hubType','businessType',
              'businessCategory','categoryId','profession','professionalType','categoryLabel']);
    }

    /* applicationDecide's server-only decision record — the trigger and the reconcile path grant a
       role ONLY when this names the same status and decider as the application. */
    match /applicationDecisions/{appId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* ENTERTAINMENT BOOKING IDENTITY (functions/entertainment-bookings.js) — server-written only.
       The envelope: its two parties and admins read it. The raw booking PIN: its BUYER only (the
       provider verifies through entBookingVerifyPin and never sees it). References, attempt counters and
       the audit trail: admins only. */
    match /entBookings/{envId} {
      allow read:  if isAdmin()
                   || (isAuthed() && (resource.data.buyerUid == request.auth.uid || resource.data.providerUid == request.auth.uid));
      allow write: if false;
    }
    match /entBookingSecrets/{envId} {
      allow read:  if isAuthed() && resource.data.buyerUid == request.auth.uid;
      allow write: if false;
    }
    match /entBookingRefs/{ref} {
      allow read, write: if false;
    }
    match /entBookingPinAttempts/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /entBookingAudit/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    /* VENUE PAYMENTS (functions/venue-payments.js) — server-written only. The venue owner reads their own
       settlement; the buyer and the owner read the refund request on their booking; exceptions are admin. */
    match /venueSettlements/{ref} {
      allow read:  if isAdmin() || (isAuthed() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }
    match /venueRefundRequests/{bookingId} {
      allow read:  if isAdmin() || (isAuthed() && (resource.data.requestedBy == request.auth.uid));
      allow write: if false;
    }
    match /venueExceptions/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* Provider reputation (functions/reputation.js) — server-only. */
    match /shareHandles/{handle} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /shareEvents/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /reputationAudit/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* ── Entertainment availability authority (functions/ent-availability.js, 2026-09-27) ──────────
       Occupancy (bookings, holds, the provider's PRIVATE blocks and their labels) is server-only:
       no client reads another provider's schedule or writes availability — not even the owner,
       whose changes go through audited callables. The public doc is a COUNTER a storefront listens
       to (bounded: one calendar + one month); it carries no slot, reason, booking or buyer. */
    match /entAvailability/{calKey} {
      allow read:  if isAdmin();
      allow write: if false;
      match /months/{month} {
        allow read:  if isAdmin();
        allow write: if false;
      }
    }
    match /entAvailabilityPublic/{id} {
      allow read:  if true;
      allow write: if false;
    }
    match /entAvailabilityAudit/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    /* Rate cards — versioned prices (functions/ent-rate-cards.js). The storefront reads them through
       entRateCardsPublic, which applies visibility (PUBLIC / ENQUIRY_ONLY / BOOKING_ONLY / PRIVATE)
       and eligibility; the documents themselves are the owner's and AdminOS's only. */
    match /entRateCards/{cardId} {
      allow read:  if isAdmin() || (isAuthed() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
      match /versions/{v} {
        allow read:  if isAdmin() || (isAuthed() && get(/databases/$(database)/documents/entRateCards/$(cardId)).data.ownerUid == request.auth.uid);
        allow write: if false;
      }
    }
    match /entRateCardEligibility/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /entRateCardAudit/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /entQuotes/{quoteId} {
      allow read:  if isAdmin() || (isAuthed() && (resource.data.ownerUid == request.auth.uid || resource.data.buyerUid == request.auth.uid));
      allow write: if false;
    }
    match /mktCouponRedemptions/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    /* Messaging controls, public enquiries, call requests (functions/ent-enquiries.js). Every state
       move is the server's; a client reads only what it is party to. */
    match /entMessagingSettings/{uid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write: if false;
    }
    match /entEnquiries/{id} {
      allow read:  if isAdmin() || (isAuthed() && (resource.data.providerUid == request.auth.uid || resource.data.buyerUid == request.auth.uid));
      allow write: if false;
    }
    match /entEnquiryLimits/{id} {
      allow read, write: if false;
    }
    match /entEnquiryDedup/{id} {
      allow read, write: if false;
    }
    match /entBlocks/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /entCallRequests/{id} {
      allow read:  if isAdmin() || (isAuthed() && (resource.data.requesterUid == request.auth.uid || resource.data.recipientUid == request.auth.uid));
      allow write: if false;
    }
    match /entCommsAudit/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* Administrator invitations. Written EXCLUSIVELY by the inviteUser /
       resendInvitation / reconcileInvitations Cloud Functions via the Admin SDK,
       which bypasses these rules — so every client-side write is denied outright.
       A client that could create an invitation could grant itself a role, and a
       client that could edit one could mark itself accepted. Admins read the
       dashboard through listInvitations, not by querying this collection. */
    /* ── POS / TILL COMMISSION AND THE BUSINESS WALLET ────────────────────────
       Four collections that decide what a merchant owes and hold the float that
       pays it. Every one is CLIENT-UNWRITABLE without exception.

       A merchant who could write these could clear their own liability, credit
       their own wallet, or forge the settlement receipt that proves a payment
       arrived. Reads are owner-scoped so a merchant can see their own position
       in the POS app; nobody can see anyone else's.

       The Cloud Functions that own these paths use the Admin SDK, which bypasses
       rules entirely — so denying every client write here costs the platform
       nothing and removes the entire class of forgery. */

    /* What a merchant owes, one row per non-custodial POS/Till sale. */
    match /posCommissionLiabilities/{saleId} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.merchantUid == request.auth.uid);
      allow create: if false;
      allow update: if false;   /* clearing your own debt is exactly the attack */
      allow delete: if false;
    }

    /* Proof that a settlement actually happened. Forging one of these would mark
       a liability paid for money that never arrived. */
    match /posCommissionSettlements/{settlementRef} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.merchantUid == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /* The BUSINESS wallet — separate from wallets/{uid}, which is personal.
       Balance is in MINOR units here and in shillings there; they are different
       collections precisely so the two can never be confused. */
    match /businessWallets/{shopId} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.ownerUid == request.auth.uid);
      allow create: if false;
      allow update: if false;   /* a writable balance is not a balance */
      allow delete: if false;
    }

    /* Every movement of that wallet, keyed by its idempotency reference. */
    match /businessWalletEntries/{ref} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.ownerUid == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /invitations/{inviteId} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /providers/{providerId} {
      allow read:   if resource.data.status == 'active' || resource.data.status == 'approved'
                    || isAuthed();
      /* `status` is NOT covered by noAdminFields(), so until this clause any
         signed-in user could create providers/{their-uid} with
         status:'active' and appear immediately as a live provider in global
         search, on providers.html and in the homepage strip — self-publishing
         straight past the application review that onboarding-professional.html
         and services.html both submit. That was latent while `providers` was
         empty and unread; it became reachable the moment the registry started
         serving the directory.

         A client may only create a record in the pending state. Promotion to
         'active' or 'approved' is an admin action (see the update rule below,
         which already blocks status changes by the owner). */
      allow create: if isActive() && isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields()
                    && (!request.resource.data.keys().hasAny(['status'])
                        || request.resource.data.status == 'pending')
                    /* 2026-09-27: reputation is server-derived (functions/reputation.js) */
                    && !request.resource.data.keys().hasAny(['rating','reviewCount','ratingSum','ratingDist','followerCount','shareCount','shareHandle','repV','followV','reputationUpdatedAt','jobsCompleted'])
                    /* CHANGELOG 227 — server-set identity attributes: the healthcare category (application-lifecycle /
                       AdminOS) and the Legal authority's link (legal-verification.js). A provider setting
                       provisionedBy:'legal-verification' on their own record defeated the Legal identity-conflict guard. */
                    && !request.resource.data.keys().hasAny(['healthcare','legalProviderId','provisionedBy','legalVerification',
                                                             /* CHANGELOG 236 — the ONE canonical business category + commercial lane */
                                                             'business']);
      /* CHANGELOG 236: `business` (category + commercial lane) is server-written ONLY — not by the provider, and not
         by an admin's raw client write either: reclassification is the audited AdminOS callable (bizAdminClassify). */
      allow update: if (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['business']))
                    || (isAuthed()
                        && resource.data.uid == request.auth.uid
                        && uidUnchanged()
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['status', 'verified', 'suspended', 'approved',
                                      /* 2026-09-27: an owner could set their own public rating, review count and
                                         jobs completed (shown on the profile and used by search). Server-derived. */
                                      'rating','reviewCount','ratingSum','ratingDist','followerCount','shareCount','shareHandle','repV','followV','reputationUpdatedAt', 'jobsCompleted',
                                      /* CHANGELOG 227 — server-set: healthcare category, Legal authority link */
                                      'healthcare','legalProviderId','provisionedBy','legalVerification',
                                      /* CHANGELOG 236 — canonical business category + commercial lane */
                                      'business']));
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {

      /* Client create is for a booking REQUEST only. The authoritative price,
         payment state, commission and confirmed status are set by the server
         (bookingCreate / bookingCreateService via Admin SDK, which bypass rules).
         A client may not self-declare them — status must be absent or 'pending',
         and the financial/settlement fields are forbidden. This closes the
         manipulation vector (a client writing status:'confirmed' / paymentStatus:
         'paid' / a fake price) while still letting the request-creation UIs work.
         Service bookings go through `providerBookings` (write:false → CF-only). */
      allow create: if isActive() && isAuthed()
                    && (request.resource.data.customerId == request.auth.uid
                        || request.resource.data.buyerId  == request.auth.uid
                        || request.resource.data.userId   == request.auth.uid)
                    && noAdminFields()
                    && (!('status' in request.resource.data)
                        || request.resource.data.status == 'pending')
                    && !request.resource.data.keys().hasAny([
                         'price','pricingBreakdown','paymentStatus','paymentId',
                         'verifiedPaymentId','commission','commissionRate','net',
                         'amountPaid','settlement','settled',
                         /* 2026-09-27: a venue booking (a reservation of a venue's time) is made only by
                            bookingCreate through the availability authority — a client-written one could
                            block a venue's slots or open a booking conversation with its owner. */
                         'venueId','ownerId','startTs','endTs','availability','slotKey']);
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid          == request.auth.uid)
                    || (isAuthed() && resource.data.buyerId      == request.auth.uid)
                    || (isAuthed() && resource.data.userId       == request.auth.uid)
                    || (isAuthed() && resource.data.providerId   == request.auth.uid)
                    || (isAuthed() && resource.data.customerId   == request.auth.uid)
                    || (isAuthed() && resource.data.ownerId      == request.auth.uid);
      /* 2026-09-27 (Entertainment convergence): either party could write ANY status directly —
         the owner could mark a booking active / checked-in (skipping the buyer's booking PIN) or
         completed; the customer could move the date. Lifecycle moves are the callables' (bookingApprove
         / bookingCheckIn / bookingCheckOut / bookingReschedule / bookingCancel — Admin SDK). A client may
         now only: the customer cancels their own booking; the owner / provider edits their note. */
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.customerId == request.auth.uid
                        && !('venueId' in resource.data)          /* a venue booking cancels through bookingCancel / a refund */
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','cancelReason','cancellationReason','cancelledAt','cancelledBy','updatedAt']))
                    || (isAuthed() && (resource.data.ownerId == request.auth.uid || resource.data.providerId == request.auth.uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['providerNote','updatedAt']));
      allow delete: if isAdmin();
    }
    match /venues/{venueId} {

      allow read:   if resource.data.status == 'active' || isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid);
      /* 2026-09-27: an owner could write ANY field — status (un-suspend themselves), rating,
         reviewCount, verified/featured. Venues are created by venueCreate (server); a direct client
         create may not arrive already active or carrying moderation / reputation fields, and an
         owner's edit may not touch them. Suspension is an AdminOS decision (entAdminVenueSetStatus). */
      allow create: if isAuthed()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.get('status', 'pending') == 'pending'
                    && noAdminFields()
                    && !request.resource.data.keys().hasAny(['rating','reviewCount','suspendedBy','suspendReason',
                         'ratingSum','ratingDist','followerCount','shareCount','shareHandle','repV','followV','reputationUpdatedAt']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == request.auth.uid
                        && noAdminFields()
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['status','rating','reviewCount','suspendedBy','suspendReason',
                                      'ratingSum','ratingDist','followerCount','shareCount','shareHandle','repV','followV','reputationUpdatedAt']));
      allow delete: if isAdmin();
    }
    match /venueBlockouts/{blockId} {
      /* 2026-09-27: legacy store. Blocks now live in the availability authority (bookingBlockSlots).
         Any signed-in user could read every venue's block reasons and notes; now the owner / admin only,
         and no new client-written block (it would not be seen by the authority anyway). */
      allow read:   if isAdmin() || (isAuthed() && resource.data.createdBy == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.createdBy == request.auth.uid);
    }
    match /bookingHolds/{holdId} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      /* 2026-09-27: a client could create a hold with ANY expiry and block any venue's time. Holds are
         server-only (waitlist offers); a reservation is the unpaid booking itself. */
      allow create: if false;
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid || isAdmin();
    }

    match /rides/{rideId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid         == request.auth.uid)
                    || (isAuthed() && resource.data.passengerId == request.auth.uid)
                    || (isAuthed() && resource.data.driverId    == request.auth.uid);

      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','cancelReason','updatedAt']))
                    || (isAuthed() && resource.data.driverId == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','driverNote','updatedAt','acceptedAt',
                                       'arrivedAt','startedAt','completedAt','driverLocation']));
      allow delete: if isAdmin();
    }

    match /driverLocations/{driverId} {
      /* GPS privacy: scoped to the driver themselves, passengers in an active ride
         (the dispatch CF populates `viewers` when a ride is assigned), and admins.
         Until `viewers` is written, only the driver and admins can read. */
      allow read:   if isAdmin()
                    || (isAuthed() && request.auth.uid == driverId)
                    || (isAuthed() && resource.data.viewers is list
                        && request.auth.uid in resource.data.viewers);
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.uid         == request.auth.uid
                        && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || isOwner();
    }

    match /packages/{pkgId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.senderId == request.auth.uid)
                    || (isAuthed() && resource.data.driverId == request.auth.uid);
      allow update: if isAdmin()
                    || ((isAuthed() && resource.data.driverId == request.auth.uid
                         || isOwner())
                        && uidUnchanged());
      allow delete: if isAdmin();
    }

    /* Workspace memberships — a person's employment records.

       There was no rule at all, so the collection defaulted to deny. That is
       safe but it silently broke the workforce client: sokoni-workspace.js
       subscribes to this collection to build the business switcher, and its
       onSnapshot error handler only console.warn'd, so the failure surfaced as
       an empty workspace list rather than an error.

       A member may read ONLY documents that name them. The client query
       already filters on uid, so it is satisfiable; a query without that
       filter is rejected rather than silently truncated, which is what stops
       anyone enumerating another organisation's staff.

       No client write of any kind. Membership, role and permissions are set by
       workforce-identity's Cloud Functions through the Admin SDK, which
       bypasses these rules. Allowing a client write here would let a member
       grant themselves capabilities — the escalation this collection exists to
       prevent. */
    /* ══ FINANCIAL RECORDS ══════════════════════════════════════════════════
       Written exclusively by the financial engine through the Admin SDK, which
       bypasses these rules. Nothing here is client-writable: an invoice a
       customer can edit is not an invoice, and a journal a client can post to
       is not a ledger.

       These collections were created without rules, which meant default-deny
       and a customer portal that could never read its own invoices — the same
       defect diagnosed in workspaceMemberships earlier the same day. Reads are
       therefore granted narrowly rather than left absent.

       The split is deliberate: customer-facing documents are readable by the
       person they belong to; internal accounting is admin-only. A buyer has a
       right to their own receipt and no business reading the double-entry
       book. */

    /* Tax invoices — the customer's own document. */
    match /financialDocuments/{ref} {
      allow read:   if isAuthed() && (resource.data.uid == request.auth.uid
                                   || resource.data.sellerUid == request.auth.uid
                                   || isAdmin());
      allow create, update, delete: if false;
    }

    /* Receipts — same audience as the invoice they settle. */
    match /financialReceipts/{ref} {
      allow read:   if isAuthed() && (resource.data.uid == request.auth.uid
                                   || resource.data.sellerUid == request.auth.uid
                                   || isAdmin());
      allow create, update, delete: if false;
    }

    /* Double-entry journal — internal accounting. Exposing debit/credit legs
       would leak platform revenue and commission structure to any buyer. */
    match /financialJournal/{entryId} {
      allow read:   if isAdmin();
      allow create, update, delete: if false;
    }

    /* Tax ledger — the rows a KRA return is built from. Finance only. */
    match /taxLedger/{ref} {
      allow read:   if isAdmin();
      allow create, update, delete: if false;
    }

    /* Payment timeline — a customer may see where their own payment reached;
       support and finance may see any. Diagnostic, never authoritative. */
    match /paymentTimeline/{ref} {
      allow read:   if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    /* Payment intents — the commercial authority record. A client that could
       write one could name its own price, which is the exact vulnerability the
       intent model closed. Read-own only, so a page can confirm what it is
       about to be charged. */
    match /paymentIntents/{ref} {
      allow read:   if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    /* SOKONI Till identity (Q2/Q4/Q5) — immutable once issued; status is the
       ONLY mutable field, transitioned only by setSokoniTillStatus. Issuance
       and status transitions run transactionally server-side (mintSokoniTill/
       setSokoniTillStatus, functions/sokoni-till.js) — a client that could
       write one could mint an unlimited number of Tills or reactivate a
       retired one, which is exactly the identity-authority gap this
       collection exists to close. Buyers never read this directly; QR
       resolution goes through resolveSokoniQR, which uses the Admin SDK. */
    match /sokoniTills/{sokoniTillId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantUid == request.auth.uid);
      allow write: if false;
    }

    /* Per-shop Till-issuance sequence counter — not information a client
       needs (mirrors the /_counters/{counterId} rationale immediately
       below: exposing it reveals how many Tills a shop has issued). */
    match /shopTillCounters/{shopId} {
      allow read, write: if false;
    }

    /* Reconciliation queue — payments whose paperwork failed. Operational. */
    match /financialEngineFailures/{ref} {
      allow read:   if isAdmin();
      allow create, update, delete: if false;
    }

    /* Sequential document counters. Readable by nobody: the next invoice
       number is not information a client needs, and exposing it reveals
       transaction volume. */
    match /_counters/{counterId} {
      allow read, create, update, delete: if false;
    }

    match /workspaceMemberships/{membershipId} {
      allow read:   if isAuthed() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      allow create: if isActive() && claimsOwner()
                    && validOrderStatus()
                    && clientOrderInit();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid              == request.auth.uid)
                    || (isAuthed() && resource.data.userId           == request.auth.uid)
                    || (isAuthed() && resource.data.buyerId          == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid         == request.auth.uid)
                    || (isAuthed() && resource.data.sellerUid        == request.auth.uid)
                    || (isAuthed() && resource.data.assignedDriverUid == request.auth.uid);
      allow update: if isAdmin()

                    || ((isAuthed() && (resource.data.uid == request.auth.uid
                                       || resource.data.buyerUid == request.auth.uid))
                        && uidUnchanged()
                        && request.resource.data.status in ['cancelled']
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','cancelReason','updatedAt','review']))

                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && uidUnchanged() && validOrderStatus()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','sellerNote','readyAt','trackingNo','updatedAt']))

                    /* The assigned rider drives the delivery FORWARD, but cannot declare it
                       finished. `delivered` is what onOrderStatusChange pays them for, so a
                       client write of that status was the rider authorising their own payout —
                       and the PIN "check" was a comparison in the rider's own browser against
                       a plaintext value their client had already fetched.
                       Completion now goes through completeDeliveryWithPin (server-verifies the
                       buyer's PIN against the keyed HMAC) or buyerConfirmDelivery (the buyer
                       acting as themselves). Both use the Admin SDK, which bypasses these
                       rules, so closing the client door here does not close theirs.
                       En-route statuses stay client-writable: they move the tracking screen and
                       pay nobody. */
                    || (isAuthed() && resource.data.assignedDriverUid == request.auth.uid
                        && uidUnchanged() && validOrderStatus()
                        && !(request.resource.data.status in ['delivered','completed'])
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','driverNote','updatedAt','pickedUpAt','etaMin']));
      allow delete: if isAdmin();
      match /events/{eventId} {

        allow create: if isAdmin()
                      || (isAuthed()
                          && (
                               get(/databases/$(database)/documents/orders/$(orderId)).data.uid              == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.buyerUid         == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.sellerUid        == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDriverUid == request.auth.uid
                          ));
        allow read:   if isAdmin()
                      || (isAuthed()
                          && get(/databases/$(database)/documents/orders/$(orderId))
                               .data.keys().hasAny(['uid','buyerUid','sellerUid','assignedDriverUid'])
                          && (
                               get(/databases/$(database)/documents/orders/$(orderId)).data.uid              == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.buyerUid         == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.sellerUid        == request.auth.uid
                            || get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDriverUid == request.auth.uid
                          ));
        allow update, delete: if false;
      }
    }

    /* Booking resolution engine (Slice 2). Both are written ONLY by Cloud Functions
       (Admin SDK bypasses rules); clients may READ their own participant rows. */
    match /bookingEvents/{eventId} {
      // immutable, append-only canonical event log; participants + admin read
      allow read:                 if isAdmin()
                                  || (isAuthed() && (resource.data.providerId == request.auth.uid
                                                  || resource.data.customerUid == request.auth.uid));
      allow create, update, delete: if false;   // server-only (Admin SDK)
    }
    match /affectedBookings/{bookingId} {
      allow read:  if isAdmin()
                   || (isAuthed() && (resource.data.providerId == request.auth.uid
                                   || resource.data.customerUid == request.auth.uid));
      allow write: if false;                     // server-only (Admin SDK)
    }

    match /fcm_tokens/{tokenId} {
      allow write: if isAuthed()
                   && request.auth.token.email != null
                   && request.resource.data.email == request.auth.token.email;
      allow read:  if isAdmin();
    }

    match /auditLogs/{logId} {
      allow create:         if isAuthed()
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.keys().hasAll(['uid','action','ts']);
      allow read:           if isModerator();
      allow update, delete: if false;
    }

    /* Durable consent audit trail (Must-fix #2). A user may only APPEND their own consent event;
       records are immutable (no update/delete) so historical consent is preserved and auditable. */
    match /consentRecords/{recId} {
      allow create:         if isAuthed()
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.keys().hasAll(['uid','policyVersion','source']);
      allow read:           if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }

    match /notifications/{notifId} {

      allow create: if isAdmin()
                    || (isAuthed()
                        && request.resource.data.targetUid == request.auth.uid
                        && request.resource.data.targetUid != 'broadcast'
                        && request.resource.data.keys().hasAll(['targetUid','heading','sub'])
                        && request.resource.data.type in [
                             'order','delivery','ride','general',
                             'booking','message','review','inventory_low',
                             'payment_reminder','support_reply'
                           ]);
      allow read:   if isAdmin()
                    || (isAuthed() && (
                         resource.data.targetUid == request.auth.uid
                      || resource.data.targetUid == 'broadcast'
                    ));

      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.targetUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['read', 'archived', 'pinned']));

      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.targetUid == request.auth.uid);
    }

    match /userNotifPrefs/{userId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }

    match /escrow/{orderId} {
      allow read:   if isAdmin();
      allow create, update, delete: if false;
    }
    match /referrals/{refId} {
      allow create: if isAuthed() && claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.referrerUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // CONSOLIDATED: Duplicate match /reviews/{reviewId} merged here (was duplicated near line 3119).
    // Moderation gate enforced: only 'approved' reviews are publicly readable.
    // Authors and admins may read their own unapproved reviews.
    match /reviews/{reviewId} {
      allow read:   if resource.data.status == "approved"
                    || (request.auth != null && (request.auth.uid == resource.data.authorUid || isAdmin()));
      /* 2026-09-27: a client could create a review with status 'approved', any target and any rating (and
         later edit it) — published and counted in ratingsSummary with no eligibility. submitReview (Admin SDK)
         is the only writer. */
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /etims_submissions/{docId} {
      allow create:               if claimsOwner();
      allow read, update, delete: if isAdmin();
    }

    /* CHANGELOG 220 — the public legal directory card is PROJECTED by the Legal Verification
       Authority (functions/legal-verification.js) and exists only while an advocate is admin-approved
       AND LSK-verified. A client could create one for itself before (a self-published "lawyer" that
       site search listed), so client create/update is closed. */
    match /lawyers/{docId} {
      allow read:   if true;
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /legalAppointments/{apptId} {
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','area','type','date','time','status'])
                    && request.resource.data.uid    == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status'])
                        && request.resource.data.status == 'cancelled')
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status'])
                        && request.resource.data.status in ['confirmed','declined','completed']);
      allow delete: if isAdmin();
    }

    match /legalServiceRequests/{reqId} {
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','category','type','status'])
                    && request.resource.data.uid    == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status'])
                        && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    match /legalReviews/{reviewId} {
      allow read:   if true;

      /* CLIENT MAY NOT DECIDE who wrote a review, who it is about, whether the experience happened, the
         aggregate, verification or moderation (CHANGELOG 213). No client writer is legitimate here: the hub's
         server authority (or none yet) owns it. */
      allow create: if false;   /* ratings: rateLegalProvider (a completed consultation of the caller's) */
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /foodOrders/{orderId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.buyerUid     == request.auth.uid)
                    || (isAuthed() && resource.data.restaurantId == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['id','restaurantId','restaurantName','phone','items','total','status','buyerUid'])
                    && request.resource.data.status   == 'placed'
                    && request.resource.data.total     > 0;
      allow update: if isAdmin()
                    || (isAuthed() && (resource.data.restaurantId == request.auth.uid
                        || resource.data.buyerUid == request.auth.uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','riderName','riderPhone','riderRating','updatedAt','statusHistory']));
      allow delete: if isAdmin();
    }

    match /foodMenus/{restaurantId} {
      allow read:   if true;
      allow write:  if isAdmin() || (isAuthed() && request.auth.uid == restaurantId);
    }

    match /legalBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.clientUid == request.auth.uid)
                    || (isAuthed() && resource.data.lawyerId  == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['ref','lawyerId','lawyerName','clientName','phone','matter','status','hub'])
                    && request.resource.data.clientUid == request.auth.uid
                    && request.resource.data.status in ['sent','confirmed']
                    && request.resource.data.hub == 'legal';
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.lawyerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
      allow delete: if isAdmin();
    }

    match /mechanics/{docId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    match /etims_config/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /userSync/{uid}/{subcol}/{docId} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write:  if isAuthed() && request.auth.uid == uid;
      allow delete: if isAuthed() && request.auth.uid == uid;
    }

    /* Server-maintained marketplace product counter.
       Rules cannot aggregate, so the count AND the ceiling are materialised into
       one document by functions/product-limit.js and read here with a single
       get(). Writes are denied to everyone: a seller must not be able to raise
       their own limit or reset their own count. Absent document = no limit yet
       resolved, which allows the write — a counter that has not been created must
       never block a merchant from publishing. */
    match /productCounters/{sellerUid} {
      allow read:  if isAuthed() && (sellerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* Reject base64 data: URIs in product image fields. Products are written
       client-direct, so this rule is the server-side backstop that stops a base64
       image from ever landing in a product doc — the 2026-07-24 "PEACH MANGO ICE"
       incident, where a 195KB data: URI in `image`/`imageUrl` bloated the record
       past Algolia's 10KB limit and poisoned every batch it shipped in, stalling
       search indexing for all products. Rules cannot iterate the `images` array,
       so the client strips array entries; this covers the single-string fields,
       which is where that incident's payload lived. .matches() is whole-string, so
       a real https:// Storage URL passes and only a data: URI is rejected. Uses
       .get(field,'') so an update that does not touch the field is never blocked. */
    function noBase64Image() {
      let d = request.resource.data;
      return !(d.get('image', '') is string        && d.get('image', '').matches('data:.*'))
          && !(d.get('imageUrl', '') is string     && d.get('imageUrl', '').matches('data:.*'))
          && !(d.get('thumbnailUrl', '') is string && d.get('thumbnailUrl', '').matches('data:.*'));
    }

    match /products/{productId} {
      allow read:   if true;
      allow create: if isActive() && isAuthed()
                    && request.resource.data.sellerUid == request.auth.uid
                    && validPrice('price')
                    && noAdminFields()
                    && noBase64Image()
                    && withinProductLimit();
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.sellerUid == request.auth.uid
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['sellerUid'])
                        && noAdminFields()
                        && noBase64Image());
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
    }

    match /listings/{listingId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.ownerId == request.auth.uid
                    && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.ownerId == request.auth.uid
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['ownerId'])
                        && noAdminFields());
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid);
    }

    match /conversations/{convId} {
      function isParticipant() {
        return isAuthed() && request.auth.uid in resource.data.participants;
      }
      allow read: if isParticipant();

      allow update: if isParticipant()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['lastMessage','lastMessageAt','lastSenderId','unread']);
      /* CHANGELOG 230 — conversations are created ONLY by the server: createConversation (parties
         DERIVED from the transaction — the B931 participant authority, ported) and
         ensureAnchoredConversation (server-anchored bookings / enquiries). The client create this
         rule used to allow let any signed-in user seat any uid beside themselves in any conversation
         id outside the ent_* space; the one client writer (product.js) then failed its message write,
         leaving an orphan conversation behind. */
      allow create: if false;
      allow delete: if isAdmin();
      match /messages/{msgId} {
        function inConvo() {
          return isAuthed()
            && get(/databases/$(database)/documents/conversations/$(convId))
                 .data.participants.hasAny([request.auth.uid]);
        }
          /* HISTORY BOUNDARY. A rider added to an order conversation must not
             receive the earlier buyer/seller history. addRiderToConversation
             records participantJoinedAt[uid]; anyone carrying that stamp reads
             only messages from their join instant onward. Original participants
             have no stamp, so `in` is false for them and their access is
             unchanged — this can only narrow a later joiner, never an existing
             party. */
          function joinedAtMap() {
            return get(/databases/$(database)/documents/conversations/$(convId))
                     .data.get('participantJoinedAt', {});
          }
          allow read: if inConvo()
                      && (!(request.auth.uid in joinedAtMap())
                          || resource.data.timestamp >= joinedAtMap()[request.auth.uid]);
        // MSG-1: creates go through the sendMessage CF (admin SDK, bypasses rules).
        // Direct client creates are blocked to prevent senderId/senderName spoofing.
        allow create: if false;
        // Sender may soft-edit or soft-delete their own messages (limited fields only).
        allow update: if isAdmin()
                      || (isAuthed()
                          && resource.data.senderId == request.auth.uid
                          && request.resource.data.senderId == resource.data.senderId
                          && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['deleted','deletedAt','text','edited','editedAt','storageRef']));
        allow delete: if isAdmin();
      }
    }

    match /teams/{teamId} {
      allow read:   if true;

      allow create: if isAuthed() && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid);
    }

    match /tournaments/{tourneyId} {
      allow read:   if true;
      allow create: if claimsOwner();
      allow update: if isAdmin() || (isOwner() && uidUnchanged());
      allow delete: if isAdmin();
    }

    match /sportsPlayers/{playerId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }

    match /sportsCoaches/{coachId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    match /sportsVenues/{venueId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }

    match /sportsVenueBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['venueId','date','slots','name','phone','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sportsCoachBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['coachId','name','phone','date','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sportsTournamentRegs/{regId} {
      allow read:   if request.auth != null; // PII guard (B-17): phone/captain data requires authentication
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['tournamentId','teamName','captain','phone','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /sportsReviews/{reviewId} {
      /* CLIENT MAY NOT DECIDE who wrote a review, who it is about, whether the experience happened, the
         aggregate, verification or moderation (CHANGELOG 213). No client writer is legitimate here: the hub's
         server authority (or none yet) owns it. */
      allow read:   if true;
      allow create: if false;   /* no sports booking authority exists yet to make a review eligible */
      allow delete: if isAdmin();
    }

    match /sportsPosts/{postId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['type','author','sport','content','uid','ts'])
                    && request.resource.data.content.size() <= 3000;
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['content','likes','comments','updatedAt']));
      allow delete: if isAdmin() || isOwner();
    }

    match /sportsOrders/{orderId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(
                         ['itemId','qty','total','phone','uid','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /fitness_bookings/{bookingId} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(['type','provider','ref','uid','status','ts'])
                    && request.resource.data.status == 'confirmed';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /fitness_progress/{userId} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == userId);
      allow create: if isAuthed() && request.auth.uid == userId;
      allow update: if isAuthed() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /fitness_gyms/{gymId} {
      allow read:   if true;
      allow create: if isAuthed() && request.auth.uid == gymId && noAdminFields();
      allow update: if isAuthed() && request.auth.uid == gymId && uidUnchanged() && noAdminFields();
      allow delete: if isAdmin();
    }

    match /fitness_classes/{classId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['name','type','instructor','phone','uid','ts']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['name','loc','time','fee','slots','desc','type','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_clubs/{clubId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['name','type','uid','ts']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['name','desc','meet','members','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_community_posts/{postId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['uid','ts'])
                    && (request.resource.data.text == null || request.resource.data.text.size() <= 2000);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['text','likes','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_equipment/{itemId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['uid','ts']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['price','desc','sold','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_requests/{requestId} {
      allow read:   if request.auth != null; // PII guard (B-17): contact/phone data requires authentication
      allow create: if claimsOwner()
                    && noAdminFields()
                    && request.resource.data.keys().hasAll(['text','uid','ts'])
                    && request.resource.data.text.size() <= 1000;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['text','phone','updatedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_challenges/{entryId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAuthed() && resource.data.uid == request.auth.uid && uidUnchanged();
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /fitness_checkins/{checkinId} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.gymUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.gymUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['memberName','gymUid','ts']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // REMOVED (B-17 fix): duplicate match /digitalProducts/{productId} — this block permitted
    // client-side create/update/delete, bypassing the CF-only intent enforced below.
    // Firestore OR-merges duplicate match blocks, so the client create here silently defeated
    // the `allow write: if false` guard in the Digital Products Hub section.
    // Canonical authoritative block is in the Digital Products Hub section below.

    // REMOVED (B-17 fix): duplicate match /digitalPurchases/{purchaseId} — this block permitted
    // client-side creates (pending/processing status), allowing clients to fabricate purchase
    // records and potentially claim entitlements without completing payment.
    // All purchase record creation/updates must go through Admin SDK (Cloud Functions).
    // Canonical authoritative block is in the Digital Products Hub section below.

    match /bnbListings/{listingId} {
      allow read:   if true;
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(['id','name','type','location','price','phone','hostUid'])
                    && request.resource.data.hostUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.hostUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name','type','location','price','pricePerNight','desc','description','amenities','phone','image','images','video','available','maxGuests','bedrooms','bathrooms','updatedAt']));
      allow delete: if isAdmin() || (isAuthed() && resource.data.hostUid == request.auth.uid);
    }

    match /bnbBookings/{bookingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid    == request.auth.uid)
                    || (isAuthed() && resource.data.hostUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['bnbId','uid','name','phone','checkIn','checkOut','nights','total','status'])
                    /* CHANGELOG 215: this REQUIRED a client 'confirmed' — a guest confirmed their own unpaid stay. A client
                       may at most REQUEST; confirmation, payment and commission fields are the server's. */
                    && request.resource.data.status == 'requested'
                    && !request.resource.data.keys().hasAny(['paymentRef','paymentStatus','paidAt','mpesaCode','confirmedAt','commission']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.hostUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
      allow delete: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow create: if claimsOwner()
                    && request.resource.data.keys().hasAll(['orderId','reason','status'])
                    && request.resource.data.status == 'open';
      allow read:   if isModerator()
                    || (isAuthed() && resource.data.uid      == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid == request.auth.uid)
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);

      allow update: if isModerator()
                    || (isAuthed()
                        && (resource.data.uid      == request.auth.uid
                         || resource.data.buyerUid == request.auth.uid)
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['evidence','refundRequested',
                             'refundAmount','refundReason','refundRequestedAt'])
                        && uidUnchanged());
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow create: if isAuthed()
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.keys().hasAll(['message','senderUid','sentAt'])
                      && request.resource.data.message.size() <= 2000
                      && (
                           get(/databases/$(database)/documents/disputes/$(disputeId)).data.uid       == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.buyerUid  == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.sellerUid == request.auth.uid
                        || isModerator()
                      );
        allow read:   if isModerator()
                      || (isAuthed() && (
                           get(/databases/$(database)/documents/disputes/$(disputeId)).data.uid       == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.buyerUid  == request.auth.uid
                        || get(/databases/$(database)/documents/disputes/$(disputeId)).data.sellerUid == request.auth.uid
                      ));
        allow update, delete: if false;
      }
    }

    match /fraudAlerts/{alertId} {
      allow create: if isAuthed()
                    && request.resource.data.flaggedBy == request.auth.uid
                    && request.resource.data.keys().hasAll(['targetId','reason','flaggedBy']);
      allow read:   if isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    match /onboardingCompleted/{docId} {
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['role','uid','completedAt']);
      allow read:   if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* Wizard progress checkpoint — one doc per UID, written by saveOnboardingProgress CF.
       The collection previously had no rule and defaulted to DENY ALL, which would cause
       the progress-save to silently fail (non-fatal in the wizard, but prevents resume). */
    match /onboardingProgress/{uid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write: if false; /* CF only — saveOnboardingProgress uses Admin SDK */
    }

    match /offers/{offerId} {
      allow read:   if true;
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['productId','offerPrice','originalPrice','active','createdBy'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.offerPrice < request.resource.data.originalPrice;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ── SELLER STORIES ────────────────────────────────────────────────────
       Ephemeral seller posts rendered in the homepage ring. Public to read,
       writable only by the authenticated owner.

       THE 24-HOUR LIFETIME IS ENFORCED HERE, not only in the client query.
       expiresAt is a client-supplied epoch-ms number, so without this ceiling a
       seller could publish a permanent story simply by sending a larger value —
       the homepage filter would happily keep showing it. 60s of slack absorbs
       clock skew between the device and the server.

       uid is immutable across updates, so a story document can never change
       hands; re-promoting the same product overwrites only the owner's own. */
    match /stories/{storyId} {
      allow read:   if true;

      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.postedAt  is number
                    && request.resource.data.expiresAt is number
                    && request.resource.data.expiresAt >  request.time.toMillis()
                    && request.resource.data.expiresAt <= request.time.toMillis() + 86460000;

      allow update: if isAuthed()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.expiresAt is number
                    && request.resource.data.expiresAt >  request.time.toMillis()
                    && request.resource.data.expiresAt <= request.time.toMillis() + 86460000;

      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }
    match /withdrawals/{withdrawalId} {
      allow create: if isAuthed()
                    && request.resource.data.uid    == request.auth.uid
                    && request.resource.data.amount is  number
                    && request.resource.data.amount >   0
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['authorUid','content'])
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.content.size() <= 5000;

      allow update: if isAuthed()
                    && (
                         (resource.data.authorUid == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['content','title','edited','editedAt','tags','images']))
                      || (request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['likes','helpful','replies','reactions','reactionCount','views'])
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes'])
                              || (request.resource.data.likes is number
                                  && request.resource.data.likes >= resource.data.likes - 1
                                  && request.resource.data.likes <= resource.data.likes + 1))
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['helpful'])
                              || (request.resource.data.helpful is number
                                  && request.resource.data.helpful >= resource.data.helpful - 1
                                  && request.resource.data.helpful <= resource.data.helpful + 1))
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['views'])
                              || (request.resource.data.views is number
                                  && request.resource.data.views == resource.data.views + 1))
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionCount'])
                              || (request.resource.data.reactionCount is number
                                  && request.resource.data.reactionCount >= resource.data.reactionCount - 1
                                  && request.resource.data.reactionCount <= resource.data.reactionCount + 1))
                         )
                    );
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.authorUid == request.auth.uid);
    }
    match /communityGroups/{groupId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (isAuthed() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() || (isAuthed() && resource.data.createdBy == request.auth.uid);
    }
    match /userProgress/{uid}/{subcol}/{docId} {
      allow read, write: if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }
    /* UID is the canonical session identity; email is optional metadata.
       Previously every operation required request.auth.token.email != null, so a
       phone-authenticated account could not create, read or revoke a session at
       all — the rule enforced an identity model that excluded a supported
       provider. It also compared the raw token email against a value the client
       lowercases, so a mixed-case address was denied on create.

       ownsByEmail() is a MIGRATION affordance for documents written before uid
       existed. New writes must carry uid == request.auth.uid, so legacy documents
       drain as users return and this branch can then be removed.

       .get(field, default) is used deliberately: legacy documents have no uid and
       new phone-account documents have no userEmail, and a bare resource.data.uid
       on a missing field errors and denies. */
    match /userSessions/{sessionId} {
      function ownsByUid() {
        return isAuthed() && resource.data.get('uid', '') == request.auth.uid;
      }
      function ownsByEmail() {
        return isAuthed()
               && request.auth.token.email != null
               && resource.data.get('userEmail', '') == request.auth.token.email.lower();
      }

      /* Canonical: a session may only ever be created for the caller's own uid. */
      allow create: if isAuthed()
                    && request.resource.data.get('uid', '') == request.auth.uid;

      allow read:   if isAdmin() || ownsByUid() || ownsByEmail();
      allow update: if isAdmin() || ownsByUid() || ownsByEmail();
      allow delete: if isAdmin() || ownsByUid() || ownsByEmail();
    }

    match /bookingFees/{feeId} {

      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','amount','type'])
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /broadcast_notifications/{notifId} {
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin()
                  || (isAuthed() && (
                       resource.data.targetUid == request.auth.uid
                    || resource.data.targetUid == 'broadcast'
                  ));
    }

    match /deleted_products/{productId} {
      allow create, update: if isAdmin();
      allow read, delete:   if isAdmin();
    }

    match /unboxingReviews/{reviewId} {
      /* A community photo review: the author writes the words; the SERVER decides "Verified Buy"
         (reviews.js verifyUnboxingReview → orderVerified), likes and moderation (CHANGELOG 213). */
      allow read:   if true;
      allow create: if claimsOwner()
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && !request.resource.data.keys().hasAny(['verified','orderVerified','orderVerifiedAt','likes','status','approved','featured']);
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged()
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['verified','orderVerified','orderVerifiedAt','likes','rating','orderId','status','approved','featured']));
      allow delete: if isAdmin() || isOwner();
    }

    match /shopEmployees/{empUid} {
      allow read:   if isAdmin()
                    || request.auth.uid == empUid
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
      allow create: if isAdmin()
                    || (isAuthed() && request.resource.data.shopOwnerId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
    }

    /* ── shops/{uid} — the canonical storefront document ──
       Had NO rule block, so every read was denied by default: store.html could
       not load a shop's name, logo, banner or policies, product.html could not
       show which shop sells an item, and the wallet could not resolve a seller's
       shop. The document is created server-side (automation-engine.js writes
       shops/{userId} when a seller application is approved) and read by buyers,
       so: public read, server-only create, and an owner update restricted to
       presentation fields.

       `status` is deliberately NOT in the owner's allowlist — it is the approval
       flag the CF sets, and letting a seller write it would be self-approval.
       noAdminFields() does not cover `status`, so the allowlist does. */
    match /shops/{uid} {
      allow read:   if true;
      allow create: if isAdmin();          // Cloud Functions / admin only
      allow update: if isAdmin()
                    || (isAuthed()
                        && request.auth.uid == uid
                        && uidUnchanged()
                        && noAdminFields()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name','storeName','tagline','bio','about','description',
                                       'logo','logoUrl','banner','bannerUrl','themeColor',
                                       'phone','email','website','address','city','mapsLink',
                                       'instagram','tiktok','facebook','twitter','youtube','linkedin',
                                       'hours','openingHours','returnPolicy','returnText',
                                       'packagingNote','delMethod','delTime','zones','updatedAt']));
      allow delete: if isAdmin();

      /* Canonical per-shop analytics — maintained ONLY by Cloud Functions (analytics-aggregator).
         The shop owner + admins may read their own numbers; clients never write. */
      match /analytics/{doc} {
        allow read:  if isAdmin() || (isAuthed() && request.auth.uid == uid);
        allow write: if false;
      }

      /* Regulatory identifiers — KRA PIN, single business permit, BRS number.
         Shop Setup collects these, and the legacy save wrote them into
         `sellers/{uid}`, which is `allow read: if true` — so every seller's tax
         identifier was readable by anyone who asked. They are NOT storefront
         copy and must never sit on a world-readable document, so they live here
         instead: written only by saveShopProfile (Admin SDK, after it has proved
         ownership) and readable only by the owner and admins. */
      match /private/{doc} {
        allow read:  if isAdmin() || (isAuthed() && request.auth.uid == uid);
        allow write: if false;
      }
    }

    /* Canonical platform-wide analytics (analytics/global, analytics/daily_*) — the ONE source
       every admin/finance dashboard reads. Admin-read only; written only by Cloud Functions. */
    match /analytics/{doc} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* Dimensional analytics (RBAC) — platform-wide product/category stats + the cutover
       parity log are admin-only; written only by Cloud Functions. */
    match /productAnalytics/{productId}  { allow read: if isAdmin(); allow write: if false; }
    match /categoryAnalytics/{categoryId}{ allow read: if isAdmin(); allow write: if false; }
    match /analyticsParityLog/{entryId}  { allow read: if isAdmin(); allow write: if false; }

    /* ── orderEvents/{orderId}/events — the sale's audit trail / timeline ──
       Had no rule block, so `sokoni-orders.js::listenOrderEvents` and the
       matching helper in sokoni-db.js were denied for everyone: the order
       tracking timeline a buyer sees after paying was always empty, and every
       _writeEvent() call during checkout failed silently.

       Visibility follows the parent order — the same participants the
       /orders rule admits. The get() costs one document read per query, which
       is the price of not duplicating participant ids onto every event. */
    match /orderEvents/{orderId} {
      allow read:  if isOrderParticipant(orderId);
      allow write: if false;               // the trail lives in /events below

      match /events/{eventId} {
        allow read:   if isOrderParticipant(orderId);
        /* Append-only: a participant may add an event, nobody may rewrite one. */
        allow create: if isOrderParticipant(orderId) && noAdminFields();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    /* ── entRequests — entertainment booking / enquiry requests ──
       Client-created in entertainment-hub.js. No rule meant every submission
       failed, so the hub's request form could never produce a request. */
    match /entRequests/{requestId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ── ratings — public seller/product rating rows, read by product.js ──
       No rule block meant the rating summary on a product page was always
       denied. Writes stay server-side: a rating a buyer can write directly is a
       rating a buyer can forge. */
    match /ratings/{ratingId} {
      allow read:  if true;
      allow write: if false;               // CF-only
    }

    match /sellers/{uid} {
      allow read:   if true;
      allow create: if isAuthed() && request.auth.uid == uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && request.auth.uid == uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();

      // Click-and-collect orders placed by buyers, managed by the seller at POS
      match /clickAndCollect/{orderId} {
        // Seller sees all their C&C orders; buyer sees only their own
        allow read: if isAuthed()
                    && (request.auth.uid == uid
                        || resource.data.customerId == request.auth.uid
                        || isAdmin());
        allow create: if isAuthed()
                      && request.resource.data.customerId == request.auth.uid
                      && request.resource.data.keys().hasAll(['customerId','items','total','status'])
                      && request.resource.data.total is number
                      && request.resource.data.total > 0
                      && request.resource.data.status == 'pending';
        // Only seller / admin updates status (ready, collected, cancelled)
        allow update: if isAuthed() && (request.auth.uid == uid || isAdmin());
        allow delete: if false;
      }
    }

    match /sellerBroadcasts/{sellerName}/broadcasts/{broadcastId} {
      /* RETIRED (CHANGELOG 212): the path key was a caller-chosen display name, so any signed-in user could
         broadcast AS any shop. Shop announcements are miniShopSendAnnouncement (server, owner-verified).
         Legacy documents stay for audit — admin only; nobody writes. */
      allow read:   if isAdmin();
      allow create: if false;
      allow delete: if isAdmin();
    }

    /* ── Landlord properties ───────────────────────────────────────────────────
       Three levels: a building, its units, and a financial ledger per unit.

       This replaces landlordData/{uid}.properties[] — an array that held units,
       which held rentHistory[] and waterBills[]. Recording one tenant's rent
       rewrote the entire building, ledger entries could not be queried, indexed
       or audited individually, and the document grew by two entries per unit per
       month forever. Measured 2026-08-02: 0 documents existed, so the correct
       shape was built once rather than migrated to later.

       ownerUid is DENORMALISED onto units and ledger entries deliberately. The
       alternative is get(parent) inside the rule, which costs a document read on
       every single access and counts against the rules read limit. A copied uid
       is cheaper and cannot drift, because nothing may change it: it is absent
       from every hasOnly() list below. */
    match /landlordProperties/{propertyId} {
      allow read:   if true;                    /* public directory, as bnbListings */
      allow create: if isAuthed()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['ownerUid','name','status','createdAt'])
                    /* A landlord may not publish themselves. Moderation is the
                       platform's, so a new building starts pending and only an
                       admin can move it. */
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name','address','city','phone','description',
                                       'images','image','updatedAt']));
      allow delete: if isAdmin() || (isAuthed() && resource.data.ownerUid == request.auth.uid);

      /* Units are not public. A building is advertised; who lives in it is not. */
      match /units/{unitId} {
        allow read:   if isAdmin()
                      || (isAuthed() && resource.data.ownerUid  == request.auth.uid)
                      || (isAuthed() && resource.data.tenantUid == request.auth.uid);
        allow create: if isAuthed()
                      && request.resource.data.ownerUid == request.auth.uid
                      && request.resource.data.keys().hasAll(['ownerUid','number','createdAt']);
        allow update: if isAdmin()
                      || (isAuthed() && resource.data.ownerUid == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['number','type','monthlyRent','deposit','tenantUid',
                                         'tenantName','tenantPhone','leaseStart','leaseEnd',
                                         'occupancyStatus','updatedAt']));
        allow delete: if isAdmin() || (isAuthed() && resource.data.ownerUid == request.auth.uid);

        /* Ledger entries are financial records. They may be created and settled,
           and their amount and period may be corrected while still pending — but
           a PAID entry is closed to the landlord. Reversing money is an
           adjustment or refund entry of its own, never an edit to history, which
           is the whole reason these left the array. */
        match /ledger/{entryId} {
          allow read:   if isAdmin()
                        || (isAuthed() && resource.data.ownerUid  == request.auth.uid)
                        || (isAuthed() && resource.data.tenantUid == request.auth.uid);
          allow create: if isAuthed()
                        && request.resource.data.ownerUid == request.auth.uid
                        && request.resource.data.keys().hasAll(['ownerUid','type','period','amount','status','createdAt'])
                        && request.resource.data.type in ['rent','water','deposit','refund','adjustment','penalty','discount']
                        && request.resource.data.amount is number
                        && request.resource.data.status in ['pending','paid','overdue','refunded'];
          allow update: if isAdmin()
                        || (isAuthed() && resource.data.ownerUid == request.auth.uid
                            && resource.data.status != 'paid'
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['status','paidAt','reference','amount','period','updatedAt']));
          /* Deleting a settled financial record is not a landlord's to do. */
          allow delete: if isAdmin();
        }
      }
    }

    /* SUPERSEDED by landlordProperties above. Left in place, read-only for its
       owner and admins, so any device still holding a legacy mirror can be
       inspected. It has no reader in the codebase and nothing writes it after
       landlord.html moved to the new collection. */
    match /landlordData/{uid} {
      allow read, write: if isAuthed() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    match /follows/{followId} {
      allow read:   if isAdmin() || (isAuthed() && followId.matches(request.auth.uid + '--.*'));
      /* 2026-09-27: a PROVIDER / VENUE / CREATOR follow is written only by the reputation authority (a
         transactional follower count). Other hubs' follows are unchanged. */
      allow create: if isAuthed() && followId.matches(request.auth.uid + '--.*')
                    && !followId.matches('.*--(provider|venue|creator|shop)--.*');
      allow delete: if isAdmin() || (isAuthed() && followId.matches(request.auth.uid + '--.*')
                    && !followId.matches('.*--(provider|venue|creator|shop)--.*'));
    }

    match /driverRatings/{ratingId} {
      /* CLIENT MAY NOT DECIDE who wrote a review, who it is about, whether the experience happened, the
         aggregate, verification or moderation (CHANGELOG 213). No client writer is legitimate here: the hub's
         server authority (or none yet) owns it. */
      allow create: if false;   /* rider ratings are csatRatings (bound to a delivery) */
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.driverId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /rideDrivers/{driverId} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && noAdminFields() && noRatingAggOnCreate()
                    && _validGPS(request.resource.data.lat, request.resource.data.lng);
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.uid         == request.auth.uid
                        && request.resource.data.uid == request.auth.uid
                        && noAdminFields() && noRatingAggOnUpdate()
                        && (!request.resource.data.keys().hasAny(['lat','lng'])
                            || _validGPS(request.resource.data.lat, request.resource.data.lng)));
      allow delete: if isAdmin();
    }

    match /rideRequests/{reqId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid              == request.auth.uid)
                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid);

      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','cancelReason','updatedAt']))
                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','assignedDriverId','driverNote',
                                                      'updatedAt','acceptedAt','arrivedAt',
                                                      'startedAt','completedAt','driverLocation']));
      allow delete: if isAdmin();
    }

    match /packageRequests/{pkgId} {
      allow create: if claimsOwner();
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid              == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid         == request.auth.uid)
                    || (isAuthed() && resource.data.sellerUid        == request.auth.uid)
                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid);
      allow update: if isAdmin()

                    || (isOwner() && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','cancelReason','confirmedAt',
                                                      'buyerConfirmedAt','sellerPayoutReady',
                                                      'timeline','_lastTimelineEntry','updatedAt']))

                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','sellerNote','readyAt',
                                                      'timeline','_lastTimelineEntry','updatedAt']))

                    || (isAuthed() && resource.data.assignedDriverId == request.auth.uid
                        && uidUnchanged()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','driverNote','updatedAt',
                                                      'pickedUpAt','deliveredAt','arrivedAtSellerAt',
                                                      'acceptedAt','etaMin','payoutDue','proofNote',
                                                      'driverLat','driverLng','driverSpeed',
                                                      'driverLocUpdatedAt',
                                                      'timeline','_lastTimelineEntry'])
                        && (!request.resource.data.keys().hasAny(['driverLat','driverLng'])
                            || _validGPS(request.resource.data.driverLat, request.resource.data.driverLng)));
      allow delete: if isAdmin();
    }

    // Legacy Entertainment (EntHub) — RETIRED from the client 2026-09-27 (readiness sweep).
    // The Entertainment Hub now routes to the canonical owners: events → event-hub (events/*),
    // artists & services → the provider marketplace (services.html), venues → the venue booking
    // engine (venues/*), films → Creator Hub. These collections were still public-read (artists'
    // and venue owners' PHONE and EMAIL, pending / suspended records, unapproved reviews),
    // client-writable with self-set status, prices and payment refs, and fed a performer deposit
    // that credited the PAYER's own wallet. What remains: the record's owner and administrators can
    // read it (data rights + AdminOS moderation through entAdmin*, which runs on the Admin SDK);
    // nothing new is written from a browser.
    match /entArtists/{artistId} {
      allow read:   if isAdmin() || isOwner();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || isOwner();
    }
    match /entEvents/{eventId} {
      allow read:   if isAdmin() || isOwner();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || isOwner();
    }
    match /entTickets/{ticketId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /entVenues/{venueId} {
      allow read:   if isAdmin() || isOwner();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || isOwner();
    }
    match /entVenueBookings/{bookId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid)
                    || (isAuthed() && resource.data.venueOwnerUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /entArtistBookings/{bookId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid)
                    || (isAuthed() && resource.data.artistUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /entReviews/{reviewId} {
      allow read:   if isAdmin() || isOwner();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || isOwner();
    }
    match /entContent/{contentId} {
      allow read:   if isAdmin() || isOwner();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || isOwner();
    }

    match /deliveries/{deliveryId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.senderUid   == request.auth.uid)
                   || (isAuthed() && resource.data.assignedRiderId == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.senderUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.senderUid   == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['senderUid','deliveryFee','proofPIN']))
                    /* driverLat/driverLng/driverLocUpdatedAt let the assigned rider
                       publish their live position onto the delivery record itself.
                       deliveryLocations is rider/admin-only, so this mirror is the
                       sender's ONLY readable source for the live tracking map. Read
                       access is unchanged — still sender, rider, or admin. */
                    || (isAuthed() && resource.data.assignedRiderId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status','timeline','updatedAt','assignedRiderId',
                                      'riderName','riderPhone','riderAt','pickedUpAt',
                                      'deliveredAt','etaMin',
                                      'driverLat','driverLng','driverLocUpdatedAt'])
                        && (!request.resource.data.keys().hasAny(['driverLat','driverLng'])
                            || _validGPS(request.resource.data.driverLat, request.resource.data.driverLng)));
      allow delete: if isAdmin();
    }

    match /deliveryRiders/{riderId} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.auth.uid == riderId
                    && !request.resource.data.keys().hasAny(['approved','verified','suspended','banned'])
                    && noRatingAggOnCreate();
      allow update: if isAdmin()
                    || (isAuthed() && request.auth.uid == riderId
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['approved','verified','suspended','banned'])
                        && noRatingAggOnUpdate());
      allow delete: if isAdmin();
    }

    match /deliveryLocations/{riderId} {
      /* GPS privacy: scoped to the rider themselves, assigned delivery participants
         (buyers/sellers whose order has this rider), and admins. The `viewers` array
         is written by the dispatch CF when a rider is assigned to a delivery. Until
         that array is present on a doc, only the rider and admins can read it. */
      allow read:   if isAdmin()
                    || (isAuthed() && request.auth.uid == riderId)
                    || (isAuthed() && resource.data.viewers is list
                        && request.auth.uid in resource.data.viewers);
      allow write:  if isAdmin()
                    || (isAuthed() && request.auth.uid == riderId);
    }

    match /deliveryProofs/{proofId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.riderId    == request.auth.uid)
                   || (isAuthed() && resource.data.senderUid  == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.riderId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /shopSettings/{sellerUid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
      allow write: if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
    }

    /* SmartPOS 2.0 — Multi-device sessions */
    match /posSessions/{sessionId} {
      /* Seller always has full read access; other session members via memberUids array.
         Guard the in-array check: if memberUids field is absent, `uid in resource.data.memberUids`
         throws a rules evaluation error (treated as DENY). The `in` key-existence guard
         makes it a clean false instead. */
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerId == request.auth.uid)
                    || (isAuthed() && 'memberUids' in resource.data && request.auth.uid in resource.data.memberUids);
      /* Only Cloud Functions (Admin SDK) write session state */
      allow write:  if false;
    }

    match /posPayments/{checkoutId} {
      allow read:  if isAdmin()
                   || (isAuthed() && (resource.data.sellerUid == request.auth.uid || resource.data.sellerId == request.auth.uid))
                   || (isAuthed() && (resource.data.callerUid == request.auth.uid || resource.data.buyerId == request.auth.uid));
      allow write: if false;
    }

    match /posQrLog/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /sellerPayments/{paymentId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid  == request.auth.uid)
                   || (isAuthed() && resource.data.callerUid  == request.auth.uid);
      /* SEC-F1: financial record — Cloud Functions only (Admin SDK bypasses rules).
         Previously `if isAdmin()`, which let a compromised/mis-scoped admin token
         mutate payment records straight from a client. 0 client files write this. */
      allow write: if false;
    }

    match /revenueConfig/{configId} {
      allow read:  if isAdmin()
                   || (isAuthed() && configId == ("seller_" + request.auth.uid))
                   || (isAuthed() && configId == "global")
                   || (isAuthed() && configId.matches("hub_.*"));
      allow write: if isAdmin();
    }

    match /subscriptionPlans/{planId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /sellerSubscriptions/{sellerUid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
      allow write: if isAdmin();
    }

    /* Merchant payment destinations (Till / PayBill).
       CLIENT WRITES ARE DENIED OUTRIGHT — this is the whole security model.
       A merchant who could write this document could set status:'VERIFIED' on
       any number and have STK push route live customer money to it with no test
       ever performed. Every field is written by savePaymentDestination /
       confirmVerified / markFailed through the Admin SDK, which bypasses these
       rules. Read is owner-or-admin: a Till is not secret, but the verification
       state and history are not public either — note `shops` is world-readable,
       which is exactly why this does not live there. */
    match /paymentDestinations/{sellerUid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
      allow write: if false;
    }

    /* Commission restriction state — what the premium gate reads.
       Server-computed ONLY. If a client could write this, a restricted merchant
       could clear their own restriction and keep trading with an unpaid
       balance, which is the single thing the gate exists to prevent. */
    match /sellerRestrictions/{sellerUid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
      allow write: if false;
    }

    match /commissionLedger/{entryId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      /* SEC-F1: IMMUTABLE financial ledger — Cloud Functions only (Admin SDK bypasses
         rules). Previously `if isAdmin()`, which allowed ledger tampering from a client
         with an admin token, defeating the audit trail. 0 client files write this. */
      allow write: if false;
    }

    match /featuredListings/{featureId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid)
                   || resource.data.status == "active";
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sokoAds/{adId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /adImpressions/{impId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    /* Featured Shops (P4) — server-authoritative shop spotlight.
       This collection holds ONLY a secrets-free display projection written by
       adminSetFeaturedShop; the sensitive source (shopSettings, users) stays
       locked down. Public read is allowed ONLY while a shop is actively featured
       and not expired — so an anonymous homepage sees exactly the live spotlight
       and nothing dormant. featuredUntil == null means indefinite. Admin-only
       write; the CF uses the admin SDK, this rule guards direct client writes. */
    match /featuredShops/{merchantUid} {
      allow read:  if isAdmin()
                   || (isAuthed() && merchantUid == request.auth.uid)
                   || (resource.data.featuredOnHome == true
                       && (resource.data.featuredUntil == null
                           || resource.data.featuredUntil > request.time));
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /sellerBilling/{sellerUid}/monthly/{period} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);
      allow write: if isAdmin();
    }

    match /deliveryFees/{feeId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
    match /communityEvents/{eventId} {
      allow read: if true;
      allow create: if isAuthed()
                    && request.resource.data.organizerUid == request.auth.uid
                    && noAdminFields();
      allow update: if isAdmin() || (isAuthed() && resource.data.organizerUid == request.auth.uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    match /communityRecommendations/{recId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.askerUid == request.auth.uid;

      allow update: if isAdmin()
                    || (isAuthed() && resource.data.askerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['content','title','tags','edited','editedAt']));
      allow delete: if isAdmin();
    }
    match /communityRecResponses/{respId} {
      allow read: if true;
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['responderUid','content'])
                    && request.resource.data.responderUid == request.auth.uid;
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.responderUid == request.auth.uid);
    }
    match /communityReports/{reportId} {

      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','targetId','reason'])
                    && request.resource.data.uid == request.auth.uid;
      allow read, update: if isModerator();
      allow delete: if isAdmin();
    }

    match /leadFees/{leadId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /b2bFees/{feeId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /users/{uid}/loyalty/{docId} {
      allow read: if isAdmin() || (isAuthed() && request.auth.uid == uid);

      allow write: if isAdmin()
                   || (isAuthed()
                       && request.auth.uid == uid
                       && resource != null
                       && request.resource.data.total <= resource.data.total);
    }

    match /verifications/{sellerUid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == sellerUid);

      allow create: if isAuthed()
                    && request.auth.uid == sellerUid
                    && request.resource.data.status == 'pending'
                    && !request.resource.data.keys().hasAny(['verifiedAt','approvedBy']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /homeServiceBookings/{bookingId} {

      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['uid','name','phone','service'])
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /homeServiceProviders/{provId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields() && noRatingAggOnCreate();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && uidUnchanged() && noAdminFields() && noRatingAggOnUpdate());
      allow delete: if isAdmin();
    }

    match /homeServiceReviews/{revId} {
      /* CLIENT MAY NOT DECIDE who wrote a review, who it is about, whether the experience happened, the
         aggregate, verification or moderation (CHANGELOG 213). No client writer is legitimate here: the hub's
         server authority (or none yet) owns it. */
      allow read:   if true;
      allow create: if false;   /* no home-services booking authority exists yet to make a review eligible */
      allow update, delete: if isAdmin();
    }

    match /homeServiceLeads/{leadId} {
      allow read:   if isAdmin();
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['phone','service','uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /techITRequests/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /techStartups/{docId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    match /techJobs/{docId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    match /techLeads/{docId} {
      allow read:   if isAdmin();
      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['name','phone']);
      allow update, delete: if isAdmin();
    }

    match /wallets/{walletUid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == walletUid);

      allow create: if isAuthed() && request.auth.uid == walletUid
                    && request.resource.data.balance == 0;

      allow update: if isAdmin(); // Wallet mutations via Admin SDK (Cloud Functions) only
      allow delete: if isAdmin();
    }

    match /notificationPrefs/{prefUid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == prefUid);
      allow create: if isAuthed() && request.auth.uid == prefUid
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthed() && request.auth.uid == prefUid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']);
      allow delete: if isAdmin();
    }

    match /walletTxns/{txId} {
      allow read:             if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin(); // All writes via Admin SDK (Cloud Functions) only
    }

    match /escrows/{escrowId} {
      /* Gate 1A 2026-07-19 — entitlement. Granted create on IDENTITY alone: any authed
           user could write an escrow naming themselves buyer with any sellerNetCents,
           straight from the browser, bypassing every CF. No layer verified the amount.
           CF-only now; finosCreateEscrow uses the Admin SDK and is unaffected.
           Behaviour-neutral: all client refs are .get() reads. */
        allow create: if false;
      allow read:   if isAdmin()
                    || (isAuthed() && (resource.data.buyerUid  == request.auth.uid
                                    || resource.data.sellerUid == request.auth.uid));
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.buyerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['status','updatedAt'])
                        && request.resource.data.status in ['disputed','cancelled'])
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['status','updatedAt'])
                        && request.resource.data.status in ['shipped','delivered']);
      allow delete: if isAdmin();
    }

    match /businesses/{bizId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();

      match /pos_transactions/{txId} {
        allow read:   if isAdmin()
                      || (isAuthed() && request.auth.uid == bizId)
                      || (isAuthed() && resource.data.sellerUid == request.auth.uid);
        allow create: if isAuthed()
                      && request.auth.uid == bizId
                      && request.resource.data.sellerUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /terminals/{terminalId} {
        allow read:            if isAdmin() || (isAuthed() && request.auth.uid == bizId);
        allow create, update:  if isAuthed() && request.auth.uid == bizId;
        allow delete:          if isAdmin() || (isAuthed() && request.auth.uid == bizId);
      }

      match /terminal_queue/{queueId} {
        allow read:   if isAdmin() || (isAuthed() && request.auth.uid == bizId);
        allow create: if isAuthed() && request.auth.uid == bizId;
        allow update, delete: if isAdmin();
      }
    }

    match /bizViews/{bizId} {
      allow read:   if true;

      allow create: if isAuthed()
                    && request.resource.data.keys().hasOnly(['viewCount','lastViewAt'])
                    && request.resource.data.viewCount == 1;
      allow update: if isAuthed()
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['viewCount','lastViewAt'])
                    && request.resource.data.viewCount == resource.data.viewCount + 1;
      allow delete: if isAdmin();
    }

    match /businessTeam/{memberId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.ownerUid == request.auth.uid && uidUnchanged()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.ownerUid == request.auth.uid);
    }

    match /verificationRequests/{reqId} {
      allow create: if isAuthed()
                    && request.resource.data.applicantUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.applicantUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /adminLog/{logId} {
      allow create: if isAdmin();
      allow read:   if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /platformMetrics/{metricId} {
      allow read:  if isModerator();
      allow write: if isAdmin();
    }

    match /roleGrants/{grantId} {
      allow read:           if isAdmin();
      allow create:         if isAdmin();
      allow update, delete: if false;
    }

    match /flags/{flagId} {
      allow create: if isAuthed()
                    && request.resource.data.reporterUid == request.auth.uid;
      allow read:   if isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }
    match /propertyInquiries/{docId} {

      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['phone','propertyId','uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /propertyViewings/{docId} {

      allow create: if isAuthed()
                    && request.resource.data.keys().hasAll(['propertyId','date','time','uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /platformInvites/{token} {
      allow get:    if true;
      allow list:   if isAdmin();
    }

    match /platformEmployees/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /shopInvites/{token} {
      allow get:    if true;
      allow list:   if isAdmin()
                    || (isAuthed() && resource.data.shopOwnerId == request.auth.uid);
    }

    /* payments rules are defined exclusively in the Unified Payment Orchestrator block below (CF-only writes) */

    match /subscriptions/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);

    }

    match /vouchers/{code} {

      allow read:   if isAuthed();

      allow create, update, delete: if isAdmin();
    }

    match /voucherRedemptions/{redemptionId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /clientMetrics/{docId} {
      allow read:  if isAdmin();
    }

    match /trending/{hub} {
      allow read:  if true;
    }

    match /mailQueue/{docId} {
      allow read:  if isAdmin();
    }

    match /emailBounces/{email} {
      allow read:   if isAdmin();
      allow delete: if isAdmin();
    }

    match /emailAnalytics/{docId} {
      allow read:  if isAdmin();
    }

    match /emailEvents/{eventId} {
      allow read:  if isAdmin();
    }

    match /notificationHistory/{docId} {
      allow read:  if isAdmin()
                   || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    match /dmarcReports/{reportId} {
      allow read:  if isAdmin();
    }

    match /dmarcReports/{reportId}/records/{ipId} {
      allow read:  if isAdmin();
    }

    match /dmarcAlerts/{alertId} {
      allow read:  if isAdmin();
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(["resolved", "resolvedAt", "resolvedBy"]);
    }

    match /jobs/{jobId} {
      allow read:  if resource.data.active == true || isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.company is string
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 5000
                    && request.resource.data.contactEmail is string
                    && !('applicants' in request.resource.data)
                       || request.resource.data.applicants == 0;
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == resource.data.uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['applicants','featured','plan','uid']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /jobApplications/{appId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['jobId','uid','name','email','phone','coverLetter','appliedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.coverLetter.size() <= 3000
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /education/{docId} {
      allow read:   if resource.data.active == true || isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.category is string
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 3000
                    && !('featured' in request.resource.data)
                    && !('active'   in request.resource.data)
                    && !('verified' in request.resource.data);
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.uid == request.auth.uid
                        && resource.data.uid == request.resource.data.uid
                        && !('featured' in request.resource.data)
                        && !('verified' in request.resource.data)
                        && !('active'   in request.resource.data));
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    function isPosOwner() {
      return isAuthed() && resource.data.sellerId == request.auth.uid;
    }
    function claimsPosOwner() {
      return isAuthed() && request.resource.data.sellerId == request.auth.uid;
    }

    match /posTransactions/{txnId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.status in ['completed', 'failed', 'pending']
                    && !('adminNote' in request.resource.data);
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isAdmin(); 
    }

    match /posProducts/{productId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0;
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isPosOwner() || isAdmin();
      allow delete: if isPosOwner() || isAdmin();
    }

    match /posStockMovements/{moveId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.productId is string
                    && request.resource.data.qty is number;
      allow read:   if isPosOwner() || isAdmin();
    }

    match /posShifts/{shiftId} {
      allow create: if claimsPosOwner();
      allow read:   if isPosOwner() || isAdmin();
      /* Only non-financial fields can be updated from a client — financial aggregates
         (totalSales, cashSales, status, closingCash) are written by Cloud Functions
         via Admin SDK and are therefore not covered by these rules. */
      allow update: if (isPosOwner() || isAdmin())
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['notes', 'updatedAt']);
      allow delete: if isAdmin();
    }

    /* posRetailSales — all writes via Cloud Functions (Admin SDK bypasses rules).
       Explicit deny prevents accidental exposure if a wildcard rule is added later. */
    match /posRetailSales/{saleId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerId == request.auth.uid)
                   || (isAuthed() && resource.data.merchantId == request.auth.uid)   /* seller reads own sales (mirror + CF write merchantId) */
                   || (isAuthed() && resource.data.cashierUid == request.auth.uid);
      allow write: if false; /* CF Admin SDK only */
    }

    /* posCashDrawerEvents — all writes via Cloud Functions. */
    match /posCashDrawerEvents/{eventId} {
      allow read:  if isPosOwner() || isAdmin();
      allow write: if false; /* CF Admin SDK only */
    }

    match /posCustomers/{customerId} {
      allow create: if claimsPosOwner();
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isPosOwner() || isAdmin();
      allow delete: if isAdmin();
    }

    /* SmartPOS 2.1 — Sale records */
    match /posSales/{saleId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerId == request.auth.uid)
                   || (isAuthed() && resource.data.cashierUid == request.auth.uid);
      allow write: if false; /* CF only */
    }

    /* Digital receipts — public verify, CF write */
    /* PII, 2026-07-19. This was `allow read: if true`, justified as a "public
       verification endpoint". That endpoint does not exist: /receipt/{id} returns
       404, there is no receipt.html, and no client anywhere reads this collection.
       The rule granted nothing and exposed everything.

       Receipt documents carry customer.name, customer.phone, buyerId, sellerId and
       full line items (payment-success.js), and the ids are guessable —
       receiptId == paymentId == the client-supplied payment ref, which has no
       format validation. Anyone could enumerate customer names and phone numbers.

       Reads now go through the getReceipt Cloud Function, which already strips PII
       (pos-retail-engine.js:449). Admin SDK bypasses rules, so server writes and
       CF reads are unaffected. If a public verification page is built later, it
       must call that CF — not read this collection directly. */
    match /receipts/{receiptId} {
      allow read:  if false;
      allow write: if false;
    }

    /* POS audit trail — manager+ read, CF write */
    match /posAuditLog/{logId} {
      allow read:  if isAdmin()
                   || (isAuthed() && (request.auth.token.posRole == 'manager'
                       || request.auth.token.posRole == 'owner'));
      allow write: if false;
    }

    /* Inventory transfers */
    match /inventoryTransfers/{transferId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerId == request.auth.uid);
      allow write: if false;
    }

    /* Branches */
    /* Branch reads were denied for every merchant.

       The rule guarded resource.data.sellerId, but branches created by
       business-bootstrap carry merchantId and have no sellerId field at all —
       confirmed against the live document branches/SOK-GL58F7-main, which has
       {merchantId, status, name, isDefault} and nothing else. A comparison
       against an absent field is never true, so every non-admin read failed
       and the branch selector rendered its empty state. The UI was correct;
       the rule was guarding a field that does not exist.

       Ownership now resolves through the field the document actually has, by
       following merchantId to the business and comparing its ownerId. The
       sellerId clause is kept ahead of it so any legacy branch document keeps
       working and no existing access is withdrawn.

       Staff access is intentionally NOT granted here. Staff reach branch data
       through Cloud Functions using the Admin SDK, which bypasses rules; a
       membership lookup in this rule would cost a second document read on
       every branch read for a path that does not need it. */
    match /branches/{branchId} {
      /* Guard the cross-document get() with an exists() check.
         Without it, if businesses/{merchantId} was ever deleted, Firestore returns
         a null resource for the get(), evaluating .data.ownerId throws a rules error,
         and Firestore silently treats it as DENY — locking the merchant out of their
         own branches with no error message. */
      allow read:  if isAuthed() && (
                        resource.data.sellerId == request.auth.uid
                     || ('merchantId' in resource.data
                         && exists(/databases/$(database)/documents/businesses/$(resource.data.merchantId))
                         && get(/databases/$(database)/documents/businesses/$(resource.data.merchantId))
                              .data.ownerId == request.auth.uid)
                     || isAdmin());
      allow write: if false;

      /* Per-branch analytics (RBAC) — maintained ONLY by Cloud Functions. The branch owner
         (parent branch's sellerId) + admins may read their own branch's numbers; no client writes. */
      match /analytics/{doc} {
        allow read:  if isAdmin()
                     || (isAuthed()
                         && exists(/databases/$(database)/documents/branches/$(branchId))
                         && get(/databases/$(database)/documents/branches/$(branchId)).data.sellerId == request.auth.uid);
        allow write: if false;
      }
    }

    match /posRefunds/{refundId} {
      /* CF-only writes — client cannot verify txn ownership server-side */
      allow read:   if isPosOwner() || isAdmin();
      allow write:  if false;
    }

    match /posVoids/{voidId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.originalTxnId is string;
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isAdmin();
    }

    match /posCashFloats/{floatId} {
      allow create: if claimsPosOwner()
                    && request.resource.data.amount is number;
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /posDevices/{deviceId} {
      allow create: if claimsPosOwner();
      allow read:   if isPosOwner() || isAdmin();
      allow update: if isPosOwner() || isAdmin();
      allow delete: if isAdmin();
    }

    /* ── Plug-and-Play POS v1.0 ─────────────────────────────────── */
    match /bootstrapCache/{cacheId} {
      allow read:  if isAuthed();
      allow write: if false; // CF-only
    }

    match /deviceAuditLog/{logId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only — immutable audit trail
    }

    match /syncQueue/{itemId} {
      allow read:  if isAuthed() && resource.data.uid == request.auth.uid;
      allow write: if false; // CF-only
    }

    match /posConfig/{configId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerId == request.auth.uid);
      allow write:  if isAdmin();
    }

    match /pos_branches/{branchId} {
      allow create: if isAuthed()
                    && request.resource.data.businessId == request.auth.uid
                    && request.resource.data.keys().hasAll(['businessId','name']);
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.businessId == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.businessId == request.auth.uid
                        && request.resource.data.businessId == resource.data.businessId);
      allow delete: if isAdmin();
    }

    /* ─── SmartPOS 3.0 — Smart Inventory Pro ───────────────────── */
    match /posBatches/{batchId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posSerials/{serialId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posWarehouses/{warehouseId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posWarehouseStock/{stockId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posPurchaseOrders/{poId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posSuppliers/{supplierId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posReorderQueue/{itemId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posStockValuation/{valuationId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — Accounting ────────────────────────────── */
    match /posAccounts/{accountId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posJournalEntries/{entryId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posExpenses/{expenseId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posAccountingPeriods/{periodId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posAccountBalances/{balanceId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — CRM Pro ───────────────────────────────── */
    match /posWallets/{walletId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posWalletTransactions/{txnId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posGiftCards/{cardId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posStoreCreditLog/{creditId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posReferrals/{referralId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posOffers/{offerId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — Staff Ops ─────────────────────────────── */
    match /posAttendance/{attendanceId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posCommissions/{commissionId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posCommissionRates/{rateId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posApprovals/{approvalId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posCashReconciliation/{reconcileId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — HQ / Branch Mgmt ──────────────────────── */
    match /posCentralPrices/{priceId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posSharedCatalog/{catalogId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posCrossBranchFulfillments/{fulfillmentId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — BI Snapshots ──────────────────────────── */
    match /posBISnapshots/{snapshotId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — AI Assistant ──────────────────────────── */
    match /posAIQueries/{queryId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — Integrations ──────────────────────────── */
    match /posWebhooks/{webhookId} {
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /posAPIKeys/{keyId} {
      /* never expose key hash to client — owner can read metadata only */
      allow read:  if isAuthed() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ─── SmartPOS 3.0 — Hardware Registry ─────────────────────── */
    match /posTerminals/{terminalId} {
      allow read:  if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      /* SEC: split create/update — update must verify the EXISTING owner (resource.data.uid),
         not just the incoming uid. Without this any authed user can overwrite another
         merchant's terminal by setting uid=self (IDOR). */
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthed()
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /tenants/{tenantId}/{document=**} {
      function isTenantMember() {
        // Allow if: user uid IS the tenant (single-merchant), OR Firebase multi-tenant claim,
        // OR sellerId custom claim matches, OR platform admin.
        return request.auth != null &&
               (request.auth.uid == tenantId ||
                request.auth.token.tenantId == tenantId ||
                request.auth.token.sellerId == tenantId ||
                isAdmin());
      }
      function isTenantAdmin() {
        return isAdmin() || request.auth.token.get('tenantAdmin', false) == true;
      }
      match /inventory_products/{productId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 200
                      && request.resource.data.tenantId == tenantId
                      && !('deletedAt' in request.resource.data);
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && request.resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }
      match /inventory_levels/{levelId} {
        allow read:   if isTenantMember();
      }
      match /inventory_movements/{mvId} {
        allow read:   if isTenantMember();
      }
      match /inventory_purchaseOrders/{poId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.supplierId is string
                      && request.resource.data.status == 'draft';
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['createdBy', 'tenantId']);
        allow delete: if isTenantAdmin();
      }
      match /inventory_suppliers/{supplierId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.name is string
                      && request.resource.data.tenantId == tenantId;
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }
      match /inventory_warehouses/{warehouseId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantAdmin();
      }
      match /inventory_categories/{catId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0;
        allow update: if isTenantAdmin();
        allow delete: if isTenantAdmin();
      }
      match /inventory_audits/{auditId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.status == 'in_progress';
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && resource.data.status == 'in_progress'
                      && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['completedAt', 'results']);
        allow delete: if isTenantAdmin();
      }
      match /inventory_alerts/{alertId} {
        allow read:   if isTenantMember();
      }
      match /inventory_reservations/{resId} {
        allow read:   if isTenantMember();
      }
      match /inventory_batches/{batchId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantMember() && request.resource.data.tenantId == tenantId;
      }
      match /inventory_serials/{serialId} {
        allow read:   if isTenantMember();
      }
      match /inventory_serialIndex/{serialNo} {
        allow read:   if isTenantMember();
      }
      match /inventory_analytics/{docId} {
        allow read:   if isTenantMember();
      }
      match /inventory_forecasts/{forecastId} {
        allow read:   if isTenantMember();
      }
      match /inventory_ai_logs/{logId} {
        allow read:   if isTenantAdmin();
      }
      match /inventory_audit/{logId} {
        allow read:   if isTenantAdmin();
      }
      match /inventory_avco/{avcoId} {
        allow read:  if isTenantMember();
        allow write: if false; // CF-only — inventoryUpdateAVCO, inventoryDeductAVCO
        match /history/{histId} {
          allow read:  if isTenantMember();
          allow write: if false; // CF-only
        }
      }
      match /inventory_health/{docId} {
        allow read:   if isTenantMember();
      }
      match /inventory_health_history/{docId} {
        allow read:   if isTenantMember();
      }
      match /inventory_fraud_events/{eventId} {
        allow read:   if isTenantAdmin();
      }
      match /inventory_simulations/{simId} {
        allow read:   if isTenantMember();
      }
      match /inventory_recalls/{recallId} {
        allow read:   if isTenantMember();
        allow create: if isTenantAdmin();
        allow update: if isTenantAdmin();
      }
      match /inventory_import_jobs/{jobId} {
        allow read:   if isTenantMember();
      }
      match /inventory_webhooks/{webhookId} {
        allow read:   if isTenantAdmin();
        allow create: if isTenantMember();
        allow update: if isTenantAdmin();
        allow delete: if isTenantAdmin();
        match /deliveries/{deliveryId} {
          allow read:  if isTenantAdmin();
        }
      }
      match /inventory_workflows/{workflowId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember() && request.resource.data.tenantId == tenantId;
        allow update: if isTenantAdmin();
        allow delete: if isTenantAdmin();
      }
      match /inventory_workflow_runs/{runId} {
        allow read:   if isTenantMember();
      }
      match /inventory_pricing_rules/{productId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantAdmin();
      }
      match /inventory_price_recommendations/{productId} {
        allow read:   if isTenantMember();
      }
      match /inventory_digital_twin/{warehouseId} {
        allow read:   if isTenantMember();
        allow write:  if isTenantAdmin();
      }
      match /inventory_sustainability/{docId} {
        allow read:   if isTenantMember();
      }
      match /inventory_commerce_graph/{docId} {
        allow read:   if isTenantMember();
      }
      match /inventory_ai_tasks/{taskId} {
        allow read:   if isTenantAdmin();
        allow create: if isTenantMember();
      }
      match /inventory_supplier_catalog/{supplierId} {
        allow read:   if isTenantMember();
      }

      match /inventory_variants/{variantId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.productId is string
                      && request.resource.data.productId.size() > 0
                      && request.resource.data.sku is string;
        allow update: if isTenantMember()
                      && resource.data.tenantId == tenantId
                      && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['tenantId', 'productId']);
        allow delete: if isTenantAdmin();
      }
      match /inventory_bom/{bomId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.parentProductId is string
                      && request.resource.data.active == true;
        allow update: if isTenantAdmin()
                      && resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }
      match /inventory_work_orders/{woId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.status == 'draft'
                      && request.resource.data.bomId is string
                      && request.resource.data.quantity is number
                      && request.resource.data.quantity > 0;

        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status in ['draft', 'in_progress']
                          && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['tenantId', 'bomId', 'completedAt', 'cancelledAt']));
        allow delete: if isTenantAdmin();
      }
      match /inventory_transfers/{transferId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.fromWarehouseId is string
                      && request.resource.data.toWarehouseId is string
                      && request.resource.data.status == 'pending'

                      && request.resource.data.fromWarehouseId != request.resource.data.toWarehouseId;

        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'receivedAt', 'receivedBy',
                                                      'receivedQty', 'note', 'updatedAt']));
        allow delete: if isTenantAdmin();
      }
      match /inventory_grn/{grnId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.purchaseOrderId is string
                      && request.resource.data.supplierId is string
                      && request.resource.data.status == 'draft';

        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status == 'draft'
                          && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['tenantId', 'purchaseOrderId', 'postedAt', 'postedBy']));

        allow delete: if isTenantAdmin()
                      && resource.data.status == 'draft';
      }
      match /inventory_stockcounts/{countId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.warehouseId is string
                      && request.resource.data.status == 'open'
                      && request.resource.data.keys().hasAll(['startedBy', 'startedAt']);

        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status == 'open'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['note', 'updatedAt']));
        allow delete: if isTenantAdmin()
                      && resource.data.status == 'open';

        match /lines/{lineId} {
          allow read:   if isTenantMember();
          allow create: if isTenantMember()
                        && get(/databases/$(database)/documents/tenants/$(tenantId)/inventory_stockcounts/$(countId))
                             .data.status == 'open'
                        && request.resource.data.keys().hasAll(['productId', 'counted', 'countedBy', 'countedAt'])
                        && request.resource.data.counted is number
                        && request.resource.data.counted >= 0;
          allow update: if isTenantMember()
                        && get(/databases/$(database)/documents/tenants/$(tenantId)/inventory_stockcounts/$(countId))
                             .data.status == 'open'
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['counted', 'note', 'updatedAt', 'updatedBy']);
          allow delete: if isTenantAdmin();
        }
      }
      match /inventory_requisitions/{reqId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.status == 'pending'
                      && request.resource.data.requestedBy == request.auth.uid
                      && request.resource.data.keys().hasAll(['items', 'requestedBy', 'requestedAt'])
                      && request.resource.data.items is list
                      && request.resource.data.items.size() > 0;

        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.requestedBy == request.auth.uid
                          && resource.data.status == 'pending'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'cancelNote', 'updatedAt'])
                          && request.resource.data.status == 'cancelled');
        allow delete: if isTenantAdmin();
      }
      match /inventory_supplier_contracts/{contractId} {
        allow read:   if isTenantMember();
        allow create: if isTenantAdmin()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.supplierId is string;
        allow update: if isTenantAdmin()
                      && resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin();
      }
      match /inventory_shelf_scans/{scanId} {
        allow read:   if isTenantMember();
        allow create: if isTenantMember()
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.warehouseId is string
                      && request.resource.data.status == 'pending';
        allow update: if isTenantAdmin()
                      || (isTenantMember()
                          && resource.data.tenantId == tenantId
                          && resource.data.status == 'pending'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'imageRef', 'updatedAt']));
        allow delete: if isTenantAdmin();
      }
    }

    match /gipLocations/{assetId} {
      allow read:   if isAuthed();
      /* GPS integrity, 2026-07-19: create validated the coordinate RANGES but never
         bound the document to its writer, while update already did
         (request.auth.uid == resource.data.uid, below). So any authenticated user
         could CREATE a location doc for an arbitrary asset carrying an arbitrary
         uid — poisoning fleet tracking and dispatch with spoofed positions, and
         then being locked out of correcting it by the stricter update rule.
         Bound to the writer on create, matching update. */
      allow create: if isAuthed()
                    && request.resource.data.assetId == assetId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.lat  is number
                    && request.resource.data.lat  >= -90   && request.resource.data.lat  <= 90
                    && request.resource.data.lng  is number
                    && request.resource.data.lng  >= -180  && request.resource.data.lng  <= 180;
      allow update: if isAuthed()
                    && (request.auth.uid == resource.data.uid || isAdmin())
                    && request.resource.data.lat  is number
                    && request.resource.data.lat  >= -90   && request.resource.data.lat  <= 90
                    && request.resource.data.lng  is number
                    && request.resource.data.lng  >= -180  && request.resource.data.lng  <= 180;
      allow delete: if isAdmin();
    }

    match /gipDispatch/{jobId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid','type','status']);
      allow update: if isAuthed()
                    && (isAdmin() || resource.data.assignedAssetId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /gipAlerts/{alertId} {
      allow read:   if isAuthed()
                    && (isAdmin() || resource.data.assetId == request.auth.uid);
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved','resolvedAt']);
      allow delete: if isAdmin();
    }

    match /gipGeofences/{zoneId} {
      allow read:   if isAuthed();
      allow write:  if isAdmin();
    }

    match /gipGeofenceEvents/{eventId} {
      allow read:   if isAdmin();
    }

    match /gipHeatData/{region}/{date}/{hour} {
      allow read:   if isAuthed();
    }

    match /gipAnalytics/{date}/{subcollection}/{docId} {
      allow read:   if isAuthed()
                    && (isAdmin() || docId == request.auth.uid);
    }

    match /gipAssets/{assetId} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthed()
                    && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      match /serviceHistory/{serviceId} {
        allow read:   if isAuthed()
                      && (isAdmin() || get(/databases/$(database)/documents/gipAssets/$(assetId)).data.uid == request.auth.uid);
        allow create: if isAuthed()
                      && (isAdmin() || get(/databases/$(database)/documents/gipAssets/$(assetId)).data.uid == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    match /gipRoutes/{routeId} {
      allow read:   if isAuthed()
                    && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isAuthed();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sasosSubscriptions/{uid} {
      allow read:   if isAuthed() && request.auth.uid == uid;
    }

    match /sasosBillingLedger/{entryId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /sasosInvoices/{invoiceId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /sasosUsage/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && docId.matches(request.auth.uid + '_.*'));
    }

    match /sasosDunning/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /sasosRiskProfiles/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /sasosRiskEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /sasosManualReview/{uid} {
      allow read, write: if isAdmin();
    }

    match /sasosInsights/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /sasosAuditLog/{logId} {
      allow read:   if isAdmin();
    }

    match /sasosPlans/{planId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    match /sasosRenewalQueue/{docId} {
      allow read, write: if isAdmin();
    }

    match /sasosRevenueAggregates/{dateId} {
      allow read:   if isAdmin();
    }

    match /sasosPaymentRefs/{refId} {
      allow read, write: if false;
    }

    match /aiCredits/{uid} {
      allow read:   if isAuthed() && request.auth.uid == uid;
    }

    match /sasosCreditLedger/{entryId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /sasosStorageUsage/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && docId.matches(request.auth.uid + '_.*'));
    }

    match /entitlements/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /sasosOrgs/{orgId} {
      allow read:  if isAdmin()
                   || (isAuthed()
                       && exists(/databases/$(database)/documents/sasosSeats/$(orgId + '_' + request.auth.uid)));
    }

    match /sasosSeats/{seatId} {
      allow read:  if isAdmin()
                   || (isAuthed() && seatId.matches('.*_' + request.auth.uid));
    }

    match /sasosSeatInvites/{inviteId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.invitee == request.auth.uid);
    }

    match /sasosLicenses/{licenseId} {
      allow read:   if isAdmin()
                    || (isAuthed()
                        && exists(/databases/$(database)/documents/sasosSeats/$(resource.data.orgId + '_' + request.auth.uid)));
    }

    match /platformServices/{serviceId} {
      allow read:  if isAdmin();
    }

    match /platformHealth/{serviceId} {
      allow read:  if isAdmin();
    }

    match /platformDependencies/{edgeId} {
      allow read:  if isAdmin();
    }

    match /platformEvents/{eventId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.metadata.publishedBy == request.auth.uid);
      allow write: if false; /* CF only */
    }

    /* Event Bus subscriber registry */
    match /eventSubscribers/{subId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* Operations Center metrics */
    match /opsMetrics/{metricId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /selfHealLog/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /platformErrors/{errId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* Unified Payment Orchestrator */
    match /payments/{paymentId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.buyerId == request.auth.uid);
      allow write: if false; /* CF only */
    }

    match /platformSubscriptions/{subId} {
      /* Restrict to the owner of the subscription or platform admins.
         Previously allowed any authenticated user to read any subscription — FIXED. */
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /platformFanOut/{taskId} {
      allow read:  if isAdmin();
    }

    match /managerAuditLog/{entryId} {
      allow read:   if isAdmin();
    }

    match /managerAuthRequests/{reqId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.requestedByUid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.requestedByUid == request.auth.uid;
      allow update: if isAuthed()
                    && (resource.data.requestedByUid == request.auth.uid || isAdmin())
                    && request.resource.data.keys().hasOnly(['status','respondedById','respondedByName','respondedAt'])
                    && request.resource.data.status in ['approved','denied'];
    }

    match /managerFCMTokens/{managerId} {
      allow read:   if isAdmin();
      /* Each manager may only write their own FCM token; admins may write any */
      allow write:  if isAdmin()
                    || (isAuthed()
                        && request.auth.uid == managerId
                        && request.resource.data.uid == request.auth.uid);
    }

    match /contactRequests/{reqId} {
      allow create: if isAuthed()
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['buyerUid','sellerUid','productId','message','createdAt']);
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid)
                    || (isAuthed() && resource.data.buyerUid  == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status','respondedAt','sellerNote']));
      allow delete: if isAdmin();
    }

    match /productQA/{qaId} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['buyerUid','productId','question','createdAt']);
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.buyerUid  == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['question']))
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['answer','answeredAt']));
      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.buyerUid == request.auth.uid);
    }

    match /posPrintJobs/{jobId} {
      allow read:             if isAdmin()
                              || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;  
    }

    match /sellerStats/{sellerUid} {
      allow read:             if isAdmin()
                              || (isAuthed() && request.auth.uid == sellerUid);
      allow create, update, delete: if false;  
    }

    match /productStats/{productId} {
      allow read:   if true;           
    }

    match /productPriceHistory/{historyId} {
      allow read:   if true;           
    }

    match /productViewDedup/{dedupKey} {
      allow read, write: if false;     
    }

    match /sellerPerformance/{sellerId} {
      allow read:   if true;           
    }

    match /ops_backups/{docId} {
      allow read:   if isAdmin();
    }

    match /cspViolations/{docId} {
      allow read:   if isAdmin();
    }

    match /_healthcheck/{docId} {
      allow read:   if isAdmin();
    }

    match /emailLogs/{logId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    match /emailQueue/{jobId} {
      allow read:   if isAdmin();
    }

    match /emailPreferences/{uid} {
      allow read:   if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write:  if isAuthed() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                        ["orders","payments","marketing","account","security"]);
    }

    match /feedback/{feedbackId} {
      allow read:   if isAdmin();
    }

    match /ops_reports/{reportId} {
      allow read:   if isAdmin();
    }

    match /healthSnapshots/{snapId} {
      allow read:   if isAdmin();
    }

    match /funnelStats/{dateId} {
      allow read:   if isAdmin();
    }

    match /recentlyViewed/{uid}/items/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /savedSearches/{uid}/searches/{searchId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /userBehavior/{uid}/kassInteractions/{docId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
    }

    match /availabilityStatus/{uid} {
      allow read:  if true;
      /* 2026-09-27: server-written (setProviderAvailability / setLiveStatus) — an owner could publish
         any open/closed label directly. No client writes it. */
      allow write: if false;
    }

    match /priceAlerts/{alertId} {
      allow read:   if request.auth != null &&
                       (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null &&
                       (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /searchQueryLog/{logId} {
      allow read:  if isAdmin();
    }

    match /checkoutSessions/{sessionId} {
      allow read:   if isAuthed() && resource.data.uid == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /rateLimits/{key} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /paymentVerifications/{ref} {
      allow read:  if isAuthed() &&
                      (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /_systemConfig/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /commissions/{commissionId} {
      allow read:   if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /securityEvents/{eventId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /sysConfig/{doc} {
      allow read:  if isAuthed();
    }

    match /trackedVehicles/{vehicleId} {
      allow read:  if isAuthed() && (
                     resource.data.ownerUid             == request.auth.uid ||
                     request.auth.uid in resource.data.authorizedDrivers ||
                     request.auth.uid in resource.data.familyMembers     ||
                     request.auth.uid in resource.data.fleetManagers      ||
                     isAdmin()
                   );
      allow create: if (isAuthed() && request.resource.data.ownerUid == request.auth.uid)
                    || isAdmin();
      allow update: if isAuthed()
                    && (resource.data.ownerUid == request.auth.uid || isAdmin())
                    && !request.resource.data.diff(resource.data)
                        .affectedKeys().hasAny(['ownerUid']);
      allow delete: if (isAuthed() && resource.data.ownerUid == request.auth.uid)
                    || isAdmin();
    }

    match /vehicleLocations/{vehicleId} {
      function _veh() {
        return get(/databases/$(database)/documents/trackedVehicles/$(vehicleId)).data;
      }
      allow read:  if isAuthed() && (
                     _veh().ownerUid == request.auth.uid ||
                     request.auth.uid in _veh().authorizedDrivers ||
                     request.auth.uid in _veh().familyMembers     ||
                     isAdmin()
                   );

      allow write: if isAuthed() && (
                     _veh().ownerUid == request.auth.uid ||
                     request.auth.uid in _veh().authorizedDrivers ||
                     isAdmin()
                   );
    }

    match /vehicleRoutes/{routeId} {
      allow read:   if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /vehicleAlerts/{alertId} {
      allow read:   if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /vehicleGeofences/{geofenceId} {
      allow read:   if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthed() && resource.data.ownerUid == request.auth.uid || isAdmin();
    }

    match /gpsDevices/{deviceId} {
      allow read:   if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    match /trackingShares/{shareId} {
      allow read:   if isAdmin()
                    || (isAuthed() && (resource.data.createdBy == request.auth.uid
                                      || resource.data.sharedWith == request.auth.uid));
      allow create: if isAuthed() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAuthed() && resource.data.createdBy == request.auth.uid || isAdmin();
      allow update: if isAdmin();
    }

    match /trackingSubscriptions/{uid} {
      allow read:   if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow write:  if isAuthed() && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(['adminOverride','freeTrial']);
      allow write:  if isAdmin();
    }

    match /vehicleServiceHistory/{recordId} {
      allow read:   if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /driverSessions/{sessionId} {
      allow read:   if isAuthed() && (
                      resource.data.driverUid == request.auth.uid ||
                      isAdmin()
                    );
      allow create: if isAuthed() && request.resource.data.driverUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.driverUid == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    match /etimsProfiles/{uid} {
      allow read:   if isAuthed() && (request.auth.uid == uid || isAdmin());
    }

    match /etimsCredentials/{uid}     { allow read, write: if false; }
    match /etimsSequences/{uid}       { allow read, write: if false; }
    match /etimsReconciliations/{docId}{ allow read, write: if false; }

    match /etimsInvoices/{invoiceId} {
      allow read:   if isAuthed() && (
                      resource.data.sellerUid == request.auth.uid ||
                      resource.data.buyerUid  == request.auth.uid ||
                      isAdmin()
                    );
    }

    match /etimsQueue/{queueId} {
      allow read:  if isAdmin();
    }
    match /etimsBulkJobs/{jobId} {
      allow read:  if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin());
    }
    match /etimsAlerts/{alertId} {
      allow read:  if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin());
    }

    /* Immutable, append-only audit trail. Owner (seller) or admin may READ; NO client
       writes at all. Records are written once by Cloud Functions (admin SDK) and never
       updated or deleted — a per-entity hash chain makes any out-of-band tampering
       detectable (functions/etims-audit.js verifyChain). */
    match /etimsAuditLog/{eventId} {
      allow read:  if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /etimsAuditHeads/{entityId} {
      allow read, write: if false;   // internal chain-head pointers — CF-only
    }

    /* Invoice lifecycle documents (credit/debit notes, cancellations, amendments,
       reversals). Owner (seller) or admin READ; all writes via Cloud Functions only
       (etims-lifecycle.js). */
    match /creditNotes/{id}          { allow read: if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin()); allow write: if false; }
    match /debitNotes/{id}           { allow read: if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin()); allow write: if false; }
    match /invoiceCancellations/{id} { allow read: if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin()); allow write: if false; }
    match /invoiceAmendments/{id}    { allow read: if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin()); allow write: if false; }
    match /invoiceReversals/{id}     { allow read: if isAuthed() && (resource.data.sellerUid == request.auth.uid || isAdmin()); allow write: if false; }
    match /etimsTransmissionQueue/{id} { allow read: if isAdmin(); allow write: if false; }

    match /hubs/{hubId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      /* SEC: hub managers may update operational fields only — they must NOT be able to
         write managerId/managerIds/ownerId, which would let them grant hub access to
         arbitrary users (hub-scoped privilege escalation). */
      allow update: if isAdmin()
                    || (isAuthed()
                        && (resource.data.managerId == request.auth.uid
                            || resource.data.managerIds.hasAny([request.auth.uid]))
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['managerId','managerIds','ownerId']));
      allow delete: if isAdmin();
    }

    match /hubCredentials/{hubId} { allow read, write: if false; }
    match /hubSequences/{hubId}   { allow read, write: if false; }

    match /hubDocuments/{docId} {
      allow read: if isAuthed() && (
                    isAdmin() ||
                    resource.data.sellerId == request.auth.uid ||
                    resource.data.buyerId  == request.auth.uid ||
                    (exists(/databases/$(database)/documents/hubs/$(resource.data.hubId)) &&
                     get(/databases/$(database)/documents/hubs/$(resource.data.hubId)).data.managerIds.hasAny([request.auth.uid]))
                  );
    }

    match /hubInvoices/{invoiceId} {
      allow read: if isAuthed() && (
                    isAdmin() ||
                    resource.data.sellerUid == request.auth.uid ||
                    resource.data.buyerUid  == request.auth.uid ||
                    (exists(/databases/$(database)/documents/hubs/$(resource.data.hubId)) &&
                     get(/databases/$(database)/documents/hubs/$(resource.data.hubId)).data.managerIds.hasAny([request.auth.uid]))
                  );
    }

    match /hubInvoiceQueue/{queueId} {
      allow read:  if isAdmin();
    }

    match /dispatchQueue/{deliveryRef} {

      allow read: if isAuthed() && (
        isAdmin() ||
        resource.data.rankedRiders[resource.data.currentIndex].riderId == request.auth.uid ||
        get(/databases/$(database)/documents/packageRequests/$(deliveryRef)).data.sellerUid == request.auth.uid
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    match /deliveryProofs/{deliveryRef} {

      allow read: if isAuthed() && (
        isAdmin() ||
        resource.data.riderId == request.auth.uid ||
        get(/databases/$(database)/documents/packageRequests/$(deliveryRef)).data.sellerUid == request.auth.uid
      );
      allow create: if isAdmin();
    }

    match /deliveryAttempts/{attemptId} {
      allow read:  if isAdmin();
    }

    match /deliveryBatches/{batchId} {
      allow read: if isAuthed() && (
        isAdmin() ||
        resource.data.riderId == request.auth.uid
      );
    }

    match /riderMetrics/{docId} {

      allow read: if isAuthed() && (
        isAdmin() ||
        docId.matches(request.auth.uid + '_.*')
      );
    }

    match /deliveryHubs/{hubId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    match /fraudAlerts/{alertId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
    }

    match /analyticsRollup/{docId} {
      allow read:  if isAdmin();
    }

    match /smsQueue/{docId} {
      allow read:  if isAdmin();
    }

    match /csatRatings/{ratingId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.riderId == request.auth.uid);
      /* ONE rating per REAL delivery (CHANGELOG 213): the doc id IS the delivery reference; the rater is that
         delivery's buyer; the rider is the driver actually assigned to it; the delivery is finished. */
      allow create: if isAuthed()
                    && ratingId == request.resource.data.deliveryRef
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.rating   is int
                    && request.resource.data.rating   >= 1
                    && request.resource.data.rating   <= 5
                    && request.resource.data.riderId  is string
                    && request.resource.data.keys().hasOnly(['deliveryRef','buyerUid','riderId','riderName','rating','comment','createdAt'])
                    && exists(/databases/$(database)/documents/packageRequests/$(ratingId))
                    && (get(/databases/$(database)/documents/packageRequests/$(ratingId)).data.get('uid', '') == request.auth.uid
                        || get(/databases/$(database)/documents/packageRequests/$(ratingId)).data.get('buyerUid', '') == request.auth.uid)
                    && get(/databases/$(database)/documents/packageRequests/$(ratingId)).data.get('assignedDriverId', '') == request.resource.data.riderId
                    && (get(/databases/$(database)/documents/packageRequests/$(ratingId)).data.get('status', '') in ['delivered', 'buyer_confirmed', 'completed']
                        || get(/databases/$(database)/documents/packageRequests/$(ratingId)).data.get('buyerConfirmedAt', null) != null);
      allow update, delete: if false;
    }

    match /whatsappQueue/{docId} {
      allow read:  if isAdmin();
    }

    match /deliverySignatures/{docId} {
      allow read:  if isAdmin()
                   || (isAuthed() && (
                       resource.data.riderId == request.auth.uid
                       || resource.data.buyerUid == request.auth.uid));
    }

    match /ledger/{txId} {
      allow read:   if isAdmin();
    }

    match /wallets/{entityId} {
      allow read:   if isAdmin()
                    || (isAuthed() && request.auth.uid == entityId);

      match /transactions/{txId} {
        allow read:   if isAdmin()
                      || (isAuthed() && request.auth.uid == entityId);
      }
    }

    match /commissionRules/{ruleId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    match /payouts/{payoutId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.entityId == request.auth.uid);
    }

    match /promotions/{promoId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    match /promotionUsage/{usageId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.buyerUid == request.auth.uid);
    }

    match /taxRecords/{taxId} {
      allow read:   if isAdmin();
    }

    match /finosSnapshots/{snapId} {
      allow read:   if isAdmin();
    }

    match /finosAuditLog/{logId} {
      allow read:   if isAdmin();
    }

    match /userConversations/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      match /items/{conversationId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
      }
    }

    match /typingIndicators/{conversationId} {
      allow read: if request.auth != null;
      match /users/{uid} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /chatPolicies/{docId} {
      allow read:  if isAdmin();
    }

    match /moderationQueue/{reportId} {
      allow read:   if isAdmin();
      allow create: if isAuthed()
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.keys().hasAll(['conversationId','reportedBy','reason','status','createdAt'])
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin();
    }

    // REMOVED (B-17 fix): duplicate match /reviews/{reviewId} — moderation-gated read rule
    // has been merged into the canonical block earlier in this file (search for CONSOLIDATED reviews).
    match /reviews/{reviewId}/flags/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /reviews/{reviewId}/helpfulVotes/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
    }
    match /ratingsSummary/{targetId} {
      allow read:  if true;
    }
    match /dataDeletionRequests/{reqId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
    }
    match /dataRightsRequests/{reqId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
    }
    match /accountDeletions/{reqId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
    }
    match /shopHandles/{handle} {
      allow read:  if true;
    }
    match /minishopConfig/{shopId} {
      allow read:  if true;
    }
    match /minishopAnalytics/{shopId} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == resource.data.ownerUid);
    }
    match /shopFollowers/{docId} {
      /* CF-only writes: a client delete desynchronised followerCount. */
      allow read:  if true;
    }
    match /minishopCampaigns/{campaignId} {

      allow read:  if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
    }
    match /merchantHealthScores/{shopId} {

      allow read:  if isAuthed() && (request.auth.uid == resource.data.sellerUid || isAdmin());
    }
    match /merchantAutomations/{docId} {

      allow read:  if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
    }
    match /merchantAcademyProgress/{shopId} {

      allow read:  if isAuthed() && (request.auth.uid == resource.data.uid || isAdmin());
    }

    match /trips/{tripId} {
      allow read:  if isAdmin() || (isAuthed() && resource.data.riderId == request.auth.uid);
    }
    match /riderLocations/{riderId} {
      allow read:  if isAdmin() || (isAuthed() && riderId == request.auth.uid);
      allow write: if isAuthed() && riderId == request.auth.uid;
    }
    match /fleetEvents/{eventId} {
      allow read:  if isAdmin();
    }
    match /driverEarningQueue/{docId} {
      allow read:  if isAdmin();
    }

    match /loyaltyAccounts/{uid} {

      allow read:  if isAuthed() && request.auth.uid == uid || isAdmin();
    }
    match /loyaltyTransactions/{txId} {

      allow read:  if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
    }
    match /loyaltyRules/{docId} {

      allow read:  if true;
      allow write: if isAdmin();
    }

    match /wallets/{uid} {

      allow read:  if isAuthed() && request.auth.uid == uid || isAdmin();
    }
    match /walletTransactions/{txId} {

      allow read:  if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /payoutRequests/{reqId} {

      allow read:  if isAuthed() && resource.data.sellerUid == request.auth.uid || isAdmin();
    }

    /* ── Returns ───────────────────────────────────────────────────────────────
       This collection had NO rule at all, so it was default-denied: every read
       failed with permission-denied, and returns.html surfaced that to merchants
       as "Failed to load returns" — including for shops that simply had none.

       Ownership mirrors the document written by functions/returns-engine.js:
         buyerId  — the customer who filed the return
         sellerId — the merchant the return is against
       Exactly the two parties, plus admin. Deliberately NOT `isAuthed()`, which
       would expose every shop's return history (customer names, order ids,
       refund amounts) to any signed-in account.

       Reads cover both get and list: returns.html queries
         where('buyerId','==',uid)  / where('sellerId','==',uid), orderBy submittedAt desc
       so every document a merchant can match is one they own. The unfiltered admin
       query is allowed by isAdmin() alone.

       All writes go through the returns-engine Cloud Functions (Admin SDK), which
       own idempotency, ownership checks and the status state machine — so a client
       must never write here directly. */
    match /returns/{returnId} {
      allow read: if isAdmin() || (isAuthed() && (
                       resource.data.buyerId  == request.auth.uid ||
                       resource.data.sellerId == request.auth.uid
                     ));
      allow write: if false;
    }

    // ── Wallet Engine 2.0 — new collections ───────────────────────────────────

    match /wallets/{walletUid}/savings/{vaultId} {
      // Only the vault owner may read; all writes go through Admin SDK (Cloud Functions)
      allow read:  if isAuthed() && request.auth.uid == walletUid;
      allow write: if false;
    }

    match /moneyRequests/{reqId} {
      // Sender or recipient may read their own request; no client writes
      allow read:  if isAuthed() &&
                     (resource.data.fromUid == request.auth.uid ||
                      resource.data.toUid   == request.auth.uid ||
                      isAdmin());
      allow write: if false;
    }

    match /claimableTransfers/{claimId} {
      // Send-to-anyone escrow. Sender may read their own; all money movement
      // (create/claim/refund) goes through Admin SDK (Cloud Functions) only.
      allow read:  if isAuthed() && (resource.data.senderUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /walletAuditLog/{logId} {
      // Immutable security audit log — admin-read only, no client writes
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /walletPinAttempts/{uid} {
      // Rate-limit tracking — Cloud Functions only
      allow read:  if false;
      allow write: if false;
    }

    match /escrowV2/{escrowId} {
      // Buyer, seller, or admin may read; all mutations through Cloud Functions
      allow read:  if isAdmin() ||
                     (isAuthed() &&
                       (resource.data.buyerUid  == request.auth.uid ||
                        resource.data.sellerUid == request.auth.uid));
      allow write: if false;
    }

    match /jobs/{jobId} {

      allow read:  if resource.data.status == 'active'
                   || (isAuthed() && resource.data.employerUid == request.auth.uid)
                   || isAdmin();
    }
    match /jobApplications/{appId} {

      allow read:  if isAuthed() && (
                     resource.data.seekerUid == request.auth.uid ||
                     resource.data.employerUid == request.auth.uid
                   ) || isAdmin();
    }
    match /jobSeekerProfiles/{uid} {

      allow read:  if isAuthed();
    }
    match /savedJobs/{docId} {

      allow read:  if isAuthed() && resource.data.uid == request.auth.uid;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthed() && resource.data.uid == request.auth.uid;
    }


    /* ── QR Code System v1.0 ─────────────────────────────────────── */
    match /qrTokens/{tokenId} {
      allow read, write: if false;
    }

    /* ── Education Hub v1.0 ────────────────────────────────────────── */
    match /courses/{courseId} {
      allow read: if resource.data.status == 'published' || isAdmin() || (isAuthed() && resource.data.instructorUid == request.auth.uid);
      allow write: if false;
    }
    match /courseEnrollments/{docId} {
      allow read: if (isAuthed() && resource.data.uid == request.auth.uid) || isAdmin();
      allow write: if false;
    }
    match /courseProgress/{docId} {
      allow read: if (isAuthed() && resource.data.uid == request.auth.uid) || isAdmin();
      allow write: if false;
    }
    match /courseReviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    /* ── Super Admin / Platform Config ─────────────────────────────── */
    match /platformConfig/{docId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
    match /platformBroadcasts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* ── SOKONI Impact Enterprise Platform ──────────────────────────── */
    match /impactLedger/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /impactBalance/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /impactCampaigns/{campId} {
      allow read: if true;
      allow write: if false;
    }
    match /impactGrants/{grantId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /impactScholarships/{schId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /impactCorporate/{corpId} {
      allow read: if true;
      allow write: if false;
    }
    match /impactUserProfiles/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid || isAdmin();
      allow write: if false;
    }
    match /impactBadges/{badgeId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /impactDisbursements/{disbId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /impactRoundupSettings/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow write: if false;
    }
    match /impactBusinessScores/{uid} {
      allow read: if isAuthed();
      allow write: if false;
    }
    match /impactBookmarks/{bookmarkId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /impactEnvironmental/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /impactEnvProjects/{projId} {
      allow read: if true;
      allow write: if false;
    }
    match /impactAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /impactMonthlySnapshots/{snapshotId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* ── Async Jobs Engine v1.0 ────────────────────────────────────────── */
    match /asyncJobs/{jobId} {
      allow read: if isAuthed() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      allow write: if false; // CF-only
    }
    match /asyncJobsDLQ/{dlqId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only
    }
    match /asyncQueues/{queueId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only
    }
    match /asyncWorkers/{workerId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only
    }
    match /posReceipts/{receiptId} {
      allow read: if isAuthed() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
      allow write: if false; // CF-only
    }

    /* ══════════════════════════════════════════════════════════════
       SECURITY 6.0 — ZERO TRUST COLLECTIONS
       All collections below are CF-write-only or CF-only.
       No client can write directly. Admins read via CFs only.
       ══════════════════════════════════════════════════════════════ */

    /* Immutable security audit log — CF writes only; never updated or deleted */
    match /securityAuditLog/{eventId} {
      allow read:   if isAdmin();
      allow create: if false; // CF-only; immutable by design
      allow update, delete: if false;
    }

    /* Security events (login attempts, payment events) — CF-write only */
    match /securityEvents/{eventId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write:  if false; // CF-only
    }

    /* Fraud and security alerts — admin read/write via CFs */
    match /securityAlerts/{alertId} {
      allow read:   if isAdmin();
      allow write:  if false; // CF-only
    }

    /* Security incidents — admin-only; never deleted */
    match /securityIncidents/{incidentId} {
      allow read:   if isAdmin();
      allow write:  if false; // CF-only
    }

    /* User risk profiles — owner reads own; admin reads all */
    match /securityRisk/{userId} {
      allow read:   if isAuthed() && (request.auth.uid == userId || isAdmin());
      allow write:  if false; // CF-only — updateRiskProfile CF manages writes
    }

    /* MFA enrollment records — owner reads own; CF writes */
    match /securityMFA/{userId} {
      allow read:   if isAuthed() && request.auth.uid == userId;
      allow write:  if false; // CF-only
    }

    /* Step-up auth challenges — transient; CF creates and marks used */
    match /securityStepUp/{challengeId} {
      allow read:   if false; // CF-only; clients never read directly
      allow write:  if false;
    }

    /* Device trust registry — owner reads own devices */
    match /securityDevices/{userId} {
      allow read:   if isAuthed() && request.auth.uid == userId;
      allow write:  if false;
      match /devices/{deviceId} {
        allow read:   if isAuthed() && request.auth.uid == userId;
        allow write:  if false; // CF-only
      }
    }

    /* WebAuthn passkey credentials — owner reads own; CF writes */
    match /securityPasskeys/{userId} {
      allow read:   if isAuthed() && request.auth.uid == userId;
      allow write:  if false;
      match /credentials/{credentialId} {
        allow read:   if isAuthed() && request.auth.uid == userId;
        allow write:  if false;
      }
      match /challenges/{challengeId} {
        allow read:   if false; // CF-only
        allow write:  if false;
      }
    }

    /* Pen test scan results — super admin only */
    match /securityPenTestResults/{scanId} {
      allow read:   if isAdmin();
      allow write:  if false; // CF-only
    }

    /* AI security audit log — admin reads; CF writes */
    match /aiSecurityLog/{eventId} {
      allow read:   if isAdmin();
      allow write:  if false; // CF-only
    }

    /* AI abuse reports — reporter reads own; admin reads all */
    match /aiAbuseReports/{reportId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.reportedBy == request.auth.uid);
      allow write:  if false; // CF-only
    }

    /* AI access blocks — admin reads; CF writes */
    match /aiBlocks/{userId} {
      allow read:   if isAdmin()
                    || (isAuthed() && request.auth.uid == userId);
      allow write:  if false; // CF-only
    }

    /* ── Missing collections (audit-identified) ─────────────────────── */
    match /supportTickets/{ticketId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid','subject','message','status']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /reports/{reportId} {
      allow read:  if isAdmin();
      allow create: if isAuthed()
                    && request.resource.data.reportedBy == request.auth.uid;
      allow write:  if isAdmin();
    }
    match /receiptEvents/{eventId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerId == request.auth.uid);
      allow write: if false;
    }
    match /mediaAssets/{assetId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    match /posWebhookDeliveryLog/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /posOfflineQueue/{queueId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.sellerId == request.auth.uid);
      allow write: if false;
    }
    match /adminAudit/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /adminAuditLogs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /adminAuditLog/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* ── Enterprise Health & Operations v1.0 ─────────────────────────── */
    match /systemHealthHistory/{snapId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /platformAlerts/{alertId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /executiveSummaries/{dateId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /hourlyMetrics/{hourId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /analyticsSnapshots/{snapId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* ── Disaster Recovery v1.0 ──────────────────────────────────────── */
    match /drSimulations/{simId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /drPlaybookLog/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /backupVerifications/{verifyId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    /* ── Post-Launch Monitoring v1.0 ─────────────────────────────────── */
    match /platformConfig/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /_health/{docId} {
      allow read:  if false;
      allow write: if false;
    }

    /* ── B2B / Wholesale Commerce v1.0 ──────────────────────────────────── */
    match /wholesaleAccounts/{uid} {
      allow read: if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow write: if false; // CF-only
    }
    match /wholesaleOrders/{orderId} {
      allow read: if isAdmin()
                  || (isAuthed() && resource.data.buyerUid == request.auth.uid)
                  || (isAuthed() && resource.data.sellerUid == request.auth.uid);
      allow write: if false; // CF-only
    }
    match /wholesaleLedger/{ledgerId} {
      allow read: if isAdmin()
                  || (isAuthed() && resource.data.buyerUid == request.auth.uid);
      allow write: if false; // CF-only
    }
    match /wholesaleCreditNotes/{noteId} {
      allow read: if isAdmin()
                  || (isAuthed() && resource.data.buyerUid == request.auth.uid);
      allow write: if false; // CF-only
    }

    /* ── Release Readiness Certification v1.0 ────────────────────────── */
    match /releaseReports/{reportId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only: runReleaseReadinessCheck + approveRelease
    }

    /* ── Event Hub v1.0 ──────────────────────────────────────────────── */
    match /events/{eventId} {
      allow read:  if resource.data.status == 'live' || resource.data.status == 'ended'
                   || (isAuthed() && resource.data.organizerUid == request.auth.uid)
                   || isAdmin();
      allow write: if false; // CF-only
    }
    match /eventTicketTiers/{tierId} {
      allow read:  if isAuthed();
      allow write: if false;
    }
    match /eventOrders/{orderId} {
      allow read:  if isAuthed() && (resource.data.buyerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /eventTickets/{ticketId} {
      allow read:  if isAuthed() && (resource.data.buyerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /eventCheckins/{checkinId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    // Event ticket settlement (functions/event-settlement.js) — server-written only. An organizer
    // may read their OWN settlements (what they will be paid, and when); exceptions are admin-only.
    match /eventSettlements/{paymentRef} {
      allow read:  if isAuthed() && (resource.data.organizerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /eventExceptions/{exceptionId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    // Event operations (functions/event-ops.js) — Cloud Functions only, stated explicitly.
    // eventTicketSecrets holds RAW ticket PINs (bearer credentials): no client may read one; the
    // buyer receives their own through getMyTickets. The PIN index, staff assignments, invites,
    // admissions, attempt counters and ops audit are server-owned — a client that could write a
    // staff assignment could give itself the gate.
    match /eventTicketSecrets/{ticketId} { allow read, write: if false; }
    match /eventTicketPins/{pinId}       { allow read, write: if false; }
    // Ticket-number uniqueness index (SK-EVT-YYYY-NNNNNN) and the fiscal (KRA eTIMS) record of each
    // paid sale: server-owned. A client that could write the fiscal record could mark a sale
    // fiscalised, or hide one from reconciliation.
    match /eventTicketNumbers/{number}   { allow read, write: if false; }
    match /eventFiscal/{saleKey}         { allow read: if isAdmin(); allow write: if false; }
    // Credit-note lifecycle per (fiscal record, refund case): server-owned. A client that could write
    // it could mark a credit note accepted or invent a KRA reference.
    match /eventFiscalReversals/{executionId} { allow read: if isAdmin(); allow write: if false; }
    match /eventStaff/{assignmentId}     { allow read, write: if false; }
    match /eventStaffInvites/{inviteId}  { allow read, write: if false; }
    match /eventAdmissions/{ticketId}    { allow read: if isAdmin(); allow write: if false; }
    match /eventPinAttempts/{key}        { allow read, write: if false; }
    match /eventOpsAudit/{entryId}       { allow read: if isAdmin(); allow write: if false; }
    // Event-day cashier sales (functions/event-sales.js). Every door sale, card reference and
    // commission receivable is server-written: a client that could write one could manufacture a
    // "paid" ticket or erase what an organizer owes. Organizers read their own receivables through
    // the dashboard callables; admins may read directly.
    match /eventSales/{saleId}                  { allow read: if isAdmin(); allow write: if false; }
    match /eventSaleClaims/{claimId}            { allow read, write: if false; }
    match /eventCardRefClaims/{refId}           { allow read: if isAdmin(); allow write: if false; }
    match /eventCommissionReceivables/{saleId}  { allow read: if isAdmin(); allow write: if false; }
    // Refund Request Wizard records (functions/event-refunds.js): the buyer may read their own request;
    // only the server writes (eligibility is computed there, never asserted by a client).
    match /eventRefundRequests/{orderId} {
      allow read:  if isAuthed() && (resource.data.buyerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    /* Codes are validated server-side (validateEventPromoCode / purchaseTickets); no client reads
       them. 2026-09-27: was isAuthed() — any signed-in user could list every event's discount codes. */
    match /eventPromoCodes/{codeId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /eventOrderIdempotency/{key} {
      allow read:  if false;
      allow write: if false;
    }

    /* ── Healthcare Hub v1.0 ─────────────────────────────────────────────── */
    /* HC-01 — THE ONE healthProviders BLOCK. A second `match /healthProviders/`
       lived further down ("publicly discoverable directory"). Firestore UNIONS
       duplicate match blocks, so the `allow write: if false` written here was
       VOID: that block's owner create/update let ANY signed-in user write
       healthProviders/{own-uid}. `status` is not among the keys noAdminFields()
       protects (only `verified` is), so the payload could carry status:'active'
       — minting an active provider with a self-asserted licenceNumber and
       specialization, and letting an admin-rejected applicant restore
       themselves. createHealthRecord and createPrescription authorize on
       exactly that status and nothing else, so the mint reached clinical
       writes against any patientUid.

       ADR-014 retires healthProviders as a provider identity: the canonical
       identity is providers/{uid}. Writes here are server-only; the Cloud
       Functions use the Admin SDK, which bypasses rules entirely, so this
       denies clients without touching any callable.

       Reads are unchanged in substance and deliberately keep the owner clause
       the removed block supplied — sokoni-health.js::listenMyProviderProfile
       queries where('uid','==',me) so an applicant can see their own pending
       status. Public discovery (search guard, listenProviders, getAllProviders)
       filters status=='active' and is unaffected. The removed block also
       admitted status=='approved'; no writer anywhere produces that value, and
       with write:false it is unreachable by construction, so it is dropped
       rather than carried forward as a state the system cannot enter.

       DO NOT re-add a second block for this path — add clauses to this one, or
       the union quietly widens access again (the same failure documented on
       /applications below). */
    match /healthProviders/{providerId} {
      allow read:  if resource.data.status == 'active'
                   || (isAuthed() && resource.data.uid == request.auth.uid)
                   || isAdmin();
      allow write: if false; // CF-only — Admin SDK bypasses rules
    }
    match /healthAppointments/{apptId} {
      allow read:  if isAuthed() && (
                     resource.data.patientUid == request.auth.uid ||
                     resource.data.providerId == request.auth.uid ||
                     isAdmin()
                   );
      allow write: if false; // CF-only
    }
    /* CHANGELOG 223 (Healthcare security slice 3) — clinical records are read by THE PATIENT only.
       The blanket `|| isAdmin()` let every platform administrator read every patient's diagnoses and
       prescriptions straight from the database, unlogged (a rules-level read cannot be audited). "Admin"
       is not clinical access: an audited, purpose-bound administrative read is a separate policy decision
       (CHANGELOG 223), and until it is made no administrator reads these here. A provider reads nothing
       here either — no provider-side read path exists yet, and none is opened by this slice. */
    match /healthRecords/{recordId} {
      allow read:  if isAuthed() && resource.data.patientUid == request.auth.uid;
      allow write: if false; // CF-only — createHealthRecord (relationship-gated, audited)
    }
    match /healthPrescriptions/{rxId} {
      allow read:  if isAuthed() && resource.data.patientUid == request.auth.uid;
      allow write: if false; // CF-only — createPrescription (relationship-gated, audited)
    }
    /* Clinical-write audit (actor · patient · provider · action · record ref · booking basis · time — no
       clinical content). Written only by the server in the same transaction as the record. */
    /* Healthcare consultation-chat limits (healthcare-conversations.js) — server-only counters. */
    match /hcMessageLimits/{id} {
      allow read, write: if false;
    }
    match /healthClinicalAudit/{auditId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /healthApptIdempotency/{key} {
      allow read:  if false;
      allow write: if false;
    }

    /* ── Property Hub v1.0 ───────────────────────────────────────────────── */
    match /propertyListings/{listingId} {
      allow read:  if resource.data.status == 'active'
                   || (isAuthed() && resource.data.agentUid == request.auth.uid)
                   || isAdmin();
      allow write: if false; // CF-only
    }
    match /propertyEnquiries/{enquiryId} {
      allow read:  if isAuthed() && (
                     resource.data.buyerUid == request.auth.uid ||
                     resource.data.agentUid == request.auth.uid ||
                     isAdmin()
                   );
      allow write: if false; // CF-only
    }
    match /propertyViewings/{viewingId} {
      allow read:  if isAuthed() && (
                     resource.data.buyerUid == request.auth.uid ||
                     resource.data.agentUid == request.auth.uid ||
                     isAdmin()
                   );
      allow write: if false; // CF-only
    }

    /* ── Vehicle Hub v1.0 ────────────────────────────────────────────────── */
    match /vehicleListings/{listingId} {
      allow read:  if resource.data.status == 'active'
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid)
                   || isAdmin();
      allow write: if false; // CF-only
    }
    match /vehicleEnquiries/{enquiryId} {
      allow read:  if isAuthed() && (
                     resource.data.buyerUid == request.auth.uid ||
                     resource.data.sellerUid == request.auth.uid ||
                     isAdmin()
                   );
      allow write: if false; // CF-only
    }
    match /vehicleReports/{reportId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only
    }

    /* ── Digital Products Hub v1.0 ───────────────────────────────────────── */
    // CONSOLIDATED (B-17 fix): Single authoritative block for digitalProducts.
    // The earlier duplicate block (which permitted client create/update/delete) has been removed.
    match /digitalProducts/{productId} {
      allow read:  if resource.data.status == 'active'
                   || (isAuthed() && resource.data.sellerUid == request.auth.uid)
                   || isAdmin();
      allow write: if false; // CF-only — all product lifecycle managed by Admin SDK
    }
    // CONSOLIDATED (B-17 fix): Single authoritative block for digitalPurchases.
    // The earlier duplicate block (which permitted client creates of pending/processing records)
    // has been removed. Seller read access retained from the removed block's merged rules.
    match /digitalPurchases/{purchaseId} {
      allow read:  if isAuthed() && (
                     resource.data.buyerUid  == request.auth.uid ||
                     resource.data.sellerUid == request.auth.uid ||
                     isAdmin()
                   );
      allow write: if false; // CF-only — purchase records created/updated by Admin SDK only
    }
    match /digitalPurchaseIdempotency/{key} {
      allow read:  if false;
      allow write: if false;
    }

    /* ── Legal Services Hub v1.0 ─────────────────────────────────────────── */
    /* CHANGELOG 220 — the Legal record carries the verification SUMMARY; the public directory is served
       by getLegalProviders (a public projection), so a raw public read is no longer needed. */
    match /legalProviders/{providerId} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == providerId);
      allow write: if false; // CF-only
    }
    /* Legal Verification Authority: private current detail (reviewer, P.105, name returned, evidence),
       the append-only event history, and quarantined legacy identities. Server-written, admin-read. */
    match /legalVerifications/{uid} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /legalVerificationEvents/{eventId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /legalProviderQuarantine/{uid} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /legalConsultations/{consultationId} {
      allow read:  if isAuthed() && (
                     resource.data.clientUid == request.auth.uid ||
                     resource.data.providerId == request.auth.uid ||
                     isAdmin()
                   );
      allow write: if false; // CF-only
    }
    match /legalConsultIdempotency/{key} {
      allow read:  if false;
      allow write: if false;
    }
    match /legalCommissions/{commId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.providerUid == request.auth.uid);
      /* Gate 1A 2026-07-19 — entitlement. The party OWING commission declared what it
           owed: type checks only, never derived from the matter or the canonical
           commission engine. Identity and authority proven; correctness not.
           CF-only. Behaviour-neutral: zero client references repo-wide. */
        allow create: if false;
        allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /legalDocDrafts/{draftId} {
      allow read:   if isAuthed() && resource.data.uid == request.auth.uid;
      allow create: if isAuthed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid','docType','title','content'])
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 100000; // 100KB max
      allow update: if isAuthed() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthed() && resource.data.uid == request.auth.uid;
    }

    /* ── Legal Acceptance Framework — court-grade evidence, CF-only ────────
       These six collections back the digital agreement engine: the signed acceptance
       records, the signature certificates, and the append-only audit trail that the
       legal docs describe as court-grade evidence.

       They had NO rules at all. They were protected only by Firestore's implicit
       default-deny — which held, but silently and by accident. Anyone adding a
       /{document=**} catch-all, or a public-read rule for the policy pages, would have
       exposed the audit trail and every user's signature without touching this block.

       Deny is now explicit and reviewable. This changes nothing at runtime: no client
       code reads or writes these collections (verified — every reference lives in
       functions/), and the Cloud Functions use the Admin SDK, which bypasses rules.
       All access goes through legalDispatch, where each handler authorizes itself. */
    match /legalAgreements/{agreementId} {
      allow read, write: if false; // CF-only — read via legalDispatch(legalGetAgreements)
      match /versions/{version} {
        allow read, write: if false; // CF-only — append-only version history
      }
    }
    match /legalAcceptances/{acceptanceId} {
      allow read, write: if false; // CF-only — signed acceptance records (evidence)
    }
    match /legalCertificates/{certificateId} {
      allow read, write: if false; // CF-only — read via legalDispatch(legalGetCertificate)
    }
    match /legalAuditLog/{entryId} {
      allow read, write: if false; // CF-only — append-only; never client-readable
    }
    match /legalConfig/{docId} {
      allow read, write: if false; // CF-only — enforcement kill-switch. Client read would leak rollout state.
    }
    match /legalRegistry/{moduleId} {
      allow read, write: if false; // CF-only — module agreement registry
    }

    /* ── Entertainment Hub v1.0 ──────────────────────────────────────────── */
    match /entertainmentListings/{listingId} {
      allow read:  if resource.data.status == 'active'
                   || (isAuthed() && resource.data.creatorUid == request.auth.uid)
                   || isAdmin();
      allow write: if false; // CF-only
    }
    match /entertainmentPurchases/{purchaseId} {
      allow read:  if isAuthed() && (resource.data.buyerUid == request.auth.uid || isAdmin());
      allow write: if false; // CF-only
    }
    match /entertainmentPurchaseIdempotency/{key} {
      allow read:  if false;
      allow write: if false;
    }
    match /entertainmentReviews/{reviewId} {
      allow read:  if true; // public reviews
      allow write: if false; // CF-only
    }

    /* ── Creator Hub (docs/CREATOR_HUB.md) ───────────────────────────────────
       EVERY write is Cloud Functions only (creator-hub.js, the entitlement engine,
       the webhook). No client can publish a film, grant an entitlement, credit a
       royalty, mark a period paid or touch a split. Reads are owner-scoped; the
       film catalogue itself is entertainmentListings (public only when active,
       and a Creator Hub film doc never carries a media URL). */
    match /entertainmentListingSecrets/{listingId} {
      allow read, write: if false; // legacy stream URLs — server-only sidecar
    }
    match /creators/{uid} {
      allow read:  if resource.data.state == 'ACTIVE'
                   || (isAuthed() && request.auth.uid == uid)
                   || isAdmin();
      allow write: if false;
    }
    match /creatorPrivate/{uid} {
      allow read:  if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    match /creatorMedia/{filmId} {
      allow read, write: if false; // master location — never to a client
    }
    match /royaltyAgreements/{filmId}/versions/{version} {
      allow read:  if isAdmin()
                   || (isAuthed() && get(/databases/$(database)/documents/entertainmentListings/$(filmId)).data.creatorUid == request.auth.uid);
      allow write: if false;
    }
    match /royaltyParticipations/{id} {
      allow read:  if isAuthed() && (resource.data.uid == request.auth.uid
                                     || resource.data.creatorUid == request.auth.uid
                                     || isAdmin());
      allow write: if false;
    }
    match /contentEntitlements/{paymentRef} {
      allow read:  if isAuthed() && (resource.data.buyerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /contentAccess/{id} {
      allow read:  if isAuthed() && (resource.data.buyerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /royaltyLedger/{entryId} {
      allow read:  if isAuthed() && (resource.data.uid == request.auth.uid
                                     || resource.data.creatorUid == request.auth.uid
                                     || isAdmin());
      allow write: if false;
    }
    match /royaltyAccruals/{id} {
      allow read:  if isAuthed() && (resource.data.creatorUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /royaltyStatements/{id} {
      allow read:  if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /royaltyPeriods/{periodId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /royaltyReversals/{id}       { allow read: if isAdmin(); allow write: if false; }
    match /royaltyDistributions/{id}   { allow read: if isAdmin(); allow write: if false; }
    match /playbackSessions/{id}       { allow read: if isAdmin(); allow write: if false; }
    match /playbackAudit/{id}          { allow read: if isAdmin(); allow write: if false; }
    match /playbackRate/{uid}          { allow read, write: if false; }
    match /creatorExceptions/{id}      { allow read: if isAdmin(); allow write: if false; }
    match /creatorPayoutHolds/{uid}    { allow read: if isAdmin(); allow write: if false; }
    /* Viewer progress: own only. Film analytics: aggregates, read via creatorDispatch
       (owner-scoped) or by admins; the per-viewer marker is never client-readable. */
    match /watchProgress/{id} {
      allow read:  if isAuthed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /filmStats/{filmId} {
      allow read:  if isAdmin();
      allow write: if false;
      match /shards/{shard} { allow read: if isAdmin(); allow write: if false; }
    }
    match /filmViewers/{id}            { allow read, write: if false; }
    /* Creator verification: ONE application per creator, keyed by uid. The status
       is decided only by AdminOS (creator-hub _adminH); no client ever writes it. */
    match /creatorVerifications/{uid} {
      allow read:  if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
      match /events/{eventId} {
        allow read:  if isAuthed() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }

    // ── Universal Loyalty & Rewards Engine v2.0 ────────────────────────────

    match /loyaltyAccounts/{uid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write: if false; // CF-only — all mutations via Cloud Functions
    }

    match /loyaltyLedger/{entryId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false; // immutable — CF-only
    }

    match /loyaltyMerchantConfigs/{merchantId} {
      allow read:  if isAuthed(); // POS + customers need to read config
      allow write: if false; // CF-only — configureLoyaltyProgram
    }

    match /loyaltyCampaigns/{campaignId} {
      allow read:  if isAuthed(); // POS fetches before checkout
      allow write: if false; // CF-only — createLoyaltyCampaign
    }

    match /loyaltyRewards/{rewardId} {
      allow read:  if isAuthed();
      allow write: if false; // CF-only — createLoyaltyReward
    }

    match /loyaltyRedemptions/{redemptionId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false; // CF-only — redeemLoyaltyReward
    }

    match /loyaltyCards/{cardId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false; // CF-only — linkPhysicalCard
    }

    match /posSyncIdempotency/{saleId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only
    }

    // v1 collections — preserved for backward compatibility
    match /loyaltyTransactions/{txId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false; // CF-only
    }

    match /loyaltyRules/{docId} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Enterprise Loyalty v1.0 collections ───────────────────────────────

    match /loyaltyGiftCards/{cardId} {
      // Issued customer can view their own card; merchant can view cards they issued; admin can view all
      allow read:  if isAdmin()
                   || (isAuthed() && (resource.data.issuedTo == request.auth.uid
                                   || resource.data.merchantId == request.auth.uid));
      allow write: if false; // CF-only — issueGiftCard, loyaltyCheckoutOrchestrate
    }

    match /loyaltyDraws/{drawId} {
      allow read:  if isAuthed(); // customers browse active draws
      allow write: if false; // CF-only — merchant creates via admin CF
    }

    match /loyaltyDrawEntries/{entryId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false; // CF-only — enterLuckyDraw
    }

    match /loyaltyCashbackLedger/{entryId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false; // CF-only — awardCashback, loyaltyCheckoutOrchestrate
    }

    match /loyaltyAccounting/{entryId} {
      allow read:  if isAdmin(); // finance team only
      allow write: if false; // CF-only — postLoyaltyAccounting, loyaltyCheckoutOrchestrate
    }

    match /loyaltyNetwork/{networkId} {
      allow read:  if isAuthed(); // public — customers can see participating merchants
      allow write: if false; // CF-only — joinLoyaltyNetwork
    }

    match /loyaltyCheckouts/{checkoutId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false; // CF-only — loyaltyCheckoutOrchestrate
    }

    match /loyaltyCheckoutIdempotency/{idemId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only
    }

    match /loyaltyReferrals/{referralId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.referrerId == request.auth.uid);
      allow write: if false; // CF-only — trackReferral
    }

    match /loyaltyReconciliation/{reconcileId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only — reconcileLoyaltyLedger
    }

    match /loyaltyPersonalization/{uid} {
      allow read:  if isAuthed() && request.auth.uid == uid;
      allow write: if false; // CF-only — getPersonalizedOffers
    }

    // ── Payment State Machine ──────────────────────────────────────────────
    match /paymentSessions/{sessionId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false; // CF-only — createPaymentSession, transitionPaymentState
    }

    match /paymentAuditSeals/{sessionId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only — sealPaymentAuditTrail (immutable)
    }

    match /paymentRecoveryLog/{entryId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only — recoverPaymentSession
    }

    match /paymentReconciliation/{reportId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only — reconcilePaymentSessions
    }

    // ── Payment Reconciliation ────────────────────────────────────────────
    match /reconciliationReports/{reportId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only — runDailyReconciliation
    }

    match /unmatchedPayments/{paymentRef} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only — flagUnmatchedPayment, resolveUnmatchedPayment
    }

    // ── Business Health Score ─────────────────────────────────────────────
    match /businessHealthScores/{scoreId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — getBusinessHealthScore, computeAllHealthScores
    }

    // ── HR & Payroll ──────────────────────────────────────────────────────
    match /hrStaff/{staffId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — addStaffMember
    }

    match /hrAttendance/{attendanceId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false; // CF-only — recordAttendance
    }

    match /hrPayrollRuns/{runId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — runPayroll, approvePayrollRun
    }

    match /hrPayslips/{payslipId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.staffUid == request.auth.uid);
      allow write: if false; // CF-only — runPayroll
    }

    match /hrLeaves/{leaveId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false; // CF-only — requestLeave, approveLeave
    }

    match /hrTraining/{trainingId} {
      allow read:  if isAuthed();
      allow write: if false; // CF-only — assignTraining, markTrainingComplete
    }

    /* ── employmentEvents — the append-only employment history (ADR-035 §6) ──
       The evidence of who established, changed, suspended or ended a
       salary-bearing relationship. Written ONLY by employment-events.js via the
       Admin SDK, inside the transaction that performs the state change.

       DELETE IS FALSE FOR EVERYONE, INCLUDING superAdmin. adminLog permits a
       superAdmin delete; that precedent is deliberately NOT followed here. A
       privileged actor must not be able to erase the record of what they did.

       The read arm names newUid and NEVER previousUid: a person whose
       binding was replaced would otherwise keep reading the employment's
       FUTURE history. Events before invite_accepted carry no newUid and are
       admin-only by construction — correct, because there is no employee yet.

       There is deliberately NO owner arm. A rule saying
       resource.data.businessId == request.auth.uid is the merchantId ==
       auth.uid mistake, true for exactly one production business;
       organization history is read through a callable that calls
       assertMerchantAccess first. That callable is a later gate. */
    match /employmentEvents/{eventId} {
      allow read:                   if isAdmin()
                                    || (isAuthed() && resource.data.newUid == request.auth.uid);
      allow create, update, delete: if false; // CF-only — employment-events.js
    }

    /* ── employmentInvites — binding a human to an employment (ADR-035 §3) ──
       FULLY CF-ONLY, reads included. shopInvites carries `allow get: if true`,
       which is tolerable for a document holding an email and a shop role; an
       employment invitation names a salary-bearing relationship.

       The token is a CALLABLE CAPABILITY, not a read key. The invitee never
       reads this document — they present the token to acceptEmploymentInvite,
       which reads it with the Admin SDK and checks their authenticated email
       against it. Exposing the document would let anyone holding a link read
       the businessId, the staffId and the invited address.

       `superseded` lives in THIS collection's status, not in the employment
       history: replacing an invitation changes no employment state
       (pending -> pending), so it is not an employment event. */
    match /employmentInvites/{token} {
      allow read, create, update, delete: if false; // CF-only — employment-invites.js
    }

    /* ── employmentUidClaims — UID occupancy, one per (business, uid) ──────
       ADR-035 §4. EXISTENCE IS THE ONLY SIGNAL:

         claim exists -> this (businessId, uid) currently has an ACTIVE binding
         claim absent -> that uid is available in that business

       Written only by employment-invites.js, with create() inside the
       acceptance transaction — it is the single document two concurrent
       acceptances share, and therefore the only thing that can serialise them.

       FULLY CF-ONLY, reads included. A client that could read this could
       enumerate which accounts are employed by which business; a client that
       could write it could either forge an occupancy that blocks a legitimate
       hire, or delete one and let a uid be bound twice.

       The document carries IMMUTABLE PROVENANCE ONLY — businessId, uid,
       staffId, createdAt — for forensic attribution. It has no status or
       lifecycle field by design, and nothing may consult it as an alternative
       employment authority: hrStaff holds employment state, employmentEvents
       holds its history. */
    match /employmentUidClaims/{claimId} {
      allow read, create, update, delete: if false; // CF-only — employment-invites.js (claims)
    }

    // ── Procurement ───────────────────────────────────────────────────────
    match /procSuppliers/{supplierId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — addSupplier
    }

    match /procPurchaseOrders/{poId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — createPurchaseOrder, approvePurchaseOrder
    }

    match /procGRN/{grnId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — receiveGoods
    }

    match /procSupplierInvoices/{invoiceId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — createSupplierInvoice, approveAndPayInvoice
    }

    match /procVendorPerformance/{perfId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — scheduledVendorPerformanceUpdate
    }

    match /procForecast/{forecastId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — getProcurementForecast
    }

    // ── Marketing Engine ──────────────────────────────────────────────────
    match /mktBundleDeals/{bundleId} {
      allow read:  if isAuthed();
      allow write: if false; // CF-only — createBundleDeal
    }

    match /mktFlashSales/{saleId} {
      allow read:  if isAuthed();
      allow write: if false; // CF-only — createFlashSale, recordFlashSalePurchase
    }

    match /mktABTests/{testId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — runABTest, recordABTestImpression
    }

    match /mktDynamicPricing/{ruleId} {
      allow read:  if isAuthed();
      allow write: if false; // CF-only — createDynamicPricingRule
    }

    match /mktCouponCodes/{couponId} {
      /* 2026-09-27: every signed-in user could list every merchant's codes. The merchant and admins
         only; buyers validate a code through the server (applyCouponCode / booking checkout). */
      allow read:  if isAdmin() || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — applyCouponCode
    }

    match /mktCampaigns/{campaignId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — createMarketingCampaign
    }

    match /mktRecommendationEngineLog/{logId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only — getCrossSellRecommendations
    }

    // ── Chaos Engineering ─────────────────────────────────────────────────
    match /chaosTestReports/{reportId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only — runWeeklyChaosTest
    }

    match /_chaosCanary/{docId} {
      allow read, write: if false; // CF-only — transient test documents
    }

    // ── CRM — Customer Relationship Management ───────────────────────────
    match /crmLeads/{leadId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid)
                   || (isAuthed() && resource.data.assignedTo == request.auth.uid);
      allow write: if false; // CF-only — createLead, updateLead, convertLead
    }

    match /crmLeadActivities/{activityId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — logLeadActivity
    }

    match /crmCustomerProfiles/{uid} {
      allow read:  if isAdmin()
                   || (isAuthed() && request.auth.uid == uid)
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only — buildCustomerProfile, calculateCLV
    }

    match /crmSegments/{segmentId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid);
      allow write: if false; // CF-only
    }

    match /crmSupportTickets/{ticketId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.uid)
                   || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false; // CF-only — createSupportTicket, updateSupportTicket
    }

    // ── Certification Reports ─────────────────────────────────────────────
    match /certificationReports/{reportId} {
      allow read:  if isAdmin();
      allow write: if false; // CF-only — runProductionCertification
    }

    // ── SmartPOS Cash Management ──────────────────────────────────────────
    match /posCashSessions/{sessionId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.token.merchantId)
                   || (isAuthed() && resource.data.cashierId  == request.auth.uid);
      allow write: if false; // CF-only — cmRecordCashEvent
    }

    match /posCashEvents/{eventId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.token.merchantId);
      allow write: if false; // CF-only — cmRecordCashEvent, cmSafeDrop
    }

    match /posDrawerEvents/{eventId} {
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.token.merchantId);
      allow write: if false; // CF-only — cmLogDrawerOpen
    }

    match /posCloseApprovals/{approvalId} {
      // Cashier who submitted the request can read their own; managers can read all for their merchant
      allow read:  if isAdmin()
                   || (isAuthed() && resource.data.merchantId == request.auth.token.merchantId
                       && (resource.data.requestedBy == request.auth.uid
                           || request.auth.token.get('manager', false)
                           || request.auth.token.get('supervisor', false)));
      allow write: if false; // CF-only — cmRequestCloseApproval, cmApproveRegisterClose
    }

    // ── Provider Onboarding & Dashboard ──────────────────────────────────────

    match /providerProfiles/{uid} {
      allow read:  if isAuthed() && request.auth.uid == uid;
      allow write: if false; // CF-only — providerDispatch
    }

    match /providerSubscriptions/{uid} {
      allow read:  if isAuthed() && request.auth.uid == uid;
      allow write: if false; // CF-only — providerDispatch
    }

    /* Provider availability — the provider owns their own settings.
       `allow write: if false` meant NOBODY could ever save: the settings document
       could not be created, mode changes could not persist, and nothing survived a
       refresh. Verified against the deployed ruleset with the Rules test API —
       create/update/delete on your OWN doc all returned DENY.
       Reads stay open to any signed-in user: customers must be able to see whether a
       provider is open. Writes are owner-only. */
    /* NB: the existing isOwner() helper takes no argument and reads
       resource.data.uid — which is NULL on create, so it cannot authorise the very
       first write. The owner here is identified by the PATH segment, so compare
       request.auth.uid to {uid} directly. */
    match /providerAvailability/{uid} {
      /* HEALTHCARE (CHANGELOG 234): a provider whose record carries the server-written `healthcare` attribute
         (CHANGELOG 227) writes availability ONLY through the server — entAvailSetConfig (audited, plan-enforced),
         add/removeAvailabilityOverride, setVacationMode. A direct write here bypassed every one of those checks.
         Other providers are unchanged by this slice. */
      function hcProvider() {
        return exists(/databases/$(database)/documents/providers/$(uid))
          && ('healthcare' in get(/databases/$(database)/documents/providers/$(uid)).data);
      }
      allow read:   if isAuthed();     // customers may read to check availability
      allow create: if isAuthed() && request.auth.uid == uid && !hcProvider();
      allow update: if isAuthed() && request.auth.uid == uid && !hcProvider();
      allow delete: if false;          // availability is never hard-deleted

      /* Date overrides (holidays / one-off closures) live in a subcollection.
         A parent match does NOT cascade to subcollections, so without this block
         every override read AND write was denied — which is why custom holidays
         silently never loaded and never saved. */
      match /overrides/{date} {
        allow read:  if isAuthed();
        allow write: if isAuthed() && request.auth.uid == uid && !hcProvider();
      }
    }

    match /providerPortfolio/{uid} {
      allow read:  if isAuthed();
      allow write: if false;
    }

    match /providerBookings/{bookingId} {
      /* Read: the provider (providerId) or the customer who owns it. The canonical
         customer field is `customerUid` (what bookingCreateService writes); `customerId`
         is kept for any legacy docs. Needed so a customer can OBSERVE their own booking
         (pending → paid_held → settled) in real time. Writes stay CF-only. */
      allow read:  if isAdmin()
                   || (isAuthed() && (resource.data.providerId == request.auth.uid
                                      || resource.data.customerUid == request.auth.uid
                                      || resource.data.customerId == request.auth.uid));
      allow write: if false;
    }

    match /providerReviews/{reviewId} {
      /* 2026-09-27: the raw doc carries the booking id, the reviewer's uid and moderation state. The PUBLIC
         reads the projection (bookingDispatch repReviews); the doc is for its author, its provider, admins. */
      allow read:  if isAdmin() || (isAuthed() && (resource.data.customerUid == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow write: if false;
    }

    match /providerVerification/{uid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write: if false;
    }

    /* ── Driver / rider records ────────────────────────────────────────────────
       `drivers/{uid}` is the operational rider record read by navigation.js
       (auto-dispatch), admin-os.js (online counts) and email-triggers.js. It had
       NO rule block at all, which in a default-deny ruleset means the rider could
       not read their own record — the driver dashboard could show a rider nothing
       about their own approval state or payout setting.

       Written exclusively by the server (`applicationLifecycle` /
       `applicationDecide` via the Admin SDK, which bypasses rules), so all client
       writes are denied. Approval status, suspension and vehicle verification are
       platform decisions; a rider who could write this document could approve
       themselves onto the road. Going online is a separate act and is expressed
       through `rideDrivers` + `riderLocations`, which have their own rules.

       Read is owner-or-admin, NOT `isAuthed()`: this record carries the rider's
       payout frequency and home area, which no other customer needs. */
    match /drivers/{uid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write: if false;   // CF-only — applicationLifecycle / dispatch
    }

    /* Rider identity documents — National ID, driving licence, expiry.
       Deliberately a SEPARATE collection from `drivers` and `rideDrivers`,
       because `rideDrivers` is readable by every signed-in user (dispatch needs
       the rider's operational record) and putting identity numbers there would
       expose every rider's National ID to any account on the platform. Consistent
       with providerVerification above and with the ODPC treatment of
       high-sensitivity identifiers: restricted at rest, never search-indexed.
       Admin-read for review; the rider may read their own to see what is still
       outstanding. CF-write only. */
    match /driverVerification/{uid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write: if false;   // CF-only — applicationLifecycle
    }

    match /providerSettings/{uid} {
      allow read:  if isAuthed() && request.auth.uid == uid;
      allow write: if false;
    }

    match /providerNotifications/{uid} {
      allow read:  if isAuthed() && request.auth.uid == uid;
      allow write: if false;
    }

    match /providerPayouts/{payoutId} {
      allow read:  if isAdmin() || (isAuthed() && resource.data.providerId == request.auth.uid);
      allow write: if false;
    }

    match /providerAnalytics/{uid} {
      allow read:  if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow write: if false;
    }

    match /providerCalendar/{uid} {
      /* 2026-09-27: the mirror carries customerName — the provider and admins only. */
      allow read:  if isAdmin() || (isAuthed() && resource.data.providerId == request.auth.uid);
      allow write: if false;
    }

    match /providerServices/{uid} {
      allow read:  if isAuthed();
      allow write: if false;
    }

    // ── Universal Onboarding Engine — account collections ──────────────────

    match /accounts/{uid} {
      allow read:  if isAuthed() && request.auth.uid == uid;
      allow write: if false; // CF-only — onboardingDispatch
    }

    match /accountDrafts/{draftId} {
      allow read:  if isAuthed() && resource.data.accountId == request.auth.uid;
      allow write: if false; // CF-only
    }

    match /accountProfiles/{profileId} {
      // Owners read own profile; public can read for discovery
      allow read:  if true;
      allow write: if false; // CF-only — onboardingDispatch
    }

    match /accountSubscriptions/{subId} {
      allow read:  if isAdmin() || (isAuthed() && resource.data.accountId == request.auth.uid);
      allow write: if false; // CF-only
    }

    match /accountHandles/{handle} {
      allow read:  if true; // public — handle availability check
      allow write: if false;
    }

    // ── SFOS — Financial Operating System ─────────────────────────────────────

    match /sfosIdentity/{uid} {
      // Only the identity owner or admin may read; writes via CF Admin SDK only
      allow read:  if (isAuthed() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    match /sfosLedger/{entryId} {
      // Immutable double-entry ledger — account owner or admin may read
      allow read:  if isAdmin() ||
                     (isAuthed() &&
                       resource.data.accountId == request.auth.uid);
      allow write: if false; // immutable — CF Admin SDK only
    }

    match /sfosTransactions/{txId} {
      // Only direct financial participants (sender / receiver) or admin may read.
      // initiatorUid is intentionally excluded: it can be set to a third-party UID
      // (e.g. an agent acting on behalf of someone else), which would create a
      // lateral-read vector if included here.
      allow read:  if isAdmin() ||
                     (isAuthed() &&
                       (resource.data.fromId == request.auth.uid ||
                        resource.data.toId   == request.auth.uid));
      allow write: if false;
    }

    match /sfosEscrow/{escrowId} {
      // Buyer, seller, or admin; no client writes
      allow read:  if isAdmin() ||
                     (isAuthed() &&
                       (resource.data.buyerUid  == request.auth.uid ||
                        resource.data.sellerUid == request.auth.uid));
      allow write: if false;
    }

    match /sfosGroups/{groupId} {
      // Group members may read; writes via CF only
      allow read:  if isAdmin() ||
                     (isAuthed() &&
                       resource.data.members.hasAny([request.auth.uid]));
      allow write: if false;
    }

    match /sfosGroups/{groupId}/wallets/{walletUid} {
      // Each member can only read their own sub-wallet; path wildcard walletUid
      // IS the member UID, so no member can enumerate another member's balance.
      allow read:  if (isAuthed() && request.auth.uid == walletUid) || isAdmin();
      allow write: if false;
    }

    match /sfosMerchant/{merchantId} {
      // Merchant owner or admin
      allow read:  if isAdmin() ||
                     (isAuthed() && request.auth.uid == merchantId);
      allow write: if false;
    }

    match /sfosMerchant/{merchantId}/settlements/{settlementId} {
      allow read:  if isAdmin() ||
                     (isAuthed() && request.auth.uid == merchantId);
      allow write: if false;
    }

    match /sfosRewards/{uid} {
      allow read:  if (isAuthed() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    match /sfosAuditLog/{logId} {
      // Immutable audit log — admin-read only
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /sfosRiskEvents/{riskId} {
      // Risk/fraud events — admin only
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /sfosFinancialHealth/{uid} {
      allow read:  if (isAuthed() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    match /sfosIdempotency/{keyId} {
      // Users can poll their own idempotency records to check retry status.
      // The key document stores uid so the rule can bind to the authenticated user.
      // CF Admin SDK is the sole writer — client writes are always rejected.
      allow read:  if isAuthed() && resource.data.uid == request.auth.uid;
      allow write: if false; // CF Admin SDK only
    }

    /* ── Public Search Catalog Collections ─────────────────────────────────
       These collections hold marketplace listings that must be publicly
       discoverable via search. Firestore fallback and Path C (search.html)
       both query them without authentication for anonymous visitors.

       Write paths are strictly admin-only or via Cloud Functions (Admin SDK).
       PII fields (phone, exact address) should be avoided at the listing level;
       detailed contact info lives behind auth in the provider/user profile. */

    /* Service listings — plumbers, electricians, tutors, cleaners, etc. */
    match /services/{serviceId} {
      allow read:   if resource.data.status == 'active' || resource.data.status == 'published'
                    || (isAuthed() && resource.data.uid == request.auth.uid)
                    || isAdmin();
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid
                        && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }

    /* Vehicle listings — cars, motorcycles, trucks */
    match /vehicles/{vehicleId} {
      allow read:   if resource.data.status == 'active' || resource.data.status == 'published'
                    || (isAuthed() && resource.data.sellerId == request.auth.uid)
                    || isAdmin();
      allow create: if isAuthed() && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.sellerId == request.auth.uid && noAdminFields());
      allow delete: if isAdmin() || (isAuthed() && resource.data.sellerId == request.auth.uid);
    }

    /* Car listings (alias collection — same shape as vehicles) */
    match /cars/{carId} {
      allow read:   if resource.data.status == 'active' || resource.data.status == 'published'
                    || (isAuthed() && resource.data.sellerId == request.auth.uid)
                    || isAdmin();
      allow create: if isAuthed() && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.sellerId == request.auth.uid && noAdminFields());
      allow delete: if isAdmin() || (isAuthed() && resource.data.sellerId == request.auth.uid);
    }

    /* Property listings */
    match /properties/{propertyId} {
      allow read:   if resource.data.status == 'active' || resource.data.status == 'published'
                    || (isAuthed() && resource.data.agentId == request.auth.uid)
                    || isAdmin();
      allow create: if isAuthed() && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.agentId == request.auth.uid && noAdminFields());
      allow delete: if isAdmin() || (isAuthed() && resource.data.agentId == request.auth.uid);
    }

    /* Property listings (extended schema) */
    match /propertyListings/{listingId} {
      allow read:   if resource.data.status == 'active' || resource.data.status == 'published'
                    || (isAuthed() && resource.data.agentId == request.auth.uid)
                    || isAdmin();
      allow create: if isAuthed() && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.agentId == request.auth.uid && noAdminFields());
      allow delete: if isAdmin() || (isAuthed() && resource.data.agentId == request.auth.uid);
    }

    /* Digital job listings — freelance / gig economy */
    match /digitalJobs/{jobId} {
      allow read:   if resource.data.status == 'active' || resource.data.status == 'published'
                    || (isAuthed() && resource.data.employerUid == request.auth.uid)
                    || isAdmin();
      allow create: if isAuthed() && request.resource.data.employerUid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.employerUid == request.auth.uid && noAdminFields());
      allow delete: if isAdmin() || (isAuthed() && resource.data.employerUid == request.auth.uid);
    }

    /* REMOVED — duplicate `applications` block.
       This was labelled "Job application listing (open calls) — searchable public
       listings", but it matched the SAME path as the onboarding-application rule
       near the top of this file. Firestore unions all matching allow rules, so
       this block's `status == 'open' || 'active'` read clause silently applied to
       provider, business and rider applications too — documents that hold a phone
       number, a National ID and a driving-licence number. No code ever wrote
       either status here (job posts live in `jobs`/`jobApplications`), so the
       public-listing intent was never realised while the PII exposure was real.

       The single authoritative block is `match /applications/{appId}` above;
       see the comment there. Do not re-add a second block for this path — add
       clauses to the one rule instead, or the union quietly widens access again. */

    /* Healthcare providers — REMOVED (HC-01, 2026-09-13). This was a SECOND
       `match /healthProviders/` block; Firestore unions duplicates, so its owner
       create/update silently overrode the `allow write: if false` in the
       Healthcare Hub v1.0 block above and made an active healthcare provider
       self-mintable. The single authoritative block is that one — add clauses
       there, never a second block here. Production carried zero real providers
       when this was removed, so nothing legitimate depended on it. See
       docs/adr/ADR-014-healthcare-provider-identity-convergence.md. */

    /* Stores (shop catalog entries — same audience as sellers) */
    match /stores/{storeId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.ownerId == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.ownerId == request.auth.uid
                        && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || (isAuthed() && resource.data.ownerId == request.auth.uid);
    }

    /* ══════════════════════════════════════════════════════════════════
       HUB COLLECTIONS THAT HAD NO RULE BLOCK  (added 2026-07-23)

       Every path below was unreachable: with no match block, Firestore
       denies by default, so these hubs could neither list nor create
       anything. Their client engines swallowed the denial, so each one
       presented as an empty screen rather than an error.

       Access model, applied consistently:
         • catalogue / listing data  → public read, owner-authored writes
         • a person's own records    → readable by that person, the provider
                                        serving them, and admins — nobody else
         • money, audit and queue    → admin read, writes server-side only
       ══════════════════════════════════════════════════════════════════ */

    /* ── Healthcare patient requests (CHANGELOG 221 — Healthcare security slice 1) ──
       Lab bookings, medicine orders, teleconsults and home-visit requests are PATIENT-OWNED requests.
       There is no server-authorized patient→provider/pharmacy relationship for them yet (ADR-014 /
       ADR-015 converge them onto canonical bookings later, not authorized). So, fail closed:
         • the requester is the authenticated caller (uid == auth.uid) — never a client-chosen identity;
         • a patient may NOT nominate a recipient (providerId / pharmacyId / facilityId / assignedTo).
           Nominating a uid used to GRANT that account read + write on the patient's symptoms,
           medicines and phone number;
         • only the patient and admins read a request; a provider/pharmacy named on a legacy document
           no longer can;
         • the patient may change their own request but never its owner or recipient, and may set
           status only to 'cancelled'; recipient assignment / reassignment is admin-only.
       Admin writes made here are not audited by any server authority (there is none for these
       collections yet) — recorded as a limitation in CHANGELOG 221. */
    function healthRecipientFields() {
      return ['providerId', 'pharmacyId', 'facilityId', 'assignedTo', 'assignedProviderId', 'labId'];
    }
    function healthRequestCreate() {
      return claimsOwner() && noAdminFields()
        && !request.resource.data.keys().hasAny(healthRecipientFields());
    }
    function healthRequestRead() {
      return isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
    }
    function healthRequestPatientUpdate() {
      return isAuthed() && resource.data.uid == request.auth.uid && uidUnchanged() && noAdminFields()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(healthRecipientFields())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || request.resource.data.status == 'cancelled');
    }
    match /healthLabBookings/{docId} {
      allow read:   if healthRequestRead();
      allow create: if healthRequestCreate();
      allow update: if isAdmin() || healthRequestPatientUpdate();
      allow delete: if isAdmin();
    }
    match /healthMedOrders/{docId} {
      allow read:   if healthRequestRead();
      allow create: if healthRequestCreate();
      allow update: if isAdmin() || healthRequestPatientUpdate();
      allow delete: if isAdmin();
    }
    match /healthTelemedicine/{docId} {
      allow read:   if healthRequestRead();
      allow create: if healthRequestCreate();
      allow update: if isAdmin() || healthRequestPatientUpdate();
      allow delete: if isAdmin();
    }
    match /healthHomeServices/{docId} {
      allow read:   if healthRequestRead();
      allow create: if healthRequestCreate();
      allow update: if isAdmin() || healthRequestPatientUpdate();
      allow delete: if isAdmin();
    }
    /* Emergency requests: created only by a SIGNED-IN requester for THEMSELVES (uid == auth.uid — the
       client used to write any uid, or 'anonymous'), with no nominated recipient; the requester and
       admins read; only admins (or a dispatcher Cloud Function, which bypasses rules) update. A
       signed-out person is directed to the national emergency numbers by the page. */
    match /healthEmergency/{docId} {
      allow read:   if healthRequestRead();
      allow create: if healthRequestCreate();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    /* Provider reviews are public by design — that is the point of them. */
    match /healthReviews/{docId} {
      /* CLIENT MAY NOT DECIDE who wrote a review, who it is about, whether the experience happened, the
         aggregate, verification or moderation (CHANGELOG 213). No client writer is legitimate here: the hub's
         server authority (or none yet) owns it. */
      allow read:   if true;
      allow create: if false;   /* ratings: rateHealthProvider (a completed appointment of the caller's) */
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ── Construction hub ── */
    match /constructProviders/{docId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields() && noRatingAggOnCreate();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields() && noRatingAggOnUpdate());
      allow delete: if isAdmin();
    }
    match /constructEquipment/{docId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }
    match /constructProjects/{docId} {
      allow read:   if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }
    /* An RFQ is visible to its author, and to providers while it is open —
       that is how a provider finds work to quote on. */
    match /constructRFQs/{docId} {
      allow read:   if resource.data.status == 'open'
                    || isAdmin()
                    || (isAuthed() && resource.data.uid == request.auth.uid);
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin() || isOwner();
    }
    /* A quotation is between one provider and the RFQ's author. The get() on
       the parent RFQ is what lets the buyer see quotes addressed to them
       without denormalising their uid onto every quotation. */
    match /constructQuotations/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.providerUid == request.auth.uid)
                    || (isAuthed()
                        && exists(/databases/$(database)/documents/constructRFQs/$(resource.data.rfqId))
                        && get(/databases/$(database)/documents/constructRFQs/$(resource.data.rfqId)).data.uid == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.providerUid == request.auth.uid
                    && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.providerUid == request.auth.uid && noAdminFields());
      allow delete: if isAdmin();
    }
    match /constructOrders/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && (resource.data.uid == request.auth.uid
                                       || resource.data.providerUid == request.auth.uid));
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && (resource.data.uid == request.auth.uid
                                       || resource.data.providerUid == request.auth.uid)
                        && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    match /constructReviews/{docId} {
      /* CLIENT MAY NOT DECIDE who wrote a review, who it is about, whether the experience happened, the
         aggregate, verification or moderation (CHANGELOG 213). No client writer is legitimate here: the hub's
         server authority (or none yet) owns it. */
      allow read:   if true;
      allow create: if false;   /* construction orders are client-asserted: no eligible experience yet */
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ── Digital / freelance hub ──
       Owner fields here are named per role, so claimsOwner() (which checks a
       plain `uid`) does not apply — each block names the field the client
       actually writes. */
    match /digitalGigs/{docId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.sellerUid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.sellerUid == request.auth.uid && noAdminFields());
      allow delete: if isAdmin() || (isAuthed() && resource.data.sellerUid == request.auth.uid);
    }
    /* A proposal is between the freelancer who wrote it and the job's owner.
       Job ownership is checked against digitalJobs, which has its own rule. */
    match /digitalProposals/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && resource.data.freelancerUid == request.auth.uid)
                    || (isAuthed()
                        && exists(/databases/$(database)/documents/digitalJobs/$(resource.data.jobId))
                        && (get(/databases/$(database)/documents/digitalJobs/$(resource.data.jobId)).data.employerUid == request.auth.uid
                            /* digital.html writes the job owner as posterUid; the
                               /digitalJobs rule names employerUid. Both are accepted
                               here so a client can see proposals on their own job
                               whichever field their job document carries. */
                            || get(/databases/$(database)/documents/digitalJobs/$(resource.data.jobId)).data.posterUid == request.auth.uid));
      allow create: if isAuthed() && request.resource.data.freelancerUid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && (resource.data.freelancerUid == request.auth.uid) && noAdminFields());
      allow delete: if isAdmin();
    }
    match /digitalContracts/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && (resource.data.clientUid == request.auth.uid
                                       || resource.data.freelancerUid == request.auth.uid));
      allow create: if isAuthed() && request.resource.data.clientUid == request.auth.uid && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && (resource.data.clientUid == request.auth.uid
                                       || resource.data.freelancerUid == request.auth.uid)
                        && noAdminFields());
      allow delete: if isAdmin();
    }
    /* Chat messages: only the sender may write, and only the two parties to
       the chat may read. Membership is carried by chatId, which is composed
       from both uids — so a reader must be one of them. */
    match /digitalMessages/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && (resource.data.senderUid == request.auth.uid
                                       || resource.data.chatId.matches('.*' + request.auth.uid + '.*')));
      allow create: if isAuthed()
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.chatId is string
                    && noAdminFields();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /digitalReviews/{docId} {
      /* CLIENT MAY NOT DECIDE who wrote a review, who it is about, whether the experience happened, the
         aggregate, verification or moderation (CHANGELOG 213). No client writer is legitimate here: the hub's
         server authority (or none yet) owns it. */
      allow read:   if true;
      allow create: if false;   /* freelance contracts are client-authored; reviews open with server-verified contract payment */
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ── Marketing services ── */
    match /marketingProviders/{docId} {
      allow read:   if true;
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin() || (isOwner() && uidUnchanged() && noAdminFields());
      allow delete: if isAdmin();
    }
    match /marketingBookings/{docId} {
      allow read:   if isAdmin()
                    || (isAuthed() && (resource.data.uid == request.auth.uid
                                       || resource.data.providerId == request.auth.uid));
      allow create: if claimsOwner() && noAdminFields();
      allow update: if isAdmin()
                    || (isAuthed() && resource.data.providerId == request.auth.uid && noAdminFields());
      allow delete: if isAdmin();
    }

    /* ── Runtime configuration and public search signals ──
       featureFlags is read by sokoni-service-mesh.js on every page load; with
       no rule the read failed and the mesh fell back to defaults silently. */
    match /featureFlags/{flagId} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /searchTrending/{docId} {
      allow read:  if true;
      allow write: if false;              // written by the search pipeline
    }

    /* Client-side search telemetry. Append-only for a signed-in user writing
       their own row; nobody but an admin reads it. Anonymous telemetry is not
       accepted — an unauthenticated write endpoint is a spam endpoint. */
    match /searchClicks/{docId} {
      allow read:   if isAdmin();
      allow create: if claimsOwner();
      allow update, delete: if false;
    }
    match /searchImpressions/{docId} {
      allow read:   if isAdmin();
      allow create: if claimsOwner();
      allow update, delete: if false;
    }
    match /searchAnalytics/{docId} {
      allow read:   if isAdmin();
      allow create: if claimsOwner();
      allow update, delete: if false;
    }

    /* ── Operations dashboards ──
       Read-only to admins. These were all denied outright, which is why the
       ops screens rendered empty for admins too. Writes stay with Cloud
       Functions except where the console itself files a record. */
    match /eccAlerts/{docId}            { allow read: if isAdmin(); allow write: if false; }
    match /eccSystemHealth/{docId}      { allow read: if isAdmin(); allow write: if false; }
    match /eccIncidents/{docId}         { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /eccAuditLog/{docId}          { allow read: if isAdmin(); allow create: if isAdmin(); allow update, delete: if false; }
    match /intelligenceLog/{docId}      { allow read: if isAdmin(); allow write: if false; }
    match /paymentAuthorizations/{docId}{ allow read: if isAdmin(); allow write: if false; }
    match /workflowInstances/{docId}    { allow read: if isAdmin(); allow write: if false; }
    match /workflowApprovals/{docId}    { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /finosAudit/{docId}           { allow read: if isAdmin(); allow write: if false; }
    match /launch_metrics/{docId}       { allow read: if isAdmin(); allow write: if false; }
    match /launch_failures/{docId}      { allow read: if isAdmin(); allow write: if false; }
    match /redisJobAudit/{docId}        { allow read: if isAdmin(); allow write: if false; }
    match /auditLog/{docId}             { allow read: if isAdmin(); allow write: if false; }
    match /support_tickets/{docId}      { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /tsQueryStats/{docId}         { allow read: if isAdmin(); allow write: if false; }
    match /tsClickStats/{docId}         { allow read: if isAdmin(); allow write: if false; }
    match /typesenseQueue/{docId}       { allow read: if isAdmin(); allow write: if false; }
    match /aiUsage/{docId}              { allow read: if isAdmin(); allow write: if false; }
    match /aiCreditLedger/{docId}       { allow read: if isAdmin(); allow write: if false; }
    match /aiPromotions/{docId}         { allow read: if isAdmin(); allow write: if isAdmin(); }

    /* ── Money, queues and audit trails — server-owned ──
       Listed explicitly so the intent is recorded rather than left to the
       default. Client engines that attempt these writes (sokoni-payment-engine,
       sokoni-wap-definitions, sokoni-fraud-engine, sokoni-webhook-engine) are
       writing to ledgers a browser must never be trusted with; their writes
       have always failed and must keep failing. The correct home for them is a
       Cloud Function, which bypasses these rules. */
    match /refunds/{docId}         { allow read: if isAdmin() || (isAuthed() && resource.data.uid == request.auth.uid); allow write: if false; }
    match /settlements/{docId}     { allow read: if isAdmin(); allow write: if false; }
    match /paymentLedger/{docId}   { allow read: if isAdmin(); allow write: if false; }
    match /payoutQueue/{docId}     { allow read: if isAdmin() || (isAuthed() && resource.data.sellerUid == request.auth.uid); allow write: if false; }
    match /notificationQueue/{docId} { allow read: if isAdmin(); allow write: if false; }
    match /analyticsEvents/{docId} { allow read: if isAdmin(); allow write: if false; }
    match /eventLog/{docId}        { allow read: if isAdmin(); allow write: if false; }
    match /webhookLogs/{docId}     { allow read: if isAdmin(); allow write: if false; }
    match /fraudLog/{docId}        { allow read: if isAdmin(); allow write: if false; }
    match /fraudBlocklist/{docId}  { allow read: if isAdmin(); allow write: if false; }

    /* ── SOKONI Connect — call sessions are SERVER-WRITTEN, always ──
       `participants` is the only list of who is on a call and it is DERIVED by
       connect-calls.js from the anchor document, never supplied by a caller.
       A client write here would let a browser add itself to a session, which is
       the same defect as a client-named conversation participant except that
       the consequence is a stranger's telephone ringing. */
    match /connectSessions/{sessionId} {
      allow read: if isAdmin() || (isAuthed() && request.auth.uid in resource.data.participants);
      allow write: if false;
      /* Signalling is relayed by connectSignal and read by the peer it is addressed to —
         never by the sender, and never by anyone else on the platform. */
      match /signals/{signalId} {
        allow read: if isAuthed() && request.auth.uid == resource.data.to;
        allow write: if false;
      }
    }
    /* A video verification session. EVIDENCE, never an authority: `providerVerification` decides
       whether an account is verified, and an official identity additionally needs a passed
       identity check, a passed face check and a completed human review. Readable by the subject
       — a person is entitled to see that they were asked to appear on camera and what was
       recorded about it — and written only by connectRecordVerificationOutcome. */
    match /connectVerifications/{verificationId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.subjectUid == request.auth.uid);
      allow write: if false;
    }
    /* The organisation's video permission. Readable by the two parties it names so a member
       can be shown why video is unavailable; written only by connectSetVideoGrant, which
       first proves the granting account's own package includes video. */
    match /connectVideoGrants/{grantId} {
      allow read: if isAdmin() || (isAuthed() &&
                    (resource.data.ownerUid == request.auth.uid ||
                     resource.data.memberUid == request.auth.uid));
      allow write: if false;
    }

  }
}
