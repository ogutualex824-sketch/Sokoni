# SOKONI Cloud Functions — non-secret environment variables
# These are configuration values (not secrets) — safe to commit.
# Secrets (admin keys, passwords) go via: firebase functions:secrets:set SECRET_NAME
#
# ── Algolia ───────────────────────────────────────────────────────────────
# Your Algolia Application ID (public — visible in browser headers)
# Get it: Algolia Dashboard → Settings → Applications → copy App ID
ALGOLIA_APP_ID=FF2WSTR4YC

# ── Typesense ─────────────────────────────────────────────────────────────
# Comma-separated list of Typesense nodes in format host:port:protocol
# Cloud example: xyz.a1.typesense.net:443:https
# Multi-node:    n1.example.com:443:https,n2.example.com:443:https
# Self-hosted:   localhost:8108:http
TYPESENSE_NODES=4kn6y5bfcxv8o702p-1.a2.typesense.net:443:https

# ── KRA eTIMS ─────────────────────────────────────────────────────────────
# Must be "production" or "sandbox". No default — missing value throws at boot.
ETIMS_ENV=production

# ── Africa's Talking ──────────────────────────────────────────────────────
# Controls which AT environment is used.
#   sandbox    → username is 'sandbox'; hits AT sandbox API (default)
#   production → reads AFRICASTALKING_USERNAME secret; hits live AT API
# Change to production ONLY after:
#   1. firebase functions:secrets:set AFRICASTALKING_USERNAME (your real AT username)
#   2. Your AT account has been approved for live use
AT_ENV=sandbox

# ── Redis ─────────────────────────────────────────────────────────────────
# REDIS_URL is stored in Firebase Secret Manager — NOT this file.
# Instance: sokoni-redis  |  Region: us-central1  |  10.127.36.43:6379
# To view:   firebase functions:secrets:access REDIS_URL
# To update: firebase functions:secrets:set REDIS_URL
# NOTE: Cloud Functions require a Serverless VPC Access connector to reach
#       Memorystore's private IP. See DEPLOY_QUEUE.md for connector setup.

# Branded sender ID — PENDING operator approval.
# Leave EMPTY until Africa's Talking approves "SOKONI".
# On approval: set AT_SENDER_ID=SOKONI and redeploy the SMS functions. No code change.
AT_SENDER_ID=
