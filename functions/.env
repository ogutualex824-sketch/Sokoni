# SOKONI Cloud Functions — non-secret environment variables
# These are configuration values (not secrets) — safe to commit.
# Secrets (admin keys, passwords) go via: firebase functions:secrets:set SECRET_NAME
#
# ── Algolia ───────────────────────────────────────────────────────────────
# Your Algolia Application ID (public — visible in browser headers)
# Get it: Algolia Dashboard → Settings → Applications → copy App ID
ALGOLIA_APP_ID=FF2WSTR4YC

# ── Typesense ─────────────────────────────────────────────────────────────
# Comma-separated list of Typesense nodes in format host:port:protocol
# Cloud example: xyz.a1.typesense.net:443:https
# Multi-node:    n1.example.com:443:https,n2.example.com:443:https
# Self-hosted:   localhost:8108:http
TYPESENSE_NODES=4kn6y5bfcxv8o702p-1.a2.typesense.net:443:https

# ── KRA eTIMS ─────────────────────────────────────────────────────────────
# Must be "production" or "sandbox". No default — missing value throws at boot.
ETIMS_ENV=production

# ── Redis ─────────────────────────────────────────────────────────────────
# Rate-limiter URL (redis-rate-limiter.js). Without this, all 12 profiles
# fall back to no-op mode — NO rate limiting is applied in production.
#
# Provision:  GCP Console → Memorystore → Create Instance
#             Tier: Basic  Capacity: 1GB  Region: us-central1  Version: 7.x
# Then set:   REDIS_URL=redis://<PRIMARY_ENDPOINT_IP>:6379
# With auth:  REDIS_URL=rediss://:<AUTH_STRING>@<IP>:6379
#
# Do NOT leave blank when deploying to production.
REDIS_URL=
