{
  "name": "sokoni-functions",
  "description": "SOKONI Firebase Cloud Functions — Kass Admin AI Agent + Payment/Subscription/Voucher Engine",
  "scripts": {
    "test": "jest --testPathPattern=test/ --forceExit --testTimeout=10000",
    "test:watch": "jest --testPathPattern=test/ --watch",
    "test:coverage": "jest --testPathPattern=test/ --coverage --forceExit",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "deploy:payment": "firebase deploy --only functions:initiateSTKPush,functions:intasendWebhook,functions:cancelPayment",
    "deploy:subscriptions": "firebase deploy --only functions:activateSubscription",
    "deploy:vouchers": "firebase deploy --only functions:redeemVoucher",
    "deploy:monitoring": "firebase deploy --only functions:recordMetric",
    "deploy:background": "firebase deploy --only functions:aggregateAnalytics,functions:generateTrending,functions:cleanupExpiredSubscriptions",
    "deploy:security": "firebase deploy --only functions:detectFraud,functions:getSecurityEvents",
    "deploy:all": "firebase deploy --only functions",
    "canary": "firebase hosting:channel:deploy canary --expires 2h",
    "canary:promote": "firebase hosting:clone sokoni-aeb26:canary sokoni-aeb26:live",
    "scale:test:1k": "node ../test-scale.js --users=1000",
    "scale:test:10k": "node ../test-scale.js --users=10000",
    "scale:test:50k": "node ../test-scale.js --users=50000",
    "scale:test:100k": "node ../test-scale.js --users=100000"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@sendgrid/mail": "^8.1.6",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "intasend-node": "^1.0.11",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "algolia-sync\\.test\\.js",
      "search-monitor\\.test\\.js",
      "search-worker\\.test\\.js"
    ],
    "collectCoverageFrom": [
      "index.js"
    ]
  },
  "_notes": {
    "crypto": "Built into Node.js 22 — no separate package needed",
    "https": "Built into Node.js — no separate package needed",
    "intasend": "Called via HTTPS directly — no SDK needed. Set INTASEND_PRIVATE_KEY via: firebase functions:secrets:set INTASEND_PRIVATE_KEY",
    "intasend_sandbox": "Set INTASEND_SANDBOX env var to 'true' for testing: firebase functions:config:set intasend.sandbox=true",
    "webhook_url": "Register https://us-central1-sokoni-aeb26.cloudfunctions.net/intasendWebhook as your IntaSend webhook URL"
  }
}
