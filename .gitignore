# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.local
# functions/.env contains only non-secret config (ALGOLIA_APP_ID, TYPESENSE_NODES)
# — keep it tracked so Firebase deploy picks it up
!functions/.env

# dataconnect generated files
.dataconnect

# AI tooling & editor config (personal, not project code)
.claude/
.agents/
.vscode/

# Temporary working directories
Temp/

# Dev artefacts dropped in root
decoded
*.url

# Screenshot & throwaway images captured during development
ss_*.png
tmp_*.png

# Functions dependencies (checked per-platform; restored via npm install)
functions/node_modules/

# Firestore index backup files generated during migrations
firestore.indexes.json.bak
firestore.indexes.json.full_backup
firestore.indexes.json.new-only
*.json.phase*.json

# Service account keys — never commit
*firebase-adminsdk*.json
*service-account*.json

# Playwright screenshots and test artifacts
screenshots/
!assets/screenshots/
test-results/
playwright-report/

# Environment files
.env
.env.*
*.env

# Generated build artifacts
dist/
build/

# CF audit / migration tool outputs (generated; not source)
cf-audit*.html
cf-audit*.json
cf-audit*.csv
cf-complete-audit.html
cf-exports-cache.json
cf-migration-plan*.html
cf-partition-report.html

# Android signing — NEVER commit keystore or passwords
*.keystore
*.jks
sokoni-release.keystore

# release baseline snapshot (generated by npm run release:preflight)
.release-preflight.json

# Scratch artifacts generated by scripts
docs/_pr-body.md
scripts/*-output*


# Performance probe auth fixture — a LIVE SESSION, never commit
.perf-auth.json

# Served Storage ruleset, fetched at audit time (scripts/test-merchant-products-2c-media.js
# refuses to assert against a repo copy). Regenerate:
#   gcloud auth print-access-token  ->  firebaserules.googleapis.com rulesets/<storage release>
storage.rules.deployed
