{
  "_comment": "SOKONI Operational Alerting — Google Cloud Monitoring alert policies.",
  "_setup": [
    "1. Install gcloud CLI: https://cloud.google.com/sdk/docs/install",
    "2. Authenticate: gcloud auth login",
    "3. Set project: gcloud config set project sokoni-aeb26",
    "4. Apply all policies: node monitoring/apply-alerts.js",
    "   OR apply one at a time: gcloud alpha monitoring policies create --policy-from-file=<policy_file.json>"
  ],
  "_notification_channels": [
    "Set up the GCP notification channel ONCE, then store the channel ID as a GitHub Actions secret.",
    "",
    "Step 1 — create the channel:",
    "  gcloud alpha monitoring channels create \\",
    "    --display-name='SOKONI Ops' \\",
    "    --type=email \\",
    "    --channel-labels=email_address=devops@mysokoni.co.ke",
    "",
    "Step 2 — get the channel ID:",
    "  gcloud alpha monitoring channels list --filter='displayName=SOKONI Ops' --format='value(name)'",
    "",
    "Step 3 — add as GitHub Actions secret:",
    "  gh secret set GCP_MONITORING_CHANNEL_ID --body 'projects/sokoni-aeb26/notificationChannels/<ID>'",
    "",
    "The deploy workflow reads NOTIFICATION_CHANNEL_ID from the GCP_MONITORING_CHANNEL_ID secret.",
    "DO NOT put the real channel ID in this file — store it in GitHub Secrets only."
  ],

  "policies": [

    {
      "displayName": "Cloud Function Error Rate > 5%",
      "documentation": {
        "content": "More than 5% of Cloud Function executions are failing. Check function logs: https://console.cloud.google.com/functions?project=sokoni-aeb26",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "CF error rate over 5%",
        "conditionThreshold": {
          "filter": "resource.type=\"cloud_function\" AND metric.type=\"cloudfunctions.googleapis.com/function/execution_count\" AND metric.labels.status!=\"ok\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0.05,
          "duration": "300s",
          "aggregations": [{
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_RATE"
          }]
        }
      }],
      "alertStrategy": { "autoClose": "1800s" },
      "combiner": "OR"
    },

    {
      "displayName": "Cloud Function P95 Latency > 10s",
      "documentation": {
        "content": "95th percentile latency for Cloud Functions exceeds 10 seconds. Payment and webhook functions may be timing out.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "CF p95 latency > 10s",
        "conditionThreshold": {
          "filter": "resource.type=\"cloud_function\" AND metric.type=\"cloudfunctions.googleapis.com/function/execution_times\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 10000,
          "duration": "300s",
          "aggregations": [{
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95"
          }]
        }
      }],
      "alertStrategy": { "autoClose": "1800s" },
      "combiner": "OR"
    },

    {
      "displayName": "Firestore Read Latency P99 > 2s",
      "documentation": {
        "content": "Firestore reads are abnormally slow. Check for missing indexes or hot documents.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "Firestore p99 read latency > 2s",
        "conditionThreshold": {
          "filter": "resource.type=\"firestore.googleapis.com/Database\" AND metric.type=\"firestore.googleapis.com/api/request_latencies\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 2000,
          "duration": "300s",
          "aggregations": [{
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_PERCENTILE_99"
          }]
        }
      }],
      "alertStrategy": { "autoClose": "3600s" },
      "combiner": "OR"
    },

    {
      "displayName": "Webhook DLQ Depth > 10",
      "documentation": {
        "content": "More than 10 webhooks are in the dead-letter queue. Payment confirmations may be failing. Check: https://us-central1-sokoni-aeb26.cloudfunctions.net/webhookHealth",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "DLQ depth over 10 (log-based)",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND jsonPayload.dlqDepth>10",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "86400s" },
      "combiner": "OR"
    },

    {
      "displayName": "Fraud Block Rate > 10/hour",
      "documentation": {
        "content": "More than 10 payments blocked by fraud engine in the past hour. Possible attack in progress. Review fraudLog and fraudBlocklist in Firestore.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "High fraud block rate",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND jsonPayload.fraudDecision=\"block\"",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "3600s" },
      "combiner": "OR"
    },

    {
      "displayName": "HTTP 5xx Error Rate > 1%",
      "documentation": {
        "content": "Firebase Hosting / Cloud Functions are returning 5xx errors. Check Cloud Function logs for errors.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "CF 5xx error spike",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND severity=ERROR",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": {
        "notificationRateLimit": { "period": "3600s" },
        "autoClose": "1800s"
      },
      "combiner": "OR"
    },

    {
      "displayName": "Hardcoded Secret Detected in Build",
      "documentation": {
        "content": "CI pipeline detected a potential hardcoded secret (ISPrivKey_live_, sk_live_, pk_live_). Build blocked. Review the commit immediately.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "CI secret scan failure",
        "conditionMatchedLog": {
          "filter": "resource.type=\"build\" AND textPayload:\"HARDCODED SECRET DETECTED\"",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "86400s" },
      "combiner": "OR"
    },

    {
      "displayName": "Email Queue Depth > 200 (backlog)",
      "documentation": {
        "content": "More than 200 emails are pending in the emailQueue collection. SendGrid may be down or the queue processor is failing.\nCheck: https://console.cloud.google.com/firestore/data/emailQueue?project=sokoni-aeb26",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "email queue depth critical",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND resource.labels.function_name=\"processEmailQueue\" AND textPayload:\"Both transports failed\"",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "3600s" },
      "combiner": "OR"
    },

    {
      "displayName": "Payment Verification Failure Rate > 10%",
      "documentation": {
        "content": "More than 10% of payment verification attempts are failing. IntaSend integration may be down or the private key is misconfigured.\nCheck verifyIntasendPayment and darajaSTKPush logs.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "payment verification errors",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND (resource.labels.function_name=\"verifyIntasendPayment\" OR resource.labels.function_name=\"darajaSTKPush\") AND severity=ERROR",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "1800s" },
      "combiner": "OR"
    },

    {
      "displayName": "Backup Not Run in 26 Hours",
      "documentation": {
        "content": "scheduledFirestoreBackup has not run successfully in over 26 hours. Check the Cloud Function logs and verify the GCS bucket sokoni-aeb26-backups exists with correct IAM permissions.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "firestore backup failure",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND resource.labels.function_name=\"scheduledFirestoreBackup\" AND severity=ERROR",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "86400s" },
      "combiner": "OR"
    },

    {
      "displayName": "CSP Violations Spike > 50/hour",
      "documentation": {
        "content": "A high volume of Content Security Policy violations has been detected. This may indicate an XSS injection attempt or a newly introduced inline script. Check cspViolations collection: https://console.cloud.google.com/firestore/data/cspViolations?project=sokoni-aeb26",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "csp violation spike",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND resource.labels.function_name=\"cspReportCollect\" AND severity!=\"ERROR\"",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "3600s" },
      "combiner": "OR"
    },

    {
      "displayName": "Search Health Degraded",
      "documentation": {
        "content": "The searchHealth endpoint returned a non-200 status code. Algolia or Typesense may be unreachable.\nCheck: https://us-central1-sokoni-aeb26.cloudfunctions.net/searchHealth",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "search health 503",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND resource.labels.function_name=\"searchHealth\" AND httpRequest.status>=500",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "1800s" },
      "combiner": "OR"
    },

    {
      "displayName": "System Health Check Degraded",
      "documentation": {
        "content": "The systemHealthCheck endpoint returned HTTP 206 (degraded) or 503 (unhealthy). One or more subsystems need attention.\nCheck: https://us-central1-sokoni-aeb26.cloudfunctions.net/systemHealthCheck",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "system health degraded",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND resource.labels.function_name=\"systemHealthCheck\" AND (httpRequest.status=206 OR httpRequest.status=503)",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "1800s" },
      "combiner": "OR"
    },

    {
      "displayName": "Payment Idempotency Replay Spike (> 20/hour)",
      "documentation": {
        "content": "More than 20 idempotent payment replays detected in an hour. This may indicate a client retry loop, a webhook misconfiguration, or a downstream processing delay that is causing IntaSend to re-deliver callbacks. Check the paymentVerifications collection and verifyIntasendPayment logs.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "high replay rate",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND resource.labels.function_name=\"verifyIntasendPayment\" AND jsonPayload.message=\"idempotent replay\"",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "3600s" },
      "combiner": "OR"
    },

    {
      "displayName": "Rate Limit Abuse Detected",
      "documentation": {
        "content": "A rate limit was triggered by verifyIntasendPayment, initiateSTKPush, or KASS. If this fires repeatedly from the same IP or UID it may indicate credential stuffing or API abuse. Check rateLimits collection and Cloud Function logs.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "rate limit triggered",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND jsonPayload.message=\"Rate limit exceeded\" AND severity=WARNING",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "3600s" },
      "combiner": "OR"
    },

    {
      "displayName": "SLO Breach — Order Success Rate < 99%",
      "documentation": {
        "content": "The order success rate (orders with status='paid' / total STK push attempts) has dropped below 99% in the last 30 minutes. This is a payment SLO breach. Check verifyIntasendPayment logs, IntaSend dashboard, and the orders collection for recent failures.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "order success rate SLO breach",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND resource.labels.function_name=\"verifyIntasendPayment\" AND severity=ERROR",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "1800s" },
      "combiner": "OR"
    },

    {
      "displayName": "SLO Breach — Checkout Session Creation Error",
      "documentation": {
        "content": "createCheckoutSession is returning errors. This directly blocks users from completing payments. Check Firestore products collection and Cloud Function logs. SLO target: < 0.1% error rate.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "checkout session error",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND resource.labels.function_name=\"createCheckoutSession\" AND severity=ERROR",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "1800s" },
      "combiner": "OR"
    },

    {
      "displayName": "KASS Prompt Injection Attempt",
      "documentation": {
        "content": "A possible prompt injection was detected in the KASS admin AI. The message has been sanitized and the event has been logged to the securityEvents collection in Firestore. Review the event for potential account compromise.",
        "mimeType": "text/markdown"
      },
      "conditions": [{
        "displayName": "kass injection detected",
        "conditionMatchedLog": {
          "filter": "resource.type=\"cloud_function\" AND resource.labels.function_name=\"kass\" AND textPayload:\"Possible injection detected\"",
          "labelExtractors": {}
        }
      }],
      "alertStrategy": { "notificationRateLimit": { "period": "3600s" }, "autoClose": "86400s" },
      "combiner": "OR"
    }

  ]
}
